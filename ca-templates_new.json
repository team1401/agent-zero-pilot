    macOS Time Machine disk picker.

    Time Machine needs the server to advertise an _adisk._tcp mDNS record
    alongside _smb._tcp. Unraid publishes only the latter, so a Time Machine
    share can be fully visible in Finder and completely absent from Time
    Machine. This plugin reads the running Samba config and publishes the
    missing record, following share changes automatically and leaving Unraid's
    own avahi file untouched.";s:9:"PluginURL";s:101:"https://raw.githubusercontent.com/externl/unraid-timemachine-discovery/main/timemachine-discovery.plg";s:12:"PluginAuthor";s:7:"externl";s:7:"Support";s:62:"https://github.com/externl/unraid-timemachine-discovery/issues";s:7:"Project";s:55:"https://github.com/externl/unraid-timemachine-discovery";s:6:"ReadMe";s:85:"https://raw.githubusercontent.com/externl/unraid-timemachine-discovery/main/README.md";s:6:"IconFA";s:7:"history";s:7:"License";s:3:"MIT";s:11:"TemplateURL";s:95:"https://raw.githubusercontent.com/externl/unraid-plugins/main/plugins/timemachine-discovery.xml";s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/plugins/timemachine-discovery.xml";s:4:"Repo";s:20:"externl's Repository";s:10:"Repository";s:101:"https://raw.githubusercontent.com/externl/unraid-timemachine-discovery/main/timemachine-discovery.plg";s:12:"CategoryList";a:2:{i:0;s:6:"Backup";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.10.11";s:6:"MinVer";s:6:"6.12.0";s:6:"Author";s:7:"externl";s:4:"Icon";s:0:"";s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:213;s:9:"FirstSeen";i:1787443513;s:14:"LastUpdateScan";i:1792411842;s:11:"pluginStats";a:13:{i:10;i:23;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:121;s:2:"09";i:69;s:1:"T";i:213;}s:8:"Category";s:16:"Backup: Plugins:";s:2:"ID";i:2051;s:11:"Displayable";b:1;s:13:"DockerHubName";s:22:"time machine discovery";s:8:"RepoName";s:20:"externl's Repository";s:10:"SortAuthor";s:7:"externl";s:8:"SortName";s:22:"Time Machine Discovery";s:6:"random";i:19448597;s:9:"Blacklist";b:0;s:4:"Path";s:210:"/tmp/community.applications/tempFiles/templates-community-apps/externlsRepository/externl-TimeMachineDiscovery-//raw.githubusercontent.com/externl/unraid-timemachine-discovery/main/timemachine-discovery.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";