On first start, ZITADEL writes here the access token that the companion zitadel-login container needs to function. Must point inside the shared bootstrap volume below.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/zitadel/bootstrap/login-client.pat";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Login Client Machine Username";s:6:"Target";s:54:"ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_USERNAME";s:7:"Default";s:12:"login-client";s:4:"Mode";s:0:"";s:11:"Description";s:128:"Do not change unless you know why. Internal service-account username created on first start for the login UI to authenticate as.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"login-client";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Login Client Machine Name";s:6:"Target";s:50:"ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_MACHINE_NAME";s:7:"Default";s:42:"Automatically Initialized IAM_LOGIN_CLIENT";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Display name for the internal login-client service account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:42:"Automatically Initialized IAM_LOGIN_CLIENT";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"Login Client PAT Expiration Date";s:6:"Target";s:56:"ZITADEL_FIRSTINSTANCE_ORG_LOGINCLIENT_PAT_EXPIRATIONDATE";s:7:"Default";s:20:"2124-01-01T00:00:00Z";s:4:"Mode";s:0:"";s:11:"Description";s:266:"CRITICAL, do not leave empty: without a valid RFC3339 date here, ZITADEL silently skips writing the login-client.pat file entirely (no error logged) and zitadel-login will never work. The default is ~100 years out, effectively 'never expires' for practical purposes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"2124-01-01T00:00:00Z";}i:19;a:2:{s:11:"@att