lse";}s:5:"value";s:2:"22";}}s:12:"TemplatePath";s:48:"/tmp/GitHub/AppFeed/unraid/chatgpt-community.xml";s:4:"Repo";s:27:"Jeffersonmouze's Repository";s:12:"CategoryList";a:2:{i:0;s:2:"AI";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790727129;s:8:"Category";s:19:"AI: Tools:Utilities";s:2:"ID";i:2646;s:11:"Displayable";b:1;s:6:"Author";s:15:"jeffreymooiweer";s:13:"DockerHubName";s:17:"chatgpt-community";s:8:"RepoName";s:27:"Jeffersonmouze's Repository";s:10:"SortAuthor";s:15:"jeffreymooiweer";s:8:"SortName";s:17:"ChatGPT Community";s:6:"random";i:1627199010;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:132:"/tmp/community.applications/tempFiles/templates-community-apps/JeffersonmouzesRepository/jeffreymooiweer-ChatGPTCommunity-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2647;a:36:{s:4:"Name";s:5:"Facet";s:10:"Repository";s:30:"ghcr.io/jesposito/facet:latest";s:8:"Registry";s:55:"https://github.com/jesposito/Facet/pkgs/container/facet";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:41:"https://github.com/jesposito/Facet/issues";s:7:"Project";s:34:"https://github.com/jesposito/Facet";s:8:"Overview";s:891:"Facet is a self-hosted personal profile platform. Create multiple views of your professional profile for different audiences (recruiters, conferences, clients) and own all of your data.

Each view is a curated slice of your full profile: a recruiter sees roles and references, a conference organizer sees talks and bio, a client sees portfolio and rates. You decide what each audience sees and they only see what you've shared.

First-time login: visit `/admin`, sign in with the first email from `Admin Emails` (or `admin@example.com` if blank) and the seeded password printed in the container logs. You will be forced to set a new password immediately.

Features:
- Multiple profile views per person
- OAuth login via Google or GitHub (optional)
