ariable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:49;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"WEBDAV_BACKUP_PATH";s:6:"Target";s:18:"WEBDAV_BACKUP_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:204:"Optional. Remote directory path where backup files are stored. Leave empty to use the value from Settings, Household, Backup and restore (default: /yuvomi/backups/); any value here overrides that setting.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:50;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"WEBDAV_BACKUP_KEEP";s:6:"Target";s:18:"WEBDAV_BACKUP_KEEP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:175:"Optional. Number of remote backup files to keep. Leave empty to use the value from Settings, Household, Backup and restore (default: 7); any value here overrides that setting.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:51;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:30:"DOCUMENT_STORAGE_LOCAL_ENABLED";s:6:"Target";s:30:"DOCUMENT_STORAGE_LOCAL_ENABLED";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:141:"Optional. Store newly uploaded document files in the mounted /documents host folder instead of the database. Existing files are not migrated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:52;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"DOCUMENT_STORAGE_LOCAL_PATH";s:6:"Target";s:27:"DOCUMENT_STORAGE_LOCAL_PATH";s:7:"Default";s:10:"/documents";s:4:"Mode";s:0:"";s:11:"Description";s:114:"Optional. Container path for local document files. Keep default unless you mounted the documents folder elsewhere.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"/documents";}i:53;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"DOCUMENT_STORAGE_WEBDAV_ENABLED";s:6:"Target";s:31:"DOCUMENT_STORAGE_WEBDAV_ENABLED";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:258:"Optional. Set to true to store newly uploaded document files on WebDAV. Leave empty to decide under Settings, Modules, Documents, Document storage: any value here, false included, overrides that switch and locks it in the UI. Existing files are not migrated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:54;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"DOCUMENT_STORAGE_WEBDAV_URL";s:6:"Target";s:27:"DOCUMENT_STORAGE_WEBDAV_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:111:"Optional. WebDAV server URL for document storage, e.g. https://cloud.example.com/remote.php/dav/files/username/";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:55;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"DOCUMENT_STORAGE_WEBDAV_USERNAME";s:6:"Target";s:32:"DOCUMENT_STORAGE_WEBDAV_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:47:"Optional. WebDAV username for document storage.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:56;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"DOCUMENT_STORAGE_WEBDAV_PASSWORD";s:6:"Target";s:32:"DOCUMENT_STORAGE_WEBDAV_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:47:"Optional. WebDAV password for document storage.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:57;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"DOCUMENT_STORAGE_WEBDAV_PATH";s:6:"Target";s:28:"DOCUMENT_STORAGE_WEBDAV_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:217:"Optional. Remote base folder for document files. Leave empty to use the value from Settings, Modules, Documents, Document storage (default: yuvomi-documents); any value here overrides it and locks the field in the UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:58;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:45:"DOCUMENT_STORAGE_WEBDAV_ALLOW_PRIVATE_NETWORK";s:6:"Target";s:45:"DOCUMENT_STORAGE_WEBDAV_ALLOW_PRIVATE_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:174:"Optional. Set to true to allow WebDAV document storage on local/private network addresses (e.g. Nextcloud in the same Docker network). Only enable in controlled environments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:59;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:38:"ICS_SUBSCRIPTION_ALLOW_PRIVATE_NETWORK";s:6:"Target";s:38:"ICS_SUBSCRIPTION_ALLOW_PRIVATE_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:249:"Optional. Set to true to allow ICS calendar subscriptions on http:// and local/private network addresses (e.g. a Sonarr/Radarr/Home Assistant feed in the same LAN). Lifts SSRF protection for ICS subscriptions. Only enable in controlled environments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:60;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"RECIPE_PROVIDER_ALLOW_PRIVATE_NETWORK";s:6:"Target";s:37:"RECIPE_PROVIDER_ALLOW_PRIVATE_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:291:"Optional. Set to true to allow recipe provider (Mealie/Tandoor) mirrors on local/private network addresses, including a base URL that is itself a private IP (e.g. self-hosted in the same Docker network). Lifts SSRF protection for recipe provider sync. Only enable in controlled environments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:61;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:34:"WASTE_SOURCE_ALLOW_PRIVATE_NETWORK";s:6:"Target";s:34:"WASTE_SOURCE_ALLOW_PRIVATE_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:273:"Optional. Set to true to allow waste collection URL sources on http:// and local/private network addresses (e.g. a municipal waste calendar mirrored in the same Docker network). Lifts SSRF protection for waste collection URL sources. Only enable in controlled environments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:62;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:34:"NOTIFICATION_ALLOW_PRIVATE_NETWORK";s:6:"Target";s:34:"NOTIFICATION_ALLOW_PRIVATE_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:293:"Optional. Set to true to allow notification channels (Webhook, Gotify, ntfy) on local/private network addresses (e.g. a Gotify container in the same Docker network or a Home Assistant webhook in the LAN). Lifts SSRF protection for notification delivery. Only enable in controlled environments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:63;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"GRAVATAR_BASE_URL";s:6:"Target";s:17:"GRAVATAR_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:374:"Optional, off unless set. Base URL for the one-time Gravatar import of a member's profile picture (Settings, Account, Use my Gravatar), e.g. https://gravatar.com/avatar/ or a Libravatar-compatible mirror (https only, public host). Only a SHA-256 hash of the lowercased email address reaches the service, never the address. Empty: nothing is sent and the button is not shown.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";