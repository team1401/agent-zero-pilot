ving their own key in the Models tab.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:52:"/tmp/GitHub/AppFeed/templates/nexus-orchestrator.xml";s:4:"Repo";s:21:"PikkonMG's Repository";s:12:"CategoryList";a:3:{i:0;s:2:"AI";i:1;s:15:"Tools-Utilities";i:2;s:12:"Productivity";}s:9:"downloads";i:4161;s:9:"FirstSeen";i:1775468553;s:10:"LastUpdate";i:1784404171;s:14:"LastUpdateScan";i:1791198847;s:8:"Category";s:33:"AI: Tools:Utilities Productivity:";s:2:"ID";i:1012;s:11:"Displayable";b:1;s:6:"Author";s:8:"pikkonmg";s:13:"DockerHubName";s:18:"nexus-orchestrator";s:8:"RepoName";s:21:"PikkonMG's Repository";s:10:"SortAuthor";s:8:"pikkonmg";s:8:"SortName";s:18:"Nexus Orchestrator";s:6:"random";i:56193371;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:120:"/tmp/community.applications/tempFiles/templates-community-apps/PikkonMGsRepository/pikkonmg-NexusOrchestrator-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:38:"Templates are free, coffee is optional";s:10:"DonateLink";s:31:"https://paypal.me/HighlandJewls";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1013;a:41:{s:4:"Name";s:17:"nvidia-nim-single";s:4:"Date";s:10:"2026-03-12";s:8:"Keywords";s:75:"AI,LLM,local-ai,NVIDIA,NIM,CUDA,inference,OpenAI API,chatbot,language model";s:10:"Repository";s:45:"nvcr.io/nim/meta/llama-3.2-3b-instruct:latest";s:8:"Registry";s:72:"https://registry.hub.docker.com/r/nvcr.io/nim/meta/llama-3.2-3b-instruct";s:6:"GitHub";s:52:"https://github.com/PikkonMG/unraid-docker-templates/";s:6:"ReadMe";s:87:"https://github.com/PikkonMG/unraid-docker-templates/blob/main/docs/NVIDIA-NIM_SINGLE.md";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:92:"https://forums.unraid.net/topic/197721-support-nvidia-nim-on-unraid-gpu-ai-inference-server/";s:7:"Project";s:25:"https://build.nvidia.com/";s:8:"Overview";s:1748:"NVIDIA NIM AI inference server for running LLMs locally on NVIDIA GPUs with CUDA acceleration and an OpenAI-compatible API. 
    
Be sure to check out for NIM related support https://developer.nvidia.com/nim 
    
DEFAULT MODEL: meta/llama-3.2-3b-instruct -- recommended for GPUs with 12 GB VRAM or less (RTX 3060, 3070, etc). 

TO CHANGE MODELS: Update BOTH the Repository image tag AND the NIM_MODEL_NAME variable to matching values. Browse available models at https://build.nvidia.com/models 

VRAM REQUIREMENTS (approximate): 
  - Llama 3.2 3B   ~6 GB  -- fits 8-12 GB cards 
  - Mistral 7B     ~14 GB -- needs 16 GB+ (fp16 uses more than expected) 
  - Llama 3.1 8B   ~22 GB -- needs 24 GB+ 
  - Llama 3.1 70B  ~80 GB -- multi-GPU only 

BEFORE FIRST START -- REQUIRED STEPS (run once in Unraid terminal): 

Before you can pull the image you must have a NVIDIA API key from https://build.nvidia.com. Generate a Personal API Key from your profile. 

  Step 1: Login to NGC registry (only needed once, persists until reboot): 
    docker login nvcr.io 
    Username: $oauthtoken 
    Password: YOUR_NGC_API_KEY 

  REQUIRED BEFORE FIRST START -- run in Unraid terminal: 
  Step 2: Fix cache directory permissions: 
    chown -R 1000:1000 /mnt/user/appdata/nvidia-nim/cache 
    chmod -R 775 /mnt/user/appdata/nvidia-nim/cache 

REQUIRES: NVIDIA GPU (Turing/RTX 20 series or newer) | nvidia-driver Unraid plugin | NGC API key from build.nvidia.com 

URLS (replace YOUR_SERVER_IP with your Unraid IP): 
  WebUI / Swagger docs : http://YOUR_SERVER_IP:8000/docs 
  API base URL         : http://YOUR_SERVER_IP:8000/v1   (use this in AnythingLLM, Open WebUI, etc.) 
