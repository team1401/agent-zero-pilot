r/zonefoundry/bridge";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:30:"https://relay.zonefoundry.dev/";s:7:"Project";s:29:"https://relay.zonefoundry.dev";s:8:"Overview";s:940:"ZoneFoundry Bridge — connects your Sonos system to ZoneFoundry's iOS app, voice assistant, and IM bots (Telegram, WeChat, QQ) via the cloud relay.

First launch: pair with a one-time code from your iOS app, container persists credentials in /app/data and reuses on restart.

1-tap updates: the iOS app's Bridges screen surfaces "升级" / "Apply Update" when a new bridge image is published — tap once and the bridge pulls the new image via the mounted docker socket and restarts itself. No SSH or Container Manager interaction needed.

Host network mode is required so the bridge can SSDP-discover Sonos speakers on your LAN. Container runs as non-root user (UID 10001) with --cap-drop ALL — make sure the host data path is chowned 10001:10001. The docker socket mount and --group-add 281 (Unraid's docker group GID) grant the bridge permission to pull new images for self-update; remove them if you prefer manual updates only.";s:11:"TemplateURL";s:103:"https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/zf-bridge-unraid.xml";s:4:"Icon";s:42:"https://relay.zonefoundry.dev/icon-512.png";s:11:"ExtraParams";s:80:"--cap-drop ALL --read-only --tmpfs /tmp:rw,nosuid,nodev,size=16m --group-add 281";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Relay URL";s:6:"Target";s:12:"ZF_RELAY_URL";s:7:"Default";s:30:"wss://relay.zonefoundry.dev/ws";s:4:"Mode";s:0:"";s:11:"Description";s:38:"ZoneFoundry cloud relay WebSocket URL.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"wss://relay.zonefoundry.dev/ws";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Pair Code (first launch only)";s:6:"Target";s:12:"ZF_PAIR_CODE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:179:"One-time 6-letter code from your iOS app's Add Bridge screen. Only needed for first launch — once paired, container caches credentials in /app/data and you can clear this field.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"User ID (override)";s:6:"Target";s:10:"ZF_USER_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:112:"Advanced: explicit user_id from existing pairing (skips pair-code redeem). Leave empty to use pair code instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attr