  `lastOnline` text NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;";s:11:"TemplateURL";s:109:"https://raw.githubusercontent.com/natcoso9955/unRAID-docker/master/ProjectZomboidReporter-Ingester_unraid.xml";s:4:"Icon";s:87:"https://github.com/natcoso9955/unRAID-docker/raw/master/icons/projectzomboid-ingest.png";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:15:"Project Zomboid";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"ZOMBOID_SERVER_NAME";s:6:"Target";s:19:"ZOMBOID_SERVER_NAME";s:7:"Default";s:10:"servertest";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"Game_Server";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Project Zomboid Server Files";s:6:"Target";s:16:"/var/www/html/sv";s:7:"Default";s:41:"/mnt/user/appdata/ProjectZomboid/Zomboid/";s:4:"Mode";s:2:"ro";s:11:"Description";s:0:"";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:41:"/mnt/user/appdata/ProjectZomboid/Zomboid/";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SQL_HOST";s:6:"Target";s:8:"SQL_HOST";s:7:"Default";s:13:"serverip:port";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"SQL_DATABASE";s:6:"Target";s:12:"SQL_DATABASE";s:7:"Default";s:5:"Zombo";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"Zombo";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SQL_USER";s:6:"Target";s:8:"SQL_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask