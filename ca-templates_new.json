rstSeen";i:1776755400;s:10:"LastUpdate";i:1781776291;s:14:"LastUpdateScan";i:1790525754;s:8:"Category";s:25:"Security: Tools:Utilities";s:2:"ID";i:645;s:11:"Displayable";b:1;s:6:"Author";s:9:"jsonbored";s:13:"DockerHubName";s:13:"infisical-aio";s:8:"RepoName";s:22:"JSONbored's Repository";s:10:"SortAuthor";s:9:"jsonbored";s:8:"SortName";s:13:"infisical aio";s:6:"random";i:1129302371;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/JSONboredsRepository/jsonbored-infisicalaio-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:165:"If these AIO templates save you time, please consider supporting ongoing maintenance via Ko-fi (ko-fi.com/jsonbored) or Buy Me a Coffee (buymeacoffee.com/jsonbored).";s:10:"DonateLink";s:27:"https://ko-fi.com/jsonbored";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:646;a:46:{s:4:"Name";s:8:"khoj-aio";s:10:"Repository";s:25:"jsonbored/khoj-aio:latest";s:8:"Registry";s:43:"https://hub.docker.com/r/jsonbored/khoj-aio";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/JSONbored/khoj-aio/issues";s:7:"Project";s:37:"https://github.com/JSONbored/khoj-aio";s:8:"Overview";s:2145:"Khoj is a self-hosted AI second brain for chatting with your docs, the web, and local or hosted LLMs.

[b]All-In-One Unraid Edition[/b]
`khoj-aio` packages the Khoj server with an internally managed PostgreSQL database so beginners can get a clean first boot on Unraid without wiring a separate database container.

[b]Quick Install (Beginners)[/b]
1. Install the template and leave the default appdata paths in place.
2. Optionally set [code]KHOJ_ADMIN_EMAIL[/code], [code]KHOJ_ADMIN_PASSWORD[/code], and [code]KHOJ_DJANGO_SECRET_KEY[/code].
3. Leave [code]KHOJ_ANONYMOUS_MODE=true[/code] for the simplest private LAN-first install, then click Apply.
4. Wait for first boot to finish, open [code]http://SERVER_IP:42110[/code], and restart the container once after the initial setup so all settings are applied cleanly.
5. If you left the password or secret blank, the container generates secure values and saves them in your mapped config folder at [code]/root/.khoj/aio/generated.env[/code].

[b]Power Users (Advanced View)[/b]
- Advanced View exposes the practical upstream self-hosted environment surface plus AIO-specific controls.
- You can keep the bundled internal PostgreSQL default, or point Khoj at external PostgreSQL, search providers, code sandboxes, identity providers, upload storage, Twilio/Notion integrations, and OpenAI-compatible local or hosted LLM endpoints.
- Leave defaults in place for the easiest install. Only set the overrides you actually need.

[b]Important Notes[/b]
- This image intentionally keeps PostgreSQL bundled because that is the critical first-boot dependency for Khoj on Unraid. Search, sandbox, and provider integrations remain optional advanced add-ons.
- If you expose Khoj outside your LAN, set strong admin credentials, configure [code]KHOJ_DOMAIN[/code] and [code]KHOJ_ALLOWED_DOMAIN[/code] correctly, and strongly consider disabling anonymous mode.
- Upstream currently documents Google OAuth mainly against the prod [code]khoj-cloud[/code] image, so the Google auth variables below should be treated as expert-only and tested carefully in this standard self-host image flow.";s:5:"WebUI";s:24:"http://[IP]:[PORT:42110]";s:11:"TemplateURL";s:76:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/khoj-aio.xml";s:6:"ReadMe";s:44:"https://github.com/JSONbored/khoj-aio#readme";s:4:"Icon";s:78:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/icons/khoj.png";s:16:"ExtraSearchTerms";s:88:"ai second-brain notes documents rag knowledge-base search ollama anthropic gemini openai";s:8:"Requires";s:207:"For public internet exposure, do not leave anonymous mode enabled unless you intentionally accept that risk. Set strong admin credentials and configure KHOJ_DOMAIN / KHOJ_ALLOWED_DOMAIN before remote access.";s:10:"Screenshot";a:3:{i:0;s:96:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/khoj-aio/01-home.png";i:1;s:96:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/khoj-aio/02-chat.png";i:2;s:100:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/khoj-aio/03-settings.png";}s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:68:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:5:"42110";s:7:"Default";s:5:"42110";s:4:"Mode";s:3:"tcp";s:11:"Description";s:33:"The main Khoj web interface port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"42110";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"AppData - Khoj Config";s:6:"Target";s:11:"/root/.khoj";s:7:"Default";s:33:"/mnt/user/appdata/khoj-aio/config";s:4:"Mode";s:2:"rw";s:11:"Description";s:68:"Stores generated credentials, uploads, and Khoj configuration state.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";