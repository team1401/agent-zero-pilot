This is the server half. The machines you play on need the Hoard desktop app (Windows, Linux, macOS, Steam Deck) or the CLI: hoard.services/download

Setup:
1. Type an admin username and password below, then press Apply.
2. Open the container log. The device token for your first PC is printed there, once.
3. In the desktop app choose "Self-Host", enter http://TOWER-IP:12421 and paste the token.
4. WebUI opens the web panel. Log in with the same username and password to see your saves, devices and users.

To add another PC later, or an account for someone else, open the WebUI and go to Users: "New token" issues one for a machine, "New user" creates an account. A token is shown once, so copy it before you close the dialog.

Everything is stored in the two appdata folders below. Back up data/ and you have your saves. Free and open source (AGPL-3.0), with no account and no telemetry when self-hosted.";s:5:"WebUI";s:30:"http://[IP]:[PORT:12421]/panel";s:11:"TemplateURL";s:71:"https://raw.githubusercontent.com/rleeon/hoard/main/templates/hoard.xml";s:4:"Icon";s:75:"https://raw.githubusercontent.com/rleeon/hoard/main/web/static/icon-512.png";s:8:"Requires";s:76:"The Hoard desktop app or CLI on each PC you play on: hoard.services/download";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"WebUI / API Port";s:6:"Target";s:5:"12421";s:7:"Default";s:5:"12421";s:4:"Mode";s:3:"tcp";s:11:"Description";s:78:"The port the server listens on. Both the desktop app and the web panel use it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"12421";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Saves and database";s:6:"Target";s:14:"/var/lib/hoard";s:7:"Default";s:28:"/mnt/user/appdata/hoard/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:106:"Everything the server stores: the database and every version of every save. This is the folder to back up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/hoard/data";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Config folder";s:6:"Target";s:10:"/etc/hoard";s:7:"Default";s:30:"/mnt/user/appdata/hoard/config";s:4:"Mode";s:2:"rw";s:11:"Description";s:154:"Holds config.toml. Leave it empty and the container writes a working one on first start. Edit it afterwards to change limits or use S3-compatible storage.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/hoard/config";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin username";s:6:"Target";s:20:"HOARD_ADMIN_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:138:"Creates this admin account the first time the container starts on an empty database. Ignored after that, so it is safe to leave filled in.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin password";s:6:"Target";s:20:"HOARD_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:129:"Password for the account above, at least 8 characters. It is what you type into the web panel, and you can change it there later.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"First device name";s:6:"Target";s:18:"HOARD_ADMIN_DEVICE";s:7:"Default";s:6:"unraid";s:4:"Mode";s:0:"";s:11:"Description";s:110:"Label for the device token printed in the log on first start. Name it after the PC you are going to use it on.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"unraid";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"The user the server runs as. 99 (nobody) matches the rest of appdata.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:70:"The group the server runs as. 100 (users) matches the rest of appdata.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log level";s:6:"Target";s:21:"HOARD__LOGGING__LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:34:"error, warn, info, debug or trace.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Log format";s:6:"Target";s:22:"HOARD__LOGGING__FORMAT";s:7:"Default";s:6:"pretty";s:4:"Mode";s:0:"";s:11:"Description";s:95:"pretty reads well in this log window. Use json if you ship the logs somewhere that parses them.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"pretty";}}s:12:"TemplatePath";s:39:"/tmp/GitHub/AppFeed/templates/hoard.xml";s:4:"Repo";s:18:"Hoard's Repository";s:12:"CategoryList";a:3:{i:0;s:6:"Backup";i:1;s:5:"Cloud";i:2;s:15:"Tools-Utilities";}s:9:"downloads";i:311;s:9:"FirstSeen";i:1790698417;s:10:"LastUpdate";i:1789644568;s:14:"LastUpdateScan";i:1790698417;s:8:"Category";s:30:"Backup: Cloud: Tools:Utilities";s:2:"ID";i:4303;s:11:"Displayable";b:1;s:6:"Author";s:6:"rleeon";s:13:"DockerHubName";s:5:"hoard";s:8:"RepoName";s:18:"Hoard's Repository";s:10:"SortAuthor";s:6:"rleeon";s:8:"SortName";s:5:"Hoard";s:6:"random";i:1422164185;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:103:"/tmp/community.applications/tempFiles/templates-community-apps/HoardsRepository/rleeon-Hoard-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4304;a:41:{s:4:"Name";s:8:"ryansend";s:10:"Repository";s:24:"ryanlittlefield/ryansend";s:8:"Registry";s:49:"https://hub.docker.com/r/ryanlittlefield/ryansend";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/rlittlefield/unraid-repository/main/ryansend.xml";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:65:"https://forums.unraid.net/topic/196593-support-kingemer-ryansend/";s:7:"Project";s:40:"https://github.com/rlittlefield/ryansend";s:6:"ReadMe";s:47:"https://github.com/rlittlefield/ryansend#readme";s:8:"Overview";s:802:"ryansend lets you share files on your computer via public download URLs with cryptographic tokens that automatically expire. Perfect for sharing large files directly from your home server without needing special software, accounts, or VPNs.

Features:
• Share large files (tested with over 70GB)
• Generates secure URLs with automatic expiration (1 hour default)
• Optional admin web interface for browsing and sharing
• No database required - tokens contain encrypted file paths
• Extremely lightweight (~32MB Docker image, 8MB RAM idle)
• Works without JavaScript for fast page loads
• No external tracking or requests (except optional ko-fi link)

The admin panel (if enabled) will be available at /admin/login with a randomly generated password shown in the container logs.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3001]/";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Sharing Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:41:"Main ryansend port for file sharing URLs.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"AppData";s:6:"Target";s:5:"/data";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:202:"Where ryansend will write its config. The config files are small so this location doesn't need much storage capacity. ryansend never copies the shared files to this location. Example: /mnt/user/ryansend";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Shared Files";s:6:"Target";s:7:"/shared";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:185:"The path to the files you intend to make shareable. These files don't become public just because you mount them! Files only become downloadable once you manually click the share button.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Admin Panel Port";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:81:"ryansend runs the admin panel on a different port from the path that shares files";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Remove Ko-fi Link";s:6:"Target";s:20:"RYANSEND_REMOVE_KOFI";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:248:"ryansend includes a link to a donation ko-fi page on the admin page. It is never shown to the person downloading, just you when you are browsing the files to share. It isn't intrusive, but you can turn it off if you donate (or if you just want to).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:8:"RUST_LOG";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:47:"Logging level (error, warn, info, debug, trace)";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"HTTPS Port";s:6:"Target";s:4:"3443";s:7:"Default";s:4:"3443";s:4:"Mode";s:3:"tcp";s:11:"Description";s:0:"";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3443";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Enable Admin Panel";s:6:"Target";s:28:"RYANSEND_DEFAULT_ADMIN_PANEL";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:128:"Enable the web admin interface for browsing and sharing files (recommended unless you want to only share files via command line)";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Admin HTTPS Port";s:6:"Target";s:4:"3444";s:7:"Default";s:4:"3444";s:4:"Mode";s:3:"tcp";s:11:"Description";s:165:"The port the admin panel should run on when configured with HTTPS. Requires adding a cert file and key manually or with the letsencrypt features via the admin panel.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3444";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:38:"User ID that the container will run as";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Group ID that the container will run as";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:32:"/tmp/GitHub/AppFeed/ryansend.xml";s:4:"Repo";s:21:"kingemer's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:11:"Network-Web";}s:4:"Beta";s:4:"true";s:9:"downloads";i:3345;s:9:"FirstSeen";i:1788855068;s:10:"LastUpdate";i:1770181962;s:14:"LastUpdateScan";i:1791447388;s:8:"Category";s:27:"Tools:Utilities Network:Web";s:2:"ID";i:4304;s:11:"Displayable";b:1;s:6:"Author";s:15:"ryanlittlefield";s:13:"DockerHubName";s:8:"ryansend";s:8:"RepoName";s:21:"kingemer's Repository";s:10:"SortAuthor";s:15:"ryanlittlefield";s:8:"SortName";s:8:"ryansend";s:6:"random";i:404519678;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:118:"/tmp/community.applications/tempFiles/templates-community-apps/kingemersRepository/ryanlittlefield-ryansend-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:20:"Support this project";s:10:"DonateLink";s:33:"https://ko-fi.com/ryanlittlefield";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4305;a:50:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:22:"deadair/deadair:latest";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4305;s:11:"Displayable";b:1;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/MaroonedSoftwaresRepository/deadair-deadair-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:5:{i:0;i:4306;i:1;i:4307;i:2;i:4308;i:3;i:4309;i:4;i:4310;}s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4306;a:51:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:20:"deadair/deadair:full";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4306;s:11:"Displayable";b:0;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4306.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"BranchName";s:4:"full";s:17:"BranchDescription";s:63:"Brings its own database and cache as well. Nothing else needed.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4307;a:53:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:20:"deadair/deadair:slim";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4307;s:11:"Displayable";b:0;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4307.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:1:{i:0;i:4306;}s:10:"BranchName";s:4:"slim";s:17:"BranchDescription";s:79:"No voice. For pointing the speech plugin at a speech server on another machine.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4308;a:53:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:21:"deadair/deadair:apple";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4308;s:11:"Displayable";b:0;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4308.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:2:{i:0;i:4306;i:1;i:4307;}s:10:"BranchName";s:5:"apple";s:17:"BranchDescription";s:86:"The default tag plus the Apple Music player. Add --shm-size=1g under Extra Parameters.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4309;a:53:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:26:"deadair/deadair:full-apple";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4309;s:11:"Displayable";b:0;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4309.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:3:{i:0;i:4306;i:1;i:4307;i:2;i:4308;}s:10:"BranchName";s:10:"full-apple";s:17:"BranchDescription";s:83:"The full tag plus the Apple Music player. Add --shm-size=1g under Extra Parameters.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4310;a:53:{s:4:"Name";s:7:"deadair";s:10:"Repository";s:26:"deadair/deadair:slim-apple";s:8:"Registry";s:40:"https://hub.docker.com/r/deadair/deadair";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:7:"Support";s:45:"https://github.com/robert-dean/deadair/issues";s:7:"Project";s:38:"https://github.com/robert-dean/deadair";s:11:"TemplateURL";s:77:"https://raw.githubusercontent.com/robert-dean/deadair/main/unraid/deadair.xml";s:7:"License";s:3:"MIT";s:8:"Overview";s:1680:"An AI radio station: it picks the records, writes what the presenter says between them,
        speaks it, and streams the result.

        Everything is in this one container: the station, its console, the audio chain and the
        stream server. Pick the tag that matches what your server already runs:

        deadair/deadair:full brings everything: PostgreSQL, Redis and a voice. Nothing else needed.
        deadair/deadair:latest includes a voice. Point it at your own PostgreSQL and Redis.
        deadair/deadair:slim is the station alone, for pointing at a speech server on another machine.
        Each has an Apple Music twin (apple, full-apple, slim-apple) that adds a player for an Apple Music
        subscription. It is most of a gigabyte bigger; add --shm-size=1g under Extra Parameters with it.

        Everything it keeps lives under one path, so backing it up is backing up one share.

        First run: open the console on the WebUI port and sign in. The database schema is applied
        automatically. The stream is served by this same container at /live.mp3, so whatever you
        put in front of the WebUI port (a reverse proxy or a tunnel) carries the station too.

        On Spotify there are TWO authorizations on the plugin page, and the station needs both.
        The connection lets the plugin read your library; the playback authorization below it lets
        the station fetch the audio. With only the first, your playlists list perfectly and nothing
        ever plays. The page Spotify sends your browser to will not load. That is expected, not a
        failure, so copy that address out of the bar and paste it back into the console.";s:8:"Requires";s:625:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;An x86-64 server: there is no arm64 image yet. On the latest and slim tags, a PostgreSQL 13 or newer database<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;that already exists and a Redis server; the full tag brings both. On the slim tag, a speech server as well.<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Music comes from your own Spotify account or your own media server (Navidrome or another Subsonic<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;server, Jellyfin, Emby, or Plex), because the station holds none of its own.<br>&nbsp;&nbsp;&nbsp;&nbsp;";s:21:"DefaultTagDescription";s:54:"A voice included. Bring your own PostgreSQL and Redis.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/web/public/logo-mark.png";s:10:"Screenshot";a:5:{i:0;s:97:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/desk.webp";i:1;s:107:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/schedule.today.webp";i:2;s:103:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.said.webp";i:3;s:109:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/voice.characters.webp";i:4;s:100:"https://raw.githubusercontent.com/robert-dean/deadair/main/apps/site/static/img/console/checkup.webp";}s:6:"Config";a:24:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The console, the API and the stream, all on this one port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/deadair";s:4:"Mode";s:2:"rw";s:11:"Description";s:297:"What the station IS: its settings, presenters, schedule, pronunciations and ratings, installed plugins, the stream's own credentials, the audio you recorded yourself, logs, and, on the full tag, the database holding most of it. Small, authored, and the thing to back up. Belongs on the cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/deadair";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:432:"Optional, and only about size. What the station HOLDS rather than what it is: records downloaded before they air, cover art, the speech it rendered, voice previews, the speech model's weights. All of it can be produced again by running the station, and it grows to roughly the size of the library you play, so put it on the array and leave it out of your backups. Blank keeps it under Data, which is fine until the library gets big.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Public address";s:6:"Target";s:12:"APP_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:471:"The address you type into a browser to reach this station, all of it: scheme, host and port, with nothing after the port. On your own network that is http:// with your server's address and the WebUI port above, such as http://192.168.1.10:8080; behind a proxy that terminates TLS it is the https:// name. Sign-in links and a music provider's authorization are sent back here, so a wrong value is a sign-in that lands nowhere. It does not decide whether the console loads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Console address";s:6:"Target";s:12:"SPA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"The same address as the public address above, because one port serves the console and the API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:496:"An IANA zone name such as America/New_York or Europe/London. The station reads the clock in this when it says the time and when it works out what half of the day it is; left unset a container reports UTC, which is a presenter saying &quot;tonight&quot; through your afternoon. Only the fallback: the station's own &quot;Where the station is&quot; setting, on the settings page, wins over it, because a station is a place and its listeners are in it rather than wherever the server happens to sit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret key";s:6:"Target";s:18:"KMS_LOCAL_ROOT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:321:"Encrypts every credential the station stores, including your music provider's. Leave it empty and the station makes one on its first boot, in secrets/ under Data. Set it only to keep the key off that share: generate once with openssl rand -hex 32 (it must be hex), and keep it. Losing it means entering all of them again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Session key";s:6:"Target";s:38:"AUTHENTICATION_SESSION_JWT_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:307:"Signs sessions. Leave it empty and the station makes one on its first boot, in secrets/ under Data. To set your own it must be RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0, since a key is several lines and this field is one. Losing it signs everybody out and nothing worse.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database host";s:6:"Target";s:13:"DATABASE_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Your PostgreSQL server, version 13 or newer (17 is what the station is tested on). No extensions needed. Leave every database and cache field blank on the full tag, which runs its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:13:"DATABASE_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database name";s:6:"Target";s:13:"DATABASE_NAME";s:7:"Default";s:7:"deadair";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Must already exist, owned by the database user below; the station creates its own schema inside it, not the database itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"deadair";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database user";s:6:"Target";s:13:"DATABASE_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Owns the schema: the station applies its migrations as this user at every start. It needs CREATEROLE, or a role named app_user created beforehand by a superuser (CREATE ROLE app_user NOLOGIN), because the first migration makes one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database password";s:6:"Target";s:17:"DATABASE_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Runtime database user";s:6:"Target";s:17:"DATABASE_APP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:323:"Optional, and both this and the password below have to be filled in for either to take effect. A second, non-owner role for the request path, holding DML grants only, so a request cannot alter the schema. Migrations still run as the owner above. Leave both empty to run everything as the owner, which is what happens today.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Runtime database password";s:6:"Target";s:21:"DATABASE_APP_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Your Redis server. Sessions live here rather than in the database, so losing it signs everybody out and costs nothing else.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache port";s:6:"Target";s:10:"REDIS_PORT";s:7:"Default";s:4:"6379";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6379";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cache user";s:6:"Target";s:14:"REDIS_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Only if your Redis asks for one. Redis 6 and newer with ACLs turned on wants a username and a password; anything older, or one with only requirepass set, wants the password alone and this left empty. Empty means the station connects with no AUTH at all, which is what a Redis on your own network usually wants.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache password";s:6:"Target";s:14:"REDIS_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cache over TLS";s:6:"Target";s:9:"REDIS_TLS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:246:"Whether the connection to the cache is itself TLS. A managed Redis reached across the internet almost always is; one on this network almost never is. This is the connection rather than the password, and a password travels in the clear without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Cache URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:508:"The whole cache as one URL instead, which is the shape a hosted Redis hands you: rediss://default:the-password@cache.example.com:6380/0. Fill this in and it is the WHOLE answer: the four fields above are not read at all, so there is no way for the two to half-disagree. It is also the only way to name a database index, if you are sharing one Redis between applications. rediss:// is TLS, redis:// is not, and anything in the password that is not a plain letter or digit has to be percent-encoded (@ is %40).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy in front";s:6:"Target";s:12:"REAL_IP_FROM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:492:"Leave empty unless a tunnel or a reverse proxy sits in front of this station. When one does, every listener reaches the station as THAT, so they all share one rate limit and the listener count collapses to however many different players are tuned in. Naming the proxy here (an address or a CIDR, and 172.16.0.0/12 covers another container on this box) lets the station see who actually asked. Only name something you put there yourself: it means believing an address that arrives in a header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Proxy address header";s:6:"Target";s:14:"REAL_IP_HEADER";s:7:"Default";s:15:"X-Forwarded-For";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Which header the proxy above puts the listener's address in. X-Forwarded-For suits almost everything; a Cloudflare tunnel also sends CF-Connecting-IP. Ignored while the field above is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"X-Forwarded-For";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Apply migrations at start";s:6:"Target";s:15:"MIGRATE_ON_BOOT";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Leave on unless you apply the schema yourself. An out-of-date schema otherwise degrades quietly rather than failing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:38:"/tmp/GitHub/AppFeed/unraid/deadair.xml";s:4:"Repo";s:29:"MaroonedSoftware's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"downloads";i:101156;s:13:"downloadtrend";a:2:{i:0;i:19660;i:1;i:101156;}s:8:"trending";d:80.565;s:6:"trends";a:1:{i:0;d:80.565;}s:10:"trendsDate";a:1:{i:0;i:1791745164;}s:9:"FirstSeen";i:1789075434;s:10:"LastUpdate";i:1791561596;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:32:"MediaApp:Music MediaServer:Music";s:2:"ID";i:4310;s:11:"Displayable";b:0;s:6:"Author";s:7:"deadair";s:13:"DockerHubName";s:7:"deadair";s:8:"RepoName";s:29:"MaroonedSoftware's Repository";s:10:"SortAuthor";s:7:"deadair";s:8:"SortName";s:7:"deadair";s:6:"random";i:127150769;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4310.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:4:{i:0;i:4306;i:1;i:4307;i:2;i:4308;i:3;i:4309;}s:10:"BranchName";s:10:"slim-apple";s:17:"BranchDescription";s:83:"The slim tag plus the Apple Music player. Add --shm-size=1g under Extra Parameters.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4311;a:38:{s:4:"Name";s:8:"GroveMap";s:10:"Repository";s:37:"ghcr.io/robsmallridge/grovemap:latest";s:8:"Registry";s:38:"https://ghcr.io/robsmallridge/grovemap";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:244:"Web-based disk usage analyzer with interactive treemap visualization. Mount your Unraid shares to see what's consuming your storage. Drill down into folders, filter by file name, extension, or date. Lightweight, read-only, no database required.";s:7:"Project";s:41:"https://github.com/robsmallridge/GroveMap";s:6:"ReadMe";s:71:"https