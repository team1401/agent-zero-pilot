ary), or Array only (runs Mover first, verifies every mounted pool is clear, with an optional Force remaining transfer for stubborn leftovers, before applying the policy). Uses Unraid's native /update.htm share-update interface, creates a timestamped backup before every batch, verifies every applied change, rolls back completed changes if a later share fails, and can restore the most recent un-restored batch. Never runs Mover automatically outside of an Array-only operation.";s:9:"PluginURL";s:94:"https://raw.githubusercontent.com/RayMunro/unraid-cache-array-share/main/cache-array-share.plg";s:12:"PluginAuthor";s:9:"Ray Munro";s:7:"Project";s:52:"https://github.com/RayMunro/unraid-cache-array-share";s:6:"ReadMe";s:82:"https://raw.githubusercontent.com/RayMunro/unraid-cache-array-share/main/README.md";s:6:"MinVer";s:6:"6.12.0";s:4:"Icon";s:147:"https://raw.githubusercontent.com/RayMunro/unraid-cache-array-share/main/src/usr/local/emhttp/plugins/cache-array-share/icons/cache-array-share.png";s:7:"License";s:16:"GPL-3.0-or-later";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/RayMunro/HackerHog/main/plugins/cache-array-share.xml";s:12:"TemplatePath";s:49:"/tmp/GitHub/AppFeed/plugins/cache-array-share.xml";s:4:"Repo";s:26:"HackerHog Apps' Repository";s:10:"Repository";s:94:"https://raw.githubusercontent.com/RayMunro/unraid-cache-array-share/main/cache-array-share.plg";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:7:"Support";s:59:"https://github.com/RayMunro/unraid-cache-array-share/issues";s:13:"pluginVersion";s:11:"2026.09.14d";s:6:"Author";s:9:"Ray Munro";s:9:"downloads";i:38;s:9:"FirstSeen";i:1790263394;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:16;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:22;s:1:"T";i:38;}s:8:"Category";s:24:"Tools:Utilities Plugins:";s:2:"ID";i:1091;s:11:"Displayable";b:1;s:13:"D