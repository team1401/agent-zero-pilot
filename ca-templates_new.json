t";a:1:{i:0;s:14:"MediaApp-Music";}s:9:"downloads";i:7238;s:9:"FirstSeen";i:1775468443;s:10:"LastUpdate";i:1787132795;s:14:"LastUpdateScan";i:1791198847;s:8:"Category";s:14:"MediaApp:Music";s:2:"ID";i:494;s:11:"Displayable";b:1;s:6:"Author";s:10:"drumsergio";s:13:"DockerHubName";s:24:"telegram-slskd-local-bot";s:8:"RepoName";s:20:"geiserx's Repository";s:10:"SortAuthor";s:10:"drumsergio";s:8:"SortName";s:24:"telegram slskd local bot";s:6:"random";i:917530761;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/geiserxsRepository/drumsergio-telegramslskdlocalbot-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:495;a:38:{s:4:"Name";s:7:"vettarr";s:10:"Repository";s:24:"drumsergio/vettarr:1.0.2";s:8:"Registry";s:43:"https://hub.docker.com/r/drumsergio/vettarr";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:41:"https://github.com/GeiserX/vettarr/issues";s:7:"Project";s:34:"https://github.com/GeiserX/vettarr";s:8:"Overview";s:1080:"vettarr takes a link, a Telegram post, a magnet, a .torrent file or a Seerr request, checks the title against your rules (certification, IMDb parents guide, TMDB genres and keywords, size, seeders, what your library already has) and approves it, holds it for you or refuses it. Approved items go to qBittorrent, Radarr, Sonarr or back to Seerr. Every decision keeps its reasons; shadow mode decides without acting so you can watch it first. Web UI that works from a phone, plus a Telegram bot.
[br][br]
One file configures it: /data/config.yaml (copy config.example.yaml from the project and edit it; secrets stay in the container's variables as ${VAR}). The schema is created in the empty Postgres database on the first start and upgraded on every later one.
[br][br]
