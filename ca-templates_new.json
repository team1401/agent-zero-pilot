VAL_MINUTES";s:7:"Default";s:1:"5";s:11:"Description";s:143:"Minutes to wait before retrying after Apple authentication or polling failures. Successful WebUI re-authentication triggers an immediate retry.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Database path";s:6:"Target";s:13:"DATABASE_PATH";s:7:"Default";s:22:"/app/data/locations.db";s:11:"Description";s:96:"Database file path inside the container. Change only when using a custom persistent data layout.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Web host";s:6:"Target";s:8:"WEB_HOST";s:7:"Default";s:7:"0.0.0.0";s:11:"Description";s:88:"Internal web server binding. Keep 0.0.0.0 when using the standard Unraid bridge network.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Web port";s:6:"Target";s:8:"WEB_PORT";s:7:"Default";s:4:"5000";s:11:"Description";s:72:"Internal container port for the WebUI. Normally this should remain 5000.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/Berlin";s:11:"Description";s:85:"Timezone used for container logs and displayed timestamps, for example Europe/Berlin.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:50:"/tmp/GitHub/AppFeed/templates/find-my-timeline.xml";s:4:"Repo";s:21:"heckpiet's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1784937837;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:2184;s:11:"Displayable";b:0;s:6:"Author";s:8:"heckpiet";s:13:"DockerHubName";s:16:"find-my-timeline";s:8:"RepoName";s:21:"heckpiet's Repository";s:10:"SortAuthor";s:8:"heckpiet";s:8:"SortName";s:16:"Find My Timeline";s:6:"random";i:690377363;s:9:"Blacklist";b:0;s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/2184.xml";s:10:"Deprecated";b:0;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:9:{i:0;i:2175;i:1;i:2176;i:2;i:2177;i:3;i:2178;i:4;i:2179;i:5;i:2180;i:6;i:2181;i:7;i:2182;i:8;i:2183;}s:10:"BranchName";s:5:"0.2.0";s:17:"BranchDescription";s:43:"Version 0.2.0, validated on Unraid OS 7.3.2";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2185;a:52:{s:4:"Name";s:11:"MagicMirror";s:10:"Repository";s:34:"karsten13/magicmirror:wolfi-server";s:8:"Registry";s:46:"https://hub.docker.com/r/karsten13/magicmirror";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:11:"ExtraParams";s:13:"--user 99:100";s:4:"Icon";s:75:"https://raw.githubusercontent.com/heckpiet/magicmirror-unraid/main/icon.svg";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:8:"Overview";s:1701:"MagicMirror² is an open source modular smart mirror platform. It turns a display behind a two-way mirror, a wall tablet or simply a browser tab into a personal dashboard showing clock, calendar, weather, news and hundreds of community modules.[br][br]This template runs MagicMirror² in server-only mode, the correct mode for a headless Unraid server: the interface is served over HTTP and rendered in any browser or on a separate client device such as a Raspberry Pi. The electron scenario, which draws to a locally attached display, will not work on Unraid and is deliberately not offered.[br][br][b]No setup is required.[/b] Install it, open the WebUI, done. On first start the image writes a working config.js that listens on all interfaces and already permits the usual private network ranges, including 10.x, 172.16-31.x and 192.168.x. The template also runs the container as user 99:100 so that everything it writes into appdata is owned nobody:users like the rest of your Unraid shares.[br][br]That same config.js is where you enable modules and change the layout, at /mnt/user/appdata/magicmirror/config/config.js. Third party modules go into the modules directory. See https://docs.magicmirror.builders and https://modules.magicmirror.builders.[br][br][b]Security note.[/b] MagicMirror² has no built-in authentication. Anyone who can reach the port sees your calendar and whatever else you configure. Keep it on a trusted network and do not forward the port. Use a VPN or an authenticated HTTPS reverse proxy for remote access.[br][br]The container image is built and maintained by Karsten Hassel at https://gitlab.com/khassel/magicmirror. This template provides only the Unraid packaging.";s:7:"Support";s:53:"https://github.com/heckpiet/magicmirror-unraid/issues";s:7:"Project";s:38:"https://khassel.gitlab.io/magicmirror/";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/heckpiet/magicmirror-unraid/main/templates/magicmirror.xml";s:6:"ReadMe";s:76:"https://raw.githubusercontent.com/heckpiet/magicmirror-unraid/main/README.md";s:16:"ExtraSearchTerms";s:112:"magicmirror magic mirror smart mirror smartmirror dashboard kiosk wall display calendar weather news modules mm2";s:8:"Requires";s:284:"No manual setup. The container runs as user 99:100 through Extra Parameters so that files it writes into appdata are owned nobody:users; leave that setting in place. MagicMirror² is unauthenticated, so keep it on a trusted LAN or behind a VPN or an authenticated HTTPS reverse proxy.";s:4:"Date";s:10:"2026-08-04";s:6:"MinVer";s:6:"6.12.0";s:7:"License";s:3:"MIT";s:21:"DefaultTagDescription";s:169:"Wolfi based, server-only mode. Recommended: a minimal, regularly rebuilt base with a reduced CVE surface, and the variant the image maintainer recommends. Ships /bin/sh.";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:162:"Host port used to open the MagicMirror² interface. It must match the port set in config.js. Keep this port limited to your trusted network and do not forward it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Configuration";s:6:"Target";s:24:"/opt/magic_mirror/config";s:7:"Default";s:36:"/mnt/user/appdata/magicmirror/config";s:4:"Mode";s:2:"rw";s:11:"Description";s:190:"Persistent directory holding config.js and custom.css. A working config.js is created here on first start; edit it to enable modules and change the layout. Include this directory in backups.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Modules";s:6:"Target";s:25:"/opt/magic_mirror/modules";s:7:"Default";s:37:"/mnt/user/appdata/magicmirror/modules";s:4:"Mode";s:2:"rw";s:11:"Description";s:84:"Persistent directory holding third party modules. Include this directory in backups.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/Berlin";s:11:"Description";s:136:"Timezone used for logs and displayed times, for example Europe/Berlin. If left empty the container falls back to UTC and logs a warning.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Run mode";s:6:"Target";s:11:"MM_SCENARIO";s:7:"Default";s:6:"server";s:11:"Description";s:151:"Run mode of the container. Keep this at server on Unraid. The electron mode requires a locally attached display and will not work on a headless server.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"Show mouse cursor";s:6:"Target";s:14:"MM_SHOW_CURSOR";s:7:"Default";s:5:"false";s:11:"Description";s:126:"Set to true to show the mouse cursor in the interface. Useful when MagicMirror² is displayed on a touchscreen or wall tablet.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/magicmirror.xml";s:4:"Repo";s:24:"magicmirror's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:12:"Productivity";}s:16:"ChangeLogPresent";s:1:"1";s:5:"stars";i:44;s:9:"downloads";i:2266398;s:13:"downloadtrend";a:3:{i:0;i:2099549;i:1;i:2131730;i:2;i:2266398;}s:8:"trending";d:5.942;s:6:"trends";a:2:{i:0;d:1.51;i:1;d:5.942;}s:10:"trendsDate";a:2:{i:0;i:1788523586;i:1;i:1791953108;}s:9:"FirstSeen";i:1785928030;s:10:"LastUpdate";i:1791779030;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:29:"HomeAutomation: Productivity:";s:2:"ID";i:2185;s:11:"Displayable";b:1;s:6:"Author";s:9:"karsten13";s:13:"DockerHubName";s:11:"magicmirror";s:8:"RepoName";s:24:"magicmirror's Repository";s:10:"SortAuthor";s:9:"karsten13";s:8:"SortName";s:11:"MagicMirror";s:6:"random";i:1897165243;s:9:"Blacklist";b:0;s:4:"Path";s:124:"/tmp/community.applications/tempFiles/templates-community-apps/magicmirrorsRepository/karsten13-MagicMirror-wolfi-server.xml";s:10:"Deprecated";b:0;s:10:"trendDelta";d:4.432;s:12:"trendAverage";d:3.726;s:13:"BranchDefault";s:12:"wolfi-server";s:8:"BranchID";a:2:{i:0;i:2186;i:1;i:2187;}s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2186;a:53:{s:4:"Name";s:11:"MagicMirror";s:10:"Repository";s:35:"karsten13/magicmirror:debian-server";s:8:"Registry";s:46:"https://hub.docker.com/r/