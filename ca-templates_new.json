aid-docker-template-fields.plg";s:12:"PluginAuthor";s:6:"shwa87";s:4:"Icon";s:116:"https://raw.githubusercontent.com/joshmans/unraid-docker-template-fields/main/icon/unraid-docker-template-fields.png";s:7:"Support";s:64:"https://github.com/joshmans/unraid-docker-template-fields/issues";s:7:"Project";s:57:"https://github.com/joshmans/unraid-docker-template-fields";s:6:"MinVer";s:5:"7.2.0";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/joshmans/unraid-tools/main/unraid-docker-template-fields.xml";s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/unraid-docker-template-fields.xml";s:4:"Repo";s:20:"shwa87-'s Repository";s:10:"Repository";s:111:"https://raw.githubusercontent.com/joshmans/unraid-docker-template-fields/main/unraid-docker-template-fields.plg";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.09.25";s:6:"Author";s:6:"shwa87";s:9:"downloads";i:106;s:9:"FirstSeen";i:1790346478;s:14:"LastUpdateScan";i:1792411842;s:11:"pluginStats";a:13:{i:10;i:33;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:73;s:1:"T";i:106;}s:8:"Category";s:24:"Tools:Utilities Plugins:";s:2:"ID";i:2739;s:11:"Displayable";b:1;s:13:"DockerHubName";s:22:"docker template fields";s:8:"RepoName";s:20:"shwa87-'s Repository";s:10:"SortAuthor";s:6:"shwa87";s:8:"SortName";s:22:"Docker Template Fields";s:6:"random";i:1259236998;s:9:"Blacklist";b:0;s:4:"Path";s:218:"/tmp/community.applications/tempFiles/templates-community-apps/shwa87sRepository/shwa87-DockerTemplateFields-//raw.githubusercontent.com/joshmans/unraid-docker-template-fields/main/unraid-docker-template-fields.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2740;a:35:{s:4:"Name";s:10:"Log Health";s:8:"Overview";s:746:"Find the logs that are spamming and see who is behind them. Log Health reads your PHP, system and Docker container logs on a schedule, works out which messages are the same line repeating, and lists the ones that repeat too often, named after the plugin (with file and line), program or container responsible. It also shows every Docker container's log size, growth and rotation limit. A crash loop that prints a long traceback is one finding, not dozens; mute anything you know about. Choose how often it scans in plain words (every 5 minutes to once a day, default every 15 minutes), and turn each source on or off. It only reads: it never changes a log, a Docker setting or a file outside its own settings, and it makes no network connections.";s:9:"PluginURL";s:87:"https://raw.githubusercontent.com/joshmans/unraid-log-health/main/unraid-log-health.plg";s:12:"PluginAuthor";s:6:"shwa87";s:4:"Icon";s:92:"https://raw.githubusercontent.com/joshmans/unraid-log-health/main/icon/unraid-log-health.png";s:7:"Support";s:52:"https://github.com/joshmans/unraid-log-health/issues";s:7:"Project";s:45:"https://github.com/joshmans/unraid-log-health";s:6:"MinVer";s:5:"7.2.0";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/joshmans/unraid-tools/main/unraid-log-health.xml";s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/unraid-log-health.xml";s:4:"Repo";s:20:"shwa87-'s Repository";s:10:"Repository";s:87:"https://raw.githubusercontent.com/joshmans/unraid-log-health/main/unraid-log-health.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:11:"2026.09.21b";s:6:"Author";s:6:"shwa87";s:9:"downloads";i:97;s:9:"FirstSeen";i:1790263394;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:22;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:75;s:1:"T";i:97;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:2740;s:11:"Displayable";b:1;s:13:"DockerHubName";s:10:"log health";s:8:"RepoName";s:20:"shwa87-'s Repository";s:10:"SortAuthor";s:6:"shwa87";s:8:"SortName";s:10:"Log Health";s:6:"random";i:138430744;s:9:"Blacklist";b:0;s:4:"Path";s:183:"/tmp/community.applications/tempFiles/templates-community-apps/shwa87sRepository/shwa87-LogHealth-//raw.githubusercontent.com/joshmans/unraid-log-health/main/unraid-log-health.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2741;a:35:{s:4:"Name";s:11:"GarageStack";s:10:"Repository";s:32:"ghcr.io/joszz/garagestack:latest";s:8:"Registry";s:16:"https://ghcr.io/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/joszz/garagestack/issues";s:7:"Project";s:36:"https://github.com/joszz/garagestack";s:8:"Overview";s:1160:"GarageStack is an open-source, self-hosted dashboard for MG / SAIC electric, plug-in hybrid and hybrid cars.
    It connects to the MG iSmart cloud through the SAIC MQTT Gateway and keeps everything in its own embedded
    PostgreSQL database. Features: a live dashboard; remote commands (climate, lock, boot, horn and lights, and on
    a plug-in car charging, the charge target, cable lock, battery heating and their schedules); climate schedules;
    energy statistics over any period; trips drawn on the roads they took, with heatmaps and speed limits; a trip
    log for the taxman with automatic commutes and CSV export; maintenance reminders; tyre history with a
    slow-puncture alert; push notifications, among them the car moving while parked; charging station, fuel
    station, service area and speed camera map layers; kilometres or miles and the other units by region; Home
    Assistant through MQTT discovery; single sign-on through any OpenID Connect provider; read-only API tokens; a
    full data export; a log viewer; and a Homepage dashboard widget.
    Everything runs in this one container: no external database or MQTT broker required.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/joszz/unraid-community-apps/main/templates/garagestack.xml";s:4:"Icon";s:88:"https://raw.githubusercontent.com/joszz/garagestack/main/frontend/public/pwa-192x192.png";s:7:"License";s:3:"MIT";s:6:"Config";a:57:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:71:"Host port for the GarageStack web interface. Open this in your browser.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"MQTT Port";s:6:"Target";s:4:"1883";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:225:"Host port for the internal Mosquitto MQTT broker. Leave blank (default) to keep the broker LAN-private. Only set if you need direct MQTT access from other devices, such as Home Assistant (see documentation/HOME_ASSISTANT.md).";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Data Directory";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/garagestack";s:4:"Mode";s:2:"rw";s:11:"Description";s:134:"Persistent storage for the PostgreSQL database, MQTT data, application logs, and ASP.NET Data Protection keys. Back this up regularly.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/garagestack";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"MG iSmart Email";s:6:"Target";s:9:"SAIC_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:273:"Your MG iSmart account email address. Must be the vehicle OWNER account -- shared or secondary accounts lack the write permissions needed to register alarm switches and will result in API error 1100003. Use a separate account on the MG phone app to avoid session conflicts.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"MG iSmart Password";s:6:"Target";s:13:"SAIC_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Your MG iSmart account password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"MG Region";s:6:"Target";s:11:"SAIC_REGION";s:7:"Default";s:2:"eu";s:4:"Mode";s:0:"";s:11:"Description";s:152:"Region your vehicle is registered in: eu (Europe, default), au (Australia/New Zealand), or tr (Turkiye). Automatically mapped to the right API endpoint.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"eu";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Database Password";s:6:"Target";s:17:"POSTGRES_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:311:"Password for the embedded PostgreSQL database. If left empty a strong random password is auto-generated on first start and saved to /data/.postgres_password inside the data directory. Set explicitly only if you need to connect to the database directly with external tools. Generate with: openssl rand -base64 24";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"App URL";s:6:"Target";s:11:"CORS_ORIGIN";s:7:"Default";s:21:"http://localhost:8080";s:4:"Mode";s:0:"";s:11:"Description";s:146:"The exact URL you use to open GarageStack in your browser, e.g. http://192.168.1.100:8080. Must match exactly -- wrong value causes login to fail.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:21:"http://localhost:8080";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"OIDC Issuer URL";s:6:"Target";s:14:"OIDC_AUTHORITY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:361:"Optional. Issuer URL of your identity provider (Authentik, Authelia, Keycloak, Pocket ID, ...) -- the URL its /.well-known/openid-configuration sits under. Setting this switches GarageStack to single sign-on and disables the built-in password login. Register the redirect URI App URL/api/auth/oidc/callback at your provider. See documentation/AUTHENTICATION.md.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"OIDC Client ID";s:6:"Target";s:14:"OIDC_CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:97:"Client ID issued by your identity provider for GarageStack. Required when OIDC Issuer URL is set.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"OIDC Client Secret";s:6:"Target";s:18:"OIDC_CLIENT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Client secret issued by your identity provider. Leave empty for a public client that uses PKCE only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"OIDC Allowed Groups";s:6:"Target";s:19:"OIDC_ALLOWED_GROUPS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:219:"Comma-separated groups allowed to sign in, e.g. garagestack-users. Leave empty only if your provider already restricts who can use this application -- otherwise every account it accepts can sign in and control your car.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"OIDC Allowed Emails";s:6:"Target";s:19:"OIDC_ALLOWED_EMAILS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:171:"Comma-separated email addresses allowed to sign in. Useful with providers that have no groups. Works alongside OIDC Allowed Groups -- a match on either list grants access.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"OIDC Provider Name";s:6:"Target";s:18:"OIDC_PROVIDER_NAME";s:7:"Default";s:3:"SSO";s:4:"Mode";s:0:"";s:11:"Description";s:49:"Name shown on the sign-in button, e.g. Authentik.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"SSO";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Keep Password Login With OIDC";s:6:"Target";s:27:"AUTH_PASSWORD_LOGIN_ENABLED";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:315:"Set to true to keep the built-in username/password login available alongside single sign-on, e.g. as break-glass access for when your identity provider is down. Leave empty to switch it off automatically once OIDC is configured. Set AUTH_USERNAME and AUTH_PASSWORD to a strong dedicated password if you enable this.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Login Username";s:6:"Target";s:13:"AUTH_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:91:"Username for the built-in web login. Leave empty to sign in with the MG iSmart email above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Login Password";s:6:"Target";s:13:"AUTH_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:181:"Password for the built-in web login. Leave empty to sign in with the MG iSmart password above. Set a strong dedicated password when the login stays enabled alongside single sign-on.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Secure Session Cookie";s:6:"Target";s:18:"AUTH_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:260:"auto (recommended) marks the session cookie Secure whenever you open GarageStack over HTTPS, also behind a TLS-terminating reverse proxy, and keeps a plain-HTTP LAN install working. true always marks it Secure (plain HTTP then cannot log in); false never does.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Session Lifetime (hours)";s:6:"Target";s:27:"AUTH_SESSION_LIFETIME_HOURS";s:7:"Default";s:3:"168";s:4:"Mode";s:0:"";s:11:"Description";s:175:"How long a single sign-on session lasts before the identity provider is consulted again. Signing in again is usually invisible while the provider's own session is still valid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"168";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"OIDC Auto Login";s:6:"Target";s:15:"OIDC_AUTO_LOGIN";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:89:"Set to true to skip the GarageStack login page and go straight to your identity provider.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"OIDC Scopes";s:6:"Target";s:11:"OIDC_SCOPES";s:7:"Default";s:20:"openid profile email";s:4:"Mode";s:0:"";s:11:"Description";s:140:"Scopes requested from the identity provider. Add the scope that carries group membership if your provider needs one for OIDC Allowed Groups.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"openid profile email";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"OIDC Groups Claim";s:6:"Target";s:17:"OIDC_GROUPS_CLAIM";s:7:"Default";s:6:"groups";s:4:"Mode";s:0:"";s:11:"Description";s:107:"Name of the token claim that OIDC Allowed Groups is matched against. Provider-specific; groups covers most.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"groups";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"OIDC Redirect URI";s:6:"Target";s:17:"OIDC_REDIRECT_URI";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:172:"Only needed when GarageStack cannot work out its own public URL, e.g. behind several chained reverse proxies. Must be App URL/api/auth/oidc/callback. Leave empty otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"OIDC Require HTTPS Metadata";s:6:"Target";s:27:"OIDC_REQUIRE_HTTPS_METADATA";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:78:"Set to false only for an identity provider served over plain HTTP on your LAN.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:24;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Home Assistant MQTT Username";s:6:"Target";s:16:"HA_MQTT_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:262:"Optional. Creates a broker login for the Home Assistant MQTT integration, limited to the car's topics. The car then appears in Home Assistant automatically. Also set the MQTT Port above so Home Assistant can reach the broker. See documentation/HOME_ASSISTANT.md.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:25;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Home Assistant MQTT Password";s:6:"Target";s:16:"HA_MQTT_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:130:"Password for the Home Assistant MQTT login. Required when Home Assistant MQTT Username is set. Generate with: openssl rand -hex 32";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:26;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Internal MQTT Username";s:6:"Target";s:20:"MQTT_BROKER_USERNAME";s:7:"Default";s:11:"garagestack";s:4:"Mode";s:0:"";s:11:"Description";s:149:"Login the SAIC gateway, API and Worker use on the bundled Mosquitto broker. Only relevant if you connect other MQTT clients to the exposed MQTT port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"garagestack";}i:27;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Internal MQTT Password";s:6:"Target";s:20:"MQTT_BROKER_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:193:"Password for the internal broker login. Leave empty to have a random one generated at every start (fine unless external MQTT clients need a stable password). Generate with: openssl rand -hex 32";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:28;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"MG API Endpoint Override";s:6:"Target";s:13:"SAIC_REST_URI";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Optional. Only needed if your region isn't eu, au, or tr -- set directly to your gateway's endpoint.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:29;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"VAPID Public Key";s:6:"Target";s:16:"VAPID_PUBLIC_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:192:"VAPID public key for Web Push notifications. Leave empty to disable push notifications (the rest of the app works fine without them). Generate a key pair with: npx web-push generate-vapid-keys";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:30;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"VAPID Private Key";s:6:"Target";s:17:"VAPID_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:63:"VAPID private key for Web Push notifications. Keep this secret.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:31;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"VAPID Subject";s:6:"Target";s:13:"VAPID_SUBJECT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Contact the push services (Google, Mozilla, Apple) receive with every notification: mailto:you@example.com or an https URL. Empty uses CORS_ORIGIN when that is https, otherwise a placeholder; it is never taken from your MG account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:32;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Notification Language";s:6:"Target";s:21:"NOTIFICATION_LANGUAGE";s:7:"Default";s:2:"en";s:4:"Mode";s:0:"";s:11:"Description";s:217:"Language of the push notification texts (Engine started, Door left open, ...): en or nl. Notifications are written by the background worker, which has no browser to take a language from, so this is set per deployment.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"en";}i:33;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Update Check";s:6:"Target";s:20:"UPDATE_CHECK_ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:196:"Once a day GarageStack asks GitHub for the latest release, and the footer links to it when it is newer. Only the release number is fetched. Set to false to keep GarageStack from contacting GitHub.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:34;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Homepage Widget API Key";s:6:"Target";s:14:"WIDGET_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:195:"Static API key for the read-only /api/widget/{vin}/status endpoint used by the gethomepage.dev Custom API widget. Leave empty to keep the endpoint disabled. Generate with: openssl rand -base64 32";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:35;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Open Charge Map API Key";s:6:"Target";s:21:"OPENCHARGEMAP_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:206:"API key for the EV charging station overlay on the map. Free to obtain at https://openchargemap.org/site/develop -- create an account and generate a key. Leave empty to disable the charging station feature.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:36;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Overpass API Base URL";s:6:"Target";s:17:"OVERPASS__BASEURL";s:7:"Default";s:39:"https://overpass-api.de/api/interpreter";s:4:"Mode";s:0:"";s:11:"Description";s:209:"Overpass API endpoint used for the fuel station, motorway service area and speed camera overlays. Defaults to the public endpoint -- no API key required. Change this only if you self-host an Overpass instance.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:39:"https://overpass-api.de/api/interpreter";}i:37;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Speed Camera Layer Enabled";s:6:"Target";s:21:"SPEEDCAMERAS__ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:317:"Offers a map layer of the speed cameras mapped in OpenStreetMap. No API key required, and the layer stays off until you switch it on in the map's layer panel. Set to false to remove it from the deployment entirely -- do that where showing a driver where the cameras are is restricted, France and Germany among others.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:38;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Reverse Geocoding Enabled";s:6:"Target";s:18:"GEOCODING__ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:279:"Turns coordinates into place names via OpenStreetMap Nominatim: city names in the trip list and the street the car is parked in. No API key required, and answers are cached for 90 days. Set to false to keep coordinates off a third-party service -- the trip list then shows dates.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:39;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Nominatim Base URL";s:6:"Target";s:18:"GEOCODING__BASEURL";s:7:"Default";s:35:"https://nominatim.openstreetmap.org";s:4:"Mode";s:0:"";s:11:"Description";s:147:"Nominatim endpoint used for those place names. Defaults to the public instance -- no API key required. Change this only if you self-host Nominatim.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"https://nominatim.openstreetmap.org";}i:40;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Map Matching Enabled";s:6:"Target";s:20:"MAPMATCHING__ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:313:"Draws a selected trip along the roads it was driven on, snapped onto OpenStreetMap by Valhalla, instead of in straight lines between GPS fixes. No API key required, and snapped trips are cached for 30 days. Set to false to keep trip geometry off a third-party service -- trips are then drawn from their raw fixes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:41;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Valhalla Base URL";s:6:"Target";s:20:"MAPMATCHING__BASEURL";s:7:"Default";s:34:"https://valhalla1.openstreetmap.de";s:4:"Mode";s:0:"";s:11:"Description";s:141:"Valhalla endpoint used for that snapping. Defaults to the public instance -- no API key required. Change this only if you self-host Valhalla.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:34:"https://valhalla1.openstreetmap.de";}i:42;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Tyre Pressure - Low (bar)";s:6:"Target";s:21:"TYRE_PRESSURE_LOW_BAR";s:7:"Default";s:3:"2.2";s:4:"Mode";s:0:"";s:11:"Description";s:137:"Tyre pressure (bar) below which a tyre is shown red / triggers a low-pressure alert. Override to match your vehicle's placarded pressure.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"2.2";}i:43;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Tyre Pressure - Good (bar)";s:6:"Target";s:22:"TYRE_PRESSURE_GOOD_BAR";s:7:"Default";s:3:"2.6";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Tyre pressure (bar) at and above which a tyre is shown green (healthy). Below this and above the low threshold, it is shown orange.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"2.6";}i:44;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Tyre Pressure - High (bar)";s:6:"Target";s:22:"TYRE_PRESSURE_HIGH_BAR";s:7:"Default";s:3:"3.2";s:4:"Mode";s:0:"";s:11:"Description";s:87:"Tyre pressure (bar) above which a tyre is shown red / triggers an over-inflation alert.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"3.2";}i:45;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:40:"Tyre Pressure - Slow Puncture Drop (bar)";s:6:"Target";s:22:"TYRE_PRESSURE_DROP_BAR";s:7:"Default";s:4:"0.15";s:4:"Mode";s:0:"";s:11:"Description";s:140:"How far one tyre may fall behind the other three over two weeks before it is reported as a possible slow puncture. 0 switches the alert off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"0.15";}i:46;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Alert - Low 12V Battery (V)";s:6:"Target";s:20:"AUX_BATTERY_LOW_VOLT";s:7:"Default";s:4:"12.0";s:4:"Mode";s:0:"";s:11:"Description";s:112:"12V battery voltage a parked car is warned below, once several polls in a row show it. 0 switches the alert off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"12.0";}i:47;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Alert - Low Fuel (%)";s:6:"Target";s:16:"LOW_FUEL_PERCENT";s:7:"Default";s:2:"15";s:4:"Mode";s:0:"";s:11:"Description";s:80:"Fuel level a hybrid or plug-in hybrid is warned below. 0 switches the alert off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"15";}i:48;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Alert - Low EV Battery (%)";s:6:"Target";s:14:"LOW_EV_PERCENT";s:7:"Default";s:2:"20";s:4:"Mode";s:0:"";s:11:"Description";s:69:"Charge level a plug-in car is warned below. 0 switches the alert off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"20";}i:49;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:36:"Alert - No Data From the Car (hours)";s:6:"Target";s:16:"STALE_DATA_HOURS";s:7:"Default";s:2:"48";s:4:"Mode";s:0:"";s:11:"Description";s:194:"Hours without a report from the car before GarageStack warns that data has stopped arriving. Keep it above the gateway's poll of a sleeping car (once a day by default). 0 switches the alert off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"48";}i:50;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"HV Battery Capacity (kWh)";s:6:"Target";s:23:"HV_BATTERY_CAPACITY_KWH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:351:"Usable capacity of the traction battery, in kWh. The MQTT gateway assumes an EV-sized pack rather than reading the real one, so the kWh it reports are far too large on a plain hybrid (an MG HS Hybrid+ carries 1.83 kWh and is reported as 72.5). Leave empty to keep the gateway's figure on a BEV or PHEV and show charge as a percentage only on a hybrid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:51;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Telemetry Full Detail (days)";s:6:"Target";s:26:"TELEMETRY_FULL_DETAIL_DAYS";s:7:"Default";s:3:"365";s:4:"Mode";s:0:"";s:11:"Description";s:302:"Days of telemetry kept exactly as the car reported it. Older telemetry is folded into one row per quarter of an hour, which keeps every reading's latest value, each day's totals and your saved trips while the database stops growing as fast. Values below 90 are raised to 90. Set to 0 to keep every row.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"365";}i:52;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"API Rate Limit (per minute)";s:6:"Target";s:28:"RATE_LIMIT_GLOBAL_PER_MINUTE";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:161:"Requests per minute the API accepts from one address. Raise it when several people share one public address. Login and the widget keep their own, tighter limits.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:53;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Debug Logs";s:6:"Target";s:10:"DEBUG_LOGS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:54:"true turns on debug logging in the API and the Worker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:54;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Log Files Kept";s:6:"Target";s:18:"LOG_RETAINED_FILES";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Log files each service keeps under /data: one per day, and another whenever a day's file passes 100 MB. The oldest go first.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}i:55;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database Name";s:6:"Target";s:11:"POSTGRES_DB";s:7:"Default";s:11:"garagestack";s:4:"Mode";s:0:"";s:11:"Description";s:74:"PostgreSQL database name. Only change this if you know what you are doing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"garagestack";}i:56;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database User";s:6:"Target";s:13:"POSTGRES_USER";s:7:"Default";s:11:"garagestack";s:4:"Mode";s:0:"";s:11:"Description";s:74:"PostgreSQL database user. Only change this if you know what you are doing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"garagestack";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/garagestack.xml";s:4:"Repo";s:16:"joz's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:14:"HomeAutomation";}s:9:"FirstSeen";i:1780229099;s:8:"Category";s:31:"Tools:Utilities HomeAutomation:";s:2:"ID";i:2741;s:11:"Displayable";b:1;s:6:"Author";s:5:"joszz";s:13:"DockerHubName";s:11:"garagestack";s:8:"RepoName";s:16:"joz's Repository";s:10:"SortAuthor";s:5:"joszz";s:8:"SortName";s:11:"GarageStack";s:6:"random";i:1506480484;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:106:"/tmp/community.applications/tempFiles/templates-community-apps/jozsRepository/joszz-GarageStack-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2742;a:39:{s:4:"Name";s:7:"Courarr";s:10:"Repository";s:33:"ghcr.io/jpjoseph12/courarr:latest";s:8:"Registry";s:60:"https://github.com/jpjoseph12/courarr/pkgs/container/courarr";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/jpjoseph12/courarr/issues";s:7:"Project";s:37:"https://github.com/jpjoseph12/courarr";s:6:"ReadMe";s:67:"https://raw.githubusercontent.com/jpjoseph12/courarr/main/README.md";s:8:"Overview";s:651:"Auto-updating lists for Sonarr and Radarr. Anime lists come from AniList (this season, next season, genres, tags, studios, streaming site…) and are added to Sonarr as Anime series; TV & movie lists come from TMDB (trending, new on your streaming services, networks, people, age ratings, critic scores…) and are added as Standard or Daily series. Courarr creates the Sonarr/Radarr import lists for you, can skip titles your Maintainerr rules flag, drip-feeds big lists, sends notifications, and refreshes every day at 3 AM or on demand. The first visit creates your login and walks you through connecting Sonarr, Radarr and the free TMDB/OMDb keys.";s:16:"ExtraSearchTerms";s:94:"anime anilist tmdb sonarr radarr lists import list listrr trakt seasonal simulcast maintainerr";s:8:"Requires";s:238:"Sonarr and/or Radarr to import the lists. Anime lists need nothing else; TV & movie lists need a 