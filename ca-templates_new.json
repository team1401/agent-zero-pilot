ributes";a:9:{s:4:"Name";s:12:"Library Path";s:6:"Target";s:29:"MeshVault__Libraries__0__Path";s:7:"Default";s:7:"/models";s:4:"Mode";s:0:"";s:11:"Description";s:95:"Path inside the container for the library. Leave as /models unless you changed the mount above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"/models";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Allow Organize";s:6:"Target";s:38:"MeshVault__Libraries__0__AllowOrganize";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:197:"Whether MeshVault may move and rename files in the library. Only takes effect on first run, when the library is created; afterwards change it on the Libraries page. The mount above must also be rw.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Rescan Interval (hours)";s:6:"Target";s:30:"MeshVault__RescanIntervalHours";s:7:"Default";s:2:"12";s:4:"Mode";s:0:"";s:11:"Description";s:145:"Skip the startup scan if the library was scanned this recently. A full walk of a large library takes minutes. Set to 0 to always rescan on start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"12";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:35:"Timezone for dates shown in the UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/meshvault.xml";s:4:"Repo";s:27:"007Darkmatter5's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Other";i:1;s:12:"Productivity";}s:9:"FirstSeen";i:1787342711;s:8:"Category";s:28:"MediaApp:Other Productivity:";s:2:"ID";i:2;s:11:"Displayable";b:1;s:6:"Author";s:14:"007darkmatter5";s:13:"DockerHubName";s:9:"meshvault";s:8:"RepoName";s:27:"007Darkmatter5's Repository";s:10:"SortAuthor";s:14:"007darkmatter5";s:8:"SortName";s:9:"MeshVault";s:6:"random";i:1197431645;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:124:"/tmp/community.applications/tempFiles/templates-community-apps/007Darkmatter5sRepository/007darkmatter5-MeshVault-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3;a:38:{s:4:"Name";s:15:"Pantrix-Browser";s:10:"Repository";s:49:"ghcr.io/007darkmatter5/pantrix-browser:production";s:8:"Registry";s:72:"https://github.com/007darkmatter5/pantrix/pkgs/container/pantrix-browser";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/007darkmatter5/pantrix/issues";s:7:"Project";s:41:"https://github.com/007darkmatter5/pantrix";s:6:"ReadMe";s:64:"https://github.com/007darkmatter5/pantrix#aisle-lookups-optional";s:11:"TemplateURL";s:100:"https://raw.githubusercontent.com/007darkmatter5/unraid-templates/main/templates/pantrix-browser.xml";s:4:"Icon";s:82:"https://raw.githubusercontent.com/007darkmatter5/pantrix/main/docs/images/icon.png";s:5:"WebUI";s:25:"https://[IP]:[PORT:3001]/";s:11:"ExtraParams";s:14:"--shm-size=1gb";s:8:"Overview";s:1538:"An optional companion to Pantrix. Install it only if you want Pantrix to look aisles up on store websites for you; Pantrix works without it, with aisles you type in.

It is a Chromium browser (linuxserver's container) with a screen you open from another computer, set up so that Pantrix can drive it. Store websites turn away plain programs, so Pantrix asks this real browser to open a store's search page and reads the aisles off it. It does this only when someone presses "Look up" in Pantrix, one page at a time.

Setup:
1. In the Unraid terminal, create a network for the two containers: docker network create pantrix
2. Set Network Type to "pantrix" on this container and on Pantrix. That is how Pantrix reaches the browser's control port (9223), which is deliberately not published to the rest of your network.
3. Open this container's WebUI (https, accept the self-signed certificate), visit each store's website and choose your store. You can sign in to store accounts there too; the sign-in stays in this browser, and Pantrix never sees the password.
4. In Pantrix, on the Admin page, enter http://Pantrix-Browser:9223 as the browser address and press Test.

Set the screen username and password below. The screen includes a terminal, and the browser may be signed in to your store accounts, so it should not be open to anyone on your network. If a store site asks for a human check, Pantrix tells you and you complete it here yourself. Automated use may be against a store's terms, and a site can change or block it at any time.";s:16:"ExtraSearchTerms";s:38:"pantrix grocery aisle chromium browser";s:7:"License";s:3:"MIT";s:8:"Requires";s:7:"Pantrix";s:4:"Date";s:10:"2026-10-07";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Browser screen port (https)";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3011";s:4:"Mode";s:3:"tcp";s:11:"Description";s:50:"Port for the browser's screen. Open it with https.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3011";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Browser profile";s:6:"Target";s:7:"/config";s:7:"Default";s:33:"/mnt/user/appdata/pantrix-browser";s:4:"Mode";s:2:"rw";s:11:"Description";s:66:"The browser's profile: chosen stores, store sign-ins and settings.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/pantrix-browser";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Screen username";s:6:"Target";s:11:"CUSTOM_USER";s:7:"Default";s:0:"";s:11:"Description";s:34:"Username for the browser's screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Screen password";s:6:"Target";s:8:"PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:34:"Password for the browser's screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default