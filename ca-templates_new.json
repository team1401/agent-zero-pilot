list";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/RaccommodesRepository/matterjs-MatterjsServer-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4260;a:37:{s:4:"Name";s:9:"OpenEasyX";s:10:"Repository";s:36:"ghcr.io/raccommode/open-easyx:latest";s:8:"Registry";s:65:"https://github.com/raccommode/OpenEasyX/pkgs/container/open-easyx";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:5:"WebUI";s:23:"http://[IP]:[PORT:3210]";s:8:"Overview";s:369:"Open EasyX is one private, self-hosted application for discovering, downloading, organizing, browsing, and playing videos and images. It includes download queues, isolated partial downloads, library indexing, favorites, history, watch progress, live-cam playback, local subtitle transcription and translation, browser-assisted plugin login, and a built-in plugin store.";s:7:"Support";s:46:"https://github.com/raccommode/OpenEasyX/issues";s:7:"Project";s:39:"https://github.com/raccommode/OpenEasyX";s:6:"ReadMe";s:69:"https://raw.githubusercontent.com/raccommode/OpenEasyX/main/README.md";s:11:"TemplateURL";s:107:"https://raw.githubusercontent.com/raccommode/Raccommode-Unraid-Community-Apps/main/templates/open-easyx.xml";s:4:"Icon";s:73:"https://raw.githubusercontent.com/raccommode/OpenEasyX/main/docs/icon.svg";s:8:"Requires";s:740:"Open EasyX is intended for content you are legally allowed to access and retain. Third-party plugins execute trusted server-side code, so review them before installation. The application is designed for a private LAN or an authenticated reverse proxy; do not expose port 3210 directly to the public internet. The Data path contains databases, sessions, plugin repositories, thumbnails, subtitles, and downloaded AI models, so protect it and include it in backups. Subtitle transcription and translation can download large models and require significant CPU, memory, and storage. This template uses Unraid's nobody:users identity through PUID 99 and PGID 100 while the container entrypoint prepares writable paths before dropping privileges.";s:7:"License";s:11:"MIT License";s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"3210";s:7:"Default";s:4:"3210";s:4:"Mode";s:3:"tcp";s:11:"Description";s:146:"Open EasyX web interface and API port. Keep this accessible only on a trusted LAN or through an authenticated reverse proxy. Container port: 3210.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3210";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:28:"/mnt/user/appdata/open-easyx";s:4:"Mode";s:2:"rw";s:11:"Description";s:142:"Stores databases, sessions, plugin repository checkouts, thumbnails, subtitles, logs, and downloaded AI models. Back up and protect this path.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/open-easyx";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:19:"/mnt/user/OpenEasyX";s:4:"Mode";s:2:"rw";s:11:"Description";s:102:"Stores the completed media library and private .downloads staging directory used for active transfers.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/mnt/user/OpenEasyX";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"External Plugins";s:6:"Target";s:8:"/plugins";s:7:"Default";s:36:"/mnt/user/appdata/open-easyx/plugins";s:4:"Mode";s:2:"ro";s:11:"Description";s:153:"Optional legacy directory containing trusted external plugin folders. The built-in plugin store and added Git repositories are stored under Data instead.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s