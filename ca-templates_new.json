splayable";b:1;s:6:"Author";s:7:"absmach";s:13:"DockerHubName";s:16:"fluxmq-dashboard";s:8:"RepoName";s:21:"hoody424's Repository";s:10:"SortAuthor";s:7:"absmach";s:8:"SortName";s:16:"FluxMQ Dashboard";s:6:"random";i:1103631762;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/hoody424sRepository/absmach-FluxMQDashboard-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2225;a:38:{s:4:"Name";s:6:"FluxMQ";s:10:"Repository";s:29:"ghcr.io/absmach/fluxmq:latest";s:8:"Registry";s:55:"https://github.com/absmach/fluxmq/pkgs/container/fluxmq";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:51:"https://github.com/hoody424/unraid-templates/issues";s:7:"Project";s:33:"https://github.com/absmach/fluxmq";s:6:"ReadMe";s:71:"https://github.com/hoody424/unraid-templates/blob/main/fluxmq/README.md";s:8:"Overview";s:892:"FluxMQ is a lightweight message broker in a single Go binary: MQTT 3.1.1 and 5.0 over TCP and WebSocket, AMQP 1.0 and AMQP 0.9.1, durable queues with consumer groups, and BadgerDB storage. Official image from Abstract Machines; the upstream project calls itself experimental.

The defaults work without a config file: MQTT 3.1.1 on 1883, MQTT 5.0 on 1884, MQTT over WebSocket on 8083/8084 (path /mqtt), AMQP 1.0 on 5672, AMQP 0.9.1 on 5682, health on 8081 and the admin API on 8082. Data is kept in the appdata folder.

Retained messages need the config.yaml from the README (single-node cluster mode). Without it they are stored but not delivered to new subscribers.

FluxMQ has no built-in user/password login: clients connect anonymously unless you add an external auth service. Only publish it to networks you trust. A web dashboard is available as the separate FluxMQ-Dashboard template.";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/hoody424/unraid-templates/main/fluxmq/fluxmq.xml";s:4:"Icon";s:82:"https://raw.githubusercontent.com/hoody424/unraid-templates/main/fluxmq/fluxmq.png";s:16:"ExtraSearchTerms";s:75:"mqtt broker amqp message queue iot mosquitto emqx rabbitmq websocket pubsub";s:7:"License";s:10:"Apache-2.0";s:4:"Date";s:10:"2026-10-13";s:11:"ExtraParams";s:41:"--user 99:100 --ulimit nofile=65536:65536";s:8:"PostArgs";s:50:"--config /tmp/fluxmq/config.yaml --config-optional";s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:11:"/tmp/fluxmq";s:7:"Default";s:24:"/mnt/user/appdata/fluxmq";s:4:"Mode";s:2:"rw";s:11:"Description";s:143:"Message store and the optional config.yaml. /tmp/fluxmq is FluxMQ's built-in data location, so the defaults persist here without a config file.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/fluxmq";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"MQTT 3.1.1";s:6:"Target";s:4:"1883";s:7:"Default";s:4:"1883";s:4:"Mode";s:3:"tcp";s:11:"Description";s:20:"MQTT 3.1.1 over TCP.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1883";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"MQTT 5.0";s:6:"Target";s:4:"1884";s:7:"Default";s:4:"1884";s:4:"Mode";s:3:"tcp";s:11:"Description";s:67:"MQTT 5.0 over TCP. FluxMQ serves each MQTT version on its own port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1884";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"MQTT 3.1.1 WebSocket";s:6:"Target";s:4:"8083";s:7:"Default";s:4:"8083