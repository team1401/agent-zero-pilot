:"trendAverage";d:4.0796;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2791;a:48:{s:4:"Name";s:20:"StandardNotes-Server";s:10:"Repository";s:27:"standardnotes/server:latest";s:8:"Registry";s:45:"https://hub.docker.com/r/standardnotes/server";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:25:"https://standardnotes.com";s:6:"ReadMe";s:88:"https://github.com/junkerderprovinz/unraid-apps/blob/main/standardnotes-server/README.md";s:8:"Overview";s:2691:"Standard Notes self-hosted backend for Unraid (community template).
    End-to-end encrypted notes, sync, files, auth and API gateway in the
    official standardnotes/server image.
    
    Required side containers, in this order:
      1. MariaDB. Create an empty database "standard_notes_db" and a
         user "std_notes_user" with all privileges on it.
      2. Redis (default port 6379, no auth).
      3. StandardNotes-LocalStack companion (SNS and SQS). The server
         resolves the hostname "localstack" at port 4566. Without it,
         files-worker.log fills with "getaddrinfo ENOTFOUND localstack"
         and notes can duplicate.
      4. This template.
    
    Generate three 32-byte hex secrets before starting:
      openssl rand -hex 32  (run three times)
    
    Ports:
      3000/tcp - API gateway (HTTP, put behind a reverse proxy).
      3125/tcp host - 3104 container - files server (per upstream
                     docker-compose). Reverse-proxy traffic must
                     forward to host port 3125.
    
    URL and cookie shapes:
      COOKIE_DOMAIN: bare domain only, no https://, no trailing slash.
        Example: standardnotesserver.mydomain.tld
      PUBLIC_FILES_SERVER_URL: full HTTPS URL, includes https://.
        Example: https://files.standardnotesserver.mydomain.tld
      Custom Sync Server (entered in the Standard Notes client):
        full HTTPS URL. Example: https://standardnotesserver.mydomain.tld
    
    Notes:
      Unofficial community template. Always reach the server over HTTPS.
      The web client (standardnotes/web) is a separate Unraid template
      in the companion repo standardnotes-webui (container name
      "StandardNotes-WebUI"). See the project README for details.
    
    Hostname "localstack" resolution:
      User-defined Docker network: put both containers on the same
        custom bridge and give LocalStack the network alias "localstack".
      br0 / macvlan / VLAN / static-IP install: put LocalStack on the
        same VLAN with a fixed IP, then append
        --add-host=localstack:LocalStack-IP to this container's Extra
        Parameters and restart. Verify with:
          docker exec StandardNotes-Server getent hosts localstack
    
    Notes can duplicate in seconds if Redis, LocalStack, COOKIE_DOMAIN,
    the reverse proxy, or the image tag is misconfigured. Always test
    with a fresh throwaway account and one client first. See the README
    section "Sync-Loop / Duplicate Notes Guardrails".
  Detailed README (full setup & options): https://github.com/junkerderprovinz/Unraid-apps/blob/main/standardnotes-server/README.md";s:5:"WebUI";s:35:"http://[IP]:[PORT:3000]/healthcheck";s:11:"TemplateURL";s:113:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/standardnotes-server/standardnotes-server.xml";s:4:"Icon";s:97:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/standardnotes-server/icon.png";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:370:"A separately running MariaDB container, a Redis container, and the StandardNotes-LocalStack companion. The server resolves the hostname &quot;localstack&quot; at port 4566 for SNS / SQS. On br0 / macvlan / VLAN / static-IP installs, give LocalStack a fixed IP on the same VLAN and APPEND `--add-host=localstack:LocalStack-IP` to Extra Parameters. See the project README.";s:6:"Config";a:18:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"API / Gateway Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:130:"HTTP port of the Standard Notes API gateway. Put behind a reverse proxy with HTTPS. Do not expose directly to the public internet.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Logs Path";s:6:"Target";s:20:"/var/lib/server/logs";s:7:"Default";s:36:"/mnt/user/appdata/standardnotes/logs";s:4:"Mode";s:2:"rw";s:11:"Description";s:23:"Persistent server logs.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:36:"/mnt/user/appdata/standardnotes/logs";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Uploads Path";s:6:"Target";s:39:"/opt/server/packages/files/dist/uploads";s:7:"Default";s:39:"/mnt/user/appdata/standardnotes/uploads";s:4:"Mode";s:2:"rw";s:11:"Description";s:46:"Persistent storage for encrypted file uploads.";s:4:"T