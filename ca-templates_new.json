9;s:11:"topTrending";d:0.9349999999999996;s:13:"topPerforming";d:5.218;s:8:"Category";s:79:"Cloud: Productivity: Security: Other: Network:Web Network:Proxy Network:Privacy";s:2:"ID";i:1246;s:11:"Displayable";b:1;s:6:"Author";s:11:"cupcakearmy";s:13:"DockerHubName";s:15:"cryptgeon_redis";s:8:"RepoName";s:17:"lamp's Repository";s:10:"SortAuthor";s:11:"cupcakearmy";s:8:"SortName";s:15:"cryptgeon_redis";s:6:"random";i:1245556406;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/lampsRepository/cupcakearmy-cryptgeonredis-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:0.935;s:12:"trendAverage";d:4.1946;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1247;a:35:{s:4:"Name";s:12:"popcorn-vote";s:10:"Repository";s:36:"ghcr.io/stadicus/popcorn-vote:latest";s:8:"Registry";s:68:"https://github.com/Stadicus/popcorn-vote/pkgs/container/popcorn-vote";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/Stadicus/popcorn-vote/issues";s:7:"Project";s:23:"https://popcornvote.org";s:8:"Overview";s:638:"Fair family movie night voting. Everyone suggests films, gets one vote a week and can save votes up, so a film only one person wants wins eventually too. Ties are settled by a wheel of fortune, and watched films go into a shared rated archive with star ratings.

    Mobile-first and installable as a PWA. Nine interface languages. Film data, posters and trailers come from TMDB, IMDb ratings through OMDb; both services are free for private use and each needs its own key.

    Everything is configured in the browser on first start: family PIN, members, both API keys and the languages. No configuration file to edit, no console needed.";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/Stadicus/popcorn-vote/main/packaging/unraid/popcorn-vote.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/Stadicus/popcorn-vote/main/static/icon-512.png";s:11:"ExtraParams";s:13:"--user 99:100";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:34:"Port the web interface listens on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:30:"/mnt/user/appdata/popcorn-vote";s:4:"Mode";s:2:"rw";s:11:"Description";s:94:"Database, downloaded posters and the nightly backups. This is the only thing worth backing up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/popcorn-vote";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"TMDB API key";s:6:"Target";s:12:"TMDB_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:164:"Free key from themoviedb.org, used for search, posters, descriptions and trailers. May be left empty here and entered in the browser during first-run setup instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"OMDb API key";s:6:"Target";s:12:"OMDB_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:111:"Free key from omdbapi.com, used for the IMDb rating only. Optional. May also be entered during first-run setup.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time zone";s:6:"Target";s:11:"PV_TIMEZONE";s:7:"Default";s:13:"Europe/Berlin";s:4:"Mode";s:0:"";s:11:"Description";s:99:"Decides when the weekly vote credit is handed out. Use your own zone, for example America/New_York.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Berlin";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Family PIN";s:6:"Target";s:6:"PV_PIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:193:"Four digits, shared by the whole family. Leave empty to set it in the browser on first start, which is the recommended way: a PIN entered here is stored in the container template in plain text.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Session timeout";s:6:"Target";s:18:"PV_SESSION_TIMEOUT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:125:"Seconds without activity before a device has to enter the PIN again. Default is one year, matching the trusted family tablet.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log level";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:44:"error, warn, info or debug. Default is info.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/packaging/unraid/popcorn-vote.xml";s:4:"Repo";s:20:"Stadicus' Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1786834286;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:1247;s:11:"Displayable";b:1;s:6:"Author";s:8:"stadicus";s:13:"DockerHubName";s:12:"popcorn-vote";s:8:"RepoName";s:20:"Stadicus' Repository";s:10:"SortAuthor";s:8:"stadicus";s:8:"SortName";s:12:"popcorn vote";s:6:"random";i:1486095409;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/StadicusRepository/stadicus-popcornvote-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1248;a:41:{s:4:"Name";s:13:"vm-babysitter";s:10:"Repository";s:32:"ghcr.io/staffwerke/vm-babysitter";s:8:"Registry";s:85:"https://github.com/Staffwerke/vm-babysitter/pkgs/container/staffwerke%2Fvm-babysitter";s:7:"Network";s:4:"host";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:5:"Forum";s:0:"";s:7:"Support";s:60:"https://forums.unraid.net/topic/187762-support-vm-babysitter";s:7:"Project";s:43:"https://github.com/Staffwerke/vm-babysitter";s:6:"ReadMe";s:69:"https://github.com/Staffwerke/vm-babysitter?tab=readme-ov-file#readme";s:7:"License";s:5:"GPLv3";s:8:"Overview";s:1179:"Automatic Backup & Monitoring utility for QEMU/KVM Virtual Machines (powered by Virtnbdbackup)

Features:
 - Manages a list of *non-transient* domains defined in QEMU to be backed up regularly via internal cron task
 - Checks backup chains integrity of all listed domains, being able to detect inconsistencies and proceed accordingly (e.g. fixing, discarding, creating new ones, etc.)
 - Configurable backup rotation and retention policy
 - Ability to create a mirror and keep it updated with Rsync right after backup schedule or at configurable one, with independent retention policy
 - All main tasks (backup, sync, rotation/retention) can be performed manually by the user from inside the container
 - Pseudo-interactive tools for domain replication (to local and remote endpoints) and recovery from backups on the local host
 - Notify about backup chain and Rsync start and end of activities, as also when user intervention is required and about errors (Unraid feature)
 - Assume a different behavior when detects the server has been started recently, assuming the possibility of a previous crash, and therefore a more strict check of backup chains (Unraid feature)";s:11:"TemplateURL";s:96:"https://raw.githubusercontent.com/Staffwerke/unraid-templates/master/templates/vm-babysitter.xml";s:4:"Icon";s:108:"https://raw.githubusercontent.com/Staffwerke/unraid-templates/refs/heads/master/icons/vm-babysitter-icon.png";s:11:"ExtraParams";s:38:"--device /dev/fuse --cap-add SYS_ADMIN";s:8:"Requires";s:29:"**Unraid VM Manager Enabled**";s:6:"MinVer";s:6:"6.10.0";s:16:"ExtraSearchTerms";s:144:"debian virtualization kvm qemu backup-manager libvirt incremental-backups sysadmin-tasks sysadmin-tool virtnbdbackup scheduled-tasks checkpoints";s:6:"Config";a:32:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:11:"Description";s:63:"Set container to a desired timezone (usually same as this host)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"Autostart Domains";s:6:"Target";s:17:"VM_AUTOSTART_LIST";s:7:"Default";s:0:"";s:11:"Description";s:115:"Space separated list of domains that will be started along with the container if found powered off (case sensitive)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Ignored Domains";s:6:"Target";s:15:"VM_IGNORED_LIST";s:7:"Default";s:0:"";s:11:"Description";s:101:"Space separated list of domains to exclude from backup schedule and automatic checks (case sensitive)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Backups Rotation (local)";s:6:"Target";s:21:"MAX_BACKUPS_PER_CHAIN";s:7:"Default";s:2:"30";s:11:"Description";s:197:"Backups rotation: Number of checkpoints to save incrmentally into a backup chain before to archive it. If set to `0`, backup chain will grow indefinitely (and no retention policies will be applied)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Path for Backups (local)";s:6:"Target";s:8:"/backups";s:7:"Default";s:25:"/mnt/user/backups/domains";s:4:"Mode";s:2:"rw";s:11:"Description";s:51:"Path to user share where all backups will be stored";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Backup Schedule";s:6:"Target";s:15:"BACKUP_SCHEDULE";s:7:"Default";s:6:"@daily";s:11:"Description";s:47:"Cron expression to schedule incremental backups";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Retention Policy (local)";s:6:"Target";s:27:"LOCAL_BACKUP_CHAINS_TO_KEEP";s:7:"Default";s:1:"1";s:11:"Description";s:150:"Local retention policy: How many backup chains to keep archived at `LOCAL_BACKUP_PATH`. If set to `0`, disables retention policy on the local endpoint";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"SSH Key";s:6:"Target";s:21:"/private/hostname.key";s:7:"Default";s:44:"/mnt/user/appdata/vm-babysitter/hostname.key";s:4:"Mode";s:2:"ro";s:11:"Description";s:204:"Path to private SSH key to perform operations onto remote servers via SSH and Rsync. Key must be owned by root and file permissions equal to '0600' (in most cases, necessary for send Unraid notifications)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"Unraid IP/Hostname";s:6:"Target";s:18:"UNRAID_NOTIFY_HOST";s:7:"Default";s:9:"localhost";s:11:"Description";s:104:"Unraid IP/Hostname to send notifications (usually, same as this host). It has no effect on non-Unraid OS";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Path for Backups (mirror)";s:6:"Target";s:17:"RSYNC_BACKUP_PATH";s:7:"Default";s:0:"";s:11:"Description";s:254:"Usually, a SSH address to a path into another host, where backup chains will be mirrored. Requires r/w permissions at the remote host. If not set, this feature remains disabled and `RSYNC_` env vars have no effect. (Read documentation for advanced usage)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Rsync Schedule";s:6:"Target";s:14:"RSYNC_SCHEDULE";s:7:"Default";s:0:"";s:11:"Description";s:130:"When a cron expression is set, backup mirrors are updated at this specific schedule, instead of immediately after backups schedule";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Retention Policy (mirror)";s:6:"Target";s:27:"RSYNC_BACKUP_CHAINS_TO_KEEP";s:7:"Default";s:1:"2";s:11:"Description";s:145:"Mirror's retention policy: How many backup chains to keep archived at `RSYNC_BACKUP_PATH`. If set to `0`, disables retention policy on the mirror";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:41:"Fix Backup Chains After Interrupted Tasks";s:6:"Target";s:25:"VM_ALLOW_BACKUP_CHAIN_FIX";s:7:"Default";s:0:"";s:11: