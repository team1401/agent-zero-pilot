ARER_TOKEN";s:7:"Default";s:0:"";s:11:"Description";s:73:"TMDB v4 read access token (Bearer). Optional alternative to TMDB_API_KEY.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"TRACKER_PROVIDER";s:6:"Target";s:16:"TRACKER_PROVIDER";s:7:"Default";s:0:"";s:11:"Description";s:207:"Which watch tracker to scrobble to. One of: none, trakt, ryot, yamtrack. Leave blank to inherit the value from /config/config.yml (defaults to `none` when unset). See the matching credential variables below.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"REQUESTER_PROVIDER";s:6:"Target";s:18:"REQUESTER_PROVIDER";s:7:"Default";s:0:"";s:11:"Description";s:136:"Where to request the movie so it's available in your library. One of: none, seerr, ombi. Leave blank to inherit from /config/config.yml.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"TRAKT_CLIENT_ID";s:6:"Target";s:15:"TRAKT_CLIENT_ID";s:7:"Default";s:0:"";s:11:"Description";s:180:"Trakt application Client ID. Create a free app at https://trakt.tv/oauth/applications - Redirect URI must be `urn:ietf:wg:oauth:2.0:oob`. Required only when TRACKER_PROVIDER=trakt.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"TRAKT_CLIENT_SECRET";s:6:"Target";s:19:"TRAKT_CLIENT_SECRET";s:7:"Default";s:0:"";s:11:"Description";s:75:"Trakt application Client Secret. Required only when TRACKER_PROVIDER=trakt.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@at