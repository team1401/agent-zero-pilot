splayable";b:1;s:6:"Author";s:11:"alexrosbach";s:13:"DockerHubName";s:15:"marketplacelens";s:8:"RepoName";s:24:"alexrosbach's Repository";s:10:"SortAuthor";s:11:"alexrosbach";s:8:"SortName";s:15:"MarketPlaceLens";s:6:"random";i:2136465639;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:124:"/tmp/community.applications/tempFiles/templates-community-apps/alexrosbachsRepository/alexrosbach-MarketPlaceLens-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:129;a:35:{s:4:"Name";s:17:"uchiyomi-suwayomi";s:10:"Repository";s:42:"ghcr.io/suwayomi/suwayomi-server:v2.4.2366";s:8:"Registry";s:74:"https://github.com/Suwayomi/Suwayomi-Server/pkgs/container/suwayomi-server";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/AngeloSha/uchiyomi/issues";s:7:"Project";s:66:"https://github.com/AngeloSha/uchiyomi/blob/main/docs/extensions.md";s:8:"Overview";s:1192:"The extension engine for Uchiyomi: it runs Mihon/Tachiyomi extensions so Uchiyomi can search, follow and download from them. You never open it yourself; Uchiyomi's Admin, Sources tab is where you add repositories and install extensions. Install Uchiyomi first. Choose a password for the engine below (AUTH_PASSWORD): its port is on your network, so it asks for one. Before the first start, open the Unraid terminal and run: mkdir -p /mnt/user/appdata/uchiyomi-suwayomi and then chown 1000:1000 /mnt/user/appdata/uchiyomi-suwayomi (the engine runs as user 1000 and cannot write to a folder that belongs to root). It takes a minute or two to start the first time. Then, on the uchiyomi container, set SUWAYOMI_URL to http://YOUR-SERVER-IP:4567, SUWAYOMI_USERNAME to the user name below (uchiyomi unless you changed it) and SUWAYOMI_PASSWORD to the password you chose, and apply. It uses 1 to 1.5 GB of memory while it runs and is capped at 2 GB. MangaDex and sites you add by address work in Uchiyomi without it. To remove it, stop it and clear SUWAYOMI_URL on Uchiyomi; keep its appdata folder if you might come back, because it holds the links for every series you added through an extension.";s:8:"Requires";s:120:"Uchiyomi (the uchiyomi template). A FlareSolverr for sites behind Cloudflare is recommended: the same one Uchiyomi uses.";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/AngeloSha/uchiyomi/main/templates/uchiyomi-suwayomi.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/AngeloSha/uchiyomi/main/web/public/icons/icon-512.png";s:11:"ExtraParams";s:14:"--memory=2048m";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"API port";s:6:"Target";s:4:"4567";s:7:"Default";s:4:"4567";s:4:"Mode";s:3:"tcp";s:11:"Description";s:143:"The port Uchiyomi talks to: SUWAYOMI_URL is http://YOUR-SERVER-IP:4567. Its own web page is off, and the user name and password below guard it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"4567";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Engine data";s:6:"Target";s:37:"/home/suwayomi/.local/share/Tachidesk";s:7:"Default";s:35:"/mnt/user/appdata/uchiyomi-suwayomi";s:4:"Mode";s:2:"rw";s:11:"Description";s:204:"Installed extensions, and the links for every series added through them. Never delete it. It is not in Uchiyomi's nightly backup: back it up with your appdata. Must belong to user 1000 (see the overview).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/uchiyomi-suwayomi";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"FLARESOLVERR_URL";s:6:"Target";s:16:"FLARESOLVERR_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:188:"The same FlareSolverr address as Uchiyomi's FLARESOLVERR_URL, e.g. http://192.168.1.10:8191. Without it, extension sources behind Cloudflare fail with Cloudflare bypass currently disabled.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"FLARESOLVERR_ENABLED";s:6:"Target";s:20:"FLARESOLVERR_ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:67:"Let the engine use that FlareSolverr. It has no browser of its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"JAVA_TOOL_OPTIONS";s:6:"Target";s:17:"JAVA_TOOL_OPTIONS";s:7:"Default";s:25:"-Xmx768m -XX:+UseSerialGC";s:4:"Mode";s:0:"";s:11:"Description";s:249:"The engine's heap cap, the same as the desktop app's. Raise it only if the engine's log says java.lang.OutOfMemoryError: Java heap space, and raise the memory limit in Extra Parameters by the same amount: keep that limit at least 1.25 GB above this.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"-Xmx768m -XX:+UseSerialGC";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"MALLOC_ARENA_MAX";s:6:"Target";s:16:"MALLOC_ARENA_MAX";s:7:"Default";s:1:"2";s:4:"Mode";s:0:"";s:11:"Description";s:179:"Keep 2. The C library otherwise gives the engine up to eight memory pools per CPU core, and what one thread frees stays in its own pool: with 2 the engine holds about 120 MB less.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"2";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"AUTO_DOWNLOAD_CHAPTERS";s:6:"Target";s:22:"AUTO_DOWNLOAD_CHAPTERS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:122:"Keep false: Uchiyomi does the downloading and owns the library. True would fill this folder with a second, unmanaged copy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"DOWNLOAD_AS_CBZ";s:6:"Target";s:15:"DOWNLOAD_AS_CBZ";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:10:"Keep true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WEB_UI_ENABLED";s:6:"Target";s:14:"WEB_UI_ENABLED";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:58:"The engine's own web page. Off: Uchiyomi is the interface.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Time zone for the engine's logs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"AUTH_MODE";s:6:"Target";s:9:"AUTH_MODE";s:7:"Default";s:10:"basic_auth";s:4:"Mode";s:0:"";s:11:"Description";s:179:"basic_auth: the engine's port asks for the user name and password below, which Uchiyomi sends as SUWAYOMI_USERNAME and SUWAYOMI_PASSWORD. Leave it on: the port is on your network.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"basic_auth";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"AUTH_USERNAME";s:6:"Target";s:13:"AUTH_USERNAME";s:7:"Default";s:8:"uchiyomi";s:4:"Mode";s:0:"";s:11:"Description";s:84:"The engine's user name. Set the same on the uchiyomi container as SUWAYOMI_USERNAME.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"uchiyomi";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"AUTH_PASSWORD";s:6:"Target";s:13:"AUTH_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:98:"Choose a password for the engine, and set the same on the uchiyomi container as SUWAYOMI_PASSWORD.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:51:"/tmp/GitHub/AppFeed/templates/uchiyomi-suwayomi.xml";s:4:"Repo";s:16:"irxs' Repository";s:12:"CategoryList";a:2:{i:0;s:17:"MediaServer-Books";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790583384;s:8:"Category";s:33:"MediaServer:Books Tools:Utilities";s:2:"ID";i:129;s:11:"Displayable";b:1;s:6:"Author";s:8:"suwayomi";s:13:"DockerHubName";s:17:"uchiyomi-suwayomi";s:8:"RepoName";s:16:"irxs' Repository";s:10:"SortAuthor";s:8:"suwayomi";s:8:"SortName";s:17:"uchiyomi suwayomi";s:6:"random";i:1216272592;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/irxsRepository/suwayomi-uchiyomisuwayomi-v2.4.2366.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:130;a:35:{s:4:"Name";s:8:"uchiyomi";s:10:"Repository";s:26:"ghcr.io/angelosha/uchiyomi";s:8:"Registry";s:61:"https://github.com/AngeloSha/uchiyomi/pkgs/container/uchiyomi";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/AngeloSha/uchiyomi/issues";s:7:"Project";s:20:"https://uchiyomi.com";s:8:"Overview";s:752:"A self-hosted manga server that downloads too: it serves your manga, manhwa and webtoons like a library server and fetches new chapters like a source app, so discover, grab, monitor, serve and read all happen in one container. Point it at a folder of CBZ/CBR files and read them on any device through a true-black OLED interface built webtoon-first. Installs as a PWA, works offline. Mihon/Tachiyomi extensions, MangaDex, AniList/MyAnimeList/Kitsu sync, OPDS, per-user progress and favourites, age ratings, two-factor auth, single sign-on, nightly backups. No account and no cloud; the update check can be turned off and the anonymous install count is off unless you turn it on. The database runs inside the container; there is nothing else to install.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:11:"TemplateURL";s:80:"https://raw.githubusercontent.com/AngeloSha/uchiyomi/main/templates/uchiyomi.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/AngeloSha/uchiyomi/main/web/public/icons/icon-512.png";s:11:"ExtraParams";s:17:"--stop-timeout 40";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:31:"The port you open in a browser.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Library";s:6:"Target";s:8:"/library";s:7:"Default";s:22:"/mnt/user/media/comics";s:4:"Mode";s:2:"rw";s:11:"Description";s:149:"Your existing CBZ/CBR library. Any folder layout works. Set PUID/PGID to the owner of these files for renames and deletes; otherwise it is read-only.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:22:"/mnt/user/media/comics";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Data (embedded database)";s:6:"Target";s:5:"/data";s:7:"Default";s:31:"/mnt/user/appdata/uchiyomi/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:89:"Postgres lives here. Back it up like any appdata, or rely on the nightly dump in Backups.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:31:"/mnt/user/appdata/uchiyomi/data";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:33:"/mnt/user/appdata/uchiyomi/config";s:4:"Mode";s:2:"rw";s:11:"Description";s:37:"Secrets, custom sites, art overrides.";s:4:"Type";s:4