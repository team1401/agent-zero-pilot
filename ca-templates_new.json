e/0usd";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2698;a:50:{s:4:"Name";s:11:"Thunderbird";s:10:"Repository";s:19:"jlesage/thunderbird";s:8:"Registry";s:53:"https://registry.hub.docker.com/r/jlesage/thunderbird";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:63:"https://github.com/jlesage/docker-thunderbird/issues/new/choose";s:6:"ReadMe";s:52:"https://github.com/jlesage/docker-thunderbird#readme";s:6:"GitHub";s:45:"https://github.com/jlesage/docker-thunderbird";s:8:"Overview";s:481:"Thunderbird is a free email application that's easy to set up and customize.

