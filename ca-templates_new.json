e";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:68;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_SMTP_USER";s:6:"Target";s:15:"EMAIL_SMTP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Optional. SMTP authentication username.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:69;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_SMTP_PASS";s:6:"Target";s:15:"EMAIL_SMTP_PASS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Optional. SMTP authentication password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:70;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"EMAIL_FROM_ADDRESS";s:6:"Target";s:18:"EMAIL_FROM_ADDRESS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:74:"Optional. Sender email address for outgoing mail, e.g. yuvomi@example.com.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:71;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_FROM_NAME";s:6:"Target";s:15:"EMAIL_FROM_NAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:177:"Optional. Sender display name for outgoing mail. Leave empty to set it under Settings, Household, Email (the server then uses Yuvomi); any value here locks that field in the UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:72;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"BASE_URL";s:6:"Target";s:8:"BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:224:"Optional but required for password-reset emails to be sent. Absolute origin used to build reset links, e.g. https://yuvomi.example.com. The request Host header is never trusted as a fallback, to prevent reset-link poisoning.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:73;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"VAPID_SUBJECT";s:6:"Target";s:13:"VAPID_SUBJECT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:362:"Optional. Contact URI sent to push services, either a mailto: address or an https: origin, e.g. mailto:admin@example.com. Must be reachable from the internet: Apple rejects a localhost or .local subject with 403 BadJwtToken, which disables push on iPhone/iPad while Android keeps working. Falls back to the SMTP sender address, then BASE_URL, then a placeholder.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:74;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"VAPID_PUBLIC_KEY";s:6:"Target";s:16:"VAPID_PUBLIC_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:248:"Optional. VAPID public key. Auto-generated on first use and stored in the database when left empty. Set together with the private key to keep existing device subscriptions valid across a redeployment. Generate with: npx web-push generate-vapid-keys";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:75;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"VAPID_PRIVATE_KEY";s:6:"Target";s:17:"VAPID_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:70:"Optional. VAPID private key. Must be set together with the public key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:76;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"FIXER_API_KEY";s:6:"Target";s:13:"FIXER_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:165:"Optional. Fixer API key for live currency conversion in Budget → Subscriptions. Rates are cached for 12 hours; works without this key using the cached/manual rate.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/templates/yuvomi.xml";s:4:"Repo";s:20:"ulsklyc's Repository";s:12:"CategoryList";a:3:{i:0;s:12:"Productivity";i:1;s:14:"HomeAutomation";i:2;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1781006626;s:8:"Category";s:45:"Productivity: HomeAutomation: Tools:Utilities";s:2:"ID";i:4786;s:11:"Displayable";b:1;s:6:"Author";s:7:"ulsklyc";s:13:"DockerHubName";s:6:"yuvomi";s:8:"RepoName";s:20:"ulsklyc's Repository";s:10:"SortAuthor";s:7:"ulsklyc";s:8:"SortName";s:6:"Yuvomi";s:6:"random";i:978242087;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:107:"/tmp/community.applications/tempFiles/templates-community-apps/ulsklycsRepository/ulsklyc-Yuvomi-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4787;a:38:{s:4:"Name";s:6:"Yuvomi";s:10:"Repository";s:29:"ghcr.io/ulsklyc/yuvomi:latest";s:8:"Registry";s:55:"https://github.com/ulsklyc/yuvomi/pkgs/container/yuvomi";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:74:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/templates/yuvomi.xml";s:4:"Icon";s:62:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/icon.svg";s:8:"Overview";s:2276:"Yuvomi is a private, self-hosted family planner - one calm home for everything your household needs to stay organized. No cloud accounts, no subscriptions, no tracking: your data lives on your server and nowhere else.

Independent modules - turn on what fits, ignore the rest:

- Dashboard - today's tasks, events, meals and reminders at a glance
- Tasks - shared to-dos with priorities, due dates and assignees
- Shopping - collaborative grocery lists, auto-sorted by category
- Meals & Recipes - weekly meal planner with a built-in recipe book
- Pantry - what's actually in the house, with storage places and best-before alerts
- Calendar - family calendar with recurring events and reminders
- Budget - income, expenses, accounts, subscriptions and loans, with shared costs split automatically
- Health - vitals, medications, lab results and activity, per household member
- Rewards - points on chores, a parent-approved catalogue and an auditable ledger
- Inventory - what you own, with warranties and deadlines (off by default)
- Housekeeping - chores, supplies and staff/session tracking
- Waste collection - pickup schedules per waste type, or a subscribed municipal ICS calendar (off by default)
- Documents - store and find important household files
- Notes, Contacts & Birthdays - everything else in one tidy place

Why Yuvomi:

- Mobile-first PWA - install it on any phone, works offline
- Light & dark mode, fast and polished (no bloated frameworks, no build step)
- Optional sync - CalDAV / CardDAV, Apple and Google Calendar
- OIDC single sign-on for households that already run an identity provider
- Encrypted-at-rest storage (SQLCipher) with automated, scheduled backups
- Multi-language, fully self-contained and MIT-licensed

- Setup -

REQUIRED: Set a long random SESSION_SECRET.
RECOMMENDED: Set a strong DB_ENCRYPTION_KEY to encrypt the database at rest - without it the database and any synced calendar/contact credentials are stored unencrypted.
Generate either secret with: openssl rand -base64 48

After the container starts, open the WebUI - the first visit guides you through creating your admin account. (Headless setups can alternatively run node setup.js in the container console.) Then log in - pick the modules you want and invite your family.";s:7:"Support";s:40:"https://github.com/ulsklyc/yuvomi/issues";s:7:"Project";s:33:"https://github.com/ulsklyc/yuvomi";s:6:"ReadMe";s:63:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:175:"family planner household organizer tasks groceries shopping meals recipes pantry inventory expiry calendar budget chores notes contacts birthdays caldav carddav pwa selfhosted";s:10:"Screenshot";a:5:{i:0;s:105:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/docs/screenshots/unraid/dashboard-combined-dark.png";i:1;s:104:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/docs/screenshots/unraid/calendar-combined-dark.png";i:2;s:101:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/docs/screenshots/unraid/meals-combined-dark.png";i:3;s:104:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/docs/screenshots/unraid/shopping-combined-dark.png";i:4;s:102:"https://raw.githubusercontent.com/ulsklyc/yuvomi/main/docs/screenshots/unraid/budget-combined-dark.png";}s:6:"Config";a:77:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:39:"Host port for the Yuvomi web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/yuvomi/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:50:"Database and stored app data (uploads, documents).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/yuvom