ser ID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:133:"User the app runs as (Unraid default 99 = nobody). Must have read access to your shares, and write access wherever you receive files.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Group ID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Group the app runs as (Unraid default 100 = users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:54:"/tmp/GitHub/AppFeed/templates/docker-localsend-nas.xml";s:4:"Repo";s:23:"alexindigo's Repository";s:12:"CategoryList";a:1:{i:0;s:7:"Network";}s:9:"downloads";i:345;s:9:"FirstSeen";i:1790002781;s:10:"LastUpdate";i:1786930249;s:14:"LastUpdateScan";i:1790002781;s:8:"Category";s:8:"Network:";s:2:"ID";i:1424;s:11:"Displayable";b:1;s:6:"Author";s:10:"alexindigo";s:13:"DockerHubName";s:13:"localsend-nas";s:8:"RepoName";s:23:"alexindigo's Repository";s:10:"SortAuthor";s:10:"alexindigo";s:8:"SortName";s:13:"localsend nas";s:6:"random";i:1154555551;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/alexindigosRepository/alexindigo-localsendnas-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1425;a:39:{s:4:"Name";s:7:"Slipmat";s:10:"Repository";s:30:"ghcr.io/alexjsp/slipmat:latest";s:8:"Registry";s:57:"https://github.com/alexjsp/slipmat/pkgs/container/slipmat";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:41:"https://github.com/alexjsp/slipmat/issues";s:7:"Project";s:34:"https://github.com/alexjsp/slipmat";s:8:"Overview";s:545:"Self-hosted control and automation for a Sonos system, entirely over your local network: no cloud and no Sonos account. A web UI for everyday playback and grouping, plus presets that group speakers, set their volumes and play a shuffled mix of playlists, albums and favourites. Fire presets from the UI, a webhook (Shortcuts, Stream Deck, Node-RED) or an optional HomeKit switch.[br][br]Host networking is required: Sonos discovery is multicast and the speakers call back into Slipmat for live updates, neither of which crosses a bridge network.";s:5:"WebUI";s:24:"http://[IP]:[PORT:5544]/";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/alexjsp/unraid-community-apps/main/templates/slipmat.xml";s:6:"ReadMe";s:64:"https://raw.githubusercontent.com/alexjsp/slipmat/main/README.md";s:4:"Icon";s:77:"https://raw.githubusercontent.com/alexjsp/unraid-community-apps/main/icon.png";s:16:"ExtraSearchTerms";s:46:"sonos speakers multiroom audio homekit presets";s:7:"License";s:3:"MIT";s:4:"Date";s:10:"2026-10-09";s:10:"Screenshot";a:4:{i:0;s:78:"https://raw.githubusercontent.com/alexjsp/slipmat/main/docs/images/desktop.png";i:1;s:79:"https://raw.githubusercontent.com/alexjsp/slipmat/main/docs/images/playback.png";i:2;s:78:"https://raw.githubusercontent.com/alexjsp/slipmat/main/docs/images/presets.png";i:3;s:78:"https://raw.githubusercontent.com/alexjsp/slipmat/main/docs/images/sources.png";}s:8:"Requires";s:93:"Host networking (set by this template), and Sonos speakers on the same network as the server.";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/slipmat";s:4:"Mode";s:2:"rw";s:11:"Description";s:114:"Presets, schedules, settings and the source cache (a small SQLite database), plus HomeKit pairing data if enabled.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/slipmat";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:12:"SLIPMAT_PORT";s:7:"Default";s:4:"5544";s:4:"Mode";s:0:"";s:11:"Description";s:99:"Port the web UI and API listen on. With host networking this is a port on the Unraid server itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5544";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Password";s:6:"Target";s:16:"SLIPMAT_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Optional. Setting a password turns on login for the web UI and API. Webhooks keep working through their own secret URLs either way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Allowed hostnames";s:6:"Target";s:21:"SLIPMAT_ALLOWED_HOSTS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:196:"Comma-separated hostnames you reach Slipmat by, such as a domain behind a reverse proxy. IP addresses, localhost, *.local and *.ts.net always work; anything else is refused to block DNS rebinding.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Speaker IP";s:6:"Target";s:15:"SLIPMAT_SEED_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:159:"Optional. The IP of any one speaker, for networks where discovery can't get through (VLANs, multicast filtering). Slipmat finds the rest of the system from it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time zone";s:6:"Target";s:10:"SLIPMAT_TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Optional IANA time zone (for example Europe/London) for schedules and time-based rules. Defaults to the container's time zone, and can also be changed in Settings.";s:4:"