erver with Wyoming protocol support for Home Assistant. CPU-only streaming TTS: German/de-DE, 24 kHz mono PCM16 LE, Q8 by default, 27 official German voice states and configurable speech speed. Models and voices are downloaded from pinned official sources when missing and persist across restarts. Compatible local assets can be installed manually. No Python, PyTorch or GPU runtime. Add Wyoming Protocol manually in Home Assistant using the host address and Wyoming port. This template prepares a future registry release; no public image or CA listing is currently claimed.";s:8:"Requires";s:247:"linux/amd64 with Gracemont-compatible AVX2 CPU; tested on Intel N100. Dedicated models and voices directories must be writable by UID 99 / GID 100. First initialization needs Internet access unless compatible local assets are installed. No Web UI.";s:4:"Icon";s:98:"https://raw.githubusercontent.com/marco-taylor/pocket-tts-german-wyoming/main/icons/pocket-tts.png";s:11:"TemplateURL";s:117:"https://raw.githubusercontent.com/marco-taylor/pocket-tts-german-wyoming/main/templates/pocket-tts-german-wyoming.xml";s:11:"ExtraParams";s:84:"--restart unless-stopped --read-only --cap-drop ALL --security-opt no-new-privileges";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Wyoming Port";s:6:"Target";s:5:"10204";s:7:"Default";s:5:"10204";s:4:"Mode";s:3:"tcp";s:11:"Description";s:66:"Wyoming TCP port for Home Assistant. Container port remains 10204.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"10204";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Models";s:6:"Target";s:11:"/app/models";s:7:"Default";s:50:"/mnt/user/appdata/pocket-tts-german-wyoming/models";s:4:"Mode";s:2:"rw";s:11:"Description";s:117:"Dedicated persistent models directory. Must be writable by UID 99 / GID 100; existing user files are not overwritten.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:50:"/mnt/user/appdata/pocket-tts-german-wyoming/models";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Voices";s:6:"Target";s:11:"/app/voices";s:7:"Default";s:50:"/mnt/user/appdata/pocket-tts-german-wyoming/voices";s:4:"Mode";s:2:"rw";s:11:"Description";s:117:"Dedicated persistent voices directory. Must be writable by UID 99 / GID 100; existing user files are not overwritten.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:50:"/mnt/user/appdata/pocket-tts-german-wyoming/voices";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Model language";s:6:"Target";s:19:"POCKET_TTS_LANGUAGE";s:7:"Default";s:6:"german";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Only german is supported; Wyoming advertises de-DE.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"german";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Local model path";s:6:"Target";s:21:"POCKET_TTS_MODEL_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:113:"Optional compatible model path inside the container. When set, no automatic model download or replacement occurs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Models directory";s:6:"Target";s:21:"POCKET_TTS_MODELS_DIR";s:7:"Default";s:11:"/app/models";s:4:"Mode";s:0:"";s:11:"Description";s:66:"Persistent model root. Keep aligned with the models volume target.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"/app/models";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Voices directory";s:6:"Target";s:21:"POCKET_TTS_VOICES_DIR";s:7:"Default";s:11:"/app/voices";s:4:"Mode";s:0:"";s:11:"Description";s:85:"Persistent official and local voice root. Keep aligned with the v