aceapps";s:13:"DockerHubName";s:10:"nutritrace";s:8:"RepoName";s:21:"TraceApps' Repository";s:10:"SortAuthor";s:9:"traceapps";s:8:"SortName";s:10:"NutriTrace";s:6:"random";i:1606399695;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/TraceAppsRepository/traceapps-NutriTrace-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:31:"Support the Trace apps on Ko-fi";s:10:"DonateLink";s:27:"https://ko-fi.com/traceapps";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1313;a:42:{s:4:"Name";s:23:"Factorio-Server-Control";s:10:"Repository";s:46:"ghcr.io/tricade/factorio-server-manager:latest";s:8:"Registry";s:89:"https://github.com/Tricade/factorio-server-manager/pkgs/container/factorio-server-manager";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:57:"https://github.com/Tricade/factorio-server-manager/issues";s:7:"Project";s:50:"https://github.com/Tricade/factorio-server-manager";s:8:"Overview";s:520:"A maintained modern fork of the original Factorio Server Manager (OpenFactorioServerManager). Operate one Factorio dedicated server through a responsive web interface with independent profiles, portable profile backups and mod restore, saves, fixed checkpoints, compatible mods and dependencies, profile-scoped mod startup settings, stable/experimental/exact game versions, base Factorio or Space Age, world creation, resource-aware factory-map snapshots with named platform detail, logs, users and safe server controls.";s:16:"ExtraSearchTerms";s:67:"factorio dedicated server manager mods saves space age ofsm tricade";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:11:"TemplateURL";s:108:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/templates/factorio-server-manager.xml";s:6:"ReadMe";s:80:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/README.md";s:4:"Icon";s:79:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/icon.png";s:11:"ExtraParams";s:43:"--restart=unless-stopped --stop-timeout=180";s:4:"Date";s:10:"2026-10-17";s:8:"Requires";s:430:"Persistent manager-data, saves, mods and config paths are required. Internet access to Factorio's official services is required for game-version installation and requested Mod Portal operations; the manager has no built-in telemetry. Keep its HTTP Web UI on a trusted LAN/VPN or behind an HTTPS reverse proxy. Split-mount recreation needs download access to restore the recorded exact game version. The image supports linux/amd64.";s:7:"License";s:3:"MIT";s:10:"Screenshot";a:7:{i:0;s:112:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Profile_Backup.png";i:1;s:110:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Map_Lightbox.png";i:2;s:110:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Map_Settings.png";i:3;s:106:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Profiles.png";i:4;s:103:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Saves.png";i:5;s:102:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Mods.png";i:6;s:118:"https://raw.githubusercontent.com/Tricade/factorio-server-manager/main/screenshots/Screenshot_Mod_Startup_Settings.png";}s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:65:"Host port used to open the Factorio Server Control web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Factorio Game Port";s:6:"Target";s:5:"34197";s:7:"Default";s:5:"34197