etwork";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/Yoshiofthewire/Spinmatch/issues";s:7:"Project";s:43:"https://github.com/Yoshiofthewire/Spinmatch";s:8:"Overview";s:907:"Clean, Sort, Repair, and Expand your music collection. Search MusicBrainz for an artist, album, or song, browse album art and tracklists, and get a YouTube link for a track, verified by cross-checking the video's duration against the MusicBrainz-recorded track length. Spinmatch only finds and verifies YouTube links; it does not download or rip audio itself. It can also organize a local folder of unsorted audio files into your music library, tagging tracks either automatically via acoustic fingerprinting (AcoustID/Chromaprint) or by manual MusicBrainz search.

Requires a free MusicBrainz-compatible contact email (set below). The optional local library ingest feature needs Ingest Directory and Music Directory; a free AcoustID API key from https://acoustid.org/new-application additionally enables automatic fingerprint identification; without one, files are matched by their existing tags instead.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/Yoshiofthewire/unraid_docker_apps/main/Spinmatch.xml";s:4:"Icon";s:91:"https://raw.githubusercontent.com/Yoshiofthewire/unraid_docker_apps/main/spinmatch-icon.png";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:26:"Port the web UI listens on";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:427:"User id the server runs as. Unraid's shares are owned by nobody:users (99:100), which is the default here — leave it alone unless you know your shares are owned by something else. It must be a uid that can write the Library DB Directory below, and the Music/Ingest directories if you use them. Upgrading from a version that ran as root? The container fixes up the DB directory itself on start; your music share is left alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:82:"Group id the server runs as. Pairs with PUID above; 100 is Unraid's `users` group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Ingest Directory";s:6:"Target";s:12:"/data/ingest";s:7:"Default";s:34:"/mnt/user/appdata/spinmatch/ingest";s:4:"Mode";s:2:"rw";s:11:"Description";s:367:"Drop-folder for unsorted audio (loose files or whole album folders) to be identified and filed into Music Directory. Only used if MB Contact Email, Music Directory, and this path are all set. AcoustID API Key is optional on top of that — without it, files are matched by the tags they already carry, and anything that can't be confirmed is listed for manual review.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:34:"/mnt/user/appdata/spinmatch/ingest";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Music Directory";s:6:"Target";s:11:"/data/music";s:7:"Default";s:15:"/mnt/user/Music";s:4:"Mode";s:2:"rw";s:11:"Description";s:165:"Your organized music library. Confirmed ingested tracks are moved here into an {Artist}/{Album}/{Track} - {Title} structure. Point this at your existing music share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/Music";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Library DB Directory";s:6:"Target";s:8:"/data/db";s:7:"Default";s:30:"/mnt/user/appdata/spinmatch/db";s:4:"Mode";s:2:"rw";s:11:"Description";s:188:"Storage for the SQLite library index (library.db) that powers the collection dashboard and album gap detection. Must be a persistent, mounted path so the index survives container rebuilds.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/spinmatch/db";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"MB Contact Email";s:6:"Target";s:16:"MB_CONTACT_EMAIL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:227:"Required: a real contact email, per the MusicBrainz API usage policy (https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting). Every request identifies itself with this address; MusicBrainz may block the app's IP without it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"MB App Name";s:6:"Target";s:11:"MB_APP_NAME";s:7:"Default";s:9:"Spinmatch";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Application name sent in the MusicBrainz User-Agent header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"Spinmatch";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"MB App Version";s:6:"Target";s:14:"MB_APP_VERSION";s:7:"Default";s:5:"0.1.0";s:4:"Mode";s:0:"";s:11:"Description";s:62:"Application version sent in the MusicBrainz User-Agent header.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"0.1.0";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"AcoustID API Key";s:6:"Target";s:16:"ACOUSTID_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:408:"Optional: enables automatic track identification for the local library ingest feature (which itself just needs Ingest Directory and Music Directory above). Get a free key at https://acoustid.org/new-application. Leave blank and ingest still works, falling back to matching files by their existing tags (confirmed against MusicBrainz by title and duration), with anything unconfirmed listed for manual review.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Library DB Path";s:6:"Target";s:10:"LIBRARY_DB";s:7:"Default";s:19:"/data/db/library.db";s:4:"Mode";s:0:"";s:11:"Description";s:226:"Path (inside the container) to the SQLite library index. Should point into Library DB Directory above so it persists across container rebuilds. The collection dashboard is enabled automatically whenever Music Directory is set.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/data/db/library.db";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Ingest Dir Path";s:6:"Target";s:10:"INGEST_DIR";s:7:"Default";s:12:"/data/ingest";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Path (inside the container) to the ingest drop-folder. Must match the container side of Ingest Directory above — the path mapping alone doesn't tell the app where to look, this variable does. Clearing it disables the Ingest page.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"/data/ingest";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Music Dir Path";s:6:"Target";s:9:"MUSIC_DIR";s:7:"Default";s:11:"/data/music";s:4:"Mode";s:0:"";s:11:"Description";s:253:"Path (inside the container) to the organized music library. Must match the container side of Music Directory above — the path mapping alone doesn't tell the app where to look, this variable does. Clearing it disables both the Ingest and Library pages.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"/data/music";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Trust Proxy";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:530:"Set to 1 when Spinmatch sits behind a reverse proxy you control (SWAG, Nginx Proxy Manager, Traefik, Cloudflare Tunnel). It makes the app trust X-Forwarded-For, so the login rate limit sees real client IPs instead of lumping everyone into one bucket, and X-Forwarded-Proto, so the session cookie is marked Secure when your users are on HTTPS even though the proxy talks plain HTTP to the container. Leave blank if you reach the container directly by IP and port — when it is set, the app trusts headers that any client can send.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"YTDLP Path";s:6:"Target";s:10:"YTDLP_PATH";s:7:"Default";s:6:"yt-dlp";s:4:"Mode";s:0:"";s:11:"Description";s:127:"Path/name of the yt-dlp binary. The image installs yt-dlp on PATH already; only change this if you've customized the container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"yt-dlp";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"FPCALC Path";s:6:"Target";s:11:"FPCALC_PATH";s:7:"Default";s:6:"fpcalc";s:4:"Mode";s:0:"";s:11:"Description";s:170:"Path/name of the fpcalc (Chromaprint) binary used for acoustic fingerprinting. The image installs it on PATH already; only change this if you've customized the container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"fpcalc";}}s:12:"TemplatePath";s:33:"/tmp/GitHub/AppFeed/Spinmatch.xml";s:4:"Repo";s:27:"Yoshiofthewire's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1784851474;s:8:"Category";s:30:"MediaApp:Music Tools:Utilities";s:2:"ID";i:1367;s:11:"Displayable";b:1;s:6:"Author";s:14:"yoshiofthewire";s:13:"DockerHubName";s:9:"spinmatch";s:8:"RepoName";s:27:"Yoshiofthewire's Repository";s:10:"SortAuthor";s:14:"yoshiofthewire";s:8:"SortName";s:9:"Spinmatch";s:6:"random";i:335359516;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:124:"/tmp/community.applications/tempFiles/templates-community-apps/YoshiofthewiresRepository/yoshiofthewire-Spinmatch-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1368;a:35:{s:4:"Name";s:14:"Docker Cleanup";s:6:"Author";N;s:9:"PluginURL";s:94:"https://raw.git