y.applications/tempFiles/templates-community-apps/TwixiisRepository/nicolashaas-golangkanban-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:944;a:35:{s:4:"Name";s:17:"immich-album-sync";s:10:"Repository";s:49:"ghcr.io/nightcrawler1016/immich-album-sync:latest";s:8:"Registry";s:86:"https://github.com/NightCrawler1016/immich-album-sync/pkgs/container/immich-album-sync";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:60:"https://github.com/NightCrawler1016/immich-album-sync/issues";s:7:"Project";s:53:"https://github.com/NightCrawler1016/immich-album-sync";s:8:"Overview";s:1094:"One-way album sync between two Immich servers with a responsive web UI.

    Designed for Unraid users who run a private Immich server (full library) and a public/family-facing Immich server (curated albums only). Configure sync jobs, schedules, and API keys entirely through the browser — no config files or environment variables needed after the initial setup.

    Features:
    - Web UI with password protection
    - Multiple sync jobs with independent schedules
    - Preserves original files, EXIF, GPS, and Apple Live Photos (.HEIC + .MOV)
    - Duplicate-safe (uses immich-go for smart detection)
    - Real-time log streaming in the browser
    - Run history with a 30-day (configurable) window, filterable by job and status
    - Webhook notifications on sync start/success/failure (Discord, Slack, or any JSON endpoint)
    - Mobile-responsive design
    - Add-only mode by default (safe for family sharing)
    - Optional per-job "Mirror deletes" mode keeps the destination album matching the source album (changes album membership only; photos are never deleted from the server)";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/NightCrawler1016/immich-album-sync/dev/immich-album-sync.xml";s:4:"Icon";s:82:"https://raw.githubusercontent.com/NightCrawler1016/immich-album-sync/main/icon.png";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:99:"Port for the Immich Album Sync web interface. Open this in your browser after the container starts.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:12:"/app/appdata";s:7:"Default";s:35:"/mnt/user/appdata/immich-album-sync";s:4:"Mode";s:2:"rw";s:11:"Description";s:112:"Persistent storage for the database (config.db), download cache, and sync logs. Map to a location on your array.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/immich-album-sync";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:10:"SECRET_KEY";s:7:"Default";s:46:"change-me-to-a-unique-random-32-64-char-string";s:4:"Mode";s:0:"";s:11:"Description";s:717:"REQUIRED: Change to a unique random string used to sign session cookies and encrypt stored API keys. The container WILL NOT START while this is left at the default/placeholder value (any value starting with 'change-me') or shorter than 16 characters. Key length: minimum 16 characters | recommended 32–64 characters | maximum 128 characters (longer values provide no extra security). Generate a strong key at: https://1password.com/password-generator/ — select 32–64 characters, all character types. WARNING: changing this key after initial setup will invalidate all stored API keys and webhook URLs and log out all active sessions — you will need to re-enter API keys for every sync job and any webhook URLs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:46:"change-me-to-a-unique-random-32-64-char-string";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:284:"Container timezone. Used for sync log timestamps only — cron schedules always run in UTC, and the web UI shows times in UTC. Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London, UTC. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:332:"User ID the app process runs as (the container no longer runs as root). The default 99 is Unraid's 'nobody' user, which matches standard appdata ownership — leave it unless your appdata/cache is owned by a different user. If the container logs permission errors writing to appdata, set this to the owner UID of your appdata share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:183:"Group ID the app process runs as. The default 100 is Unraid's 'users' group, which matches standard appdata ownership. Change only if your appdata/cache is owned by a different group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Cleanup Cache After Upload";s:6:"Target";s:13:"CLEANUP_CACHE";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:342:"Set to 'true' to turn on 'Clean up cache after upload' for every job: downloaded originals are deleted right after a successful upload instead of at the start of the next run. Either way the cache is pruned at the start of every run, and files already on the destination are never re-downloaded. Leave 'false' to choose per job in the Web UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Cache Directory Path";s:6:"Target";s:10:"CACHE_PATH";s:7:"Default";s:18:"/app/appdata/cache";s:4:"Mode";s:0:"";s:11:"Description";s:688:"Path inside the container where original files are temporarily staged before uploading to the destination server. The default stores the cache inside the App Data directory.

To store the cache on a different disk, SSD pool, or network share (recommended for large first-time syncs):
  1. In the Docker template, add a second Path mapping:
       Container path: /app/cache
       Host path: /mnt/user/YourDisk/immich-sync-cache  (or any writable path)
  2. Set this field to: /app/cache

This lets you route multi-GB or multi-TB downloads to a large array disk or NAS share without filling your primary Unraid cache pool. The container must have write access to whatever path you choose.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:18:"/app/appdata/cache";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Max Cache Batch Size (MB)";s:6:"Target";s:13:"BATCH_SIZE_MB";s:7:"Default";s:5:"10240";s:4:"Mode";s:0:"";s:11:"Description";s:391:"Maximum amount of data (in megabytes) to download before uploading a batch to the destination server. After each batch is uploaded it is cleared from the cache, then the next batch begins. This prevents the local cache from growing too large during first-time syncs of very large albums. Default: 10240 (10 GB). Set to 0 to download all files before uploading (disables size-based batching).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"10240";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Max Files Per Batch";s:6:"Target";s:16:"BATCH_FILE_COUNT";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:310:"Maximum number of files to stage per batch before uploading. Works alongside Max Cache Batch Size — whichever limit is reached first triggers an upload cycle. Default: 0 (no file-count limit; only the size limit applies). Example: set to 500 to process albums in groups of 500 files regardless of total size.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Log File Path";s:6:"Target";s:8:"LOG_PATH";s:7:"Default";s:26:"/app/appdata/logs/sync.log";s:4:"Mode";s:0:"";s:11:"Description";s:181:"Internal path for the sync log file. Viewable live in the Web UI under 'Live Logs'. Rotates at 10 MB, keeping 3 old files (sync.log.1 to sync.log.3). Leave blank to use the default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/app/appdata/logs/sync.log";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database Path";s:6:"Target";s:7:"DB_PATH";s:7:"Default";s:22:"/app/appdata/config.db";s:4:"Mode";s:0:"";s:11:"Description";s:122:"Internal path for the SQLite database that stores sync job configurations and run history. Leave blank to use the default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:22:"/app/appdata/config.db";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Run History Retention (days)";s:6:"Target";s:26:"RUN_HISTORY_RETENTION_DAYS";s:7:"Default";s:2:"90";s:4:"Mode";s:0:"";s:11:"Description";s:335:"How many days of sync run history to keep. Older runs are pruned automatically once a day; the 10 most recent runs of each job are always kept regardless of age. Default: 90 (matches the widest filter on the Run History page). Set to 0 to keep all history forever (the database will grow over time, especially with frequent schedules).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"90";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"HTTPS Certificate File (optional)";s:6:"Target";s:15:"HTTPS_CERT_FILE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:417:"OPTIONAL — leave blank for normal plain-HTTP use on your LAN. Path INSIDE the container to a PEM certificate, e.g. /app/appdata/certs/cert.pem (put the file in your App Data folder under certs/). When this AND 'HTTPS Key File' are both set, port 8080 serves HTTPS only: open https://[IP]:8080 instead of the WebUI link (which stays http://). A self-signed certificate works. See the README section 'Optional HTTPS'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"HTTPS Key File (optional)";s:6:"Target";s:14:"HTTPS_KEY_FILE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:169:"OPTIONAL — leave blank unless you set 'HTTPS Certificate File'. Path INSIDE the container to the matching unencrypted PEM private key, e.g. /app/appdata/certs/key.pem.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Secure Session Cookie (reverse proxy)";s:6:"Target";s:21:"SESSION_COOKIE_SECURE";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:367:"OPTIONAL — only for when an HTTPS reverse proxy (nginx, NPM, SWAG, Traefik…) sits in front of this app. 'true' makes the browser send the login cookie over HTTPS only. Leave 'false' if you open the UI over plain http:// — with 'true' you could never stay logged in. Not needed with the HTTPS Certificate/Key settings above (the cookie is secured automatically).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/immich-album-sync.xml";s:4:"Repo";s:25:"NightCrawler's Repository";s:12:"CategoryList";a:2:{i:0;s:6:"Backup";i:1;s:15:"MediaApp-Photos";}s:9:"FirstSeen";i:1780257812;s:8:"Category";s:23:"Backup: MediaApp:Photos";s:2:"ID";i:944;s:11:"Displayable";b:1;s:6:"Author";s:16:"nightcrawler1016";s:13:"DockerHubName";s:17:"immich-album-sync";s:8:"RepoName";s:25:"NightCrawler's Repository";s:10:"SortAuthor";s:16:"nightcrawler1016";s:8:"SortName";s:17:"immich album sync";s:6:"random";i:680036211;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:130:"/tmp/community.applications/tempFiles/templates-community-apps/NightCrawlersRepository/nightcrawler1016-immichalbumsync-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b