s/templates-community-apps/1264.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"BranchName";s:7:"develop";s:17:"BranchDescription";s:26:"Latest development release";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1265;a:37:{s:4:"Name";s:12:"ReelExporter";s:10:"Repository";s:36:"ghcr.io/sufxgit/reel-exporter:latest";s:8:"Registry";s:69:"https://github.com/SuFxGIT/reel-exporter/pkgs/container/reel-exporter";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/SuFxGIT/reel-exporter/issues";s:7:"Project";s:40:"https://github.com/SuFxGIT/reel-exporter";s:6:"ReadMe";s:47:"https://github.com/SuFxGIT/reel-exporter#readme";s:8:"Overview";s:595:"Plex-style video player: browse your library, play anything, grab full-quality screenshots and export trimmed clips. Mount one or more media shares read-only, then pick exactly which folders become libraries under Sources in the app; unpicked folders are never scanned. It plays any file in the browser through an on-the-fly H.264 preview, and captures screenshots (PNG or JPEG at source resolution, HDR tone-mapped) and clips (MP4) from the ORIGINAL files into an output share, one folder per title. No GPU, no database, and it never writes to your media. TZ is taken from Unraid automatically.";s:5:"WebUI";s:24:"http://[IP]:[PORT:7727]/";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/SuFxGIT/reel-exporter/main/unraid/reel-exporter.xml";s:4:"Icon";s:76:"https://raw.githubusercontent.com/SuFxGIT/reel-exporter/main/unraid/icon.png";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"7727";s:7:"Default";s:4:"7727";s:4:"Mode";s:3:"tcp";s:11:"Description";s:111:"Host port for the Reel Exporter web interface. The container always listens on 7727; change only the host side.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7727";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Media Library (read-only)";s:6:"Target";s:6:"/media";s:7:"Default";s:20:"/mnt/user/data/media";s:4:"Mode";s:2:"ro";s:11:"Description";s:207:"Your main media share (Plex or TRaSH layout). Mounted read-only: Reel Exporter never writes here. Open Sources in the app to pick which folders inside it become libraries; unpicked folders are never scanned.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/mnt/user/data/media";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:42:"Extra Media Folder 2 (read-only, optional)";s:6:"Target";s:7:"/media2";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:208:"Optional second media root, for example a share on another pool. Leave empty if unused. Add it under Sources in the app and pick its folders. Need more? Use Add another Path with container paths like /media3.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:42:"Extra Media Folder 3 (read-only, optional)";s:6:"Target";s:7:"/media3";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:49:"Optional third media root. Leave empty if unused.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Captures Output";s:6:"Target";s:7:"/output";s:7:"Default";s:28:"/mnt/user/data/reel-exporter";s:4:"Mode";s:2:"rw";s:11:"Description";s:117:"Where screenshots (PNG) and clips (MP4) are written, one sub-folder per movie or show. Must be writable by PUID:PGID.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/data/reel-exporter";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:31:"/mnt/user