ching Unraid's aesthetic. Each process shows twin flat CPU + RAM bars (severity-coloured), name, user, PID and absolute memory. Sort by CPU or MEM and pick the refresh rate right from the tile header. Accurate %CPU from /proc (kernel threads included, so the real culprit shows), with an overall CPU + io-wait readout that reconciles with the official Processor tile. Tracks all themes; light on resources, no background daemon.";s:9:"PluginURL";s:89:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/topprocesses.plg";s:12:"PluginAuthor";s:11:"JanitorHead";s:7:"Support";s:50:"https://github.com/JanitorHead/unraid-topprocesses";s:7:"Project";s:50:"https://github.com/JanitorHead/unraid-topprocesses";s:6:"ReadMe";s:82:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/README.md";s:4:"Icon";s:96:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/images/topprocesses.png";s:10:"Screenshot";s:92:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/docs/screenshot.png";s:7:"License";s:3:"MIT";s:6:"MinVer";s:6:"6.12.0";s:11:"TemplateURL";s:97:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/plugins/topprocesses.xml";s:12:"TemplatePath";s:44:"/tmp/GitHub/AppFeed/plugins/topprocesses.xml";s:4:"Repo";s:25:"Monetary5569's Repository";s:10:"Repository";s:89:"https://raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/topprocesses.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.06.28";s:6:"Author";s:11:"JanitorHead";s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:975;s:9:"FirstSeen";i:1784817077;s:14:"LastUpdateScan";i:1792411842;s:11:"pluginStats";a:13:{i:10;i:85;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:561;s:2:"08";i:200;s:2:"09";i:129;s:1:"T";i:975;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:686;s:11:"Displayable";b:1;s:13:"DockerHubName";s:13:"top processes";s:8:"RepoName";s:25:"Monetary5569's Repository";s:10:"SortAuthor";s:11:"JanitorHead";s:8:"SortName";s:13:"Top Processes";s:6:"random";i:1658702566;s:9:"Blacklist";b:0;s:4:"Path";s:199:"/tmp/community.applications/tempFiles/templates-community-apps/Monetary5569sRepository/JanitorHead-TopProcesses-//raw.githubusercontent.com/JanitorHead/unraid-topprocesses/master/topprocesses.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:687;a:33:{s:4:"Name";s:10:"e-note-ion";s:10:"Repository";s:31:"ghcr.io/jasonpuglisi/e-note-ion";s:8:"Registry";s:68:"https://github.com/JasonPuglisi/e-note-ion/pkgs/container/e-note-ion";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:49:"https://github.com/JasonPuglisi/e-note-ion/issues";s:7:"Project";s:42:"https://github.com/JasonPuglisi/e-note-ion";s:8:"Overview";s:342:"E•NOTE•ION is a cron-based content scheduler for Vestaboard split-flap displays. Supports both the Note (3×15) and Flagship (6×22). Content is defined in JSON files and displayed on a schedule with priority queueing. Ships with bundled contrib content (opt-in via config.toml) and supports personal content via a host-mounted directory.";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/JasonPuglisi/unraid-templates/main/e-note-ion.xml";s:4:"Icon";s:78:"https://raw.githubusercontent.com/JasonPuglisi/e-note-ion/main/assets/icon.png";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Config file";s:6:"Target";s:16:"/app/config.toml";s:7:"Default";s:40:"/mnt/user/appdata/e-note-ion/config.toml";s:4:"Mode";s:2:"rw";s:11:"Description";s:276:"Required. Path to your config.toml on the host. Copy config.example.toml from the repo, fill in your API keys and settings, and point this path at the result. Display model (note/flagship), public mode, and enabled contrib content are all set in config.toml under [scheduler].";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"User content directory";s:6:"Target";s:17:"/app/content/user";s:7:"Default";s:36:"/mnt/user/appdata/e-note-ion/content";s:4:"Mode";s:2:"rw";s:11:"Description";s:185:"Optional. Path to a directory of personal content JSON files on the host. Files placed here are always loaded automatically. Leave blank if you only want to use bundled contrib content.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Runtime data directory";s:6:"Target";s:9:"/app/data";s:7:"Default";s:33:"/mnt/user/appdata/e-note-ion/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:369:"Optional. Path on the host for persistent runtime state — currently the integration health event log behind the /health endpoint, which keeps a rolling 7 days. Leave blank for the default: an anonymous volume that Unraid recreates on container update, so health history starts fresh after each update. Set a path only if you want that history to carry across updates.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:19:"America/Los_Angeles";s:4:"Mode";s:0:"";s:11:"Description";s:222:"Container timezone (e.g. America/New_York, Europe/London). Controls when cron jobs fire. Should match the timezone set in config.toml under [scheduler].timezone, or be the only timezone setting if you omit that config key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Webhook port";s:6:"Target";s:4:"8080";s:7:"Default";s:5:"32800";s:4:"Mode";s:3:"tcp";s:11:"Descrip