;b:1;s:16:"ModeratorComment";N;}i:4558;a:36:{s:4:"Name";s:4:"mute";s:10:"Repository";s:26:"meaning/mute-client:latest";s:8:"Registry";s:44:"https://hub.docker.com/r/meaning/mute-client";s:7:"Network";s:6:"bridge";s:5:"Shell";s:7:"/bin/sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:35:"https://github.com/silkyclouds/mute";s:7:"Project";s:17:"https://muteq.eu/";s:8:"Overview";s:617:"Acoustic Intelligence for Everyone.
Monitor, analyze, and understand your sound environment with smart, affordable sensors and a powerful analytics dashboard.

Mute turns your USB sound level meter into a real-time acoustic monitoring device.
Your data appears automatically in your personal dashboard — on https://dash.muteq.eu —
where you can visualize noise trends, detect peaks, compare time periods, and explore your environment through clear, intuitive charts.

Local MQTT integration is fully optional and allows publishing data to Home Assistant or any automation platform.

More info on https://muteq.eu.";s:4:"Icon";s:80:"https://raw.githubusercontent.com/silkyclouds/PMDA_unraid_xml/main/mute_logo.png";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Config Directory";s:6:"Target";s:7:"/config";s:7:"Default";s:22:"/mnt/user/appdata/mute";s:4:"Mode";s:2:"rw";s:11:"Description";s:78:"Directory where the client stores its configuration file (config_client.json).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"USB Device";s:6:"Target";s:12:"/dev/bus/usb";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:121:"USB sound level meter to pass through. Run 'lsusb' on Unraid to identify and map the correct /dev/bus/usb/XXX/YYY device.";s:4:"Type";s:6:"Device";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:29:"Local MQTT Enabled (Optional)";s:6:"Target";s:18:"LOCAL_MQTT_ENABLED";s:7:"Default";s:5:"false";s:11:"Description";s:117:"Optional — enable this only if you want to publish noise data to your local MQTT broker (e.g., for Home Assistant).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:28:"Local MQTT Server (Optional)";s:6:"Target";s:17:"LOCAL_MQTT_SERVER";s:7:"Default";s:0:"";s:11:"Description";s:54:"Optional — hostname or IP of your local MQTT broker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:26:"Local MQTT Port (Optional)";s:6:"Target";s:15:"LOCAL_MQTT_PORT";s:7:"Default";s:4:"1883";s:11:"Description";s:44:"Optional — port of your local MQTT broker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:30:"Local MQTT Username (Optional)";s:6:"Target";s:15:"LOCAL_MQTT_USER";s:7:"Default";s:0:"";s:11:"Description";s:49:"Optional — username for your local MQTT broker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:30:"Local MQTT Password (Optional)";s:6:"Target";s:15:"LOCAL_MQTT_PASS";s:7:"Default";s:0:"";s:11:"Description";s:49:"Optional — password for your local MQTT broker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:25:"Local MQTT TLS (Optional)";s:6:"Target";s:14:"LOCAL_MQTT_TLS";s:7:"Default";s:5:"false";s:11:"Description";s:71:"Optional — enable TLS encrypted connection to your local MQTT broker.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";}s:5:"value";s:0:"";}}s:11:"TemplateURL";s:75:"https://raw.githubusercontent.com/silkyclouds/PMDA_unraid_xml/main/mute.xml";s:12:"TemplatePath";s:28:"/tmp/GitHub/AppFeed/mute.xml";s:4:"Repo";s:17:"PMDA's Repository";s:12:"CategoryList";a:1:{i:0;s:20:"Other;HomeAutomation";}s:9:"downloads";i:1898;s:9:"FirstSeen";i:1765048073;s:10:"LastUpdate";i:1776095725;s:14:"LastUpdateScan";i:1791198847;s:8:"Category";s:21:"Other;HomeAutomation:";s:2:"ID";i:4558;s:11:"Displayable";b:1;s:6:"Author";s:7:"meaning";s:13:"DockerHubName";s:4:"mute";s:8:"RepoName";s:17:"PMDA's Repository";s:10:"SortAuthor";s:7:"meaning";s:8:"SortName";s:4:"mute";s:6:"random";i:1101836444;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:102:"/tmp/community.applications/tempFiles/templates-community-apps/PMDAsRepository/meaning-mute-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4559;a:45:{s:4:"Name";s:4:"PMDA";s:10:"Repository";s:19:"meaning/pmda:latest";s:8:"Registry";s:37:"https://hub.docker.com/r/meaning/pmda";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:42:"https://github.com/silkyclouds/PMDA/issues";s:7:"Project";s:22:"https://pmda.muteq.eu/";s:8:"Overview";s:2369:"PMDA (pronounced "pimda") is one music lover's take on building the music library of his dreams — self-hosted, private, and genuinely a joy to use.

• Understands your collection — scans huge folders and identifies every album against MusicBrainz, with a smart soft / release-group pass that recovers the covers and metadata other tools give up on.
• Keeps it clean — preserves the tags and artwork you trust, quarantines duplicates and incomplete rips, and publishes a fast, PostgreSQL-backed library.
• Made for listening — gapless playback with history, cross-user recommendations, clickable artist pages, synced lyrics and waveforms.
• Yours everywhere — native iOS and Android apps stream and download your library, lossless FLAC included.
• 100% self-hosted — no cloud lock-in, no phoning home, no AI tokens. Your music, your server, your rules.

PMDA needs FIVE folders, and asks for all five even if the way you choose to run it uses only some of them — that way you can change your mind later without coming back here. It will NOT start until all five are mapped.

Set the Host Path of each — the folder on your server. Do NOT touch the Container Path: /library, /intake, /organised, /quarantine and /config are the addresses PMDA reads, not names to pick, and renaming one stops the container with a message telling you so.

  Your music (/library) — what you already have. PMDA reads it and never changes it.
  New music (/intake) — where you drop music you have just got. Empty is normal.
  The organised folder (/organised) — a tidy version of your library, named and sorted PMDA's way.
  Set aside (/quarantine) — duplicates, incomplete albums and the trash. Nothing is ever deleted: it is moved, and it can be moved back.
  PMDA's own files (/config) — its database, your settings, the covers it downloads. This is the one to back up.

Want the organised folder built with hard links, at no extra disk cost? Map one more folder: the one that contains both your music and the organised folder. See “Optional: the folder that contains both” below.

Keep these five apart. In particular Set aside must NOT sit inside your music, or PMDA keeps finding what it just moved out of the way — it will refuse that layout and tell you so on first run.

Made for people who are in love with music. 🎵";s:5:"WebUI";s:17:"http://[IP]:5005/";s:11:"TemplateURL";s:75:"https://raw.githubusercontent.com/silkyclouds/PMDA_unraid_xml/main/pmda.xml";s:4:"Icon";s:82:"https://raw.githubusercontent.com/silkyclouds/PMDA_unraid_xml/main/pmda_p_icon.png";s:6:"Config";a:14:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"PMDA's own files";s:6:"Target";s:7:"/config";s:7:"Default";s:22:"/mnt/user/appdata/pmda";s:4:"Mode";s:2:"rw";s:11:"Description";s:504:"Leave the Container Path exactly as it is (/config) — that is the address PMDA reads, not a name to choose, and the container refuses to start if it is renamed. Only the Host Path, the folder on your server, is yours to set. PMDA's database, your settings, auth state, logs and the covers it downloads. This is the one to back up. If you install the optional local MusicBrainz mirror, its data (~170 GB) lives here too — put this on a fast pool with room to spare. Keep it outside your music folders.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:22:"/mnt/user/appdata/pmda";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Your music";s:6:"Target";s:8:"/library";s:7:"Default";s:15:"/mnt/user/Music";s:4:"Mode";s:2:"rw";s:11:"Description";s:405:"Leave the Container Path exactly as it is (/library) — that is the address PMDA reads, not a name to choose, and the container refuses to start if it is renamed. Only the Host Path, the folder on your server, is yours to set. The music you already have. PMDA reads it. In read-only mode — the recommended one — it never changes a single file here. Point this at the share that holds your collection.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/Music";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"New music";s:6:"Target";s:7:"/intake";s:7:"Default";s:21:"/mnt/user/PMDA/intake";s:4:"Mode";s:2:"rw";s:11:"Description";s:451:"Leave the Container Path exactly as it is (/intake) — that is the address PMDA reads, not a name to choose, and the container refuses to start if it is renamed. Only the Host Path, the folder on your server, is yours to set. Where you drop music you have just got. Empty is normal — PMDA watches this folder and identifies whatever lands in it. It must NOT be inside Your music, or PMDA cannot tell what has just arrived from what you already had.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:21:"/mnt/user/PMDA/intake";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"The organised folder";s:6:"Target";s:10:"/organised";s:7:"Default";s:24:"/mnt/user/PMDA/organised";s:4:"Mode";s:2:"rw";s:11:"Description";s:559:"Leave the Container Path exactly as it is (/organised) — that is the address PMDA reads, not a name to choose, and the container refuses to start if it is renamed. Only the Host Path, the folder on your server, is yours to set. Where PMDA can keep a tidy version of your library, named and sorted its way. Left empty in read-only mode. If you want it built with hardlinks (no extra disk space at all), it has to be on the SAME filesystem as Your music — two Unraid user shares often are not, and PMDA will tell you when it has to make real copies instead.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/PMDA/organised";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Set aside";s:6:"Target";s:11:"/quarantine";s:7:"Default";s:25:"/mnt/user/PMDA/quarantine";s:4:"Mode";s:2:"rw";s:11:"Description";s:507:"Leave the Container Path exactly as it is (/quarantine) — that is the address PMDA reads, not a name to choose, and the container refuses to start if it is renamed. Only the Host Path, the folder on your server, is yours to set. Duplicates, incomplete albums and the trash go here. Nothing is ever deleted: it is moved, and it can be moved back. It must NOT sit inside your music or your intake folder — PMDA would keep finding what it just moved out of the way, and it refuses that layout on first run.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/PMDA/quarantine";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:39:"Optional: the folder that contains both";s:6:"Target";s:9:"/linkroot";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:591:"ONLY if you want the organised folder built with hard links — the option that costs no extra disk space at all, because the same file simply appears in two places. A hard link cannot cross between two mappings, whatever the disk, so PMDA needs one more: the folder on your server that CONTAINS both Your music and The organised folder. If they live in one share, map that share here (for example /mnt/user/Music) and leave the Container Path as /linkroot. PMDA works the rest out on its own. Leave this empty and PMDA makes real copies instead, which always works and uses the space twice.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker Socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"rw";s:11:"Description";s:290:"Lets PMDA install and manage the optional local MusicBrainz mirror for you (one click, ~170 GB, answers in a millisecond instead of the public 1 request/second). PMDA only creates and controls its own mirror containers through it. Remove this mapping if you never want the one-click mirror.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/var/run/docker.sock";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:30:"Music Root (existing installs)";s:6:"Target";s:6:"/music";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:278:"ONLY for installs that were set up before PMDA asked for the five folders above. Those instances have their folders configured under /music and keep working exactly as they are — PMDA validates what each folder is FOR, not what it is called. Leave this empty on a new install.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Review Root (existing installs)";s:6:"Target";s:6:"/dupes";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:201:"ONLY for installs that were set up before PMDA asked for the five folders above, where duplicates and incomplete albums go to /dupes. New installs use Set aside (/quarantine) instead; leave this empty.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"WebUI Port (host network)";s:6:"Target";s:9:"PMDA_PORT";s:7:"Default";s:4:"5005";s:4:"Mode";s:3:"{3}";s:11:"Description";s:163:"PMDA listens on this port directly on the host (host networking). Change it only if 5005 is already taken on your server, and adjust the WebUI address accordingly.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5005";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Enable PMDA Auth";s:6:"Target";s:17:"PMDA_AUTH_ENABLED";s:7:"Default";s:1:"1";s:4:"Mode";s:3:"{3}";s:11:"Description";s:54:"Enable PMDA accounts and session-based access control.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Trust Proxy Headers";s:6:"Target";s:29:"PMDA_AUTH_TRUST_PROXY_HEADERS";s:7:"Default";s:5:"false";s:4:"Mode";s:3:"{3}";s:11:"Description";s:77:"Enable when PMDA is placed behind Cloudflare Tunnel or another reverse proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Secure Session Cookies";s:6:"Target";s:31:"PMDA_AUTH_SESSION_COOKIE_SECURE";s:7:"Default";s:5:"false";s:4:"Mode";s:3:"{3}";s:11:"Description";s:43:"Set to true when PMDA is served over HTTPS.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Allow Public Bootstrap";s:6:"Target";s:32:"PMDA_AUTH_ALLOW_PUBLIC_BOOTSTRAP";s:7:"Default";s:5:"false";s:4:"Mode";s:3:"{3}";s:11:"Description";s:111:"Leave false for normal installs. Only enable temporarily if first-user setup must happen from outside your LAN.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:28:"/tmp/GitHub/AppFeed/pmda.xml";s:4:"Repo";s:17:"PMDA's Repository";s:12:"CategoryList";a:1:{i:0;s:14:"MediaApp-Music";}s:9:"downloads";i:85038;s:13:"downloadtrend";a:7:{i:0;i:25436;i:1;i:28077;i:2;i:33248;i:3;i:35447;i:4;i:49853;i:5;i:64301;i:6;i:85038;}s:8:"trending";d:24.386;s:6:"trends";a:7:{i:0;d:41.272;i:1;d:9.406;i:2;d:15.553;i:3;d:6.204;i:4;d:28.897;i:5;d:22.469;i:6;d:24.386;}s:10:"trendsDate";a:7:{i:0;i:1776085837;i:1;i:1778685107;i:2;i:1781283409;i:3;i:1783951364;i:4;i:1786549408;i:5;i:1789145833;i:6;i:1791745164;}s:9:"FirstSeen";i:1750102144;s:10:"LastUpdate";i:1791138584;s:14:"LastUpdateScan";i:1791745164;s:11:"topTrending";d:-16.886;s:8:"Category";s:14:"MediaApp:Music";s:2:"ID";i:4559;s:11:"Displayable";b:1;s:6:"Author";s:7:"meaning";s:13:"DockerHubName";s:4:"pmda";s:8:"RepoName";s:17:"PMDA's Repository";s:10:"SortAuthor";s:7:"meaning";s:8:"SortName";s:4:"PMDA";s:6:"random";i:833205938;s:9:"Blacklist";b:0;s:6:"MinVer";s:3: