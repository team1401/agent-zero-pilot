Secrets are encrypted in the browser before they are uploaded, and the key stays in the link, so the server only ever stores ciphertext. This image adds a built-in Memcached, so secrets live in RAM only: nothing is written to disk, and a container restart deletes all open secrets.

Yopass needs HTTPS: browsers only allow the encryption on https:// pages (or on localhost). Put it behind your reverse proxy (Nginx Proxy Manager, SWAG, Traefik, Zoraxy, ...). It works on its own domain or under a path such as https://example.com/yopass/. Over plain http://[IP]:1337 the page only shows a notice.";s:5:"WebUI";s:24:"http://[IP]:[PORT:1337]/";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/hoody424/unraid-templates/main/yopass/yopass.xml";s:4:"Icon";s:82:"https://raw.githubusercontent.com/hoody424/unraid-templates/main/yopass/yopass.png";s:16:"ExtraSearchTerms";s:97:"password secret share sharing one-time link onetimesecret privatebin send encrypted self-destruct";s:7:"License";s:10:"Apache-2.0";s:4:"Date";s:10:"2026-10-12";s:6:"Config";a:17:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI port";s:6:"Target";s:4:"1337";s:7:"Default";s:4:"1337";s:4:"Mode";s:3:"tcp";s:11:"Description";s:77:"Web UI and API, plain HTTP. Point your reverse proxy with HTTPS at this port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1337";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Default expiry";s:6:"Target";s:14:"DEFAULT_EXPIRY";s:7:"Default";s:8:"1h|1d|1w";s:11:"Description";s:57:"Expiry pre-selected in the form: 1 hour, 1 day or 1 week.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"1h";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"One-time only";s:6:"Target";s:21:"FORCE_ONETIME_SECRETS";s:7:"Default";s:10:"false|true";s:11:"Description";s:84:"true = every secret can be opened only once (users cannot untick One-time download).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Disable file uploads";s:6:"Target";s:14:"DISABLE_UPLOAD";s:7:"Default";s:10:"false|true";s:11: