rcontent.com/pixari/opentodo/main/web/public/pwa-512.png";s:8:"Requires";s:353:"Nothing else. Data is one SQLite file in the appdata folder. Leave Use Tailscale off: the image has no shell, so Unraid's Tailscale script cannot run in it and the container would not start. For an https address on your tailnet, use Tailscale Serve on the Unraid server: https://github.com/pixari/opentodo/blob/main/docs/self-hosting/unraid.md#tailscale";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:35:"The port the app and API answer on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/opentodo";s:4:"Mode";s:2:"rw";s:11:"Description";s:87:"Everything OpenTodo stores: the database, attachments and backups. Back up this folder.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/opentodo";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Base URL";s:6:"Target";s:17:"OPENTODO_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:236:"The address people open, for example https://todo.example.com. Needed behind a reverse proxy for passkeys, secure cookies and links in emails. Include the port if there is one. Leave empty when you open OpenTodo by the server's address.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Setup token";s:6:"Target";s:20:"OPENTODO_SETUP_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:172:"Optional, at least 16 characters. When set, creating the first (owner) account asks for this token, so a server reachable from the internet cannot be claimed by a stranger.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Open sign-up";s:6:"Target";s:21:"OPENTODO_ALLOW_SIGNUP";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:96:"true lets anyone who can reach the server create an account. Otherwise the owner invites people.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted proxies";s:6:"Target";s:24:"OPENTODO_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:206:"Reverse proxies whose X-Forwarded-For is trusted for the visitor's address: IP addresses or ranges such as 192.0.2.0/24 separated by commas, or cloudflare. Set it only when every request comes through them.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Push notifications";s:6:"Target";s:13:"OPENTODO_PUSH";s:7:"Default";s:2:"on";s:4:"Mode";s:0:"";s:11:"Description";s:57:"on or off: reminders as push notifications (needs https).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"on";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Session days";s:6:"Target";s:21:"OPENTODO_SESSION_DAYS";s:7:"Default";s:2:"90";s:4:"Mode";s:0:"";s:11:"Description";s:27:"Days a sign-in stays valid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"90";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Trash retention days";s:6:"Target";s:29:"OPENTODO_TRASH_RETENTION_DAYS";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Days deleted items stay in the Trash; 0 k