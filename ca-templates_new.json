:4:"Name";s:27:"Enable HLS Token Validation";s:6:"Target";s:27:"ENABLE_HLS_TOKEN_VALIDATION";s:7:"Default";s:4:"true";s:11:"Description";s:81:"Validate HLS stream tokens so only party members can fetch segments (true/false).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:17;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:26:"HLS Token Expiry (seconds)";s:6:"Target";s:16:"HLS_TOKEN_EXPIRY";s:7:"Default";s:5:"86400";s:11:"Description";s:71:"How long HLS tokens remain valid, in seconds. Default 86400 (24 hours).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"86400";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Enable Rate Limiting";s:6:"Target";s:20:"ENABLE_RATE_LIMITING";s:7:"Default";s:4:"true";s:11:"Description";s:58:"Enable per-IP rate limiting on API endpoints (true/false).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:19;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:36:"Rate Limit: Party Creations Per Hour";s:6:"Target";s:25:"RATE_LIMIT_PARTY_CREATION";s:7:"Default";s:1:"5";s:11:"Description";s:40:"Maximum party creations per IP per hour.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"5";}i:20;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:32:"Rate Limit: API Calls Per Minute";s:6:"Target";s:20:"RATE_LIMIT_API_CALLS";s:7:"Default";s:4:"1000";s:11:"Description";s:36:"Maximum API calls per IP per minute.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1000";}i:21;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"ENV File Path (optional)";s:6:"Target";s:9:"/app/.env";s:7:"Default";s:38:"/mnt/user/appdata/emby-watchparty/.env";s:11:"Description";s:132:"Optional: mount a .env file into the container. If set, values in this file will be used. Individual env vars above take precedence.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mode";s:2:"ro";}s:5:"value";s:38:"/mnt/user/appdata/emby-watchparty/.env";}i:22;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"App Config Directory";s:6:"Target";s:11:"/app/config";s:7:"Default";s:33:"/mnt/user/appdata/emby-watchparty";s:11:"Description";s:81:"Path on the host where emby-watchparty will store any persistent config or state.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mode";s:2:"rw";}s:5:"value";s:33:"/mnt/user/appdata/emby-watchparty";}}s:12:"TemplatePath";s:69:"/tmp/GitHub/AppFeed/emby-watchparty-legacy/emby-watchparty-legacy.xml";s:4:"Repo";s:20:"Mahesvara's Toolshed";s:12:"CategoryList";a:3:{i:0;s:14:"MediaApp-Video";i:1;s:17:"MediaServer-Video";i:2;s:13:"Network-Other";}s:9:"FirstSeen";i:1777872116;s:8:"Category";s:46:"MediaApp:Video MediaServer:Video Network:Other";s:2:"ID";i:968;s:11:"Displayable";b:1;s:6:"Author";s:9:"oratorian";s:13:"DockerHubName";s:22:"emby-watchparty-legacy";s:8:"RepoName";s:20:"Mahesvara's Toolshed";s:10:"SortAuthor";s:9:"oratorian";s:8:"SortName";s:22:"emby watchparty legacy";s:6:"random";i:647127338;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:123:"/tmp/community.applications/tempFiles/templates-community-apps/MahesvarasToolshed/oratorian-embywatchpartylegacy-legacy.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:28:"Support development on Ko-fi";s:10:"DonateLink";s:25:"https://ko-fi.com/jedziah";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:969;a:39:{s:4:"Name";s:15:"emby-watchparty";s:10:"Repository";s:40:"ghcr.io/oratorian/emby-watchparty:latest";s:8:"Registry";s:41:"https://ghcr.io/oratorian/emby-watchparty";s:6:"GitHub";s:44:"https://github.com/Oratorian/emby-watchparty";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:106:"https://forums.unraid.net/topic/198376-support-emby-watchparty-watch-party-for-emby-synchronized-playback/";s:7:"Project";s:44:"https://github.com/Oratorian/emby-watchparty";s:8:"Overview";s:498:"A synchronized watch party application for Emby media servers. Vue 3 SPA + FastAPI backend with per-user HLS transcodes, late-joiner voting, in-party admin panel, and drift correction. All streaming is proxied through the container so your Emby server can stay on your internal network. Only boot-essential values are set here; everything else (logging, security, rate limits, late-join vote, static session, force-transcode, etc.) is managed live via the /admin panel and persisted to config.json.";s:8:"Requires";s:417:"A running Emby server reachable from this container and an admin-level Emby API key (Emby Dashboard > Advanced > API Keys). Per-user authentication is an in-app action -- any party member clicks &quot;Login to Become Host&quot; and supplies their own Emby credentials, so no long-lived user creds are stored on disk. Emby Premiere is required on the Emby side for hardware-accelerated transcoding (QSV, NVENC, VAAPI).";s:5:"WebUI";s:23:"http://[IP]:[PORT:5000]";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/Oratorian/unraid-templates/main/emby-watchparty/emby-watchparty.xml";s:4:"Icon";s:117:"https://raw.githubusercontent.com/Oratorian/unraid-templates/refs/heads/main/emby-watchparty/emby-watchparty-icon.png";s:5:"Shell";s:2:"sh";s:6:"Config";a:14:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"5000";s:7:"Default";s:4:"5000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:83:"Host port for the emby-watchparty web interface. Must match WATCH_PARTY_PORT below.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5000";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Emby Server URL";s:6:"Target";s:15:"EMBY_SERVER_URL";s:7:"Default";s:23:"http://192.168.1.x:8096";s:11:"Description";s:99:"Full URL to your Emby server, e.g. http://192.168.1.100:8096. Reachable from inside this container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:23:"http://192.168.1.x:8096";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Emby API Key";s:6:"Target";s:12:"EMBY_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:159:"Admin Emby API key. Generate one in Emby Dashboard &gt; Advanced &gt; API Keys. Per-user credentials are NOT set here -- users log in from inside the party UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Session Secret";s:6:"Target";s:14:"SESSION_SECRET";s:7:"Default";s:29:"change-me-openssl-rand-hex-32";s:11:"Description";s:333:"Signing key for the party-bound session cookie. Generate ONCE with `openssl rand -hex 32` and leave it -- must persist across restarts and across every uvicorn worker. If left at the default, an ephemeral key is generated at boot with a loud warning; fine for local dev, catastrophic in production (every restart kicks everyone out).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:29:"change-me-openssl-rand-hex-32";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"Session Cookie Secure";s:6:"Target";s:21:"SESSION_COOKIE_SECURE";s:7:"Default";s:5:"false";s:11:"Description";s:234:"When `true`, the session cookie carries the Secure flag so browsers only send it over HTTPS. Set `true` for every deployment behind TLS; leave `false` for local http://localhost dev (setting it true on an http origin locks users out).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Bind Address";s:6:"Target";s:16:"WATCH_PARTY_BIND";s:7:"Default";s:7:"0.0.0.0";s:11:"Description";s:129:"Interface the app listens on inside the container. 0.0.0.0 listens on all interfaces (typical for Docker); rarely needs changing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"0.0.0.0";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Container Port";s:6:"Target";s:16:"WATCH_PARTY_PORT";s:7:"Default";s:4:"5000";s:11:"Description";s:104:"Port the app binds inside the container. Must match the container-side of the Web UI Port mapping above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5000";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"App Prefix";s:6:"Target";s:10:"APP_PREFIX";s:7:"Default";s:0:"";s:11:"Description";s:227:"URL prefix for reverse-proxy deployments behind a subpath (e.g. /watchparty). Leave empty for root-of-domain deployments. Backend routers, Socket.IO, /assets, and the SPA all honour the prefix at runtime -- no rebuild required.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"CORS Allowed Origins";s:6:"Target";s:20:"CORS_ALLOWED_ORIGINS";s:7:"Default";s:1:"*";s:11:"Description";s:284:"Comma-separated origin allowlist for the Socket.IO server. `*` accepts XHR-poll handshakes from any origin -- convenient for testing but pair with per-IP throttling. Pin to your real origin(s) for a proper deployment, e.g. `https://watchparty.example.com,https://staging.example.com`.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"*";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Session Expiry (seconds)";s:6:"Target";s:14:"SESSION_EXPIRY";s:7:"Default";s:5:"86400";s:11:"Description";s:61:"Session cookie lifetime in seconds. Default 86400 (24 hours).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"86400";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Avatar Database";s:6:"Target";s:9:"/app/data";s:7:"Default";s:38:"/mnt/user/appdata/emby-watchparty/data";s:11:"Description";s:121:"Persists the avatars.db SQLite database. Without this mount, every container recreate wipes every member's chosen avatar.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";s:4:"Mode";s:2:"rw";}s:5:"value";s:38:"/mnt/user/appdata/emby-watchparty/data";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Avatar Images";s:6:"Target";s:19:"/app/images/avatars";s:7:"Default";s:41:"/mnt/user/appdata/emby-watchparty/avatars";s:11:"Description";s:82:"Persists uploaded avatar image files. Paired with the Avatar Database mount above.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";s:4:"Mode";s:2:"rw";}s:5:"value";s:41:"/mnt/user/appdata/emby-watchparty/avatars";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Admin Config (config.json)";s:6:"Target";s:16:"/app/config.json";s:7:"Default";s:45:"/mnt/user/appdata/emby-watchparty/config.json";s:11:"Description";s:239:"Persists the runtime admin config (edited via /admin) across container recreates. IMPORTANT: `touch config.json` on the host BEFORE the first start, otherwise Docker silently creates it as an empty DIRECTORY and the backend fails to write.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";s:4:"Mode";s:2:"rw";}s:5:"value";s:45:"/mnt/user/appdata/emby-watchparty/config.json";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Logs (optional)";s:6:"Target";s:9:"/app/logs";s:7:"Default";s:38:"/mnt/user/appdata/emby-watchparty/logs";s:11:"Description";s:128:"Optional: persist application logs to disk. Only writes when Log To File is enabled in the /admin panel (default: console-only).";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";s:4:"Mode";s:2:"rw";}s:5:"value";s:38:"/mnt/user/appdata/emby-watchparty/logs";}}s:12:"TemplatePath";s:55:"/tmp/GitHub/AppFeed/emby-watchparty/emby-watchparty.xml";s:4:"Repo";s:20:"Mahesvara's Toolshed";s:12:"CategoryList";a:3:{i:0;s:14:"MediaApp-Video";i:1;s:17:"MediaServer-Video";i:2;s:13:"Network-Other";}s:9:"FirstSeen";i:1777872116;s:14:"LastUpdateScan";i:1777872116;s:8:"Category";s:46:"MediaApp:Video MediaServer:Video Network:Other";s:2:"ID";i:969;s:11:"Displayable";b:1;s:6:"Author";s:9:"oratorian";s:13:"DockerHubName";s:15:"emby-watchparty";s:8:"RepoName";s:20:"Mahesvara's Toolshed";s:10:"SortAuthor";s:9:"oratorian";s:8:"SortName";s:15:"emby watchparty";s:6:"random";i:732819487;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/MahesvarasToolshed/oratorian-embywatchparty-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:28:"Support development on Ko-fi";s:10:"DonateLink";s:25:"https://ko-fi.com/jedziah";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:970;a:34:{s:4:"Name";s:4:"Maki";s:10:"Repository";s:29:"ghcr.io/orbitmpgh/maki:latest";s:8:"Registry";s:53:"https://github.com/OrbitMPGH/Maki/pkgs/container/maki";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:40:"https://github.com/OrbitMPGH/Maki/issues";s:7:"Project";s:33:"https://github.com/OrbitMPGH/Maki";s:8:"Overview";s:729:"Maki is a manga collection manager for the *arr ecosystem. It tracks series across multiple scraper sources and torrent trackers, downloads chapters into CBZ files with embedded metadata, and lets you read them with a built-in reader (with a Home screen and progress tracking) or hand them off to Kavita. Includes an OPDS server for external readers, scrobbling to AniList/MyAnimeList/Kitsu/MangaBaka, rewind reading stats, user tags and saved library filters, and a local-embeddings "Discover" recommendation engine over the MangaBaka dump.

