:12:"trendAverage";d:17.044;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1152;a:44:{s:4:"Name";s:4:"Silo";s:10:"Repository";s:38:"ghcr.io/silo-server/silo-server:latest";s:8:"Registry";s:69:"https://github.com/Silo-Server/silo-server/pkgs/container/silo-server";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:11:"ExtraParams";s:20:"--restart=on-failure";s:4:"Icon";s:82:"https://raw.githubusercontent.com/Silo-Server/unraid-templates/main/icons/silo.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:1647:"Silo is a self-hosted media server for your films and series. Point it at your media folders and stream to your devices - at home or away - with direct play, remuxing and hardware-accelerated transcoding handled automatically.

A full-featured web client and admin interface ship with the server. An optional Jellyfin/Emby-compatible API lets you keep using clients you already own, such as Infuse, VidHub and Findroid. Household profiles give each member their own watch state and parental controls, and metadata is matched through installable plugins including TMDB and TVDB.

IMPORTANT: Silo needs a PostgreSQL 18 database with the pgvector extension and Redis 6.2 or newer. Install the Silo-PostgreSQL template from this repository, then install any generic Redis container from Community Applications or use an existing Redis service. Set DATABASE_URL and REDIS_URL below to point at them. If you enable Unraid autostart, place Redis and Silo-PostgreSQL before Silo in Docker startup order. If Silo starts before either dependency is reachable, it exits and Docker restarts it with a growing delay until both are up. This relies on --restart=on-failure in Advanced View's Extra Parameters, so keep it there.

Hardware transcoding is optional. For Intel or AMD, add --device=/dev/dri:/dev/dri to Advanced View's Extra Parameters, after --restart=on-failure, only when /dev/dri exists on the host. For NVIDIA, install the Unraid Nvidia-Driver plugin, add --runtime=nvidia to Advanced View's Extra Parameters after --restart=on-failure, and enter your GPU UUID in the NVIDIA GPU UUID field. Silo's automatic hardware detection will select NVENC.";s:7:"Support";s:49:"https://github.com/Silo-Server/silo-server/issues";s:7:"Project";s:42:"https://github.com/Silo-Server/silo-server";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/Silo-Server/unraid-templates/main/templates/silo.xml";s:6:"ReadMe";s:77:"https://raw.githubusercontent.com/Silo-Server/unraid-templates/main/README.md";s:7:"Discord";s:29:"https://discord.gg/siloserver";s:16:"ExtraSearchTerms";s:85:"silo media server streaming films movies tv series shows jellyfin emby plex transcode";s:8:"Requires";s:449:"PostgreSQL 18 with the pgvector extension and Redis 6.2 or newer must be running before Silo will start. Install Silo-PostgreSQL from this repository and any generic Redis container from Community Applications, or use an existing Redis service. When using Unraid autostart, order both dependencies before Silo. Silo restarts automatically if it starts before they are ready. A SECRET_KEY is also required - generate one with: openssl rand -base64 48";s:6:"MinVer";s:4:"6.12";s:7:"License";s:17:"AGPL-3.0-or-later";s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8090";s:4:"Mode";s:3:"tcp";s:11:"Description";s:40:"Port for the Silo web interface and API.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8090";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Jellyfin-Compatible API Port";s:6:"Target";s:4:"8096";s:7:"Default";s:4:"8096";s:4:"Mode";s:3:"tcp";s:11:"Description";s:215:"Port for the optional Jellyfin/Emby-compatible API, used by clients such as Infuse, VidHub and Findroid. Disabled until an administrator enables it in admin settings. Change this if you already run Jellyfin on 8096.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8096";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:34:"Audiobookshelf-Compatible API Port";s:6:"Target";s:5:"13378";s:7:"Default";s:5:"13378";s:4:"Mode";s:3:"tcp";s:11:"Description";s:108:"Port for the optional Audiobookshelf-compatible API. Change this if you already run Audiobookshelf on 13378.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"13378";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Media Data";s:6:"Target";s:14:"/mnt/user/data";s:7:"Default";s:14:"/mnt/user/data";s:4:"Mode";s:2:"ro";s:11:"Description";s:201:"Root share containing your film and series libraries. The host and container paths are identical so paths remain consistent across your media stack. Mounted read-only - Silo never writes to your media.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"/mnt/user/data";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:13:"/var/lib/silo";s:7:"Default";s:22:"/mnt/user/appdata/silo";s:4:"Mode";s:2:"rw";s:11:"Description";s:155:"All persistent Silo application data, including installed plugins and compatibility assets. Back this directory up together with PostgreSQL and SECRET_KEY.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:22:"/mnt/user/appdata/silo";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Transcode Scratch";s:6:"Target";s:19:"/tmp/silo-transcode";s:7:"Default";s:19:"/tmp/silo-transcode";s:4:"Mode";s:2:"rw";s:11:"Description";s:168:"Temporary transcode files. Defaults to /tmp, which is RAM on Unraid - this avoids unnecessary SSD wear. Point it at a cache-backed path instead if you have limited RAM.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/tmp/silo-transcode";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Host meminfo";s:6:"Target";s:18:"/host/proc/meminfo";s:7:"Default";s:13:"/proc/meminfo";s:4:"Mode";s:2:"ro";s:11:"Description";s:80:"Read-only view of host memory, used to auto-tune database settings. Leave as-is.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"/proc/meminfo";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"MODE";s:6:"Target";s:4:"MODE";s:7:"Default";s:10:"integrated";s:11:"Description";s:74:"Deployment mode. Leave as 'integrated' for a normal single-server install.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"integrated";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"SECRET_KEY";s:6:"Target";s:10:"SECRET_KEY";s:7:"Default";s:0:"";s:11:"Description";s:276:"REQUIRED. Master key for at-rest credential encryption - the server will not start without it. Generate one by opening an Unraid terminal and running: openssl rand -base64 48 -- Back this up separately from your database. If you lose it, encrypted secrets cannot be recovered.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"DATABASE_URL";s:6:"Target";s:12:"DATABASE_URL";s:7:"Default";s:70:"postgres://silo:YOUR-PASSWORD@YOUR-UNRAID-IP:5432/silo?sslmode=disable";s:11:"Description";s:296:"REQUIRED. Connection string for Silo-PostgreSQL, for example: postgres://silo:YOUR-PASSWORD@YOUR-UNRAID-IP:5432/silo?sslmode=disable. The password must match POSTGRES_PASSWORD. Replace YOUR-UNRAID-IP with your Unraid server's L