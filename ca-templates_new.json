ge manages /etc/localtime internally via TZ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Vienna";}i:40;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"User ID (PUID)";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:57:"User-ID HandBrake runs as. Default 99 (nobody on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:41;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Group ID (PGID)";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:40:"Group-ID. Default 100 (users on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:42;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:15:"000|022|002|077";s:4:"Mode";s:0:"";s:11:"Description";s:212:"Permission mask for newly created files. The default 000 lets every container user read and write them, which is what you want when other containers touch the same shares. Set 022 or 077 for stricter permissions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/handbrake/handbrake.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:15319;s:9:"FirstSeen";i:1786910658;s:10:"LastUpdate";i:1792070774;s:14:"LastUpdateScan";i:1792262791;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:2773;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:9:"handbrake";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:9:"HandBrake";s:6:"random";i:1659451709;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:128:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-HandBrake-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2774;a:45:{s:4:"Name";s:11:"JDownloader";s:10:"Repository";s:35:"junkerderprovinz/jdownloader:latest";s:8:"Registry";s:53:"https://hub.docker.com/r/junkerderprovinz/jdownloader";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:6:"ReadMe";s:67:"https://github.com/junkerderprovinz/jdownloader/blob/main/README.md";s:7:"Support";s:78:"https://forums.unraid.net/topic/199305-support-junkerderprovinz-jdownloader-2/";s:7:"Project";s:23:"https://jdownloader.org";s:8:"Overview";s:1660:"JDownloader 2 with a dark mode GUI and full clipboard support out of the box. The download list, link grabber and settings are all dark, and everything runs on a hardware-accelerated Selkies web desktop. It looks like this from the first start, without tweaking or add-ons.

What's pre-configured:
• Full dark mode by default: JD Plain Dark (monochrome Carbon #161616) in a maximised kiosk window. Switch to a matching Light theme, or JDownloader's own classic look, via the Theme variable.
• Installs and updates JDownloader by itself. The first-run install prompts are confirmed automatically, so there is nothing to click.
• Seamless clipboard over HTTPS: copy on your PC, paste straight into JD.
• Persistent config and downloads in /config and /downloads; hidden columns / layout survive a restart.

Notes:
• The first start takes a few minutes: JDownloader installs itself and its dark theme, and the WebUI stays black until that is done. Do not restart the container in the meantime, since that interrupts the install. Wait for the "JDOWNLOADER IS READY" banner in the container log, then open the WebUI.
• WebUI opens via HTTPS (port 3001, self-signed cert, accept it once), because the clipboard needs HTTPS. Plain HTTP (3000) is also exposed.
• Map /downloads to your download share. PUID/PGID default to 99/100 (nobody/users on Unraid).
• Language: English by default. Change it any time in JDownloader's own language menu (Settings, the flag icon); your choice persists across restarts.
• Auth: leave WebUI Username and Password empty for no login.

Source on GitHub: https://github.com/junkerderprovinz/jdownloader";s:5:"WebUI";s:25:"https://[IP]:[PORT:3001]/";s:11:"TemplateURL";s:95:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/jdownloader/jdownloader.xml";s:4:"Icon";s:88:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/jdownloader/icon.png";s:11:"ExtraParams";s:39:"--restart=unless-stopped --shm-size=1gb";s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"WebUI Port (HTTP / Selkies)";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:86:"Plain HTTP WebUI. Browsers block seamless clipboard over HTTP, so prefer HTTPS (3001).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"WebUI Port (HTTPS / Selkies)";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:97:"HTTPS WebUI (self-signed TLS). The WebUI button opens this port, and seamless clipboard needs it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"AppData (/config)";s:6:"Target";s:7:"/config";s:7:"Default";s:29:"/mnt/user/appdata/jdownloader";s:4:"Mode";s:2:"rw";s:11:"Description";s:58:"Persistent JDownloader install, configs, and session data.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/jdownloader";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Downloads (/downloads)";s:6:"Target";s:10:"/downloads";s:7:"Default";s:19:"/mnt/user/downloads";s:4:"Mode";s:2:"rw";s:11:"Description";s:26:"Download target directory.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/mnt/user/downloads";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Theme (JD_THEME)";s:6:"Target";s:8:"JD_THEME";s:7:"Default";s:35:"Dark|Light|JDDEFAULT|jd-highlighter";s:4:"Mode";s:0:"";s:11:"Description";s:193:"Dark = monochrome Carbon #161616, Light = JD's light theme, JDDEFAULT = JDownloader's own classic look, jd-highlighter = borderless, freely-accented dark (pick the accent with JD_ACCENT below).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"Dark";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Accent (JD_ACCENT)";s:6:"Target";s:9:"JD_ACCENT";s:7:"Default";s:7:"#ffee00";s:4:"Mode";s:0:"";s:11:"Description";s:363:"Accent colour for the jd-highlighter theme (any hex, e.g. #ffee00). Only applies when Theme is set to jd-highlighter. The accent lights up checkmarks, toggles, focus, the download progress bar and primary buttons; large fills stay neutral so text stays readable at any hue. Button/progress text is auto-contrasted (dark on a light accent, light on a dark accent).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"#ffee00";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Self-Update (JD_SELFUPDATE)";s:6:"Target";s:13:"JD_SELFUPDATE";s:7:"Default";s:10:"true|false";s:4:"Mode";s:0:"";s:11:"Description";s:295:"true (default) = JDownloader keeps updating itself. false = frozen appliance: disables JD's periodic self-update checks. Keep in mind that the same update channel delivers the hoster plugins, which go stale within weeks, so downloads may start failing. The first install always uses the updater.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:53:"In-container browser for captchas (JD_ENABLE_BROWSER)";s:6:"Target";s:17:"JD_ENABLE_BROWSER";s:7:"Default";s:15:"auto|true|false";s:4:"Mode";s:0:"";s:11:"Description";s:632:"auto (default) = remembers your last choice, so an enabled browser survives container updates (recreates). Set true to enable JDownloader's 'solve captcha in browser' flow: reCAPTCHA/hCaptcha/Turnstile open in a bundled Firefox (with uBlock Origin) on the web desktop and are solved with one click, from the container's own IP (tokens are IP-bound). The Firefox profile persists in /config/.config/mozilla. Set false to force it off. Only enable it if a hoster you use needs browser captchas. Classic image captchas are auto-solved either way, and enabling it runs a full browser, which costs more resources and adds attack surface.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Username";s:6:"Target";s:11:"CUSTOM_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:95:"Optional. Username for HTTP-basic-auth. Leave it empty together with the password for no login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Password";s:6:"Target";s:8:"PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Optional. Password for HTTP-basic-auth.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Timezone (TZ)";s:6:"Target";s:2:"TZ";s:7:"Default";s:6825:"Europe/Vienna|Africa/Abidjan|Africa/Accra|Africa/Addis_Ababa|Africa/Algiers|Africa/Asmera|Africa/Bamako|Africa/Bangui|Africa/Banjul|Africa/Bissau|Africa/Blantyre|Africa/Brazzaville|Africa/Bujumbura|Africa/Cairo|Africa/Casablanca|Africa/Ceuta|Africa/Conakry|Africa/Dakar|Africa/Dar_es_Salaam|Africa/Djibouti|Africa/Douala|Africa/El_Aaiun|Africa/Freetown|Africa/Gaborone|Africa/Harare|Africa/Johannesburg|Africa/Juba|Africa/Ka