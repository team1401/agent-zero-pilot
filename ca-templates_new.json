It was originally written for embedded devices with very limited resources in terms of RAM and CPU. Its predecessor "uvc_streamer" was created because Linux-UVC compatible cameras directly produce JPEG-data, allowing fast and perfomant M-JPEG streams even from an embedded device running OpenWRT. The input module "input_uvc.so" captures such JPG frames from a connected webcam. mjpg-streamer now supports a variety of different input devices.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:105:"https://raw.githubusercontent.com/twist3dimages/unraid-templates/main/MJPEG%20Streamer/mjpeg-streamer.xml";s:4:"Icon";s:69:"https://dashboard.snapcraft.io/site_media/appmedia/2018/01/webcam.png";s:8:"PostArgs";s:102:"-i "input_uvc.so -n -d /dev/video0 -r 1920x1080" -o "output_http.so -w  /usr/share/mjpg-streamer/www/"";s:6:"Config";a:2:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Camera";s:6:"Target";s:0:"";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:29:"Mount the path to your camera";s:4:"Type";s:6:"Device";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"/dev/video0";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"8080";s:6:"Target";s:4:"8080";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:0:"";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/MJPEG Streamer/mjpeg-streamer.xml";s:4:"Repo";s:16:"Exes' Repository";s:9:"FirstSeen";i:1663929485;s:14:"LastUpdateScan";i:1778325265;s:12:"CategoryList";a:0:{}s:8:"Category";s:6:"Other:";s:2:"ID";i:4773;s:11:"Displayable";b:1;s:6:"Author";s:14:"luckyturtledev";s:13:"DockerHubName";s:13:"mjpg-streamer";s:8:"RepoName";s:16:"Exes' Repository";s:10:"SortAuthor";s:14:"luckyturtledev";s:8:"SortName";s:13:"mjpg streamer";s:6:"random";i:1307763731;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applica