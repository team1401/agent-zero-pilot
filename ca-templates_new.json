usercontent.com/sydlexius/canticle/main/docs/img/canticle-webhook-keys.png";}s:16:"ExtraSearchTerms";s:78:"lrc synced lyrics timed lyrics musixmatch petitlyrics innertube youtube lidarr";s:8:"Overview";s:178:"Fetches time-synced (.lrc) lyrics for your music library from several providers, on a schedule, on file changes and via Lidarr webhooks, and writes them next to your audio files.";s:5:"WebUI";s:25:"http://[IP]:[PORT:50705]/";s:4:"Icon";s:90:"https://raw.githubusercontent.com/sydlexius/canticle/main/web/static/img/canticle-mark.svg";s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"WebUI / Webhook Port";s:6:"Target";s:5:"50705";s:7:"Default";s:5:"50705";s:4:"Mode";s:3:"tcp";s:11:"Description";s:62:"Serves both the web dashboard and the Lidarr webhook endpoint.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"50705";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:71:"Stores config.toml, the SQLite database, and the encrypted secrets key.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Music Library";s:6:"Target";s:6:"/music";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:148:"Your music library. Lyrics are written next to each audio file, so this must be writable. Add more Path mappings for additional libraries if needed.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Musixmatch Token";s:6:"Target";s:16:"MUSIXMATCH_TOKEN";s:7:"Default";s:0:"";s:11:"Description";s:595:"Leave this blank, and ideally delete this variable entirely. Canticle obtains its own Musixmatch token on first start and stores it encrypted, so no token is needed here for a normal install. Setting a value overrides that and also turns off automatic token renewal, so a token entered here will eventually go stale and stop fetching lyrics until you replace it by hand. Only fill this in if you have a specific reason to pin your own token. If you would rather manage it in the UI, add it under Settings in the web dashboard instead, where it is stored encrypted rather than as a plain env var.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Trusted Networks (CIDRs)";s:6:"Target";s:19:"MXLRC_TRUSTED_CIDRS";s:7:"Default";s:0:"";s:11:"Description";s:588:"LEAVE THIS BLANK unless you know you need it. Any device in a listed CIDR reaches the web dashboard and Settings WITHOUT SIGNING IN, permanently, which includes reading your API token and minting webhook keys. Blank means only the container itself is trusted, so everyone signs in normally. First-run setup no longer needs an entry here: the setup page is open until you create your admin account, then closes for good. Add your LAN (for example 192.168.1.0/24) only for something that genuinely cannot sign in, such as a Prometheus scraper reading /metrics. Public IPs are never trusted.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Enable Web UI";s:6:"Target";s:20:"MXLRC_WEB_UI_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:168:"Serve the browser dashboard and settings UI on the listen port. Leave true for the normal Unraid experience; set false to run headless (webhook + scheduled scans only).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Webhook API Key";s:6:"Target";s:21:"MXLRC_WEBHOOK_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:142:"Static API key Lidarr presents to authenticate webhook calls. Optional; you can also mint managed keys in the web UI (Settings, Webhook keys).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"Master Encryption Key";s:6:"Target";s:16:"MXLRC_MASTER_KEY";s:7:"Default";s:0:"";s:11:"Description";s:248:"Base64 of 32 random bytes (openssl rand -base64 32). Encrypts API secrets at rest. Auto-generated to a key file under /config if left blank; set an explicit value to keep the key off the data volume and preserve secrets across container recreation.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"API Cooldown (seconds)";s:6:"Target";s:18:"MXLRC_API_COOLDOWN";s:7:"Default";s:2:"60";s:11:"Description";s:134:"Minimum seconds between Musixmatch calls. 60 is recommended to avoid egress-IP rate limiting; the built-in default is more aggressive.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"60";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"Filesystem Watcher";s:6:"Target";s:21:"MXLRCGO_WATCH_ENABLED";s:7:"Default";s:5:"false";s:11:"Description";s:107:"Watch the library for changes and trigger targeted scans (in addition to the periodic scan). true or false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Instrumental Detector URL";s:6:"Target";s:42:"MXLRC_INSTRUMENTAL_DETECTOR_CLASSIFIER_URL";s:7:"Default";s:0:"";s:11:"Description";s:171:"Optional. URL of a separately-deployed YAMNet classifier sidecar (for example http://yamnet:8080) to detect instrumental track