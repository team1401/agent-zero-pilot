IMPORTANT - Network mode: This container requires Host networking. MA discovers and streams to players over mDNS/uPnP, and protocols like AirPlay open random TCP/UDP ports, so it must sit on the same flat (layer 2) network as your players with no VLANs or firewall between them. Bridge networking only works if you exclusively use software-only players and is not supported by the MA team.

Local music files / Privileged Mode: to let MA see your own files, bind-mount your music folder rather than granting the container SMB/NFS mount privileges. Mounting the share on the host and passing it through is the more secure, recommended option. Only enable Privileged Mode if MA needs to mount a remote share itself from inside the container - most users don't need this, and it reduces container isolation.";s:4:"Icon";s:100:"https://raw.githubusercontent.com/alex3305/unraid-docker-templates/master/images/music-assistant.png";s:6:"Config";a:3:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App data";s:6:"Target";s:5:"/data";s:7:"Default";s:33:"/mnt/user/appdata/music-assistant";s:4:"Mode";s:2:"rw";s:11:"Description";s:59:"Persistent storage for the MA library database and settings";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/music-assistant";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/Music";s:4:"Mode";s:2:"ro";s:11:"Description";s:124:"Optional: mount your local music share here (read-only) so MA can index it. Only needed if you use the Local Files provider.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/Music";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:67:"Log verbosity level. One of: critical, error, warning, info, debug.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}}s:12:"TemplatePath";s:39:"/tmp/GitHub/AppFeed/music-assistant.xml";s:4:"Repo";s:21:"alex3305's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Music";i:1;s:17:"MediaServer-Music";}s:8:"Official";b:1;s:9:"FirstSeen";i:1708275951;s:14:"LastUpdateScan";i:17784692