"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:40:"Port to open PrintStash in your browser.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Max upload size";s:6:"Target";s:26:"NGINX_CLIENT_MAX_BODY_SIZE";s:7:"Default";s:4:"512m";s:4:"Mode";s:0:"";s:11:"Description";s:74:"nginx client_max_body_size. Match the API VAULT_MAX_UPLOAD_MB (e.g. 512m).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"512m";}}s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/templates/printstash-frontend.xml";s:4:"Repo";s:23:"printstash's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"CAComment";s:124:"This template is set up to use a custom network. You may have to adjust the network or IP address etc to match your system  ";s:9:"FirstSeen";i:1781726673;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:4954;s:11:"Displayable";b:1;s:6:"Author";s:13:"xiao-villamor";s:13:"DockerHubName";s:19:"printstash-frontend";s:8:"RepoName";s:23:"printstash's Repository";s:10:"SortAuthor";s:13:"xiao-villamor";s:8:"SortName";s:19:"PrintStash Frontend";s:6:"random";i:1942140924;s:9:"Blacklist";b:0;s:4:"Path";s:127:"/tmp/community.applications/tempFiles/templates-community-apps/printstashsRepository/xiaovillamor-PrintStashFrontend-latest.xml";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4955;a:38:{s:4:"Name";s:10:"PrintStash";s:10:"Repository";s:39:"ghcr.io/xiao-villamor/printstash:latest";s:8:"Registry";s:69:"https://github.com/xiao-villamor/PrintStash/pkgs/container/printstash";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/xiao-villamor/PrintStash/issues";s:7:"Project";s:26:"https://www.printstash.org";s:8:"Overview";s:678:"PrintStash is a self-hosted 3D print library and G-code vault. This image runs the web UI and API together. Create the first account in the browser from your local network, or set First-run setup to environment and fill in the administrator fields to create it at first start. The one appdata path stores everything PrintStash keeps: the database, uploaded files, thumbnails, staging files, backups, and caches. Add existing model folders as separate Library sources after setup; do not use an existing library as the appdata path. One image serves every server: to use a GPU, map your GPU device or enable the NVIDIA runtime under Advanced View; without one it runs on the CPU.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/xiao-villamor/PrintStash/main/templates/printstash.xml";s:4:"Icon";s:72:"https://raw.githubusercontent.com/xiao-villamor/PrintStash/main/icon.svg";s:6:"ReadMe";s:80:"https://raw.githubusercontent.com/xiao-villamor/PrintStash/main/unraid/README.md";s:16:"ExtraSearchTerms";s:222:"3d printer 3d printing model manager stl library 3mf gcode bgcode step stp obj cad file organizer self hosted docker nas klipper moonraker octoprint prusalink bambu elegoo spoolman orcaslicer prusaslicer cura print history";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:4:"Date";s:10:"2026-09-25";s:6:"MinVer";s:4:"6.10";s:7:"License";s:8:"AGPL-3.0";s:8:"Requires";s:872:"Choose how the first administrator is created with First-run setup. With trusted_network (the default), leave the administrator fields blank and open the WebUI from your local network (tower.local or the server's LAN IP) to register in the browser; the first person to register becomes administrator, and registration through Tailscale, a VPN, a reverse proxy or a domain is refused. With environment, fill in the administrator username and password and PrintStash creates that account at first start. If the two do not fit together, setup stays closed and the WebUI explains what to change. When moving from the old two-container install, record the old API data owner first, then stop both old containers. Set PUID and PGID to that same owner (the old image usually used 10001:10001); otherwise existing Library sources can become unreadable. Follow the migration guide.";s:6:"Config";a:17:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:40:"Port to open PrintStash in your browser.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:28:"/mnt/user/appdata/printstash";s:4:"Mode";s:2:"rw";s:11:"Description";s:300:"Dedicated persistent folder for everything PrintStash keeps: database, managed files, thumbnails, staging, backups, and caches. Keep it on one pool and add no second mapping for a subfolder of /data; imports then copy each file instead of using a hard-link. Do not map an existing model library here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/printstash";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"First-run setup";s:6:"Target";s:16:"VAULT_SETUP_MODE";s:7:"Default";s:27:"trusted_network|environment";s:4:"Mode";s:0:"";s:11:"Description";s:398:"How the first administrator is created. trusted_network: in the browser, only from your local network (for example http://tower.local:3000 or the server's LAN IP); leave the administrator fields blank. environment: at first start from the administrator fields below, which are then required; choose this if you will first open PrintStash through Tailscale, a VPN, a reverse proxy or Unraid Connect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"trusted_network";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Administrator username";s:6:"Target";s:26:"VAULT_SETUP_ADMIN_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:308:"Only with First-run setup set to environment: creates this administrator at first start; sign in with it and choose where files are stored. Leave blank with trusted_network, which creates the first administrator in the browser from your local network instead. Used once: it never changes an existing account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Administrator password";s:6:"Target";s:26:"VAULT_SETUP_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Only with First-run setup set to environment: 8 to 256 characters. Used once: editing it later does not change the account; reset it under Settings, Users instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Administrator email";s:6:"Target";s:23:"VAULT_SETUP_ADMIN_EMAIL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:85:"Optional, only with First-run setup set to environment: email for that administrator.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"User ID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:175:"Numeric owner for appdata and mounted Library sources. Default is Unraid's nobody user. On upgrade, use the old API data owner's UID to keep existing Library sources readable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Group ID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:175:"Numeric group for appdata and mounted Library sources. Default is Unraid's users group. On upgrade, use the old API data owner's GID to keep existing Library sources readable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"GPU: Intel or AMD render device";s:6:"Target";s:8:"/dev/dri";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:270:"Optional. Enter the host's /dev/dri to let PrintStash use an Intel or AMD GPU; leave empty for CPU only. The same image is used either way. For an NVIDIA GPU install the Nvidia Driver plugin, add --runtime=nvidia to Extra Parameters, and set the two NVIDIA fields below.";s:4:"Type";s:6:"Device";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"GPU: NVIDIA visible devices";s:6:"Target";s:22:"NVIDIA_VISIBLE_DEVICES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:160:"Optional, NVIDIA only (with --runtime=nvidia in Extra Parameters): the GPU UUID from the Nvidia Driver plugin, or all. Leave empty when not using an NVIDIA GPU.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"GPU: NVIDIA driver capabilities";s:6:"Target";s:26:"NVIDIA_DRIVER_CAPABILITIES";s:7:"Default";s:3:"all";s:4:"Mode";s:0:"";s:11:"Description";s:74:"NVIDIA only. Keep all: graphics and compute are both needed for rendering.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"all";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"GPU use";s:6:"Target";s:18:"VAULT_COMPUTE_MODE";s:7:"Default";s:8:"auto|cpu";s:4:"Mode";s:0:"";s:11:"Description";s:145:"auto uses a GPU when the container can see one and falls back to the CPU otherwise; cpu never uses it. Settings, GPU shows what PrintStash found.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"GPU render policy";s:6:"Target";s:27:"VAULT_COMPUTE_RENDER_POLICY";s:7:"Default";s:17:"qualified|preview";s:4:"Mode";s:0:"";s:11:"Description";s:190:"qualified places work on the GPU only where a measured qualification receipt exists, so a new GPU stays on the CPU. preview lets you try the GPU for thumbnails and judge the result yourself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"qualified";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"GPU memory budget (MiB)";s:6:"Target";s:23:"VAULT_COMPUTE_MEMORY_MB";s:7:"Default";s:4:"1024";s:4:"Mode";s:0:"";s:11:"Description";s:171:"The most GPU memory PrintStash may plan to use, from 256 to 65536. It is an upper bound for admission, not a reservation; keep it below what other apps need from the card.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1024";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"System memory budget: mesh work";s:6:"Target";s:33:"VAULT_MESH_MEMORY_BUDGET_FRACTION";s:7:"Default";s:3:"0.5";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Share of the server's RAM, from 0 to 1, that thumbnail and geometry work may reserve. Lower it on a small server that runs other containers; a dense model that does not fit is indexed without a preview instead of exhausting memory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"0.5";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"System memory budget: AI models";s:6:"Target";s:38:"VAULT_EMBEDDING_MEMORY_BUDGET_FRACTION";s:7:"Default";s:4:"0.25";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Share of the server's RAM, above 0 and below 1, that resident AI search models may hold. Applies when AI search is enabled.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"0.25";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Settings restart";s:6:"Target";s:21:"VAULT_RESTART_ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:64:"Allows Settings to restart the supervised application container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}}s:12:"TemplatePath";s:44:"/tmp/GitHub/AppFeed/templates/printstash.xml";s:4:"Repo";s:23:"printstash's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790252043;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:4955;s:11:"Displayable";b:1;s:6:"Author";s:13:"xiao-villamor";s:13:"DockerHubName";s:10:"printstash";s:8:"RepoName";s:23:"printstash's Repository";s:10:"SortAuthor";s:13:"xiao-villamor";s:8:"SortName";s:10:"PrintStash";s:6:"random";i:225230285;s:9:"Blacklist";b:0;s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/printstashsRepository/xiaovillamor-PrintStash-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4956;a:43:{s:4:"Name";s:8:"PlexIPTV";s:10:"Repository";s:28:"xiaodoudoufr/plexiptv:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/xiaodoudoufr/plexiptv";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:45:"https://github.com/xiaodoudou/PlexIPTV/issues";s:7:"Project";s:38:"https://github.com/xiaodoudou/PlexIPTV";s:6:"ReadMe";s:65:"https://github.com/xiaodoudou/PlexIPTV/blob/master/docs/docker.md";s:8:"Overview";s:745:"Makes an IPTV subscription show up as live TV in Plex, by pretending to be an HDHomeRun tuner. Give it an m3u playlist URL or an Xtream account, or several of each, and it filters, renames and numbers the channels, proxies the streams so your provider only ever sees one viewer, and serves an XMLTV guide with your channel logos. ffmpeg is included, for RTSP channels and HLS with fragmented MP4 segments. The first start writes settings.json into the config folder and prints a dashboard password in the container log, so open the log first. Put your provider in settings.json, restart the container, then add an HDHomeRun tuner in Plex at your server's address and port 1234. Apart from the dashboard there is no login, so keep it on your LAN.";s:5:"WebUI";s:33:"http://[IP]:[PORT:1234]/dashboard";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/xiaodoudou/unraid-templates/main/PlexIPTV/PlexIPTV.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/xiaodoudou/unraid-templates/main/PlexIPTV/icon.png";s:16:"ExtraSearchTerms";s:58:"iptv m3u xtream hdhomerun tuner live tv dvr epg xmltv plex";s:8:"Requires";s:89:"An IPTV subscription: a playlist URL, or an Xtream server address, username and password.";s:7:"License";s:10:"Apache-2.0";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Tuner and dashboard";s:6:"Target";s:4:"1234";s:7:"Default";s:4:"1234";s:4:"Mode";s:3:"tcp";s:11:"Description";s:137:"Plex reaches the tuner on this port, and the dashboard is at /dashboard on it. If you change it, add the tuner in Plex with the new port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1234";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:20:"/opt/PlexIPTV/config";s:7:"Default";s:26:"/mnt/user/appdata/plexiptv";s:4:"Mode";s:2:"rw";s:11:"Description";s:102:"settings.json, where your provider goes, and the cached playlist. Both are written on the first start.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/plexiptv";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:131:"User PlexIPTV runs as. 99 is nobody, the usual owner of appdata. The container hands the config folder to this user when it starts.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:37:"Group PlexIPTV runs as. 100 is users.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"Log folder";s:6:"Target";s:15:"PLEXIPTV_LOGDIR";s:7:"Default";s:25:"/opt/PlexIPTV/config/logs";s:11:"Description";s:76:"Where logs.txt is written. Inside the config folder, so it survives updates.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/opt/PlexIPTV/config/logs";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/PlexIPTV/PlexIPTV.xml";s:4:"Repo";s:23:"Xiaodoudou's Repository";s:12:"CategoryList";a:3:{i:0;s:14:"MediaApp-Video";i:1;s:17:"MediaServer-Video";i:2;s:13:"Network-Proxy";}s:16:"ChangeLogPresent";s:1:"1";s:5:"stars";i:4;s:9:"downloads";i:215645;s:9:"FirstSeen";i:1792354556;s:10:"LastUpdate";i:1792303017;s:14:"LastUpdateScan";i:1792354556;s:8:"Category";s:46:"MediaApp:Video MediaServer:Video Network:Proxy";s:2:"ID";i:4956;s:11:"Displayable";b:1;s:6:"Author";s:12:"xiaodoudoufr";s:13:"DockerHubName";s:8:"plexiptv";s:8:"RepoName";s:23:"Xiaodoudou's Repository";s:10:"SortAuthor";s:12:"xiaodoudoufr";s:8:"SortName";s:8:"PlexIPTV";s:6:"random";i:263017292;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/XiaodoudousRepository/xiaodoudoufr-PlexIPTV-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4957;a:43:{s:4:"Name";s:8:"SyncYomi";s:10:"Repository";s:32:"ghcr.io/syncyomi/syncyomi:latest";s:8:"Registry";s:60:"https://github.com/SyncYomi/SyncYomi/pkgs/container/syncyomi";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/SyncYomi/SyncYomi/issues";s:7:"Project";s:36:"https://github.com/SyncYomi/SyncYomi";s:6:"ReadMe";s:43:"https://github.com/SyncYomi/SyncYomi#readme";s:8:"Overview";s:507:"Keeps your manga library and reading progress in sync between devices running TachiyomiSY or Komikku. Each device uploads its library to this server and downloads what the others changed, and the server keeps the last few versions so a bad sync can be rolled back from the web UI. The first start writes config.toml and a SQLite database into the config folder. Open the web UI, create an account, then create an API key under Settings, API Keys. Give every device the same key: each key is its own library.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8282]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/xiaodoudou/unraid-templates/main/SyncYomi/SyncYomi.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/SyncYomi/SyncYomi/develop/.github/images/logo.png";s:16:"ExtraSearchTerms";s:64:"tachiyomi tachiyomisy komikku manga sync backup reading progress";s:8:"Requires";s:55:"TachiyomiSY or Komikku on each device you want to sync.";s:7:"License";s:7:"GPL-2.0";s:6:"Config";a:2:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Web UI and sync";s:6:"Target";s:4:"8282";s:7:"Default";s:4:"8282";s:4:"Mode";s:3:"tcp";s:11:"Description";s:103:"The web UI, and the address your devices sync with. If you change it, use the new port in the apps too.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8282";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:26:"/mnt/user/appdata/syncyomi";s:4:"Mode";s:2:"rw";s:11:"Description";s:191:"config.toml and the SQLite database holding every synced library. Back this folder up. Keep it on a cache or other local disk: SQLite needs WAL mode, which some network shares cannot provide.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/syncyomi";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/SyncYomi/SyncYomi.xml";s:4:"Repo";s:23:"Xiaodoudou's Repository";s:12:"CategoryList";a:3:{i:0;s:6:"Backup";i:1;s:17:"MediaServer-Books";i:2;s:15:"Tools-Utilities";}s:8:"Official";b:1;s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1700321420;s:14:"LastUpdateScan";i:1778325284;s:8:"Category";s:41:"Backup: MediaServer:Books Tools:Utilities";s:2:"ID";i:4957;s:11:"Displayable";b:1;s:6:"Author";s:8:"syncyomi";s:13:"DockerHubName";s:8:"syncyomi";s:8:"RepoName";s:23:"Xiaodoudou's Repository";s:10:"SortAuthor";s:8:"syncyomi";s:8:"SortName";s:8:"SyncYomi";s:6:"random";i:1771350396;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/XiaodoudousRepository/syncyomi-SyncYomi-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4958;a:44:{s:4:"Name";s:11:"homelabdash";s:10:"Repository";s:31:"xiaodoudoufr/homelabdash:latest";s:8:"Registry";s:49:"https://hub.docker.com/r/xiaodoudoufr/homelabdash";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/xiaodoudou/homelabdash/issues";s:7:"Project";s:41:"https://github.com/xiaodoudou/homelabdash";s:6:"ReadMe";s:48:"https://github.com/xiaodoudou/homelabdash#readme";s:8:"Overview";s:536:"A self-hosted dashboard for your homelab, configured in one YAML file. Edit /config/homelabdash.yaml and the page follows every save; the first start writes a starter file to begin from. Tiles update live, can graph their last hour, and raise alerts you can dismiss. 16 plugins come built in, among them Tautulli, the arrs, Seerr, qBittorrent, SABnzbd, Docker, Unraid, apcupsd, AdGuard Home and OpenWrt, and you can write your own. There is no login by default, so keep it on your LAN or put it behind a reverse proxy that signs you in.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/xiaodoudou/unraid-templates/main/homelabdash/homelabdash.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/xiaodoudou/unraid-templates/main/homelabdash/icon.png";s:11:"ExtraParams";s:29:"--user 99:100 --group-add 281";s:16:"ExtraSearchTerms";s:54:"dashboard homepage homelab startpage status monitoring";s:8:"Requires";s:184:"Only the docker plugin needs the Docker socket. Extra Parameters adds the container to group 281; if stat -c %g /var/run/docker.sock prints another number on your server, use that one.";s:7:"License";s:10:"Apache-2.0";s:10:"Screenshot";a:3:{i:0;s:88:"https://raw.githubusercontent.com/xiaodoudou/homelabdash/main/docs/ui/dashboard-dark.png";i:1;s:89:"https://raw.githubusercontent.com/xiaodoudou/homelabdash/main/docs/ui/dashboard-light.png";i:2;s:84:"https://raw.githubusercontent.com/xiaodoudou/homelabdash/main/docs/ui/phone-dark.png";}s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Web UI";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:22:"Port of the dashboard.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:29:"/mnt/user/appdata/homelabdash";s:4:"Mode";s:2:"rw";s:11:"Description";s:90:"What you edit: homelabdash.yaml, secrets.yaml, and your own plugins, icons and custom.css.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/homelabdash";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:34:"/mnt/user/appdata/homelabdash/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:97:"What the dashboard writes itself: dismissed alerts, plugin state, graph history and cached icons.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:34:"/mnt/user/appdata/homelabdash/data";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"ro";s:11:"Description";s:66:"Only needed by the docker plugin, for container status and events.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/var/run/docker.sock";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:11:"Description";s:64:"Time zone for the clock and job schedules, such as Europe/Paris.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}}s:12:"TemplatePath";s:47:"/tmp/GitHub/AppFeed/homelabdash/homelabdash.xml";s:4:"Repo";s:23:"Xiaodoudou's Repository";s:12:"CategoryList";a:3:{i:0;s:15:"Tools-Utilities";i:1;s:12:"Tools-System";i:2;s:12:"Productivity";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:156;s:9:"FirstSeen";i:1791953108;s:10:"LastUpdate";i:1791936126;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:42:"Tools:Utilities Tools:System Productivity:";s:2:"ID";i:4958;s:11:"Displayable";b:1;s:6:"Author";s:12:"xiaodoudoufr";s:13:"DockerHubName";s:11:"homelabdash";s:8:"RepoName";s:23:"Xiaod