ccoli-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:-27.968;s:12:"trendAverage";d:24.5254;s:10:"DonateText";s:19:"Support me on Ko-fi";s:10:"DonateLink";s:27:"https://ko-fi.com/ohitsjudd";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2759;a:48:{s:4:"Name";s:29:"RunescapeDragonwilds-broccoli";s:10:"Repository";s:62:"indifferentbroccoli/runescape-dragonwilds-server-docker:latest";s:8:"Registry";s:80:"https://hub.docker.com/r/indifferentbroccoli/runescape-dragonwilds-server-docker";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:53:"https://github.com/juddisjudd/unraid-templates/issues";s:7:"Project";s:34:"https://dragonwilds.runescape.com/";s:6:"ReadMe";s:81:"https://github.com/indifferentbroccoli/runescape-dragonwilds-server-docker#readme";s:8:"Overview";s:460:"A dedicated server for RuneScape: DragonWilds. The server files are downloaded with DepotDownloader on first start.

Before you start: set OWNER_ID to your Player ID (at the bottom of the in-game Settings menu) and set ADMIN_PASSWORD. The server does not start without OWNER_ID.

Forward UDP port 7777 on your router. The host port and the container port must be the same. If you change the port, also change DEFAULT_PORT.

