ault";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:70:"UID for permissions.  Do not change unless you know what you're doing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:70:"GID for permissions.  Do not change unless you know what you're doing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:33:"/tmp/GitHub/AppFeed/borgmatic.xml";s:4:"Repo";s:17:"sdub's Repository";s:12:"CategoryList";a:1:{i:0;s:6:"Backup";}s:9:"FirstSeen";i:1676660881;s:14:"LastUpdateScan";i:1776568455;s:8:"Category";s:7:"Backup:";s:2:"ID";i:1139;s:11:"Displayable";b:1;s:6:"Author";s:20:"borgmatic-collective";s:13:"DockerHubName";s:9:"borgmatic";s:8:"RepoName";s:17:"sdub's Repository";s:10:"SortAuthor";s:20:"borgmatic-collective";s:8:"SortName";s:9:"borgmatic";s:6:"random";i:1690177462;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/sdubsRepository/borgmaticcollective-borgmatic-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:45:"If you like my work please consider Donating.";s:10:"DonateLink";s:27:"https://paypal.me/ScottWaun";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1140;a:35:{s:4:"Name";s:8:"Palisade";s:10:"Repository";s:32:"ghcr.io/shakes63/palisade:latest";s:8:"Registry";s:60:"https://github.com/Shakes63/palisade/pkgs/container/palisade";s:7:"Network";s:12:"palisade-net";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/Shakes63/palisade/issues";s:7:"Project";s:36:"https://github.com/Shakes63/palisade";s:8:"Overview";s:549:"Palisade - a web control panel for game dedicated servers (ARK ASA/ASE, Conan,
    Palworld, Minecraft Java + Bedrock, Icarus, Valheim, 7 Days to Die, Enshrouded, Project Zomboid, V Rising, Sons of the Forest, Satisfactory, Life is Feudal: Your Own, American + Euro Truck Simulator, Core Keeper, Terraria, Factorio, Rust, BeamNG.drive, OpenTTD).
    Manages every setting, mods, backups, schedules, players, and port-forwards, and
    spawns one container per game server. Controls Docker through the host socket
    mounted at /var/run/docker.sock.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:4:"Icon";s:81:"https://raw.githubusercontent.com/Shakes63/palisade/main/unraid/palisade-icon.png";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/Shakes63/unraid-community-apps/main/templates/palisade.xml";s:11:"ExtraParams";s:44:"--add-host host.docker.internal:host-gateway";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:6:"Web UI";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"8970";s:4:"Mode";s:3:"tcp";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:209:"Port for the web control panel. Open http://your-server-ip:this-port in a browser (the WebUI button uses it too). It maps to the app's internal port 3000 - only change this host number if it is already in use.";}s:5:"value";s:4:"8970";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"App data";s:6:"Target";s:5:"/data";s:7:"Default";s:27:"/mnt/cache/appdata/palisade";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:518:"Where the manager keeps everything: its database, your settings, and every game server's installed files and saves. Use a path on /mnt/cache (a real disk), not /mnt/user (the FUSE share), so the large game-file cache can reflink-clone between servers. Installs made before this release use /mnt/cache/appdata/ark-manager. Keeping that path is fine and nothing needs to move. If you deleted the container and reinstalled it, and Palisade now looks empty, set this field back to your old folder. The data is still there.";}s:5:"value";s:27:"/mnt/cache/appdata/palisade";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Docker socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:11:"Description";s:130:"Lets the manager create, start, stop and monitor the game-server containers - it controls Docker through this socket. Leave as-is.";}s:5:"value";s:20:"/var/run/docker.sock";}i:3;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:15:"PUBLIC_BASE_URL";s:6:"Target";s:15:"PUBLIC_BASE_URL";s:7:"Default";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:11:"Description";s:232:"The address you actually reach the manager at, e.g. http://10.10.10.10:8970. Used for links and for each game server's WebUI button on the Unraid Docker page. Also settable later in Settings - General, where it overrides this field.";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"SECRETS_KEY";s:6:"Target";s:11:"SECRETS_KEY";s:7:"Default";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";s:11:"Description";s:387:"Optional. LEAVE BLANK and the manager generates a strong key on first start and saves it in App data, so it stays stable across restarts - nothing to do. Only set one yourself (openssl rand -hex 32, 64 hex chars) if you want to control it or reuse an App-data folder from another install. It encrypts saved passwords, so if it ever changes, previously saved passwords can't be decrypted.";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"JWT_SECRET";s:6:"Target";s:10:"JWT_SECRET";s:7:"Default";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";s:11:"Description";s:230:"Optional. LEAVE BLANK - the manager generates and persists one on first start. It signs your login session tokens; changing it just logs everyone out (no data loss). Only set one (openssl rand -hex 24) if you specifically want to.";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:17:"GAME_HOST_NETWORK";s:6:"Target";s:17:"GAME_HOST_NETWORK";s:7:"Default";s:4:"true";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:11:"Description";s:305:"Run game servers directly on the host network instead of a Docker bridge. true (recommended) gives more reliable ASA/EOS public server listing; false puts them on the palisade-net bridge. This is the starting value only - change it later in Settings - General, or per server on that server's General card.";}s:5:"value";s:4:"true";}i:7;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:11:"DOCKER_HOST";s:6:"Target";s:11:"DOCKER_HOST";s:7:"Default";s:27:"unix:///var/run/docker.sock";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:211:"How the manager connects to Docker. unix:///var/run/docker.sock uses the socket mounted above. Only change this if you front Docker with a least-privilege socket-proxy, in which case use tcp://socket-proxy:2375.";}s:5:"value";s:27:"unix:///var/run/docker.sock";}i:8;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:19:"AUTO_CREATE_NETWORK";s:6:"Target";s:19:"AUTO_CREATE_NETWORK";s:7:"Default";s:4:"true";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:453:"Let Palisade manage its Docker network by itself: create it when a game server needs it, attach this container to it when it isn't already, and let go of the old 'ark-net' network once no server uses it. true (recommended) means there is nothing to set up by hand - including on a custom network, where Palisade keeps its own IP and just adds a route to the game servers. Set false to manage networks yourself. Also settable later in Settings - General.";}s:5:"value";s:4:"true";}i:9;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:14:"SHARED_NETWORK";s:6:"Target";s:14:"SHARED_NETWORK";s:7:"Default";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:388:"Optional. LEAVE BLANK. Name of the Docker network the manager and its game servers share; blank means 'palisade-net'. That name matters on Unraid: a container's WebUI link is built from the first of its networks sorted by name, so a network sorting before br0 would take the link with it. Installs made before v1.11 used 'ark-net' and move across on their own as each server is restarted.";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:13:"HOST_DATA_DIR";s:6:"Target";s:13:"HOST_DATA_DIR";s:7:"Default";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:371:"Optional. LEAVE BLANK - the manager auto-detects the host-side path of App data from its own /data mount on start. It only needs this to bind-mount data into the game-server containers it spawns. Set it manually only if auto-detection fails (check the log), in which case use the exact App data path above - or fix it in Settings - General without editing this container.";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:130:"User ID the manager owns its files as. Unraid's default is 99 (the nobody user). Leave as-is unless you specifically need another.";}s:5:"value";s:2:"99";}i:12;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:84:"Group ID for file ownership. Unraid's default is 100 (the users group). Leave as-is.";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/palisade.xml";s:4:"Repo";s:22:"shakes_63's Repository";s:12:"CategoryList";a:2:{i:0;s:11:"GameServers";i:1;s:15:"Tools-Utilities";}s:9:"CAComment";s:124:"This template is set up to use a custom network. You may have to adjust the network or IP address etc to match your system  ";s:9:"FirstSeen";i:1783613081;s:8:"Category";s:28:"GameServers: Tools:Utilities";s:2:"ID";i:1140;s:11:"Displayable";b:1;s:6:"Author";s:8:"shakes63";s:13:"DockerHubName";s:8:"palisade";s:8:"RepoName";s:22:"shakes_63's Repository";s:10:"SortAuthor";s:8:"shakes63";s:8:"SortName";s:8:"Palisade";s:6:"random";i:491732981;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:111:"/tmp/community.applications/tempFiles/templates-community-apps/shakes63sRepository/shakes63-Palisade-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1141;a:49:{s:4:"Name";s:9:"Fireshare";s:10:"Repository";s:28:"shaneisrael/fireshare:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/shaneisrael/fireshare";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:57:"https://forums.unraid.net/topic/124036-support-fireshare/";s:7:"Project";s:42:"https://github.com/fireshare-app/fireshare";s:8:"Overview";s:715:"Fireshare allows you to easily share your media whether that be game clips, screen records, or movies through a unique publically accessible link. 

default username/password: **admin / admin**

Add "--gpus=all" to the Extra Parameters field if you have a valid GPU for transcoding (see transcoding setup docs on the github page)

This software is currently being actively developed on. If you have feature ideas or suggestions please visit the GitHub project.

