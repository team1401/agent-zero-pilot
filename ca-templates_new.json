equired. Komga is optional.";s:16:"ExtraSearchTerms";s:60:"comic comics comic books Mylar Mylar3 Komga request requests";s:11:"ExtraParams";s:74:"--read-only --restart=unless-stopped --security-opt=no-new-privileges:true";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:81:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/unraid/inkwell.xml";s:10:"Screenshot";a:6:{i:0;s:100:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/discover-desktop.png";i:1;s:98:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/browse-desktop.png";i:2;s:105:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/volume-request-detail.png";i:3;s:104:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/settings-connections.png";i:4;s:97:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/browse-mobile.png";i:5;s:99:"https://raw.githubusercontent.com/WhoIsCalebBrown/inkwell/main/docs/screenshots/first-run-setup.png";}s:6:"Config";a:21:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3013";s:4:"Mode";s:3:"tcp";s:11:"Description";s:86:"Trusted-LAN HTTP port. For remote access, put Inkwell behind HTTPS and authentication.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3013";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"AppData";s:6:"Target";s:7:"/config";s:7:"Default";s:25:"/mnt/user/appdata/inkwell";s:4:"Mode";s:2:"rw";s:11:"Description";s:388:"Required Inkwell application data: SQLite, setup state, covers, and migration backups. Kept on the host, so it survives container updates and replacement. Use local Unraid appdata, never an SMB/NFS share. If your appdata lives on a pool, prefer the direct pool path (/mnt/cache/appdata/inkwell) over /mnt/user: the user share goes through shfs, and SQLite and FUSE are a poor combination.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/inkwell";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Mylar AppData";s:6:"Target";s:10:"/run/mylar";s:7:"Default";s:24:"/mnt/user/appdata/mylar3";s:4:"Mode";s:2:"ro";s:11:"Description";s:117:"Required Mylar appdata directory containing config.ini and mylar.db. Read-only; this is not your comics/media folder.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/mylar3";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Mylar API URL";s:6:"Target";s:9:"MYLAR_URL";s:7:"Default";s:20:"http://[IP]:8090/api";s:4:"Mode";s:0:"";s:11:"Description";s:159:"Required address Inkwell can use to reach Mylar, including /api. Use a LAN address or Docker service name, not 127.0.0.1 unless both share a network namespace.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"http://[IP]:8090/api";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:56:"User ID that owns Inkwell /config. Unraid default is 99.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:58:"Group ID that owns Inkwell /config. Unraid default is 100.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"002";s:4:"Mode";s:0:"";s:11:"Description";s:46:"Permissions mask for files created in /config.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"002";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Shared username";s:6:"Target";s:12:"INKWELL_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:74:"Optional shared HTTP Basic username. Recommended with remote/proxy access.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Shared password";s:6:"Target";s:16:"INKWELL_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:117:"Optional shared HTTP Basic password. In multi-user mode this is an extra outer gate and never grants an Inkwell role.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Access mode";s:6:"Target";s:19:"INKWELL_ACCESS_MODE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:253:"auto opens browser administrator setup on a fresh install and preserves existing access. Settings → Access enables accounts in the app. multi opens account setup; single applies only until accounts exist. Personal/Friends choices are saved in /config.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Allow account login over HTTP";s:6:"Target";s:18:"INKWELL_ALLOW_HTTP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:110:"Only set to 1 on a private LAN if you deliberately accept unencrypted passwords. Use HTTPS for remote friends.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Mylar web URL";s:6:"Target";s:13:"MYLAR_WEB_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:168:"Optional address for Mylar's web interface when it differs from the API URL without /api. Used for the download queue, its controls, and administrator request settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Komga URL";s:6:"Target";s:9:"KOMGA_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:83:"Optional. Lets Inkwell show when a requested title arrived in your reading library.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Komga username";s:6:"Target";s:10:"KOMGA_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:69:"Optional direct Komga login when no read-only Komf config is mounted.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Komga password";s:6:"Target";s:14:"KOMGA_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:31:"Optional direct Komga password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Komf config path";s:6:"Target";s:12:"KOMGA_CONFIG";s:7:"Default";s:25:"/run/komf/application.yml";s:4:"Mode";s:0:"";s:11:"Description";s:185:"Where Inkwell looks inside the container for the Komf config mapped below. Leave at the default. If nothing is mapped there, Inkwell falls back to the Komga username and password above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/run/komf/application.yml";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Komf config";s:6:"Target";s:25:"/run/komf/applicati