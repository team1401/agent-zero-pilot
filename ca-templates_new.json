tName";s:24:"CUPS Virtual PDF Printer";s:6:"random";i:1992611843;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/fxqqsRepository/fxqq-CUPSVirtualPDFPrinter-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2129;a:38:{s:4:"Name";s:8:"Home-Ops";s:10:"Repository";s:32:"ghcr.io/g0browns/home-ops:latest";s:8:"Registry";s:33:"https://ghcr.io/g0browns/home-ops";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:72:"https://raw.githubusercontent.com/g0browns/home-ops-unraid/main/icon.svg";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:2026:"Home Ops is a self-hosted household management system: chores, a shared calendar, recipes and meal planning, groceries, contacts, notes and health records — one private application on hardware you own. No cloud account, no API key, no telemetry.
    
    It is built for a household rather than a company, which shows up in one place above all: members have different levels of trust. Every record carries its own visibility — private, shared with named people, or the whole household — and there is no administrator override on any of it. Every member also owns a colour that follows them into every list.
    
    Modules: Tasks (assignments, categories, priorities, subtasks, recurring chores) · Notes (a shared noticeboard with tags and pinning) · Calendar (month and agenda views, RFC 5545 recurrence, drag to move) · Kitchen (recipes with structured ingredients, import from a web page or a Mealie backup, meal planning) · Shopping (many lists, per-list visibility, generated from the meal plan) · Contacts (vCard import and export) · Health (vitals, medications, lab results, activity).
    
    Everything runs in this single container — FastAPI, nginx and PostgreSQL 16 together under s6-overlay — with one appdata path and one port. The first page you open is a setup wizard; whoever completes it becomes the administrator, and that page stops existing once a user exists.
    
    [b]Before you start:[/b] set POSTGRES_PASSWORD, and leave RUN_MIGRATIONS set to true so the database schema is created on first boot. Add your server's LAN address to APP_HOSTS and set WEB_PORT to the [i]host[/i] port you mapped, or the browser will be refused when it tries to log in.
    
    [b]Appdata:[/b] the container path /data holds the PostgreSQL cluster and the uploaded recipe images together. Point it at a share that lives on the cache pool (not a fuse/shfs path that can move to the array) — PostgreSQL is not happy on /mnt/user. Back up that one directory and you have backed up everything.";s:7:"Project";s:36:"https://github.com/g0browns/Home-ops";s:7:"Support";s:43:"https://github.com/g0browns/Home-ops/issues";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/g0browns/home-ops-unraid/main/templates/home-ops.xml";s:6:"ReadMe";s:66:"https://raw.githubusercontent.com/g0browns/Home-ops/main/README.md";s:16:"ExtraSearchTerms";s:108:"household family chores tasks calendar recipes meal planning shopping list contacts notes health self-hosted";s:8:"Requires";s:231:"Set POSTGRES_PASSWORD before the first start — PostgreSQL bakes it into the data directory on first boot and changing it afterwards does not change the user. Put the appdata path on a cache pool rather than a /mnt/user fuse path.";s:4:"Date";s:10:"2026-08-13";s:6:"MinVer";s:3:"6.1";s:7:"License";s:3:"MIT";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:138:"Host port for the web interface. The container always listens on 8080. If you change the host port, set WEB_PORT below to the same number.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/home-ops";s:4:"Mode";s:2:"rw";s:11:"Description";s:326:"Everything persistent: the PostgreSQL cluster (/data/postgres) and uploaded recipe images (/data/uploads). Put this on a cache pool — e.g. /mnt/cache/appdata/home-ops — rather than a /mnt/user fuse path, which PostgreSQL does not tolerate well. A database dump alone is NOT a complete backup; back up this whole directory.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/home-ops";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"POSTGRES_PASSWORD";s:6:"Target";s:17:"POSTGRES_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:237:"Password for the bundled database. SET THIS BEFORE THE FIRST START: PostgreSQL bakes it into the data directory on first boot, and changing it later does not re-create the user. Any characters are fine; it is escaped wherever it is used.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"RUN_MIGRATIONS";s:6:"Target";s:14:"RUN_MIGRATIONS";s:7:"Default";s:4:"true";s:11:"Description";s:237:"Apply database migrations on start. Leave this true. With it off the app starts but has no tables, and the first page fails. Turn it off only if you prefer to run 'home-ops-migrate' by hand from the container console before each upgrade.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"APP_HOSTS";s:6:"Target";s:9:"APP_HOSTS";s:7:"Default";s:9:"localhost";s:11:"Description";s:319:"Every hostname and IP you will open the app on over plain HTTP — your Unraid server's LAN address, a Tailscale name, and so on. NAMES ONLY: no scheme, no port, comma separated. Each becomes an allowed origin on WEB_PORT, which is what lets a browser at that address log in. Example: localhost,192.168.1.10,tower.local";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"localhost";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"WEB_PORT";s:6:"Target";s:8:"WEB_PORT";s:7:"Default";s:4:"8080";s:11:"Description";s:215:"The HOST port you mapped above. It is not used to bind anything — it is used to build the allowed browser origins from APP_HOSTS. If this does not match the port in your address bar, sign-in fails on that address.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:3:"UTC";s:11:"Description";s:171:"IANA timezone name, e.g. Europe/London or America/New_York. Used for log timestamps and scheduling. Never an offset like +01:00 — offsets cannot survive daylight saving.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"UTC";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"PUBLIC_BASE_URL";s:6:"Target";s:15:"PUBLIC_BASE_URL";s:7:"Default";s:0:"";s:11:"Description";s:221:"Your HTTPS address, if you put the app behind a reverse proxy or a Cloudflare Tunnel, e.g. https://home.example.com. It becomes an allowed origin and is used for links that leave the app. Leave blank if you have no proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"SESSION_COOKIE_SECURE";s:6:"Target";s:21:"SESSION_COOKIE_SECURE";s:7:"Default";s:5:"false";s:11:"Description";s:181:"Mark the session cookie Secure. Keep this false unless EVERY path to the app is HTTPS — a Secure cookie is silently dropped over plain HTTP, which would lock out your LAN address.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"SETUP_ALLOW_TUNNEL_PATH";s:6:"Target";s:23:"SETUP_ALLOW_TUNNEL_PATH";s:7:"Default";s:5:"false";s:11:"Description";s:280:"Whether the first-run setup wizard may be completed over the public HTTPS path. While no user exists that page is unauthenticated by nature — whoever reaches it first becomes the administrator — so it is restricted to the LAN by default. It has no effect once any user exists.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"LOG_LEVEL";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"INFO";s:11:"Description";s:40:"CRITICAL, ERROR, WARNING, INFO or DEBUG.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"INFO";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"UPLOAD_MAX_BYTES";s:6:"Target";s:16:"UPLOAD_MAX_BYTES";s:7:"Default";s:8:"10485760";s:11:"Description";s:82:"Largest single image upload accepted, in bytes, before decoding. Default is 10 MB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"10485760";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"APP_ENV";s:6:"Target";s:7:"APP_ENV";s:7:"Default";s:10:"production";s:11:"Description";s:90:"Leave as production. 'development' enables the /api/docs page and verbose error responses.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"production";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"TRUSTED_PROXY_IPS";s:6:"Target";s:17:"TRUSTED_PROXY_IPS";s:7:"Default";s:12:"127.0.0.1/32";s:11:"Description";s:208:"Peers whose X-Forwarded-For / X-Real-IP headers are honoured. nginx and the API talk over loopback inside this container, so 127.0.0.1/32 is the whole list. Empty means client IPs are all logged as 127.0.0.1.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"127.0.0.1/32";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"DATABASE_URL";s:6:"Target";s:12:"DATABASE_URL";s:7:"Default";s:0:"";s:11:"Description";s:257:"Leave blank to use the PostgreSQL bundled in this container. Set it only to point at a PostgreSQL 16 server you run elsewhere (postgresql+psycopg://user:pass@host:5432/home_ops); the bundled one then simply goes unused. Percent-encode any @ in the password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"HEALTHCHECK_TOKEN";s:6:"Target";s:17:"HEALTHCHECK_TOKEN";s:7:"Default";s:0:"";s:11:"Description";s:200:"When set, GET /api/health/ready requires a matching X-Healthcheck-Token header. Leave blank on a private network. The plain /api/health liveness endpoint stays public either way and discloses nothing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/home-ops.xml";s:4:"Repo";s:20:"gobrowns' Repository";s:12:"CategoryList";a:3:{i:0;s:12:"Productivity";i:1;s:14:"HomeAutomation";i:2;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1786651497;s:8:"Category";s:45:"Productivity: HomeAutomation: Tools:Utilities";s:2:"ID";i:2129;s:11:"Displayable";b:1;s:6:"Author";s:8:"g0browns";s:13:"DockerHubName";s:8:"home-ops";s:8:"RepoName";s:20:"gobrowns' Repository";s:10:"SortAuthor";s:8:"g0browns";s:8:"SortName";s:8:"Home Ops";s:6:"random";i:1142150855;s:9:"Blacklist";b:0;s:4:"Path";s:109:"/tmp/community.applications/tempFiles/templates-community-apps/gobrownsRepository/g0browns-HomeOps-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2130;a:38:{s:4:"Name";s:8:"Indexarr";s:10:"Repository";s:24:"gabryk83/indexarr:latest";s:8:"Registry";s:23:"https://hub.docker.com/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/gabryk91/Indexarr/issues";s:7:"Project";s:36:"https://github.com/gabryk91/Indexarr";s: