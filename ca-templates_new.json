n";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:28:"Timezone for log timestamps.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}}s:12:"TemplatePath";s:62:"/tmp/GitHub/AppFeed/templates/lansweeper-network-discovery.xml";s:4:"Repo";s:27:"007Darkmatter5's Repository";s:12:"CategoryList";a:2:{i:0;s:18:"Network-Management";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790266484;s:8:"Category";s:34:"Network:Management Tools:Utilities";s:2:"ID";i:0;s:11:"Displayable";b:1;s:6:"Author";s:14:"007darkmatter5";s:13:"DockerHubName";s:28:"lansweeper-network-discovery";s:8:"RepoName";s:27:"007Darkmatter5's Repository";s:10:"SortAuthor";s:14:"007darkmatter5";s:8:"SortName";s:28:"Lansweeper Network Discovery";s:6:"random";i:1347626454;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:141:"/tmp/community.applications/tempFiles/templates-community-apps/007Darkmatter5sRepository/007darkmatter5-LansweeperNetworkDiscovery-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1;a:38:{s:4:"Name";s:8:"Ledgerly";s:10:"Repository";s:42:"ghcr.io/007darkmatter5/ledgerly:production";s:8:"Registry";s:66:"https://github.com/007darkmatter5/ledgerly/pkgs/container/ledgerly";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:49:"https://github.com/007darkmatter5/ledgerly/issues";s:7:"Project";s:42:"https://github.com/007darkmatter5/ledgerly";s:6:"ReadMe";s:49:"https://github.com/007darkmatter5/ledgerly#unraid";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/007darkmatter5/unraid-templates/main/templates/ledgerly.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/007darkmatter5/ledgerly/main/docs/images/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:8:"Overview";s:1596:"Ledgerly is a self-hosted personal finance app. Track bills with expected and "up to" amounts, due dates and the account each one is paid from, on a list or a calendar, and mark them paid to build a payment history. Log one-off purchases and refunds as transactions in a couple of taps. See the projected running balance of your accounts and when they would dip low or go negative, with income, recurring transfers between your own accounts, and transactions included.

Credit cards are handled as revolving balances: statements, everyday spending, interest and payments (in full, minimum or a fixed amount) are projected forward. Loans get full amortization tables, including extra principal payments. Organize with payees (with links to their websites) and color-coded categories.

Multiple people can use one install, and each user's data is private unless they choose to share it: share your ledger with someone else on the install, view only, and they can switch it on to see it alongside their own, marked in its own color. Sign-ins support two-factor authentication. The first account you create becomes the admin, who can close sign-ups, set up email for password resets, and download or restore a backup of the whole install. Sample data can be explored and deleted without touching your own.

Everything is stored in the appdata folders below. Keep the keys folder with the data folder: it holds the encryption keys for sign-ins and the saved email password. To reach Ledgerly from outside your network, put it behind a reverse proxy with HTTPS and set "Behind a reverse proxy" to true.";s:16:"ExtraSearchTerms";s:105:"finance budget bills money loans amortization mortgage expenses credit card transactions shared household";s:7:"License";s:3:"MIT";s:10:"Screenshot";a:4:{i:0;s:100:"https://raw.githubusercontent.com/007darkmatter5/ledgerly/main/docs/images/screenshots/dashboard.png";i:1;s:106:"https://raw.githubusercontent.com/007darkmatter5/ledgerly/main/docs/images/screenshots/running-balance.png";i:2;s:96:"https://raw.githubusercontent.com/007darkmatter5/ledgerly/main/docs/images/screenshots/bills.png";i:3;s:95:"https://raw.githubusercontent.com/007darkmatter5/ledgerly/main/docs/images/screenshots/loan.png";}s:4:"Date";s:10:"2026-09-24";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"5005";s:4:"Mode";s:3:"tcp";s:11:"Description";s:36:"Port for the Ledgerly web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5005";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:31:"/mnt/user/appdata/ledgerly/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:27:"The database (ledgerly.db).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:31:"/mnt/user/appdata/ledgerly/data";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Keys";s:6:"Target";s:5:"/keys";s:7:"Default";s:31:"/mnt/user/appdata/ledgerly/keys";s:4:"Mode";s:2:"rw";s:11:"Description";s:87:"Encryption keys for sign-ins and the saved email password. Back these up with the data.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"M