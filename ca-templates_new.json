fault";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:166:"Optional. When true: HTTPS redirect, HSTS header, CSP upgrade-insecure-requests, and secure cookies. Only useful behind a TLS-terminating proxy. Requires TRUST_PROXY.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"HSTS_INCLUDE_SUBDOMAINS";s:6:"Target";s:23:"HSTS_INCLUDE_SUBDOMAINS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:255:"When true: adds includeSubDomains to the HSTS header, extending HTTPS enforcement to all subdomains. Only effective when HSTS is active (FORCE_HTTPS=true or NODE_ENV=production). Leave false if you run other services on sibling subdomains over plain HTTP.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"COOKIE_SECURE";s:6:"Target";s:13:"COOKIE_SECURE";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:146:"Auto-derived (true in production or when FORCE_HTTPS=true). Set to false to force session cookies over plain HTTP. Not recommended for production.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"TRUST_PROXY";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:143:"Trusted proxy hops for X-Forwarded-For/X-Forwarded-Proto. Defaults to 1 in production; off in development unless set. Required for FORCE_HTTPS.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"ALLOW_INTERNAL_NETWORK";s:6:"Target";s:22:"ALLOW_INTERNAL_NETWORK";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description