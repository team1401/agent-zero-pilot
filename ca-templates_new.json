he internet. Designs are saved on your server. It can send a model straight to Trident, the self-hosted slicer, and its Resin tools (hollow, drain holes, supports) use Trident 0.7.0 or later. There is no login: keep it on a trusted network.";s:7:"Support";s:46:"https://github.com/mugenoesis/holecraft/issues";s:7:"Project";s:39:"https://github.com/mugenoesis/holecraft";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/mugenoesis/unraid-templates/main/templates/holecraft.xml";s:6:"ReadMe";s:69:"https://raw.githubusercontent.com/mugenoesis/holecraft/main/README.md";s:16:"ExtraSearchTerms";s:75:"3d modeling cad tinkercad stl 3mf 3d printing resin supports hollow trident";s:4:"Date";s:10:"2026-10-19";s:7:"License";s:8:"AGPL-3.0";s:6:"Config";a:2:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:20:"Port for the web UI.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:27:"/mnt/user/appdata/holecraft";s:4:"Mode";s:2:"rw";s:11:"Description";s:62:"Saved designs and settings (including the Trident connection).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/holecraft";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/holecraft.xml";s:4:"Repo";s:22:"mugenoesis' Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:250;s:9:"FirstSeen";i:1792411842;s:10:"LastUpdate";i:1792403674;s:14:"LastUpdateScan";i:1792411842;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:3451;s:11:"Displayable";b:1;s:6:"Author";s:10:"mugenoesis";s:13:"DockerHubName";s:9:"holecraft";s:8:"RepoName";s:22:"mugenoesis' Repository";s:10:"SortAuthor";s:10:"mugenoesis";s:8:"SortName";s:9:"Holecraft";s:6:"random";i:516723676;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/mugenoesisRepository/mugenoesis-Holecraft-latest.xml";s:10:"Deprecated";b:0;s:10:"DonateText";s:89:"Trident is free and built in my spare time. If it helps you, you can support it on Ko-fi.";s:10:"DonateLink";s:28:"https://ko-fi.com/mugenoesis";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3452;a:43:{s:4:"Name";s:7:"Trident";s:10:"Repository";s:18:"mugenoesis/trident";s:8:"Registry";s:43:"https://hub.docker.com/r/mugenoesis/trident";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:75:"https://raw.githubusercontent.com/mugenoesis/unraid-templates/main/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:8:"Overview";s:731:"A self-hosted slicer with a web UI. Trident runs OrcaSlicer's slicing engine headless in Docker, so you can upload a model, pick a printer and material, preview the G-code layer by layer, and download it or send it straight to a Moonraker or OctoPrint printer, from any browser or phone. OrcaSlicer's full printer and filament library is built in (70+ vendors), you can import your own profiles, and it handles multi-material and tool-changer printers (for example the Snapmaker U1), multi-plate 3MF files with object picking, copies and positioning. As a bonus it also supports belt (conveyor) printers such as the IdeaFormer IR3 V2. Built on OrcaSlicer (AGPL-3.0); the patched fork's source is linked from the app's /source page.";s:7:"Support";s:44:"https://github.com/mugenoesis/Trident/issues";s:7:"Project";s:37:"https://github.com/mugenoesis/Trident";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/mugenoesis/unraid-templates/main/templates/trident.xml";s:6:"ReadMe";s:69:"https://raw.githubusercontent.com/mugenoesis/Trident/master/README.md";s:16:"ExtraSearchTerms";s:91:"3d printing slicer orcaslicer orca gcode klipper moonraker