lstack:3.0";s:8:"Registry";s:46:"https://hub.docker.com/r/localstack/localstack";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:40:"https://github.com/localstack/localstack";s:6:"ReadMe";s:88:"https://github.com/junkerderprovinz/unraid-apps/blob/main/standardnotes-server/README.md";s:8:"Overview";s:2799:"LocalStack companion for the Standard Notes self-hosted backend.
    Provides the SNS and SQS endpoints the standardnotes/server image
    expects at "localstack:4566".
    
    Required side container. Without it, files-worker.log fills with
    "SQSError: SQS receive message failed: getaddrinfo ENOTFOUND
    localstack" and notes can duplicate.
    
    Hostname resolution. The server resolves the literal name
    "localstack". Pick one:
      User-defined Docker network: put both containers on the same
        custom bridge and set this container's network alias to
        "localstack". Docker's embedded DNS handles the rest.
      br0 / macvlan / VLAN / static-IP install: assign this container
        a fixed IP on the same VLAN as StandardNotes-Server, then
        append --add-host=localstack:LocalStack-IP to
        StandardNotes-Server's Extra Parameters and restart it.
    Verify from the Unraid host:
      docker exec StandardNotes-Server getent hosts localstack
    Must print a non-empty line.
    
    Required init script. LocalStack starts empty. The server expects a
    fixed set of SNS topics and SQS queues. The "LocalStack Bootstrap
    Script" path mapping below mounts the bootstrap script into
    /etc/localstack/init/ready.d/ where LocalStack runs it on ready.
    
    Automatic bootstrap on container start runs ONLY when ALL THREE
    of the following are true at first start:
      a) the host file /mnt/user/appdata/standardnotes/localstack_bootstrap.sh
         exists,
      b) it is executable (chmod +x),
      c) the "LocalStack Bootstrap Script" Path mapping is left at its
         default (mapped to /etc/localstack/init/ready.d/localstack_bootstrap.sh).
    LocalStack's init/ready.d/ hook fires ONCE per container lifetime.
    If the script was missing on first start, restart the container or
    use the README emergency-bootstrap one-liner to populate it in place.
    
    Before first start, on the Unraid host:
      mkdir -p /mnt/user/appdata/standardnotes
      curl -fsSL -o /mnt/user/appdata/standardnotes/localstack_bootstrap.sh \
        https://raw.githubusercontent.com/junkerderprovinz/Unraid-apps/main/standardnotes-server/scripts/localstack_bootstrap.sh
      chmod +x /mnt/user/appdata/standardnotes/localstack_bootstrap.sh
    
    Verify after start:
      docker exec StandardNotes-LocalStack awslocal \
        --endpoint-url=http://localhost:4566 sqs list-queues
      docker exec StandardNotes-LocalStack awslocal \
        --endpoint-url=http://localhost:4566 sns list-topics
    Both must list the *-local-queue / *-local-topic entries.
  Detailed README (full setup & options): https://github.com/junkerderprovinz/Unraid-apps/blob/main/standardnotes-server/README.md";s:11:"TemplateURL";s:117:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/standardnotes-server/standardnotes-localstack.xml";s:4:"Icon";s:97:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/standardnotes-server/icon.png";s:11:"ExtraParams";s:46:"--restart=unless-stopped --hostname=localstack";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"LocalStack Edge Port";s:6:"Target";s:4:"4566";s:7:"Default";s:4:"4566";s:4:"Mode";s:3:"tcp";s:11:"Description";s:117:"Edge port for SNS / SQS. Reachable from the server container on the same network. Publishing to the host is optional.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"4566";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Services (SERVICES)";s:6:"Target";s:8:"SERVICES";s:7:"Default";s:7:"sns,sqs";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Required services. Keep sns,sqs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"sns,sqs";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"External Hostname (HOSTNAME_EXTERNAL)";s:6:"Target";s:17:"HOSTNAME_EXTERNAL";s:7:"Default";s:10:"localstack";s:4:"Mode";s:0:"";s:11:"Description";s:43:"Keep localstack. Server resolves this name.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"localstack";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Log Level (LS_LOG)";s:6:"Target";s:6:"LS_LOG";s:7:"Default";s:27:"warn|error|info|debug|trace";s:4:"Mode";s:0:"";s:11:"Description";s:24:"Log level. Default warn.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"warn";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name