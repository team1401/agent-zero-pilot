.com/make-ware/unraid-templates/main/garage-ware/images/garage-ware-1.png";i:1;s:102:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/garage-ware/images/garage-ware-2.png";i:2;s:102:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/garage-ware/images/garage-ware-3.png";i:3;s:102:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/garage-ware/images/garage-ware-4.png";}s:6:"Config";a:17:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8890";s:4:"Mode";s:3:"tcp";s:11:"Description";s:92:"Host port for the web app, PocketBase API and admin (proxied by nginx on container port 80).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8890";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/garage-ware";s:4:"Mode";s:2:"rw";s:11:"Description";s:107:"Persistent storage: PocketBase database, uploads, the generated superuser credentials, and first-run state.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/garage-ware";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Garage Admin URL";s:6:"Target";s:16:"GARAGE_ADMIN_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:201:"Base URL of your Garage cluster's ADMIN API - port 3903 by default, NOT the S3 port 3900. Example: http://YOUR-GARAGE-IP:3903. Without it there is no cluster status, no buckets, no keys and no metrics.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Garage Admin Token";s:6:"Target";s:18:"GARAGE_ADMIN_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:109:"Admin API token for the cluster. Mint one on a Garage node with: garage admin-token create --name garage-ware";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Garage S3 Endpoint";s:6:"Target";s:18:"GARAGE_S3_ENDPOINT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:299:"Your Garage S3 gateway URL - example: https://s3.example.com or http://YOUR-GARAGE-IP:3900. Required for the in-app file browser and the bucket connect page. The browser signs S3 requests against this endpoint directly, so each bucket must allow CORS from this app's origin (see the project README).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"App Public URL";s:6:"Target";s:14:"APP_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:308:"How users actually reach this container, including the WebUI Port - example: http://YOUR-UNRAID-IP:8890 or https://garage.example.com. Used to build links in storage invites, usage alerts and the setup banner. If unset, those emails are skipped entirely - the invite row is still written, but nobody is told.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Sign-up Mode";s:6:"Target";s:11:"SIGNUP_MODE";s:7:"Default";s:6:"closed";s:4:"Mode";s:0:"";s:11:"Description";s:319:"Who may create an account: 'closed' (admins create every account), 'invite' (only addresses holding a pending storage or admin invite), or 'open' (anyone who can reach the sign-up page). While no administrator exists yet sign-up stays open regardless, so you can create the account you will claim with - claim promptly.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"closed";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Garage S3 Region";s:6:"Target";s:16:"GARAGE_S3_REGION";s:7:"Default";s:9:"us-east-1";s:4:"Mode";s:0:"";s:11:"Description";s:54:"S3 region name your Garage cluster is configured with.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"us-east-1";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Public S3 Endpoint";s:6:"Target";s:25:"GARAGE_PUBLIC_S3_ENDPOINT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:154:"Optional. The S3 URL advertised to users, when it differs from the CORS-enabled gateway the in-app browser must talk to. Falls back to Garage S3 Endpoint.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Enable Node Claims";s:6:"Target";s:19:"FEATURE_NODE_CLAIMS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:233:"Optional. Set to 'true' to let users claim cluster nodes (by proving the full node id) and grant storage sourced from them. Off by default - admins assign owners and grant all storage. Ownership decides who may grant, never how much.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Enable Asset Claims";s:6:"Target";s:20:"FEATURE_ASSET_CLAIMS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:187:"Optional. Set to 'true' to let users self-claim pre-existing Garage keys (by proving the secret) and the buckets those keys own. Off by default - admins onboard assets via import instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Setup Claim Token";s:6:"Target";s:17:"SETUP_CLAIM_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:150:"Optional. Supply the one-time first-run claim token yourself instead of letting the container mint one and print it to the log. Never written to disk.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Setup Owner Email";s:6:"Target";s:17:"SETUP_OWNER_EMAIL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:365:"Optional and WEAKER than the claim token: auto-promotes whoever signs up with this address, but only while no administrator exists yet. An address is rarely secret and sign-up is open until the instance is claimed, so anyone who reaches the app first and guesses it becomes the administrator. Prefer the token unless this container is unreachable from the internet.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Admin Email";s:6:"Target";s:22:"POCKETBASE_ADMIN_EMAIL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:255:"Optional. Email for the PocketBase superuser. Leave BOTH this and Admin Password blank and the container generates a password on first boot, storing it at /data/pb_superuser.env (mode 0600) - back that file up. Setting only one of the two is a hard error.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:25:"POCKETBASE_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:170:"Optional. Password for the PocketBase superuser. Set this only together with Admin Email - setting one without the other is a hard error and the container will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Avg Object Size (MB)";s:6:"Target";s:25:"GARAGE_AVG_OBJECT_SIZE_MB";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:153:"Optional. Average object size in MB. When set, each bucket also gets an object-count cap derived from its byte quota. Leave blank to apply no object cap.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Node Metrics Retention (days)";s:6:"Target";s:27:"NODE_METRICS_RETENTION_DAYS";s:7:"Default";s:2:"90";s:4:"Mode";s:0:"";s:11:"Description";s:78:"How many days of per-node metrics history to keep. 0 keeps everything forever.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"90";}}s:12:"TemplatePath";s:47:"/tmp/GitHub/AppFeed/garage-ware/garage-ware.xml";s:4:"Repo";s:22:"make-ware's Repository";s:12:"CategoryList";a:3:{i:0;s:5:"Cloud";i:1;s:15:"Tools-Utilities";i:2;s:18:"Network-Management";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:387;s:9:"FirstSeen";i:1787357148;s:10:"LastUpdate";i:1787274574;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:41:"Cloud: Tools:Utilities Network:Management";s:2:"ID";i:3269;s:11:"Displayable";b:1;s:6:"Author";s:7:"dastron";s:13:"DockerHubName";s:10:"garageware";s:8:"RepoName";s:22:"make-ware's Repository";s:10:"SortAuthor";s:7:"dastron";s:8:"SortName";s:10:"GarageWare";s:6:"random";i:693987132;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/makewaresRepository/dastron-GarageWare-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3270;a:39:{s:4:"Name";s:13:"InventoryWare";s:10:"Repository";s:29:"dastron/inventory-ware:latest";s:8:"Registry";s:47:"https://hub.docker.com/r/dastron/inventory-ware";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/make-ware/inventory-ware/issues";s:7:"Project";s:43:"https://github.com/make-ware/inventory-ware";s:8:"Overview";s:377:"Self-hosted inventory manager that catalogs your belongings from photos. Snap a picture and InventoryWare identifies the item with AI vision - or label it yourself - then organizes everything into containers you can search. Includes an `iw` CLI for scripted bulk imports. Runs as one container with one data path; AI labeling is optional and works with OpenAI or Google Gemini.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:11:"TemplateURL";s:99:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/inventory-ware.xml";s:4:"Icon";s:89:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/icon.png";s:10:"Screenshot";a:5:{i:0;s:108:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/images/inventory-ware-1.png";i:1;s:108:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/images/inventory-ware-2.png";i:2;s:108:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/images/inventory-ware-3.png";i:3;s:108:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/images/inventory-ware-4.png";i:4;s:108:"https://raw.githubusercontent.com/make-ware/unraid-templates/main/inventory-ware/images/inventory-ware-5.png";}s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8889";s:4:"Mode";s:3:"tcp";s:11:"Description";s:92:"Host port for the web app, PocketBase API and admin (proxied by nginx on container port 80).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8889";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:5:"/data";s:7:"Default";s:32:"/mnt/user/appdata/inventory-ware";s:4:"Mode";s:2:"rw";s:11:"Description";s:60:"Persistent storage: PocketBase database and uploaded images.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:32:"/mnt/user/appdata/inventory-ware";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Admin Email";s:6:"Target";s:22:"POCKETBASE_ADMIN_EMAIL";s:7:"Default";s:17:"admin@example.com";s:4:"Mode";s:0:"";s:11:"Description";s:48:"Email for the auto-created PocketBase superuser.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:17:"admin@example.com";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:25:"POCKETBASE_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Password for the auto-created PocketBase superuser. MUST be set to a strong value - leaving it blank skips superuser creation.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"OpenAI API Key";s:6:"Target";s:14:"OPENAI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:203:"Set this to use OpenAI for AI labeling (default model gpt-5.4-2026-03-05). Get a key at https://platform.openai.com/api-keys. Leave blank if you are using Gemini instead, or to label items manually only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Gemini API Key";s:6:"Target";s:14:"GEMINI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:216:"Set this to use Google Gemini for AI labeling instead of OpenAI (default model gemini-3.5-flash). Get a key at https://aistudio.google.com/apikey. Leave blank if you are using OpenAI, or to label items manually only.";s:4:"Type";s:8:"Variable";s:7:"Display";