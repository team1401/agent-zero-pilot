ask";s:5:"false";}s:5:"value";s:4:"text";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"LOG_FILE";s:6:"Target";s:8:"LOG_FILE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Optional path to a log file inside /config/logs (e.g. /config/logs/pocketlog-importer.log). Leave empty to log to stdout only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:50:"/tmp/GitHub/AppFeed/anym001/pocketlog-importer.xml";s:4:"Repo";s:20:"Anym001's Repository";s:9:"downloads";i:1521;s:9:"FirstSeen";i:1781381050;s:10:"LastUpdate";i:1791044076;s:14:"LastUpdateScan";i:1792262791;s:12:"CategoryList";a:0:{}s:8:"Category";s:6:"Other:";s:2:"ID";i:1500;s:11:"Displayable";b:1;s:6:"Author";s:7:"anym001";s:13:"DockerHubName";s:18:"pocketlog-importer";s:8:"RepoName";s:20:"Anym001's Repository";s:10:"SortAuthor";s:7:"anym001";s:8:"SortName";s:18:"pocketlog importer";s:6:"random";i:1053331894;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:118:"/tmp/community.applications/tempFiles/templates-community-apps/Anym001sRepository/anym001-pocketlogimporter-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1501;a:39:{s:4:"Name";s:9:"pocketlog";s:10:"Repository";s:32:"ghcr.io/anym001/pocketlog:latest";s:8:"Registry";s:33:"https://ghcr.io/anym001/pocketlog";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:75:"https://forums.unraid.net/topic/195410-support-anym001-application-dockers/";s:7:"Project";s:36:"https://github.com/anym001/pocketlog";s:8:"Overview";s:1558:"PocketLog is a self-hosted budget book (household finances) Progressive Web App. It runs in the browser on all common platforms and can be installed to the homescreen as an app.

Designed for private self-hosting: your data lives exclusively on your own server. By default PocketLog uses an embedded SQLite database (no separate database needed) - just map the /config volume so your data survives container updates. An external MariaDB is optional. The app runs in your own container. All assets (fonts, icons, JS libraries) are served from your own origin - no CDN calls, no external connections, no tracking, no telemetry.

Features: income & expense transactions with categories and tags, savings goals and debt tracking, budgets with spending limits, recurring transactions, bulk actions, reports & charts, full-text search, CSV import/export, offline support, light/dark themes, multi-user with its own username/password login and brute-force protection, scoped API access via bearer tokens (read/import/write).

STORAGE: By default the SQLite database lives at /config/db/pocketlog.db - map /config to your appdata share to persist it. Set PUID=99 / PGID=100 so the files are owned by nobody:users on Unraid.

OPTIONAL MariaDB: To use an external MariaDB 10.6+ instead, create a database and user and set the DB_* variables. Setting any DB_* variable switches PocketLog from SQLite to MariaDB; DB_PASSWORD is then required.

On first launch open the WebUI to create the initial admin account.

