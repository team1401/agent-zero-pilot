false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:37:"/tmp/GitHub/AppFeed/matrix/matrix.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:3:{i:0;s:17:"Network-Messenger";i:1;s:13:"Network-Other";i:2;s:12:"Productivity";}s:9:"downloads";i:14523;s:9:"FirstSeen";i:1781028981;s:10:"LastUpdate";i:1790873382;s:14:"LastUpdateScan";i:1791745164;s:8:"Category";s:45:"Network:Messenger Network:Other Productivity:";s:2:"ID";i:2778;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:6:"matrix";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:6:"Matrix";s:6:"random";i:915868906;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-Matrix-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2779;a:48:{s:4:"Name";s:3:"n8n";s:10:"Repository";s:16:"n8nio/n8n:latest";s:8:"Registry";s:34:"https://hub.docker.com/r/n8nio/n8n";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:14:"https://n8n.io";s:6:"ReadMe";s:71:"https://github.com/junkerderprovinz/unraid-apps/blob/main/n8n/README.md";s:8:"Overview";s:1318:"n8n is a powerful workflow-automation tool: connect 400+ apps and APIs, build flows
    visually, and drop into code whenever you need to. This is a plug-and-play Unraid
    Community Applications template that wraps the official n8nio/n8n image, tuned with
    sensible production defaults. Variables with fixed options are dropdowns.
    
    IMPORTANT - two one-time setup steps (see the README):
    1. DATABASE: this template defaults to PostgreSQL (recommended). Create a database and
       user first, then fill in the Postgres Host / Database / User / Password fields below.
       (To use SQLite instead, set DB Type to 'sqlite' and ignore the Postgres fields.)
    2. PERMISSIONS: n8n runs as user 'node' (UID 1000) and has no PUID/PGID. Create the
       AppData folder first, then make it writable by UID 1000 - run once on the Unraid console:
       mkdir -p /mnt/user/appdata/n8n/files
       chown -R 1000:1000 /mnt/user/appdata/n8n
    
    Included defaults: task runners on, execution-history pruning (no DB bloat), binary
    data stored on disk, telemetry off, and N8N_SECURE_COOKIE=false so login works over
    plain LAN HTTP (set it to true behind HTTPS).
    
