Name";s:11:"AppForgeHub";s:10:"Repository";s:32:"allornothing/appforge-hub:latest";s:8:"Registry";s:50:"https://hub.docker.com/r/allornothing/appforge-hub";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Project";s:41:"https://github.com/aon082910/appforge-hub";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/aon082910/AoN-Unraid-Apps/main/AppForge-Hub/appforge-hub.xml";s:6:"ReadMe";s:71:"https://raw.githubusercontent.com/aon082910/appforge-hub/main/UNRAID.md";s:7:"License";s:3:"MIT";s:8:"Overview";s:828:"Self-hosted AI app builder: describe an app in chat and it scaffolds a real, running
