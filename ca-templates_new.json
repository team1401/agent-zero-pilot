can";i:1790645917;s:11:"topTrending";d:0.017000000000000015;s:13:"topPerforming";d:0.426;s:8:"Category";s:29:"Tools:Utilities Network:Other";s:2:"ID";i:856;s:11:"Displayable";b:1;s:6:"Author";s:13:"markusmcnugen";s:13:"DockerHubName";s:4:"sftp";s:8:"RepoName";s:26:"MarkusMcNugen's Repository";s:10:"SortAuthor";s:13:"markusmcnugen";s:8:"SortName";s:4:"sftp";s:6:"random";i:956999936;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/MarkusMcNugensRepository/markusmcnugen-sftp-latest.xml";s:4:"Date";N;s:10:"Deprecated";b:0;s:10:"trendDelta";d:0.017;s:12:"trendAverage";d:0.5527;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:857;a:37:{s:4:"Name";s:8:"hivekeep";s:10:"Repository";s:34:"ghcr.io/marlburrow/hivekeep:latest";s:8:"Registry";s:35:"https://ghcr.io/marlburrow/hivekeep";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:41:"https://hivekeep.app/apple-touch-icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:8:"Overview";s:819:"Hivekeep is a self-hosted platform of autonomous, persistent personal AI agents. Run a team of specialized agents on your own server: each one has its own identity, expertise, memory and tools. Agents collaborate with each other, remember everything across months in one continuous session, and extend the platform themselves by writing custom tools, mini-apps and NPM plugins. Built-in channels: Telegram, WhatsApp, Slack, Discord, Signal, Matrix. Single process with Bun and SQLite, no external database. Secrets are stored in an AES-256-GCM encrypted vault and never sent to the LLM. After starting the container, open the web UI and the built-in setup agent (Queenie) walks you through connecting AI providers and creating your first agents. Bring your own API keys (Anthropic, OpenAI, Gemini, OpenRouter and more).";s:7:"Project";s:38:"https://github.com/MarlBurroW/hivekeep";s:7:"Support";s:45:"https://github.com/MarlBurroW/hivekeep/issues";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/MarlBurroW/unraid-templates/main/templates/hivekeep.xml";s:6:"ReadMe";s:68:"https://raw.githubusercontent.com/MarlBurroW/hivekeep/main/README.md";s:16:"ExtraSearchTerms";s:68:"ai agents assistant chatbot llm automation telegram whatsapp discord";s:8:"Requires";s:100:"An API key for at least one AI provider (Anthropic, OpenAI, Gemini, OpenRouter...). Internet access.";s:4:"Date";s:10:"2026-07-05";s:6:"Config";a:3:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:35:"Port for the Hivekeep web interface";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:10:"PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:327:"The exact URL you use to open Hivekeep in your browser, e.g. http://192.168.1.50:3000 (your server IP and the WebUI port above). It must match the scheme, host and port exactly. If it is left blank or wrong, sign-up fails with 'Invalid origin'. Using a reverse proxy or hostname? Put that full URL here instead, https included.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:9:"/app/data";s:7:"Default";s:26:"/mnt/user/appdata/hivekeep";s:4:"Mode";s:2:"rw";s:11:"Description";s:55:"All Hivekeep state (SQLite database, vault, workspaces)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/hivekeep";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/hivekeep.xml";s:4:"Repo";s:23:"MarlBurroW's Repository";s:12:"CategoryList";a:2:{i:0;s:2:"AI";i:1;s:12:"Productivity";}s:16:"ChangeLogPresent";s:1:"