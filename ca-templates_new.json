9:"PluginURL";s:111:"https://raw.githubusercontent.com/strike84/unraid-disk.space.management/refs/heads/main/DiskSpaceManagement.plg";s:12:"PluginAuthor";s:6:"strike";s:4:"Name";s:21:"Disk Space Management";s:8:"Overview";s:754:"This plugin was created mainly for those who use the split-level feature in Unraid. Due to how split level works, it will ignore the minimum free space setting and continue to move stuff to disks that are full/almost full. This is because split level tries to keep files and folders that belong together based on your split level setting on the same disk, and split level trumps all other settings. Even if there's little space left on the disk. So to combat this, this plugin will automatically move Movies and TV shows from disks that are below the threshold setting to the disk with the most free space available. It prioritizes to move movies first, then if no movies are found it will go to TV shows and move the shows with the fewest seasons first.";s:7:"Support";s:145:"https://forums.unraid.net/topic/191758-plugin-disk-space-management-mainly-for-those-who-use-the-split-level-feature-in-unraid-coming-soon-to-ca/";s:4:"Icon";s:88:"https://github.com/strike84/unraid-disk.space.management/blob/main/plugin-icon.png?raw=1";s:11:"TemplateURL";s:100:"https://raw.githubusercontent.com/strike84/DiskSpaceManagement-template/main/DiskSpaceManagement.xml";s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/DiskSpaceManagement.xml";s:4:"Repo";s:19:"strike's Repository";s:10:"Repository";s:111:"https://raw.githubusercontent.com/strike84/unraid-disk.space.management/refs/heads/main/DiskSpaceManagement.plg";s:12:"CategoryList";a:4:{i:0;s:14:"HomeAutomation";i:1;s:5:"Other";i:2;s:15:"Tools-Utilities";i:3;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.04.09";s:6:"Author";s:6:"strike";s:9:"downloads";i:2669;s:9:"FirstSeen";i:1753120631;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:30;i:11;i:140;i:12;i:122;s:2:"01";i:164;s:2:"02";i: