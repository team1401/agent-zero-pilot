Hardware encoding vendor for every automated watch-folder conversion. 'nvidia' needs the NVIDIA Container Runtime (Extra Parameters: --runtime=nvidia) plus NVIDIA_DRIVER_CAPABILITIES=compute,video,utility. 'intel' and 'amd' need the GPU device passed through (Extra Parameters: --device /dev/dri). NVIDIA and Intel are verified on real hardware; AMD is wired but unverified (no AMD GPU to test on). A vendor that cannot be honoured logs exactly why and falls back to software encoding. Check the reason with: docker exec handbrake cat /config/handbrake-gpu.log";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"none";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"App Niceness (APP_NICENESS)";s:6:"Target";s:12:"APP_NICENESS";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:120:"nice level (0-19) applied to the GUI and every transcode. Higher = lower priority, leaves more CPU for other containers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:43:"Automated Conversion (AUTOMATED_CONVERSION)";s:6:"Target";s:20:"AUTOMATED_CONVERSION";s:7:"Default";s:3:"1|0";s:4:"Mode";s:0:"";s:11:"Description";s:79:"1 = watch-folder conversion enabled (default), 0 = disable the daemon entirely.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:47:"Conversion Preset (AUTOMATED_CONVERSION_PRESET)";s:6:"Target";s:27:"AUTOMATED_CONVERSION_PRESET";s:7:"Default";s:25:"General/Very Fast 1080p30";s:4:"Mode";s:0:"";s:11:"Description";s:73:"HandBrake preset used for every automated conversion, as 'category/name'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"General/Very Fast 1080p30";}i:17;