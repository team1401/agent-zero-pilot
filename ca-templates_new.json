play";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"GUEST_URL";s:6:"Target";s:9:"GUEST_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:112:"External base URL for guest links, e.g. https://guest.myhouse.com. Leave empty to use the local network address.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"APP_NAME";s:6:"Target";s:8:"APP_NAME";s:7:"Default";s:11:"Home Access";s:4:"Mode";s:0:"";s:11:"Description";s:28:"Display name shown to guests";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"Home Access";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"CONTACT_MESSAGE";s:6:"Target";s:15:"CONTACT_MESSAGE";s:7:"Default";s:62:"Please request a new link from the person who shared this one.";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Message shown when a guest link expires";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:62:"Please request a new link from the person who shared this one.";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"BRAND_BG";s:6:"Target";s:8:"BRAND_BG";s:7:"Default";s:7:"#F2F0E9";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Background color (hex) shown to guests";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"#F2F0E9";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"BRAND_PRIMARY";s:6:"Target";s:13:"BRAND_PRIMARY";s:7:"Default";s:7:"#D9523C";s:4:"Mode";s:0:"";s:11:"Description";s:41:"Accent/button color (hex) shown to guests";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"#D9523C";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"ACCESS_LOG_RETENTION_DAYS";s:6:"Target";s:25:"ACCESS_LOG_RETENTION_DAYS";s:7:"Default";s:2:"90";s:4:"Mode";s:0:"";s:11:"Description";s:37:"Days to keep guest access log entries";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"90";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PORT";s:6:"Target";s:4:"PORT";s:7:"Default";s:4:"5880";s:4:"Mode";s:0:"";s:11:"Description";s:82:"Internal listen port (only change if you also change the WebUI Port mapping above)";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5880";}}s:12:"TemplatePath";s:53:"/tmp/GitHub/AppFeed/templates/ha-pass-invitations.xml";s:4:"Repo";s:21:"Nebur692's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1791813236;s:8:"Category";s:31:"HomeAutomation: Tools:Utilities";s:2:"ID";i:929;s:11:"Displayable";b:1;s:6:"Author";s:8:"nebur692";s:13:"DockerHubName";s:19:"ha-pass-invitations";s:8:"RepoName";s:21:"Nebur692's Repository";s:10:"SortAuthor";s:8:"nebur692";s:8:"SortName";s:19:"ha pass invitations";s:6:"random";i:46372954;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:120:"/tmp/community.applications/tempFiles/templates-community-apps/Nebur692sRepository/nebur692-hapassinvitations-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateLink";s:36:"https://github.com/sponsors/Nebur692";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:930;a:36:{s:4:"Name";s:12:"oauth2-proxy";s:11:"TemplateURL";s:96:"https://raw.githubusercontent.com/Nebur692/unraid-community-apps/main/templates/oauth2-proxy.xml";s:10:"Repository";s:40:"quay.io/oauth2-proxy/oauth2-proxy:latest";s:8:"Registry";s:52:"https://quay.io/repository/oauth2-proxy/oauth2-proxy";s:6:"GitHub";s:44:"https://github.com/oauth2-proxy/oauth2-proxy";s:7:"Project";s:44:"https://oauth2-proxy.github.io/oauth2-proxy/";s:7:"Support";s:65:"https://forums.unraid.net/topic/200036-unraid-templates-nebur692/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:110:"https://raw.githubusercontent.com/oauth2-proxy/oauth2-proxy/master/docs/static/img/logos/OAuth2_Proxy_icon.png";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:8:"Overview";s:1293:"Puts a login in front of web apps that have none of their own. Your reverse proxy asks this container, on every request, whether the visitor is signed in; if not, the visitor is sent to your identity provider (ZITADEL, Keycloak, Authentik, Authelia, Google, GitHub...) and only comes back once authenticated.
    
    Typical use: an Nginx Proxy Manager host with an "auth_request" block in its Advanced tab pointing here, so the app itself is never reachable without a login. One container can protect any number of sites: leave the redirect URL as a path only and it derives the right absolute URL from each request, and a shared cookie domain means one login covers all of them.
    
    Every setting below maps to an oauth2-proxy option of the same name. The four you must fill in are the issuer URL, the client ID and secret from your provider, and the cookie secret. The ready-to-paste reverse proxy snippet and a step-by-step walkthrough are in the repository README.
    
    IMPORTANT: this container is a gate, not a proxy. It is meant to be used with "Upstreams = static://202", letting your reverse proxy do the actual proxying. Anyone whose e-mail is in the allow-list file gets into everything behind the same instance, so use a separate instance for a different audience.";s:6:"Config";a:25:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"4180";s:7:"Default";s:4:"4180";s:4:"Mode";s:3:"tcp";s:11:"Description";s:79:"Port your reverse proxy will point at. Nothing else should be able to reach it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"4180";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:30:"/mnt/user/appdata/oauth2-proxy";s:4:"Mode";s:2:"ro";s:11:"Description";s:65:"Folder holding the allow-list file. Mounted read-only on purpose.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/oauth2-proxy";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Listen address";s:6:"Target";s:25:"OAUTH2_PROXY_HTTP_ADDRESS";s:7:"Default";s:12:"0.0.0.0:4180";s:4:"Mode";s:0:"";s:11:"Description";s:79:"Address inside the container. Leave as is unless you change the port above too.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"0.0.0.0:4180";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Provider";s:6:"Target";s:21:"OAUTH2_PROXY_PROVIDER";s:7:"Default";s:4:"oidc";s:4:"Mode";s:0:"";s:11:"Description";s:151:"Keep 'oidc' for any standards-compliant provider (ZITADEL, Keycloak, Authentik, Authelia...). Other values such as google or github are also supported.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"oidc";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Issuer URL";s:6:"Target";s:28:"OAUTH2_PROXY_OIDC_ISSUER_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:152:"Public HTTPS address of your identity provider, exactly as it appears in the 'issuer' field of its /.well-known/openid-configuration. No trailing slash.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Client ID";s:6:"Target";s:22:"OAUTH2_PROXY_CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:60:"Client ID of the application you registered at the provider.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Client secret";s:6:"Target";s:26:"OAUTH2_PROXY_CLIENT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Client secret of that same application.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Redirect URL";s:6:"Target";s:25:"OAUTH2_PROXY_REDIRECT_URL";s:7:"Default";s:16:"/oauth2/callback";s:4:"Mode";s:0:"";s:11:"Description";s:235:"Leave it as a path only and the absolute URL is derived from the host of each request, so one container serves many sites. Every one of those sites must be registered as a redirect URI at your provider, as https://site/oauth2/callback.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"/oauth2/callback";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Cookie secret";s:6:"Target";s:26:"OAUTH2_PROXY_COOKIE_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:97:"32 random bytes, base64. Generate with: openssl rand -base64 32 . Changing it signs everyone out.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Cookie domains";s:6:"Target";s:27:"OAUTH2_PROXY_COOKIE_DOMAINS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:168:"Domains the session cookie is issued for, comma separated. A leading dot covers subdomains (.example.com), so a single login is shared by every protected site under it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Allowed redirect domains";s:6:"Target";s:30:"OAUTH2_PROXY_WHITELIST_DOMAINS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:184:"Domains the proxy may send the visitor back to after login, comma separated. A leading dot allows subdomains. Anything not listed here is refused, which is what stops an open redirect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure cookie";s:6:"Target";s:26:"OAUTH2_PROXY_COOKIE_SECURE";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:91:"Only send the session cookie over HTTPS. Leave true unless you are testing over plain HTTP.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Session lifetime";s:6:"Target";s:26:"OAUTH2_PROXY_COOKIE_EXPIRE";s:7:"Default";s:2:"8h";s:4:"Mode";s:0:"";s:11:"Description";s:68:"How long a login lasts before the visitor has to authenticate again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"8h";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"E-mail domains";s:6:"Target";s:26:"OAUTH2_PROXY_EMAIL_DOMAINS";s:7:"Default";s:1:"*";s:4:"Mode";s:0:"";s:11:"Description";s:89:"Accepted e-mail domains. Set to * when you filter with the allow-list file below instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"*";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Allow-list file";s:6:"Target";s:38:"OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE";s:7:"Default";s:30:"/data/authenticated-emails.txt";s:4:"Mode";s:0:"";s:11:"Description";s:197:"File with one allowed e-mail address per line, inside the Data folder above. The container watches it, so adding someone does not need a restart. Without it, every account at your provider gets in.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/data/authenticated-emails.txt";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Upstreams";s:6:"Target";s:22:"OAUTH2_PROXY_UPSTREAMS";s:7:"Default";s:12:"static://202";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Leave as static://202 when your reverse proxy does the proxying (auth_request). Point it at an app URL only if you want this container to proxy the traffic itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"static://202";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Behind reverse proxy";s:6:"Target";s:26:"OAUTH2_PROXY_REVERSE_PROXY";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:70:"Trust X-Forwarded-* headers, but only from the addresses listed below.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Trusted proxy IPs";s:6:"Target";s:30:"OAUTH2_PROXY_TRUSTED_PROXY_IPS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:158:"CIDR of your reverse proxy, for example 192.168.1.10/32. Fill this in: leaving it empty lets any client claim any IP address in the logs and in rate limiting.";s:4:"Type"