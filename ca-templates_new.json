/github.com/RoboSats/robosats/tree/main/nodeapp";s:11:"TemplateURL";s:105:"https://raw.githubusercontent.com/raccommode/Raccommode-Unraid-Community-Apps/main/templates/robosats.xml";s:4:"Icon";s:89:"https://raw.githubusercontent.com/RoboSats/robosats/main/nodeapp/assets/icon/Robosats.svg";s:8:"Requires";s:544:"This template runs the RoboSats self-hosted client, not a coordinator backend, Lightning node, database, or Tor daemon. For private/full use, configure a reachable SOCKS Tor proxy through TOR_PROXY_IP and TOR_PROXY_PORT. The upstream client defaults to 127.0.0.1:9050 when these variables are blank and coordinator connectivity will fail unless a proxy is reachable there. Leave the Tor fields blank only if you intentionally want the local web UI without self-hosted coordinator connectivity, or if you provide your own image/runtime override.";s:7:"License";s:16:"AGPL-3.0 License";s:10:"Screenshot";a:2:{i:0;s:96:"https://raw.githubusercontent.com/RoboSats/robosats/main/nodeapp/assets/images/screenshots/1.png";i:1;s:96:"https://raw.githubusercontent.com/RoboSats/robosats/main/nodeapp/assets/images/screenshots/2.png";}s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:5:"12596";s:7:"Default";s:5:"12596";s:4:"Mode";s:3:"tcp";s:11:"Description";s:65:"RoboSats self-hosted client web interface. Container port: 12596.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"12596";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Install Path";s:6:"Target";s:17:"/var/lib/robosats";s:7:"Default";s:26:"/mnt/user/appdata/robosats";s:4:"Mode";s:2:"rw";s:11:"Description";s:82:"Host path used as the Unraid install/appdata location for this RoboSats container.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/robosats";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Tor Proxy IP";s:6:"Target";s:12:"TOR_PROXY_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:243:"Optional SOCKS Tor proxy host used by the client to reach coordinators. Use a reachable Tor container hostname, IP, or host proxy address. Leave blank only for local UI use without coordinator connectivity or when overriding the image runtime.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Tor Proxy Port";s:6:"Target";s:14:"TOR_PROXY_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:142:"Optional SOCKS Tor proxy port used by the client to reach coordinators, commonly 9050. Leave blank only with the same caveats as Tor Proxy IP.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/robosats.xml";s:4:"Repo";s:23:"Raccommode's Repository";s:12:"CategoryList";a:2:{i:0;s:13:"Network-Other";i:1;s:15:"Tools-Utilities";}s:5:"stars";i:1;s:9:"downloads";i:78108;s:13:"downloadtrend";a:5:{i:0;i:66737;i:1;i:67030;i:2;i:68287;i:3;i:70459;i:4;i:78108;}s:8:"trending";d:9.793;s:6:"trends";a:4:{i:0;d:0.437;i:1;d:1.841;i:2;d:3.083;i:3;d:9.793;}s:10:"trendsDate";a:4:{i:0;i:1783281837;i:1;i:1785926957;i:2;i:1788523586;i:3;i:1791953108;}s:9:"FirstSeen";i:1780689832;s:10:"LastUpdate";i:1791377285;s:14:"LastUpdateScan";i:1791953108;s:11:"topTrending";d:9.356;s:8:"Category";s:29:"Network:Other Tools:Utilities";s:2:"ID";i:4263;s:11:"Displayable";b:1;s:6:"Author";s:8:"recksato";s:13:"DockerHubName";s:8:"robosats";s:8:"RepoName";s:23:"Raccommode's Repository";s:10:"SortAuthor";s:8:"recksato";s:8:"SortName";s:8:"RoboSats";s:6:"random";i:2043553154;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/RaccommodesRepository/recksato-RoboSats-latest.xml";s:4:"Date";N;