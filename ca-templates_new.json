s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1862;a:37:{s:4:"Name";s:8:"PanelsXR";s:10:"Repository";s:23:"dervish/panelsxr:latest";s:8:"Registry";s:41:"https://hub.docker.com/r/dervish/panelsxr";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:45:"https://github.com/dervish666/PanelsXR/issues";s:7:"Project";s:38:"https://github.com/dervish666/PanelsXR";s:8:"Overview";s:630:"Panel is a WebXR comic reader that streams your self-hosted Komga library into a Meta Quest 3 headset. Resume where your iPad left off, turn pages on the thumbstick, and browse a 3D library of your series. Runs in the Quest browser (no store, no sideload).

Set KOMGA_URL to your Komga address and KOMGA_API_KEY to a Komga API key (Komga, Account Settings, API Keys). The key is injected server-side and never reaches the browser.

IMPORTANT: WebXR needs HTTPS. Access this behind a reverse proxy (SWAG / Nginx Proxy Manager / Cloudflare Tunnel). A plain http address loads the 2D page but the Quest browser will not enter VR.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:4:"Icon";s:90:"https://raw.githubusercontent.com/dervish666/PanelsXR/main/deploy/unraid/panelsxr-icon.png";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/dervish666/unraid-templates/main/dervish/panelsxr.xml";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8677";s:4:"Mode";s:3:"tcp";s:11:"Description";s:25:"Port for the Panel web UI";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8677";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Komga URL";s:6:"Target";s:9:"KOMGA_URL";s:7:"Default";s:0:"";s:11:"Description";s:50:"Your Komga base URL, e.g. http://192.168.1.10:8080";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Komga API Key";s:6:"Target";s:13:"KOMGA_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:276:"Use a DEDICATED READ-ONLY Komga user's key (Komga, Account Settings, API Keys). It is injected server-side and never sent to the browser, but it also bypasses Komga's own auth, so a read-only key caps the blast radius to 'someone saw my comics' instead of full account access.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Basic Auth User";s:6:"Target";s:10:"PANEL_USER";s:7:"Default";s:5:"panel";s:11:"Description";s:71:"Username for the built-in login (only used if a password is set below).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"panel";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Password";s:6:"Target";s:14:"PANEL_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:307:"Set a password to lock the whole app + Komga proxy behind a login (the Quest browser remembers it, so it's a one-time login). SAFE BY DEFAULT: if you leave this blank, Panel refuses to serve your library (503) until you set one — unless you set the Auth Mode below to 'none'. Set it here before first run.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Auth Mode (advanced)";s:6:"Target";s:10:"PANEL_AUTH";s:7:"Default";s:0:"";s:11:"Description";s:229:"Leave blank to use the Password above (recommended). Set to 'none' ONLY if Panel is LAN-only or already gated by a reverse proxy / Cloudflare Access / Authelia — 'none' serves your whole library to anyone who can reach the URL.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/dervish/panelsxr.xml";s:4:"Repo";s:20:"dervish's Repository";s:12:"CategoryList";a:1:{i:0;s:14:"MediaApp-Books";}s:9:"downloads";i:1443;s:9:"FirstSeen";i:1783296225;s:10:"LastUpdate";i:1790514390;s:14:"LastUpdateScan";i:1792077780;s:8:"Category";s:14:"MediaApp:Books";s:2:"ID";i:1862;s:11:"Displayable";b:1;s:6:"Author";s:7:"dervish";s:13:"DockerHubName";s:8:"panelsxr";s:8:"RepoName";s:20:"dervish's Repository";s:10:"SortAuthor";s:7:"dervish";s:8:"SortName";s:8:"PanelsXR";s:6:"random";i:1796930782;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:109:"/tmp/community.applications/tempFiles/templates-community-apps/dervishsRepository/dervish-PanelsXR-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1863;a:37:{s:4:"Name";s:18:"Unraid-Monitor-Bot";s:10:"Repository";s:31:"dervish/unraidmonitorbot:latest";s:8:"Registry";s:49:"https://hub.docker.com/r/dervish/unraidmonitorbot";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:66:"https://forums.unraid.net/topic/197009-support-unraid-monitor-bot/";s:7:"Project";s:41:"https://scratch-it.co.uk/unraidmonitorbot";s:8:"Overview";s:1664:"Telegram bot for monitoring Docker containers and Unraid servers. Get real-time alerts, check container status, view logs, control containers,
and monitor server health - all from Telegram.

On first launch, an interactive setup wizard in Telegram guides you through connecting to your Unraid server and auto-classifies your containers into
categories (priority, protected, watched, killable, ignored). Re-run anytime with /setup.

Features:
- Interactive setup wizard with container auto-classification
- Container crash, health-check, and restart-loop alerts with one-tap action buttons
- Container control from Telegram - start, stop, restart, and pull/update (with confirmation)
- Auto-heal - opt-in automatic restart of containers that fail their healthcheck, with a storm guard
- Image-update detection - opt-in daily digest of containers with newer images, each with a Pull button
- Resource monitoring with per-container CPU/memory thresholds, adjustable straight from the alert
- Log watching with error detection and smart, AI-generated ignore patterns
- AI-powered diagnostics and container classification (Anthropic, OpenAI, or Ollama; switch at runtime with /model)
- Unraid server monitoring (CPU, memory, temps, UPS, array, disks)
- Natural language chat interface ("what's wrong with plex?", "restart sonarr")
- Mute system to temporarily silence alerts per container, server, or array
- Interactive /manage dashboard for status, resources, mutes, ignores, and feature toggles

Setup requires a Telegram bot token from @BotFather and your Telegram user ID. After installing, message your bot with /start to begin the setup
