et";s:18:"KD_SHARE_READ_ONLY";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:41:"true refuses every change the peer sends.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Inbound port";s:6:"Target";s:15:"KD_INBOUND_PORT";s:7:"Default";s:5:"26431";s:4:"Mode";s:0:"";s:11:"Description";s:96:"TCP port peers dial (26000 to 27000). Change only if another KeibiDrop peer on this box uses it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"26431";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Outbound port";s:6:"Target";s:16:"KD_OUTBOUND_PORT";s:7:"Default";s:5:"26432";s:4:"Mode";s:0:"";s:11:"Description";s:29:"TCP port this box dials from.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"26432";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Strict mode";s:6:"Target";s:9:"KD_STRICT";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:85:"true never falls back to the bridge; the connection fails when no direct path exists.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/keibidrop.xml";s:4:"Repo";s:22:"keibisoft's Repository";s:12:"CategoryList";a:2:{i:0;s:19:"Network-FileSharing";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:92;s:9:"FirstSeen";i:1792354556;s:10:"LastUpdate";i:1792241657;s:14:"LastUpdateScan";i:1792354556;s:8:"Category";s:35:"Network:FileSharing Tools:Utilities";s:2:"ID";i:757;s:11:"Displayable";b:1;s:6:"Author";s:9:"keibisoft";s:13:"DockerHubName";s:9:"keibidrop";s:8:"RepoName";s:22:"keibisoft's Repository";s:10:"SortAuthor";s:9:"keibisoft";s:8:"SortName";s:9:"KeibiDrop";s:6:"random";i:614591144;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/keibisoftsRepository/keibisoft-KeibiDrop-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:758;a:35:{s:4:"Name";s:9:"GameKeepr";s:10:"Repository";s:35:"ghcr.io/kengoossens/gamekeep:latest";s:8:"Registry";s:36:"https://ghcr.io/kengoossens/gamekeep";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:93:"https://forums.unraid.net/topic/200758-support-gamekeepr-game-server-portal-for-your-friends/";s:7:"Project";s:39:"https://kengoossens.github.io/Gamekeep/";s:8:"Overview";s:1715:"Your game servers, your friends' hands. GameKeepr is a self-hosted portal that lets friends see which game servers are up, who is playing, and restart a server when a game update lands - without giving anyone access to Unraid itself.

WHAT IT DOES
- Restarts verified in two stages: the container came back, then the game itself answered. Per-game startup times and a cooldown that stops restart-hammering.
- Deploy new servers from Community Applications, or any of ~580 dedicated servers on Steam - GameKeepr composes the container itself on Valve's official steamcmd image.
- Schedules (nightly restart that skips when players are online), world backups with safe restores, live logs with a console that types at the game, mod installs with archive-safety checks and optional malware scanning, Steam Workshop support for Project Zomboid and ARK.
- Three roles (member / operator / owner) with per-server exceptions, an activity log everyone can read, Discord notifications, and a built-in wiki that documents all of it.

IMPORTANT - read before installing:
This container mounts the Docker socket, which is root-equivalent on your server. It never lets a request name a container directly and never deploys privileged containers, but treat the owner password like your Unraid root password, and put Cloudflare Access or similar in front if you expose it to the internet. The built-in wiki's "Security model" page explains the full posture.

