"Name";s:10:"mangapixer";s:10:"Repository";s:33:"ghcr.io/dixit92/mangapixer:latest";s:8:"Registry";s:63:"https://github.com/dixit92/mangapixer/pkgs/container/mangapixer";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:72:"https://raw.githubusercontent.com/dixit92/unraid-templates/main/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:8:"Overview";s:1589:"MangaPixer is a self-hosted comic and manga server with a fast web reader for desktop, tablet and phone. It is folder-native: point it at your existing folders of .cbz and .cbr archives and it shows them exactly as they are organized on disk - no renaming, no metadata to curate, and your media is only ever read.

Reading: per-user reading progress and read marks, continue reading and new-chapter rows, single, double-page and vertical (webtoon) reading with right-to-left support, favorites, search, private libraries, and server-side image resizing that keeps line art and screentones clean on every screen.

Series information (optional): descriptions, authors, covers, volumes and which volumes or chapters you are missing come from ComicInfo.xml inside your archives and, only if an admin turns it on, from MangaUpdates, MangaDex, AniList, the Grand Comics Database (comics and graphic novels) and Wikipedia (volume lists).

Tracker sync (optional): once an admin allows it, each user can connect their own MyAnimeList or MangaUpdates account and have their reading progress sent there while they read. A Tracking page shows every tracked series side by side.

Other apps: an admin can create API tokens so another app on your network (such as MangaList) can read the series information and, if allowed, ask for a library scan after it adds files.

Privacy: accounts are created by an admin; there are no default credentials and no telemetry, and nothing leaves your server until an admin turns on an optional internet feature (the update check, series information or tracker sync).";s:7:"Support";s:99:"https://forums.unraid.net/topic/200672-support-dixit92-mangapixer-folder-native-comic-manga-server/";s:7:"Project";s:37:"https://github.com/dixit92/mangapixer";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/dixit92/unraid-templates/main/templates/mangapixer.xml";s:6:"ReadMe";s:80:"https://raw.githubusercontent.com/dixit92/mangapixer/main/docs/install-unraid.md";s:16:"ExtraSearchTerms";s:58:"manga comics comic reader webtoon manhwa cbz cbr yacreader";s:8:"Requires";s:160:"Your comics or manga as .cbz / .zip or non-solid .cbr / .rar archives in a share. Solid archives (including every .cb7 / .7z) are listed but cannot be read yet.";s:7:"License";s:3:"MIT";s:4:"Date";s:10:"2026-10-15";s:10:"Screenshot";a:4:{i:0;s:93:"https://raw.githubusercontent.com/dixit92/mangapixer/main/assets/screenshots/home-desktop.jpg";i:1;s:107:"https://raw.githubusercontent.com/dixit92/mangapixer/main/assets/screenshots/reader-desktop-double-page.jpg";i:2;s:100:"https://raw.githubusercontent.com/dixit92/mangapixer/main/assets/screenshots/docs-library-folder.png";i:3;s:93:"https://raw.githubusercontent.com/dixit92/mangapixer/main/assets/screenshots/reader-phone.jpg";}s:11:"ExtraParams";s:152:"--read-only --tmpfs /tmp:rw,noexec,nosuid,size=256m --security-opt=no-new-privileges:true --log-driver local --log-opt max-size=20m --log-opt max-file=5";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"6266";s:4:"Mode";s:3:"tcp";s:11:"Description";s:74:"Host port for the web UI. The server listens on 8080 inside the container.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"6266";}i:1;a:2:{s:11:"@attr