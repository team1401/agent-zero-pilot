nced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:28;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"OMBI_BASE_URL";s:6:"Target";s:13:"OMBI_BASE_URL";s:7:"Default";s:0:"";s:11:"Description";s:142:"Base URL of your Ombi instance (e.g. http://ombi:3579). Required only when REQUESTER_PROVIDER=ombi, and only if not set in /config/config.yml.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:29;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"OMBI_API_KEY";s:6:"Target";s:12:"OMBI_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:57:"Ombi API key. Required only when REQUESTER_PROVIDER=ombi.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:30;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OMBI_LANGUAGE_CODE";s:6:"Target";s:18:"OMBI_LANGUAGE_CODE";s:7:"Default";s:2:"en";s:11:"Description";s:48:"ISO 639-1 language code sent with Ombi requests.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:31;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"TICKETARR_LOG_LEVEL";s:6:"Target";s:19:"TICKETARR_LOG_LEVEL";s:7:"Default";s:4:"INFO";s:11:"Description";s:51:"Python logging level (DEBUG, INFO, WARNING, ERROR).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/ticketarr.xml";s:4:"Repo";s:25:"jivandabeast's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:14:"MediaApp-Other";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:900;s:9:"FirstSeen";i:1785424815;s:10:"LastUpdate";i:1786851757;s:14:"LastUpdateScan";i:1790645917;s:8:"Category";s:30:"Tools:Utilities MediaApp:Other";s:2:"ID";i:2658;s:11:"Displayable";b:1;s:6:"Author";s:12:"jivandabeast";s:13:"DockerHubName";s:9:"ticketarr";s:8:"RepoName";s:25:"jivandabeast's Repository";s:10:"SortAuthor";s:12:"jivandabeast";s:8:"SortName";s:9:"ticketarr";s:6:"random";i:1903380267;s:9:"Blacklist";b:0;s:4:"Path";s:120:"/tmp/community.applications/tempFiles/templates-community-apps/jivandabeastsRepository/jivandabeast-ticketarr-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2659;a:48:{s:4:"Name";s:15:"spotify-to-plex";s:10:"Repository";s:34:"jjdenhertog/spotify-to-plex:latest";s:8:"Registry";s:61:"https://registry.hub.docker.com/r/jjdenhertog/spotify-to-plex";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:0:"";s:7:"Project";s:46:"https://github.com/jjdenhertog/spotify-to-plex";s:8:"Overview";s:843:"A beautiful web application to sync your Spotify playlists with Plex. Automatically matches songs from any Spotify playlist (including Spotify-owned playlists, liked songs, and private playlists) with your Plex library using advanced matching algorithms. The app provides detailed match information and supports automatic downloads of missing tracks via Tidal Downloader or Lidarr integration.

Important: Setup an encryption key for secure Spotify user integration. Generate a random key using the command below and add it to the ENCRYPTION_KEY variable:

