:"LOG_LEVEL";s:7:"Default";s:4:"INFO";s:4:"Mode";s:0:"";s:11:"Description";s:45:"Log verbosity: DEBUG, INFO, WARNING or ERROR.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"INFO";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"LOG_FORMAT";s:6:"Target";s:10:"LOG_FORMAT";s:7:"Default";s:4:"text";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Log output format: text or json.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"text";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"LOG_FILE";s:6:"Target";s:8:"LOG_FILE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:117:"Optional path to a log file inside /config/logs (e.g. /config/logs/pocketlog.log). Leave empty to log to stdout only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/anym001/pocketlog.xml";s:4:"Repo";s:20:"Anym001's Repository";s:9:"downloads";i:4881;s:9:"FirstSeen";i:1780085059;s:10:"LastUpdate";i:1791044868;s:14:"LastUpdateScan";i:1792262791;s:12:"CategoryList";a:0:{}s:8:"Category";s:6:"Other:";s:2:"ID";i:1501;s:11:"Displayable";b:1;s:6:"Author";s:7:"anym001";s:13:"DockerHubName";s:9:"pocketlog";s:8:"RepoName";s:20:"Anym001's Repository";s:10:"SortAuthor";s:7:"anym001";s:8:"SortName";s:9:"pocketlog";s:6:"random";i:1850519829;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:110:"/tmp/community.applications/tempFiles/templates-community-apps/Anym001sRepository/anym001-pocketlog-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1502;a:42:{s:4:"Name";s:6:"AoNarr";s:10:"Repository";s:28:"allornothing/aonarr:combined";s:8:"Registry";s:44:"https://hub.docker.com/r/allornothing/aonarr";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:42:"https://github.com/aon082910/AoNarr/issues";s:7:"Project";s:35:"https://github.com/aon082910/AoNarr";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/aon082910/AoN-Unraid-Apps/main/AoNarr/aonarr.xml";s:6:"ReadMe";s:65:"https://raw.githubusercontent.com/aon082910/AoNarr/main/README.md";s:4:"Icon";s:80:"https://raw.githubusercontent.com/aon082910/AoN-Unraid-Apps/main/AoNarr/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:9876]/";s:8:"Overview";s:1743:"Self-hosted media manager covering every library the individual *arr apps split across separate
containers - Movies, TV Shows, Anime, Music, Books, Audiobooks, Comics, Manga, ROMs, Online
Videos, Courses, Podcasts and Adult - in one app, one database, one container.

Same core mechanics as Sonarr/Radarr/Lidarr/Readarr: quality profiles, custom formats, indexers
(Torznab/Newznab, Prowlarr/Jackett sync), download clients (qBittorrent, SABnzbd, Real-Debrid,
AllDebrid, direct HTTP, yt-dlp, Soulseek), notifications, calendar, naming templates, a recycle
bin, scheduled jobs, delay profiles and per-connection notification triggers - all built in, not
bolted on as separate services.

Also included: an OPDS catalog and Send-to-Kindle for e-readers, subtitle management with
multi-language downloads and a background rescan for anything missed, an MCP server for AI-agent
control, a Discord /request slash command, IRC instant-grab announce feeds (Autobrr-style), Plex/
Jellyfin/Emby watch-status sync with automatic archival, household user accounts with self-service
invite links, hardlink/symlink import strategies for debrid/rclone-mounted setups, and watch-
history-based auto-recommendations.

This is the single-container build (nginx + the API in one image) - the simplest way to run it on
Unraid. A split two-container version exists upstream for setups that want the UI and API to scale
or update independently, but the combined image here is what this template uses.

On first run, open the WebUI - it walks you through creating the admin account and generates an
API key for you. Everything else (indexers, download clients, root folders, quality profiles) is
configured from inside the app itself, not through container variables.";s:16:"ExtraSearchTerms";s:113:"sonarr radarr lidarr readarr prowlarr bazarr media manager pvr books comics manga audiobooks podcasts irc autobrr";s:8:"Requires";s:201:"An indexer (Torznab/Newznab, or Prowlarr/Jackett to sync from) and at least one download client are needed before it can actually acquire anything - both configured from inside the app after first run.";s:4:"Date";s:10:"2026-08-31";s:7:"License";s:3:"MIT";s:6:"MinVer";s:3:"6.9";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"9876";s:7:"Default";s:4:"9876";s:4:"Mode";s:3:"tcp";s:11:"Description";s:121:"Port for the web interface. The container's own API runs behind it on the same port - nothing else needs to be published.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9876";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:24:"/mnt/user/appdata/aonarr";s:4:"Mode";s:2:"rw";s:11:"Description";s:79:"Database, settings and the generated admin API key all live here. Back this up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/aonarr";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Downloads";s:6:"Target";s:10:"/downloads";s:7:"Default";s:19:"/mnt/user/downloads";s:4:"Mode";s:2:"rw";s:11:"Description";s:141:"Where your download client(s) save completed files for AoNarr to import - point this at the same share your download client itself writes to.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/mnt/user/downloads";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"rw";s:11:"Description";s:173:"Your library storage. Add indivi