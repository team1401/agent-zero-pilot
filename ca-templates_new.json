Docs: https://www.dockroute.dev";s:4:"Icon";s:99:"https://raw.githubusercontent.com/Dockroute/dockroute-site/main/public/brand/dockroute-icon-128.png";s:11:"TemplateURL";s:79:"https://raw.githubusercontent.com/Dockroute/unraid-templates/main/dockroute.xml";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"ro";s:11:"Description";s:88:"Docker Engine socket (read-only). DockRoute only listens to events and lists containers.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/var/run/docker.sock";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Provider";s:6:"Target";s:18:"DOCKROUTE_PROVIDER";s:7:"Default";s:3:"log";s:4:"Mode";s:0:"";s:11:"Description";s:91:"DNS provider: 'log' (dry run, prints desired state, no credentials needed) or 'cloudflare'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"log";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Owner ID";s:6:"Target";s:18:"DOCKROUTE_OWNER_ID";s:7:"Default";s:7:"default";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Ownership id written to companion TXT records; lets several DockRoute instances share a zone safely.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"default";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Sync policy";s:6:"Target";s:16:"DOCKROUTE_POLICY";s:7:"Default";s:4:"sync";s:4:"Mode";s:0:"";s:11:"Description";s:108:"sync = create/update/delete owned records; upsert-only = never delete; create-only = never update or delete.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"sync";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Delete grace (seconds)";s:6:"Target";s:30:"DOCKROUTE_DE