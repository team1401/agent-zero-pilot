plates/my-unraid-duplicate-file-handler.xml";s:4:"Repo";s:19:"Bovive's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1749139510;s:14:"LastUpdateScan";i:1777727399;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:205;s:11:"Displayable";b:1;s:6:"Author";s:6:"bovive";s:13:"DockerHubName";s:29:"unraid-duplicate-file-handler";s:8:"RepoName";s:19:"Bovive's Repository";s:10:"SortAuthor";s:6:"bovive";s:8:"SortName";s:29:"Unraid Duplicate File Handler";s:6:"random";i:2098249930;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/BovivesRepository/bovive-UnraidDuplicateFileHandler-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:206;a:42:{s:4:"Name";s:22:"factorio-stack-manager";s:10:"Repository";s:45:"brennanwoodbury/factorio-stack-manager:latest";s:8:"Registry";s:63:"https://hub.docker.com/r/brennanwoodbury/factorio-stack-manager";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:4:"true";s:4:"Icon";s:86:"https://raw.githubusercontent.com/BrennanWoodbury/factorio-stack-manager/main/icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:7:"Support";s:96:"https://github.com/BrennanWoodbury/factorio-stack-manager/issues/new?template=unraid-support.yml";s:7:"Project";s:57:"https://github.com/BrennanWoodbury/factorio-stack-manager";s:11:"TemplateURL";s:114:"https://raw.githubusercontent.com/BrennanWoodbury/factorio-stack-manager/main/templates/factorio-stack-manager.xml";s:6:"ReadMe";s:87:"https://raw.githubusercontent.com/BrennanWoodbury/factorio-stack-manager/main/README.md";s:16:"ExtraSearchTerms";s:59:"factorio game server multiplayer dedicated srv mods modpack";s:8:"Overview";s:1877:"Run and manage **many Factorio dedicated servers** from one web UI.

This container is the manager only. It creates each Factorio server as its own
sibling container through the Docker socket, so servers keep running across a
manager update and are managed entirely from the UI: create, start/stop, live
RCON console and container logs, saves and backups, mods and shared modpacks,
map-generation settings with per-planet previews, whitelists, and per-server
Factorio version.

Optionally, each server can be reachable at its own subdomain with no port number
to type (for example factory1.yourdomain.com), using Cloudflare DNS SRV records
plus a built-in DDNS job. That is configured in the UI, not here, and the app
works fine without it.

[b]Before you start[/b]
[ol]
[li]Pick a contiguous UDP port range for your games (default 34197-34297) and
forward it on your router to this server, using the SAME external and internal
ports. The manager only ever hands out ports from that range, so every server it
creates is reachable.[/li]
[li]Set ADMIN_PASSWORD below. It is the only required setting.[/li]
[/ol]

[b]Notes[/b]
[ul]
[li]The manager runs in privileged mode and controls the host Docker daemon through
the Docker socket. This is required to create and manage sibling Factorio
containers. Treat access to its web UI as equivalent to host administrator access,
and do not expose it directly to the internet.[/li]
[li]Game ports are published by the individual server containers, not by this one,
so there are no game ports to map here.[/li]
[li]The Factorio servers it creates appear in the Docker tab without their own
templates. That is expected — manage them from this app's UI.[/li]
[li]RCON is never exposed off the host and never appears in DNS.[/li]
[li]The Space Age mods ship with the game and require the DLC; they are enabled,
never downloaded.[/li]
[/ul]";s:8:"Requires";s:263:"<br>A contiguous UDP port range forwarded on your router (default 34197-34297),<br>privileged mode, and access to the Docker socket so the manager can create and<br>manage sibling server containers. Cloudflare DNS is optional and configured<br>inside the app.<br>";s:4:"Date";s:10:"2026-07-25";s:6:"MinVer";s:4:"6.12";s:7:"License";s:3:"MIT";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:92:"Host port for the web UI. Put a TLS reverse proxy in front if you expose it beyond your LAN.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:40:"/mnt/user/appdata/factorio-stack-manager";s:4:"Mode";s:2:"rw";s:11:"Description";s:233:"Everything persistent lives here: the manager database and each server's saves, mods and config. The manager detects the host path behind this mount automatically, so the Factorio containers it creates bind-mount the right directory.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:40:"/mnt/user/appdata/factorio-stack-manager";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker Socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"rw";s:11:"Description";s:186:"Required with privileged mode. The manager creates each Factorio server as a sibling container through this socket. Treat access to the web UI as equivalent to host administrator access.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/var/run/docker.sock";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:14:"ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"M