"Support Scryer development";s:10:"DonateLink";s:39:"https://www.scryer.media/scryer/donate/";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4380;a:41:{s:4:"Name";s:6:"Weaver";s:10:"Repository";s:34:"ghcr.io/scryer-media/weaver:latest";s:8:"Registry";s:60:"https://github.com/scryer-media/weaver/pkgs/container/weaver";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:74:"https://raw.githubusercontent.com/scryer-media/weaver-unraid/main/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:9090]/";s:8:"Overview";s:923:"Weaver is engineered to be the fastest and most secure Usenet downloader. Its native Rust core downloads NZBs, decodes articles, verifies and repairs PAR2 data, and extracts archives in one tightly integrated process. A concurrent pipeline can begin extraction while later archive volumes are still downloading, reducing handoffs, disk churn, and time to completion. Security is built in with TLS-protected provider connections, encrypted-at-rest credentials and API keys, persistent encryption-key management, optional login and scoped API access, least-privilege container support, and keyless-signed release images. Weaver also provides adaptive multi-server dispatch, global and per-server speed limits, schedules, ISP bandwidth caps, provider quotas, queue controls, real-time history and progress updates, detailed logs, Prometheus metrics, and a responsive web UI, all without requiring separate unrar or PAR2 tools.";s:7:"Support";s:45:"https://github.com/scryer-media/weaver/issues";s:7:"Project";s:32:"https://www.scryer.media/weaver/";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/scryer-media/weaver-unraid/main/templates/weaver.xml";s:6:"ReadMe";s:75:"https://raw.githubusercontent.com/scryer-media/weaver-unraid/main/README.md";s:7:"Discord";s:29:"https://discord.gg/SQmtZTanqm";s:6:"Reddit";s:38:"https://www.reddit.com/r/scryer_media/";s:16:"ExtraSearchTerms";s:76:"usenet nzb nntp downloader par2 rar sabnzbd nzbget fast secure encrypted tls";s:8:"Requires";s:28:"Access to a Usenet provider.";s:4:"Date";s:10:"2026-09-14";s:7:"License";s:51:"GPL-3.0-or-later with UnRAR source-code restriction";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"9090";s:7:"Default";s:4:"9090";s:4:"Mode";s:3:"tcp";s:11:"Description";s:39:"HTTP port for the Weaver web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:24:"/mnt/user/appdata/weaver";s:4:"Mode";s:2:"rw";s:11:"Description";s:56:"Persistent database, settings, logs, and encryption key.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Downloads";s:6:"Target";s:10:"/downloads";s:7:"Default";s:19:"/mnt/user/downloads";s:4:"Mode";s:2:"rw";s:11:"Description";s:93:"Download working and completed-file storage. Optional if you configure other paths in Weaver.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Login Username";s:6:"Target";s:31:"WEAVER_BOOTSTRAP_LOGIN_USERNAME";s:7:"Default";s:0:"";s:11:"Description";s:145:"Administrator username Weaver creates on its first start. Read only while no login exists; afterwards change the login in Settings &gt; Security.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Login Password";s:6:"Target";s:31:"WEAVER_BOOTSTRAP_LOGIN_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:158:"Password for that login, at least 8 characters. Read only while no login exists. Set it together with the username; one without the other stops the container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Access Mode";s:6:"Target";s:18:"WEAVER_ACCESS_MODE";s:7:"Default";s:0:"";s:11:"Description";s:216:"Leave empty on a new install. Set to authenticated to move an install created before Weaver 0.12.0 to the 0.12.0 access model, where every browser signs in. The move is permanent; the value can be cleared afterwards.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:43:"User ID used to own /config and run Weaver.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:44:"Group ID used to own /config and run Weaver.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:11:"Description";s:47:"Container timezone, for example America/Denver.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"022";s:11:"Description";s:34:"Optional octal file-creation mask.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Incomplete Directory";s:6:"Target";s:23:"WEAVER_INTERMEDIATE_DIR";s:7:"Default";s:21:"/downloads/incomplete";s:11:"Description";s:52:"First-run seed for incomplete and intermediate work.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"Complete Directory";s:6:"Target";s:19:"WEAVER_COMPLETE_DIR";s:7:"Default";s:19:"/downloads/complete";s:11:"Description";s:39:"First-run seed for completed downloads.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"Allowed Hostnames";s:6:"Target";s:25:"WEAVER_HTTP_ALLOWED_HOSTS";s:7:"Default";s:0:"";s:11:"Description";s:92:"Optional comma-separated DNS or reverse-proxy hostnames allowed by Weaver's Host validation.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/templates/weaver.xml";s:4:"Repo";s:19:"Weaver's Repository";s:12:"CategoryList";a:2:{i:0;s:11:"Downloaders";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1785928030;s:8:"Category";s:28:"Downloaders: Tools:Utilities";s:2:"ID";i:4380;s:11:"Displayable";b:1;s:6:"Author";s:12:"scryer-media";s:13:"DockerHubName";s:6:"weaver";s:8:"RepoName";s:19:"Weaver's Repository";s:10:"SortAuthor";s:12:"scryer-media";s:8:"SortName";s:6:"Weaver";s:6:"random";i:592329109;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:110:"/tmp/community.applications/tempFiles/templates-community-apps/WeaversRepository/scryermedia-Weaver-latest.xml";s:10:"Deprecated";b:0;s:10:"DonateText";s:26:"Support Weaver development";s:10:"DonateLink";s:39:"https://www.scryer.media/weaver/donate/";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4381;a:36:{s:4:"Name";s:6:"Reaper";s:10:"Repository";s:33:"ghcr.io/scythe-labs/reaper:latest";s:8:"Registry";s:59:"https://github.com/scythe-labs/reaper/pkgs/container/reaper";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/scythe-labs/reaper/issues";s:7:"Project";s:37:"https://github.com/scythe-labs/reaper";s:8:"Overview";s:1301:"Reaper finds media nobody watches, explains why it thinks each item is expendable, and removes it safely through Sonarr and Radarr. It reads watch history from Tautulli and requests from Seerr, and it refreshes Plex when it is done.

Deletion is off until you turn it on. Until then Reaper can only scan, score and explain, so you can run it for weeks and just read the results. It never touches your files directly: everything goes through Sonarr and Radarr, so this container needs no access to your media shares.

Installing asks which channel you want. Releases are the steadier one. The dev channel follows daily development and changes often.

Ownership of the data folder is handled for you. The container fixes it on start and then drops to the user set by PUID and PGID (default 99 and 100, Unraid's nobody:users), so you do not need to chown anything first.

Then open the WebUI and follow the setup wizard. It creates your admin login and links Plex, Sonarr, Radarr, Tautulli and Seerr. API keys are entered there and stored encrypted, not in this template.

Back up the data folder. It holds reaper.db and secret.key, and secret.key is the only thing that can decrypt your stored API keys.

Locked out? Open this container's console and run: reaper-admin reset-password --username yourname";s:5:"WebUI";s:24:"http://[IP]:[PORT:8420]/";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/scythe-labs/reaper/dev/contrib/unraid/my-Reaper.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/scythe-labs/reaper/dev/frontend/public/icon-512.png";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI port";s:6:"Target";s:4:"8420";s:7:"Default";s:4:"8420";s:4:"Mode";s:3:"tcp";s:11:"Description";s:121:"The port you reach Reaper's web interface on. Running a second copy beside this one? Give that one a different port here.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8420";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:24:"/mnt/user/appdata/reaper";s:4:"Mode";s:2:"rw";s:11:"Description";s:242:"Reaper's database, its encryption key, and the cached data it scans. Back this folder up. Its ownership is fixed automatically on start, so you do not need to chown it. Running a second copy beside this one? Give that one its own folder here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/reaper";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:210:"The user id Reaper runs as. The container fixes the data folder to this user on start, then drops to it before opening the database. The default 99 is Unraid's nobody, so your appdata stays owned the usual way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:87:"The group id Reaper runs as, paired with PUID. The default 100 is Unraid's users group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Allow deletion";s:6:"Target";s:34:"REAPER_DESTRUCTIVE_ACTIONS_ENABLED";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:311:"The starting state for deletion, used on the first run only. Leave it false. After the first run Reaper remembers your choice and this field is ignored: you turn deletion on in the web interface under Policy, which asks for your password. Set it true only if you want a fresh install to come up ready to delete.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Encryption key";s:6:"Target";s:17:"REAPER_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:361:"Optional. Encrypts your stored API keys. Leave it empty and Reaper makes one on first start and saves it to the data folder as secret.key, which you back up with the database. Fill it in only if you would rather hold the key yourself, for example from a password manager. Generate one with: python -c &quot;import secrets; print(secrets.token_urlsafe(32))&quot;";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Recovery mode";s:6:"Target";s:15:"REAPER_RECOVERY";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:156:"Set true and restart to print a single-use login link to this container's log, good for 15 minutes. Use it if you are locked out, then set it back to false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"Warn users before deletion is on";s:6:"Target";s:33:"REAPER_ALLOW_UNARMED_LEAVING_SOON";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:261:"Set true to let Reaper add the Leaving Soon label in Plex while deletion is still off, so your users see the warning during the countdown rather than after you turn deletion on. The label is reversible and touches no files, and this can never permit a deletion.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log level";s:6:"Target";s:16:"REAPER_LOG_LEVEL";s:7:"Default";s:4:"INFO";s:4:"Mode";s:0:"";s:11:"Description";s:292:"How much detail goes to the log: DEBUG, INFO, WARNING or ERROR. Change it later in the web interface, under Settings, Logs, and Reaper remembers that choice and ignores this field. ERROR is the one level that picker does not offer, so set it here before you pick a level in the web interface.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"INFO";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Logs as JSON";s:6:"Target";s:15:"REAPER_LOG_JSON";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Set true to write the log as one JSON object per line, for a log collector. Leave false for logs meant to be read by a person.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Discord webhook";s:6:"Target";s:22:"REAPER_DISCORD_WEBHOOK";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:264:"Optional, and used on the first start only. It tells your users what is leaving soon. The whole URL is a secret. After the first start the web interface is where you change it, and a value left here is ignored, so removing it later does not turn notifications of