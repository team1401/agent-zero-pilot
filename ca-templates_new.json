n.";s:5:"WebUI";s:25:"http://[IP]:[PORT:12121]/";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/theodorecharles/unraid-templates/master/broadcaster.xml";s:4:"Icon";s:100:"https://raw.githubusercontent.com/theodorecharles/Broadcaster/refs/heads/master/broadcaster_icon.png";s:11:"ExtraParams";s:16:"--runtime=nvidia";s:8:"Requires";s:511:"<br>&nbsp;&nbsp;&nbsp;&nbsp;Before first run:<br>&nbsp;&nbsp;&nbsp;&nbsp;1. Media Directory - Point to your media library (read-only access)<br>&nbsp;&nbsp;&nbsp;&nbsp;2. NVIDIA GPU - Requires NVIDIA Container Toolkit installed on Unraid (Community Applications: Nvidia-Driver)<br><br>&nbsp;&nbsp;&nbsp;&nbsp;After first run, create a channels.json in your Data Directory:<br>&nbsp;&nbsp;&nbsp;&nbsp;}><br><br>&nbsp;&nbsp;&nbsp;&nbsp;See https://github.com/theodorecharles/Broadcaster for full documentation<br>";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:5:"12121";s:7:"Default";s:5:"12121";s:4:"Mode";s:3:"tcp";s:11:"Description";s:18:"Web interface port";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"12121";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Data Directory";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/broadcaster";s:4:"Mode";s:2:"rw";s:11:"Description";s:75:"Storage for HLS streams, config files (channels.json, config.txt), and logs";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/broadcaster";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Media Directory";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"ro";s:11:"Description";s:41:"Your media files (movies, TV shows, etc.)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/media";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"