ory";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:2199;s:11:"Displayable";b:1;s:6:"Author";s:10:"hernandito";s:13:"DockerHubName";s:17:"tinymmv.5-selkies";s:8:"RepoName";s:23:"hernandito's Repository";s:10:"SortAuthor";s:10:"hernandito";s:8:"SortName";s:17:"TinyMMv.5 Selkies";s:6:"random";i:431231586;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:122:"/tmp/community.applications/tempFiles/templates-community-apps/hernanditosRepository/hernandito-TinyMMv5Selkies-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:-43.214;s:12:"trendAverage";d:23.338;s:10:"DonateText";s:15:"Buy me a coffee";s:10:"DonateLink";s:35:"https://buymeacoffee.com/hernandito";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2200;a:50:{s:4:"Name";s:11:"Whisper-asr";s:10:"Repository";s:50:"onerahmet/openai-whisper-asr-webservice:latest-gpu";s:8:"Registry";s:74:"https://registry.hub.docker.com/r/onerahmet/openai-whisper-asr-webservice/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/ahmetoner/whisper-asr-webservice/issues";s:7:"Project";s:51:"https://github.com/ahmetoner/whisper-asr-webservice";s:8:"Overview";s:632:"GPU accelerated Whisper ASR Webservice using the faster-whisper engine, exposing an HTTP API that returns word-level timestamps. This image ALSO contains WhisperX (word-alignment), which SubSyncarr calls directly - no separate install. Models are stored on the host (ASR_MODEL_PATH) so they are NOT baked into the docker image. The two "SubSyncarr patch" file-mappings at the bottom bind-mount SubSyncarr's patched engine files over the image's copies, which adds the multilingual=true per-segment language option to /asr and survives image upgrades (no re-apply needed). Leave those two mappings empty if you do not use SubSyncarr.";s:5:"WebUI";s:28:"http://[IP]:[PORT:9000]/docs";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/hernandito/docker-templates/master/hernando/whisper-asr.xml";s:4:"Icon";s:93:"https://raw.githubusercontent.com/hernandito/docker-templates/master/hernando/whisper-asr.png";s:11:"ExtraParams";s:10:"--gpus all";s:8:"Requires";s:240:"Requires the unRAID &quot;Nvidia Driver&quot; plugin and an NVIDIA GPU. First start downloads the model (large-v3 ~3 GB) to the Models path below. On a 6GB card keep ASR_QUANTIZATION=int8. (No NVIDIA GPU? Use the CPU-only template instead.)";s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"WebUI / API Port";s:6:"Target";s:4:"9000";s:7:"Default";s:4:"9000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:47:"HTTP API + Swagger docs (http://host:9000/docs)";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"ASR_ENGINE";s:6:"Target";s:10:"ASR_ENGINE";s:7:"Default";s:14:"faster_whisper";s:4:"Mode";s:0:"";s:11:"Description";s:302:"Engine: openai_whisper, faster_whisper, or whisperx. Use faster_whisper (it supports SubSyncarr's multilingual=true per-segment detection). WhisperX is still in the image and SubSyncarr calls its aligner directly - do NOT set this to whisperx (its engine mode currently fails at startup on this image).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"faster_whisper";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"ASR_MODEL";s:6:"Target";s:9:"ASR_MODEL";s:7:"Default";s:8:"large-v3";s:4:"Mode";s:0:"";s:11:"Description";s:79:"Model: tiny, base, small, medium, large-v3. Larger = more accurate + more VRAM.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"large-v3";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"ASR_QUANTIZATION";s:6:"Target";s:16:"ASR_QUANTIZATION";s:7:"Default";s:4:"int8";s:4:"Mode";s:0:"";s:11:"Description";s:210:"Model precision: float32, float16, int8. 