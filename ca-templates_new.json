62784386;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4677.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"BranchName";s:7:"nightly";s:17:"BranchDescription";s:107:"Nightly builds from main. New features sooner, occasional rough edges. Not recommended for production data.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4678;a:36:{s:4:"Name";s:7:"Ferrite";s:10:"Repository";s:37:"ghcr.io/syntlyx/ferrite-server:latest";s:8:"Registry";s:71:"https://github.com/syntlyx/ferrite-server/pkgs/container/ferrite-server";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/syntlyx/ferrite-server/issues";s:7:"Project";s:41:"https://github.com/syntlyx/ferrite-server";s:8:"Overview";s:579:"Ferrite is self-hosted DNS that blocks ads and trackers — and routes chosen domains or devices through a tunnel. A Pi-hole-style sinkhole in one Rust binary that goes further: selective routing through built-in WireGuard — kernel-backed for line-rate throughput where the host allows it, with an in-process userspace fallback that needs nothing from the kernel — plus SOCKS5/Tor and a DPI-evasion path; encrypted upstream resolvers (DoH/DoT/DoQ) with DNSSEC forwarding; per-device query history keyed by MAC; live query log and a web/API management surface with hot-reload.";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:11:"TemplateURL";s:81:"https://raw.githubusercontent.com/syntlyx/ferrite-unraid/main/ferrite/ferrite.xml";s:4:"Icon";s:79:"https://raw.githubusercontent.com/syntlyx/ferrite-unraid/main/icons/ferrite.png";s:11:"ExtraParams";s:46:"--cap-add=NET_BIND_SERVICE --cap-add=NET_ADMIN";s:8:"Requires";s:943:"Ports 53 TCP/UDP and 80 TCP must be available on the selected Unraid network/IP; the selective-routing (tunnels) feature additionally needs 443 TCP reachable unmapped. A custom Docker network or fixed IP (br0) is recommended: the Unraid web UI often already uses host ports 80/443, and routed domains require clients to reach Ferrite on the real ports 80/443. All Ferrite config, SQLite data, blocklist cache, snapshots, and web assets are stored under /mnt/user/appdata/ferrite. The template grants NET_BIND_SERVICE (to bind port 53 without running as root) and NET_ADMIN (for kernel-mode WireGuard tunnels: Ferrite creates its own wg interface over netlink and routes only its own traffic through it, never touching the host routing table). Kernel mode also needs the wireguard module on the Unraid host, which is present on 6.9 and newer; without it Ferrite falls back to the userspace tunnel automatically and logs which backend it picked.";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:16:"/var/lib/ferrite";s:7:"Default";s:25:"/mnt/user/appdata/ferrite";s:4:"Mode";s:2:"rw";s:11:"Description";s:83:"Stores Ferrite config, SQLite database, blocklist cache, snapshots, and web assets.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/ferrite";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"DNS TCP";s:6:"Target";s:2:"53";s:7:"Default";s:2:"53";s:4:"Mode";s:3:"tcp";s:11:"Description";s:37:"DNS TCP listener for name resolution.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"53";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"DNS UDP";s:6:"Target";s:2:"53";s:7:"Default";s:2:"53";s:4:"Mode";s:3:"udp";s:11:"Description";s:37:"DNS UDP listener for name resolution.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"53";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Web UI";s:6:"Target";s:2:"80";s:7:"Default";s:2:"80";s:4:"Mode";s:3:"tcp";s:11:"Description";s:95:"Ferrite API and web UI. Also intercepts HTTP for routed domains (demultiplexed by Host header).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"80";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"HTTPS Routing";s:6:"Target";s:3:"443";s:7:"Default";s:3:"443";s:4:"Mode";s:3:"tcp";s:11:"Description";s:180:"HTTPS (SNI) intercept for the selective-routing/tunnels feature. Only bound while routing is enabled. Must stay 443:443 for routing to work; leave unmapped if tunnels are not used.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"443";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Server Release Version";s:6:"Target";s:22:"FERRITE_SERVER_VERSION";s:7:"Default";s:6:"latest";s:4:"Mode";s:0:"";s:11:"Description";s:164:"Use latest to install the newest Ferrite release on container start. Set a fixed version, for example 0.1.1, to disable automatic server release updates on restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"latest";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Web Release Version";s:6:"Target";s:19:"FERRITE_WEB_VERSION";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:128:"Optional web UI release version. Leave blank to follow Server Release Version; set a fixed version to pin the web UI separately.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Panel IP";s:6:"Target";s:16:"FERRITE_PANEL_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:154:"Optional LAN IP for the built-in fe.te A record. In bridge networking set this to the Unraid host IP, for example 192.168.1.5. Leave blank to auto-detect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attri