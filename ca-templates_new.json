"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:11:"Description";s:266:"Container directory where Unraid's CA Tailscale integration stores its state (machine key, node info). Kept under /root/.claude so it persists across container recreation and image updates. Only used when Tailscale is enabled via the Docker template's Advanced View.";}s:5:"value";s:23:"/root/.claude/tailscale";}}s:12:"TemplatePath";s:59:"/tmp/GitHub/AppFeed/templates/claudeclaw-plus-container.xml";s:4:"Repo";s:27:"claudeclaw-plus' Repository";s:12:"CategoryList";a:1:{i:0;s:2:"AI";}s:9:"FirstSeen";i:1779206095;s:8:"Category";s:3:"AI:";s:2:"ID";i:4204;s:11:"Displayable";b:1;s:6:"Author";s:9:"paulmeier";s:13:"DockerHubName";s:15:"claudeclaw-plus";s:8:"RepoName";s:27:"claudeclaw-plus' Repository";s:10:"SortAuthor";s:9:"paulmeier";s:8:"SortName";s:15:"claudeclaw plus";s:6:"random";i:934232487;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:123:"/tmp/community.applications/tempFiles/templates-community-apps/claudeclawplusRepository/paulmeier-claudeclawplus-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4205;a:52:{s:4:"Name";s:11:"Grafana-MCP";s:10:"Repository";s:26:"grafana/mcp-grafana:latest";s:8:"Registry";s:44:"https://hub.docker.com/r/grafana/mcp-grafana";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:7:"Support";s:54:"https://github.com/paulmeier/mcp-grafana-unraid/issues";s:7:"Project";s:38:"https://github.com/grafana/mcp-grafana";s:4:"Icon";s:89:"https://raw.githubusercontent.com/paulmeier/mcp-grafana-unraid/main/icons/mcp-grafana.png";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/paulmeier/mcp-grafana-unraid/main/templates/mcp-grafana.xml";s:5:"WebUI";s:31:"http://[IP]:[PORT:8000]/healthz";s:17:"TailscaleStateDir";s:25:"/appdata/.tailscale_state";s:8:"Overview";s:692:"Grafana MCP is the official Model Context Protocol server from Grafana Labs. It exposes your Grafana instance to AI assistants and other MCP clients through a single endpoint, so a client such as Claude can search dashboards, run Prometheus and Loki queries, inspect datasources, review alert rules and incidents, explore profiles, and more, using scoped tools instead of raw API calls. The container runs the server in SSE transport mode on port 8000 and serves the MCP endpoint at /sse. It needs a reachable Grafana instance and a Grafana service account token to authenticate. This is a headless server with no browsable web interface: point your MCP client at http://[Unraid-IP]:8000/sse.";s:8:"Requires";s:447:"A running Grafana instance that this container can reach over the network, plus a Grafana service account token. Create the token in Grafana under Administration, then Users and access, then Service accounts, granting the service account only the roles you want the MCP server to be able to use. In the Grafana URL field use the Grafana host LAN IP or container name, not localhost, which inside the container points back at the MCP server itself.";s:16:"ExtraSearchTerms";s:149:"grafana mcp model context protocol ai llm claude anthropic observability dashboards prometheus loki alerts incidents sse streamable http grafana labs";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"MCP Server Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:191:"Host port mapped to the Grafana MCP server. MCP clients connect to http://[UNRAID-IP]:[this port]/sse for the SSE transport. Change only the host side if 8000 is already taken on your server.";}s:5:"value";s:4:"8000";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Grafana URL";s:6:"Target";s:11:"GRAFANA_URL";s:7:"Default";s:27:"http://GRAFANA-HOST-IP:3000";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:501:"Full base URL of the Grafana instance the MCP server connects to, including scheme and port. Example http://192.168.1.10:3000 or https://grafana.example.com . Do not use localhost or 127.0.0.1 here, because inside the container those refer to the MCP server itself, not your Grafana. If Grafana runs as another Docker container on this same Unraid host, use the Unraid host LAN IP with the published Grafana port, or put both containers on one custom Docker network and use the Grafana container name.";}s:5:"value";s:27:"http://GRAFANA-HOST-IP:3000";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:29:"Grafana Service Account Token";s:6:"Target";s:29:"GRAFANA_SERVICE_ACCOUNT_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";s:11:"Description";s:355:"Grafana service account token used to authenticate every request to Grafana. In Grafana go to Administration, then Users and access, then Service accounts, create a service account with the roles you want to grant, add a token, and paste it here. This is the recommended authentication method and replaces the deprecated API key. Treat it like a password.";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Grafana Org ID";s:6:"Target";s:14:"GRAFANA_ORG_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:144:"Optional Grafana organization ID to scope requests to. Useful on multi-org instances. Leave blank to use the default organization for the token.";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Extra Headers";s:6:"Target";s:21:"GRAFANA_EXTRA_HEADERS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:239:"Optional extra HTTP headers sent with every Grafana request, given as a JSON object mapping header names to values. Handy for tenant routing on Grafana Cloud or Mimir, for example an X-Scope-OrgID header. Leave blank if you do not need it.";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:108:"Container timezone, used for log timestamps. Example Europe/Madrid or America/New_York. Leave blank for UTC.";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Appdata (Tailscale state)";s:6:"Target";s:8:"/appdata";s:7:"Default";s:29:"/mnt/user/appdata/mcp-grafana";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:367:"Small writable folder used only to persist Tailscale state when you enable Unraid built-in Tailscale integration. The Grafana MCP server itself is stateless and stores nothing here. If you do not use Tailscale you can safely leave this at its default. Keeping it mapped lets the Use Tailscale toggle work without the Couldn't detect persistent Docker directory error.";}s:5:"value";s:29:"/mnt/user/appdata/mcp-grafana";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/mcp-grafana.xml";s:4:"Repo";s:34:"UnraidUser-8400968429's Repository";s:12:"CategoryList";a:3:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";i:2;s:18:"Network-Management";}s:8:"Official";b:1;s:5:"stars";i:1;s:9:"downloads";i:3712226;s:13:"downloadtrend";a:4:{i:0;i:1266339;i:1;i:1447588;i:2;i:2361707;i:3;i:3712226;}s:8:"trending";d:36.38;s:6:"trends";a:3:{i:0;d:12.521;i:1;d:38.706;i:2;d:36.38;}s:10:"trendsDate";a:3:{i:0;i:1786105684;i:1;i:1788711256;i:2;i:1791384879;}s:9:"FirstSeen";i:1783512296;s:10:"LastUpdate";i:1790858211;s:14:"LastUpdateScan";i:1791384879;s:11:"topTrending";d:23.859;s:8:"Category";s:48:"Productivity: Tools:Utilities Network:Management";s:2:"ID";i:4205;s:11:"Displayable";b:1;s:6:"Author";s:7:"grafana";s:13:"DockerHubName";s:11:"grafana-mcp";s:8:"RepoName";s:34:"UnraidUser-8400968429's Repository";s:10:"SortAuthor";s:7:"grafana";s:8:"SortName";s:11:"Grafana MCP";s:6:"random";i:66765630;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:124:"/tmp/community.applications/tempFiles/templates-community-apps/UnraidUser8400968429sRepository/grafana-GrafanaMCP-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:23.859;s:12:"trendAverage";d:29.2023;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4206;a:48:{s:4:"Name";s:8:"OxiCloud";s:10:"Repository";s:25:"diocrafts/oxicloud:latest";s:8:"Registry";s:43:"https://hub.docker.com/r/diocrafts/oxicloud";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:7:"Support";s:51:"https://github.com/paulmeier/oxicloud-unraid/issues";s:7:"Project";s:39:"https://github.com/AtalayaLabs/OxiCloud";s:4:"Icon";s:83:"https://raw.githubusercontent.com/paulmeier/oxicloud-unraid/main/icons/oxicloud.png";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/paulmeier/oxicloud-unraid/main/templates/oxicloud.xml";s:5:"WebUI";s:23:"http://[IP]:[PORT:8086]";s:17:"TailscaleStateDir";s:29:"/app/storage/.tailscale_state";s:8:"Overview";s:504:"OxiCloud is an ultra-fast, lightweight self-hosted cloud built in Rust. It gives you files, sharing, previews, trash, search, photos, plus calendars and contacts over WebDAV, CalDAV, and CardDAV, with OIDC SSO, per-user quotas, and shared links. OxiCloud needs an EXTERNAL PostgreSQL database (it has no built-in DB) so install a PostgreSQL container first. The schema is created automatically on first start. There is no default login: open the WebUI after the first start and create your admin account.";s:8:"Requires";s:314:"An external PostgreSQL database is required. Install a PostgreSQL container (for example the official postgres image from Community Applications), create a database and a user, then fill in the Database Connection String field before starting OxiCloud. On first start, open the WebUI and create your admin account.";s:16:"ExtraSearchTerms";s:130:"cloud storage files nextcloud alternative owncloud webdav caldav carddav rust self-hosted oidc sso photos calendar contacts office";s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8086";s:7:"Default";s:4:"8086";s:4:"Mode";s:3:"tcp";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:107:"Host port mapped to the OxiCloud web interface. Browse to http://[UNRAID-IP]:[this port] to reach OxiCloud.";}s:5:"value";s:4:"8086";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:26:"Database Connection String";s:6:"Target";s:29:"OXICLOUD_DB_CONNECTION_STRING";s:7:"Default";s:50:"postgres://oxicloud:oxicloud@HOST-IP:5432/oxicloud";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:382:"PostgreSQL connection string. OxiCloud has no built-in database so it needs an external PostgreSQL container. After installing PostgreSQL, create a database and a role both named oxicloud, then replace HOST-IP with that container address or the Unraid host IP. Example postgres://oxicloud:yourpassword@192.168.1.10:5432/oxicloud . The schema is created automatically on first start.";}s:5:"value";s:50:"postgres://oxicloud:oxicloud@HOST-IP:5432/oxicloud";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"Storage";s:6:"Target";s:12:"/app/storage";s:7:"Default";s:26:"/mnt/user/appdata/oxicloud";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:331:"Holds all user files (the content-addressable blob store), the auto-generated JWT secret, the full-text search index, and the Tailscale state directory. Must persist across restarts and image updates. For a large file library you can point this at an array share such as /mnt/user/oxicloud instead of the cache-backed appdata path.";}s:5:"value";s:26:"/mnt/user/appdata/oxicloud";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Bind Address";s:6:"Target";s:20:"OXICLOUD_SERVER_HOST";s:7:"Default";s:7:"0.0.0.0";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:11:"Description";s:141:"Interface OxiCloud binds inside the container. Must stay 0.0.0.0 or the container becomes unreachable through the mapped port. Do not change.";}s:5:"value";s:7:"0.0.0.0";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Internal Server Port";s:6:"Target";s:20:"OXICLOUD_SERVER_PORT";s:7:"Default";s:4:"8086";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:11:"Description";s:162:"Port OxiCloud listens on inside the container. Keep it matched to the container side of the WebUI Port mapping above (8086). Change both together if you remap it.";}s:5:"value";s:4:"8086";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"JWT Secret";s:6:"Target";s:19:"OXICLOUD_JWT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:318:"Secret that signs session tokens (HS256). Leave blank to let OxiCloud generate a strong one on first start and persist it inside the Storage volume as .jwt_secret, which survives restarts. Set your own (minimum 32 characters) only if you want a fixed value across redeployments. Generate one with: openssl rand -hex 32";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Public Base URL";s:6:"Target";s:17:"OXICLOUD_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:330:"External URL clients use to reach OxiCloud, including the scheme. Set this when access goes through a reverse proxy, a custom domain, or a Tailscale hostname so generated share links and OIDC redirects are correct. Example https://oxicloud.your-tailnet.ts.net or https://cloud.example.com . Leave blank for plain LAN access by IP.";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Disable Open Registration";s:6:"Target";s:29:"OXICLOUD_DISABLE_REGISTRATION";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:158:"Set to true to block public self-registration once you have created your accounts. Recommended for an internet-exposed instance. Leave false while setting up.";}s:5:"value";s:5:"false";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:142:"Container timezone, used for log timestamps. tzdata is installed in the image. Example Europe/Madrid or America/New_York. Leave blank for UTC.";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/oxicloud.xml";s:4:"Repo";s:24:"paulynomial's Repository";s:12:"CategoryList";a:3:{i:0;s:5:"Cloud";i:1;s:11:"Network-Web";i:2;s:12:"Productivity";}s:5:"stars";i:5;s:9:"downloads";i:114175;s:13:"downloadtrend";a:3:{i:0;i:25277;i:1;i:69079;i:2;i:114175;}s:8:"trending";d:63.409;s:6:"trends";a:2:{i:0;d:63.409;i:1;d:39.497;}s:10:"trendsDate";a:2:{i:0;i:1787227551;i:1;i:1790001868;}s:9:"FirstSeen";i:1782043347;s:10:"LastUpdate";i:1789742470;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:32:"Cloud: Network:Web Productivity:";s:2:"ID";i:4206;s:11:"Displayable";b:1;s:6:"Author";s:9:"diocrafts";s:13:"DockerHubName";s:8:"oxicloud";s:8:"RepoName";s:24:"paulynomial's Repository";s:10:"SortAuthor";s:9:"diocrafts";s:8:"SortName";s:8:"OxiCloud";s:6:"random";i:1894798136;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/paulynomialsRepository/diocrafts-OxiCloud-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:-23.912;s:12:"trendAverage";d:51.453;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4207;a:37:{s:4:"Name";s:17:"Paperless-NGX-MCP";s:10:"Repository";s:52:"ghcr.io/paulmeier/paperless-ngx-mcp-container:latest";s:8:"Registry";s:99:"https://github.com/paulmeier/paperless-ngx-mcp-container/pkgs/container/paperless-ngx-mcp-container";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:4:"bash";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:7:"Support";s:60:"https://github.com/paulmeier/paperless-ngx-mcp-unraid/issues";s:7:"Project";s:56:"https://github.com/paulmeier/paperless-ngx-mcp-container";s:4:"Icon";s:101:"https://raw.githubusercontent.com/paulmeier/paperless-ngx-mcp-unraid/main/icons/paperless-ngx-mcp.png";s:11:"TemplateURL";s:105:"https://raw.githubusercontent.com/paulmeier/paperless-ngx-mcp-unraid/main/templates/paperless-ngx-mcp.xml";s:17:"TailscaleStateDir";s:25:"/appdata/.tailscale_state";s:8:"Overview";s:781:"Paperless-NGX MCP is a Model Context Protocol server that connects AI assistants and other MCP clients to your Paperless-NGX document archive. A client such as Claude can search your documents, read their content and metadata, and manage tags, correspondents, and document types through scoped tools instead of raw API calls. This container runs the server in streamable HTTP transport mode on port 3000 and serves the MCP endpoint at POST /mcp. It needs a reachable Paperless-NGX instance and a Paperless-NGX API token to authenticate. This is a headless server with no browsable web interface: point your MCP client at http://[Unraid-IP]:3000/mcp . The image is maintained at paulmeier/paperless-ngx-mcp-container and wraps the upstream paperless-ngx-mcp project by cubinet-code.";s:8:"Requires";s:505:"A running Paperless-NGX instance that this container can reach over the network, plus a Paperless-NGX API token. Create the token in Paperless-NGX under Settings, then the user menu, then API Token. The token inherits the permissions of the Paperless user that owns it, so use an account scoped to only what you want the MCP server to be able to do. In the Paperless URL field use the Paperless host LAN IP or container name, not localhost, which inside the container points back at the MCP server itself.";s:16:"ExtraSearchTerms";s:164:"paperless paperless-ngx paperlessngx mcp model context protocol ai llm claude anthropic documents document management dms ocr archive search streamable http cubinet";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"MCP Server Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:209:"Host port mapped to the paperless-ngx-mcp server. MCP clients connect to http://[UNRAID-IP]:[this port]/mcp for the streamable HTTP transport. Change only the host side if 3000 is already taken on your server.";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Paperless URL";s:6:"Target";s:13:"PAPERLESS_URL";s:7:"Default";s:29:"https://paperless.example.com";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:11:"Description";s:541:"Full base URL of the Paperless-NGX instance the MCP server connects to, including scheme and port if non-standard. Example http://192.168.1.10:8000 or https://paperless.example.com . Do not use localhost or 127.0.0.1 here, because inside the container those refer to the MCP server itself, not your Paperless-NGX. If Paperless-NGX runs as another Docker container on this same Unraid host, use the Unraid host LAN IP with the published Paperless port, or put both containers on one custom Docker network and use the Paperless container name.";}s:5:"value";s:29:"https://paperless.example.com";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Paperless API Token";s:6:"Target";s:17:"PAPERLESS_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";s:11:"Description";s:313:"Paperless-NGX API token used to authenticate every request to Paperless. In Paperless-NGX open Settings, then the user menu, then API Token, create or copy a token, and paste it here. The token inherits the permissions of its owning Paperless user, so scope that user to least privilege. Treat it like a password.";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Paperless Public URL";s:6:"Target";s:20:"PAPERLESS_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:282:"Optional public-facing base URL used when the server builds shareable document links. Set this only if your Paperless-NGX is reached through a different external address than the Paperless URL above, for example behind a reverse proxy. Leave blank to fall back to the Paperless URL.";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:108:"Container timezone, used for log timestamps. Example Europe/Madrid or America/New_York. Leave blank for UTC.";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"Appdata (Tailscale state)";s:6:"Target";s:8:"/appdata";s:7:"Default";s:35:"/mnt/user/appdata/paperless-ngx-mcp";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:11:"Description";s:373:"Small writable folder used only to persist Tailscale state when you enable Unraid built-in Tailscale integration. The paperless-ngx-mcp server itself is stateless and stores nothing here. If you do not use Tailscale you can safely leave this at its default. Keeping it mapped lets the Use Tailscale toggle work without the Couldn't detect persistent Docker directory error.";}s:5:"value";s:35:"/mnt/user/appdata/paperless-ngx-mcp";}}s:12:"TemplatePath";s:51:"/tmp/GitHub/AppFeed/templates/paperless-ngx-mcp.xml";s:4:"Repo";s:18:"pauly's Repository";s:12:"CategoryList";a:3:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";i:2;s:18:"Network-Management";}s:9:"FirstSeen";i:1783613081;s:8:"Category";s:48:"Productivity: Tools:Utilities Network:Management";s:2:"ID";i:4207;s:11:"Displayable";b:1;s:6:"Author";s:9:"paulmeier";s:13:"DockerHubName";s:17:"paperless-ngx-mcp";s:8:"RepoName";s:18:"pauly's Repository";s:10:"SortAuthor";s:9:"paulmeier";s:8:"SortName";s:17:"Paperless NGX MCP";s:6:"random";i:2129040415;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/paulysRepository/paulmeier-PaperlessNGXMCP-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4208;a:49:{s:4:"Name";s:7:"flexget";s:10:"Repository";s:23:"wiserain/flexget:latest";s:8:"Registry";s:48:"https://hub.docker.com/r/wiserain/flexget:latest";s:8:"Requires";s:16:"binhex-delugevpn";s:7:"Network";s:4:"none";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:4:"true";s:7:"Support";s:73:"https://forums.unraid.net/topic/114713-support-paulpoco-flexget-template/";s:7:"Project";s:19:"http://flexget.com/";s:8:"Overview";s:163:"FlexGet is a multipurpose automation tool for all of your media.  REQUIRES binhex-delugevpn to be installed 1st.  Then follow instructions at Binhex's VPN FAQ Q24.";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/paulpoco/docker-templates/master/paulpoco/flexget.xml";s:4:"Icon";s:101:"https://github.com/paulpoco/docker-templates/raw/master/paulpoco/images/