:8:"Overview";s:1152:"NASearch — a lightweight, self-hosted file search UI for your Unraid array.

    Powered by plocate, it indexes your entire array in seconds and delivers instant search across millions of files — directly in your browser.

    FEATURES
    • Rich file previews — images, video (with seek), audio, PDF, rendered Markdown, interactive 3D STL models (WebGL, no plugins), and ZIP contents browser — all inline.
    • Folder browsing — click any result to explore its directory tree; download individual files or whole folders as ZIP archives.
    • Secure login — session-cookie authentication with CSRF protection and rate limiting. No credentials in URLs.
    • Themes & colour customisation — built-in dark, purple, slate, and light themes; set your own background, text, and accent colours; optional scanline overlay.
    • Auto-indexing — configurable scheduler (1 h to 7 days) or manual trigger via the UI; real-time progress indicator.

    No Elasticsearch. No Node. No build step. One container, one volume.

    IMPORTANT: You must set either AUTH_USER + AUTH_PASS (recommended) or NOAUTH=true before the app will start.";s:10:"Screenshot";s:78:"https://raw.githubusercontent.com/dewgenenny/nasearch/main/docs/screenshot.png";s:7:"Support";s:45:"https://github.com/dewgenenny/nasearch/issues";s:7:"Project";s:38:"https://github.com/dewgenenny/nasearch";s:6:"ReadMe";s:68:"https://raw.githubusercontent.com/dewgenenny/nasearch/main/README.md";s:7:"License";s:3:"MIT";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:42:"Port to access the NASearch web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Array Path";s:6:"Target";s:5:"/data";s:7:"Default";s:9:"/mnt/user";s:4:"Mode";s:2:"ro";s:11:"Description";s:92:"Root of your Unraid array, mounted read-only. NASearch will index and serve files from here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"/mnt/user";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Index &amp; Config Storage";s:6:"Target";s:6:"/index";s:7:"Default";s:26:"/mnt/user/appdata/nasearch";s:4:"Mode";s:2:"rw";s:11:"Description";s:62:"Persistent storage for the plocate database and settings.json.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nasearch";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Auth Username";s:6:"Target";s:9:"AUTH_USER";s:7:"Default";s:0:"";s:11:"Description";s:88:"Login username. Set both AUTH_USER and AUTH_PASS to enable authentication (recommended).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Auth