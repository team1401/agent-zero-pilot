;s:8:"fansmall";s:13:"DockerHubName";s:15:"frontend-killer";s:8:"RepoName";s:21:"fansmall's Repository";s:10:"SortAuthor";s:8:"fansmall";s:8:"SortName";s:15:"Frontend Killer";s:6:"random";i:1538877999;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/fansmallsRepository/fansmall-FrontendKiller-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2060;a:39:{s:4:"Name";s:11:"meerkat-crm";s:10:"Repository";s:35:"ghcr.io/fbuchner/meerkat-crm:latest";s:8:"Registry";s:66:"https://github.com/fbuchner/meerkat-crm/pkgs/container/meerkat-crm";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:71:"https://raw.githubusercontent.com/fbuchner/meerkat-unraid/main/icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:1137:"Meerkat CRM is a self-hosted personal CRM, i.e. a digital rolodex for the people in your life.

    Keep track of contacts, group them into circles (friends, family, work), record how they are related to each other, and keep a social-network style timeline of notes and shared activities. Reminders (with optional e-mail notifications) nudge you about birthdays and about staying in touch.

    Features:
    - Contact management with circles, relationships, photos and custom fields
    - CardDAV server for two-way contact sync with your phone
    - Notes, activities and journaling
    - Recurring reminders with e-mail notification via SMTP or Resend
    - Calendar sync (CalDAV/ICS) to import activities
    - Optional single sign-on via OIDC
    - Multi-user with per-user data isolation

    All data lives in a single SQLite database inside your appdata share. No cloud, no telemetry.

