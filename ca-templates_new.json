91:"MediaForge is a self-hosted media ingest engine — a single application and single Docker container that handles the complete journey of a raw video file from arrival to library-ready:[br][b]Ingest[/b] - watch a folder, detect new files, verify they are fully written[br][b]Identify[/b] - codec detection via ffprobe, metadata lookup via TVDB/TMDB/OMDb, LLM-assisted verification for ambiguous matches[br][b]Transcode[/b] - AVC (H.264) files are queued and encoded to HEVC (H.265) using hardware acceleration (NVIDIA, AMD, Intel, or CPU fallback)[br][b]Organize[/b] - rename and move to library with media-server-compatible folder and file naming[br][br][br]MediaForge is not a media server. It is designed to feed Plex, Jellyfin, Emby, or any other media server that watches a library folder.[br][br][b]GPU Setup (Recommended):[/b][br]Without GPU passthrough, MediaForge falls back to slower CPU encoding.[br][br][b]Intel/AMD:[/b] Add --device=/dev/dri to Extra Parameters.[br][br][b]NVIDIA:[/b] Install the Nvidia-Driver plugin (reboot after) and add --runtime=nvidia to Extra Parameters.";s:7:"Support";s:46:"https://github.com/braydin72/mediaforge/issues";s:7:"Project";s:39:"https://github.com/braydin72/mediaforge";s:11:"TemplateURL";s:84:"https://raw.githubusercontent.com/braydin72/MediaForge/main/templates/mediaforge.xml";s:6:"ReadMe";s:46:"https://github.com/braydin72/mediaforge#readme";s:16:"ExtraSearchTerms";s:94:"transcode ffmpeg compression video hevc av1 encode ingest organize mediaforge shrink shrinkray";s:8:"Requires";s:92:"For hardware acceleration, GPU passthrough is required. See Overview for setup instructions.";s:4:"Date";s:10:"2026-07-30";s:6:"MinVer";s:3:"6.1";s:6:"MaxVer";s:3:"7.3";s:7:"License";s:3:"MIT";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:4:"Type";s:4:"Port";s:11:"Description";s:18:"Web interface port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:28:"/mnt/user/appdata/mediaforge";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:11:"Description";s:36:"Configuration and database directory";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Incoming";s:6:"Target";s:9:"/incoming";s:7:"Default";s:18:"/mnt/user/incoming";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:11:"Description";s:57:"Watch folder — drop new media files here for processing";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"Staging";s:6:"Target";s:8:"/staging";s:7:"Default";s:18:"/mnt/cache/staging";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:11:"Description";s:115:"Fast storage for AVC files awaiting encode and transcode working directory. SSD or cache pool strongly recommended.";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Movies Library";s:6:"Target";s:13:"/media/Movies";s:7:"Default";s:22:"/mnt/user/media/Movies";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:11:"Description";s:68:"Movie library output folder. Can be a locally mounted network share.";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"TV Library";s:6:"Target";s:15:"/media/TV Shows";s:7:"Default";s:24:"/mnt/user/media/TV Shows";s:4:"Mode";s:2:"rw";s:4:"Type";s:4:"Path";s:11:"Description";s:70:"TV show library output folder. Can be a locally mounted network share.";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:7:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Type";s:8:"Variable";s:11:"Description";s:28:"User ID for file permissions";s:7:"Display";s:8:"advanced";s:8:"Required";s:5