nel intact, for a keyed graphic or an overlay. Leave false for a full-frame source such as a dashboard.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Disable audio";s:6:"Target";s:18:"WEBLINKED_NO_AUDIO";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:104:"Set to true to ignore the page's audio entirely. A dashboard has none, so this costs nothing either way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/weblinked.xml";s:4:"Repo";s:27:"Stoatworks Labs' Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1791764069;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:4652;s:11:"Displayable";b:1;s:6:"Author";s:15:"stoatworks-labs";s:13:"DockerHubName";s:9:"weblinked";s:8:"RepoName";s:27:"Stoatworks Labs' Repository";s:10:"SortAuthor";s:15:"stoatworks-labs";s:8:"SortName";s:9:"weblinked";s:6:"random";i:542621740;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:121:"/tmp/community.applications/tempFiles/templates-community-apps/StoatworksLabsRepository/stoatworkslabs-weblinked-edge.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4653;a:34:{s:4:"Name";s:13:"willmyshowfit";s:10:"Repository";s:44:"ghcr.io/stoatworks-labs/willmyshowfit:latest";s:8:"Registry";s:45:"https://ghcr.io/stoatworks-labs/willmyshowfit";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:55:"https://github.com/stoatworks-labs/willmyshowfit/issues";s:7:"Project";s:48:"https://github.com/stoatworks-labs/willmyshowfit";s:8:"Overview";s:161:"Describe a show — screens, canvases, layers, sources and destinations — and it works out whic