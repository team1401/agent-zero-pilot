1:"observe1234/concise-wealth-tracker:latest";s:8:"Registry";s:59:"https://hub.docker.com/r/observe1234/concise-wealth-tracker";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:90:"https://forums.unraid.net/topic/200184-support-concise-docker-container-net-worth-tracker/";s:7:"Project";s:36:"https://github.com/Observe-1/concise";s:8:"Overview";s:658:"Concise is a minimalist, self-hosted personal finance / net-worth tracker. One small Node.js process serves BOTH the web UI and the REST API from a single internal port — 3000 inside the container (there is no separate API port; the UI calls /api on the same port). Map a host port to container 3000 with "WebUI Port" below. All state is a single SQLite file; validated backups are written to the mapped backup directory. Set PUID/PGID to the user that owns your appdata share (Unraid: 99 / 100). Access over plain HTTP on your LAN requires COOKIE_SECURE=false (the template default); set it to true only when serving Concise behind an HTTPS reverse proxy.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/Observe-1/concise/main/unraid/concise-wealth-tracker.xml";s:4:"Icon";s:88:"https://raw.githubusercontent.com/Observe-1/concise/main/web/public/apple-touch-icon.png";s:11:"ExtraParams";s:6:"--init";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:17:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:250:"Host port published for Concise. The container always listens on 3000 internally, serving BOTH the web UI and the /api REST API from that one port (there is no separate API port). Change the host (left) side only — leave the container side as 3000.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:40:"/mnt/user/appdata/concise-wealth-tracker";s:4:"Mode";s:2:"rw";s:11:"Description";s:148:"Persistent storage for the SQLite database (concise.db). Must be writable by PUID:PGID. Backups go to the separate 'Backup Directory' mapping below.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:40:"/mnt/user/appdata/concise-wealth-tracker";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Backup Directory";s:6:"Target";s:8:"/backups";s:7:"Default";s:48:"/mnt/user/appdata/concise-wealth-tracker/backups";s:4:"Mode";s:2:"rw";s:11:"Description";s:327:"Where validated database backups are written (automatic + manual). Point the host (left) side at any share you like — e.g. a dedicated backups share or a second disk — to keep copies off the database's own folder. The container side is fixed at /backups (the BACKUP_DIR variable points here). Must be writable by PUID:PGID.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:48:"/mnt/user/appdata/concise-wealth-tracker/backups";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:108:"User ID that owns the appdata share. Unraid default is 99 (nobody). Files in /data are created as this user.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:68:"Group ID that owns the appdata share. Unraid default is 100 (users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"COOKIE_SECURE";s:6:"Target";s:13:"COOKIE_SECURE";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:194:"Send session cookies only over HTTPS. Leave 'false' for plain-HTTP LAN access (e.g. http://tower:3000) or login will silently fail. Set 'true' ONLY when Concise is behind an HTTPS reverse proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"BACKUP_DIR";s:6:"Target";s:10:"BACKUP_DIR";s:7:"Default";s:8:"/backups";s:4:"Mode";s:0:"";s:11:"Description";s:201:"Container path Concise writes backups to. Leave this as /backups — it must match the container side of the 'Backup Directory' volume above; change the HOST folder there to relocate backups, not this.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"/backups";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:97:"Timezone for log timestamps. Concise's own date calculations are always UTC, so this is cosmetic.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"022";s:4:"Mode";s:0:"";s:11:"Description";s:48:"File-creation mask for the database and backups.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"022";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"TRUST_PROXY";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:137:"Number of reverse-proxy hops to trust for client IPs (rate limiting, audit log). Set to 1 behind a single proxy; 0 when exposed directly.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";