";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Largest Upload (MB)";s:6:"Target";s:23:"NEXCANVAS_UPLOAD_MAX_MB";s:7:"Default";s:2:"50";s:4:"Mode";s:0:"";s:11:"Description";s:109:"The largest photo or file in megabytes that can be put on a board. The operator can lower it in the settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"50";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/nexcanvas.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:5:"stars";i:1;s:9:"downloads";i:107;s:9:"FirstSeen";i:1791198847;s:10:"LastUpdate";i:1791886395;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:342;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:9:"nexcanvas";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:9:"nexcanvas";s:6:"random";i:54223046;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexcanvas-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:343;a:39:{s:4:"Name";s:8:"nexcrate";s:10:"Repository";s:26:"ghcr.io/derkezorm/nexcrate";s:8:"Registry";s:61:"https://github.com/DerKezorm/nexcrate/pkgs/container/nexcrate";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/DerKezorm/nexcrate/issues";s:6:"GitHub";s:37:"https://github.com/DerKezorm/nexcrate";s:6:"ReadMe";s:44:"https://github.com/DerKezorm/nexcrate#readme";s:7:"Project";s:37:"https://github.com/DerKezorm/nexcrate";s:8:"Overview";s:1084:"nexcrate manages movies, shows and music in one self-hosted app, in place of Radarr, Sonarr and Lidarr side by side. A movie or a show can have several versions, such as Full HD and 4K, each with its own profile and folder, so there is no second instance for 4K. Music has one version for now.Profiles come from everyday questions with the rules of the TRaSH Guides inside, and an expert mode edits every part by hand. Movies, shows and anime come from TMDB, music from MusicBrainz. Releases are searched over Newznab and Torznab indexers and downloaded through SABnzbd, NZBGet, qBittorrent, Transmission or Deluge; torrents are hardlinked and keep seeding. A switch-over reads the library, indexers, download clients and profiles of an existing Radarr, Sonarr and Lidarr, then takes the files over.Also: automatic search and RSS with delay rules per version, renaming with a preview and an undo, library rules that pick the target folder, a calendar with an iCal feed, notifications, Plex, Jellyfin and Emby told about new files, encrypted backups, and an API for other programs.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8390]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexcrate.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexcrate.png";s:4:"Date";s:10:"2026-09-25";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8390";s:7:"Default";s:4:"8390";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"Port you reach nexcrate at. Container port: 8390";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8390";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/nexcrate";s:4:"Mode";s:2:"rw";s:11:"Description";s:246:"Holds the SQLite database, the key that encrypts the stored credentials, logs and backups. Keep it on a local disk, not on a network share, and give nexcrate a folder of its own: it refuses to start on a folder that holds files it did not create.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nexcrate";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:30:"Media (Container Path: /media)";s:6:"Target";s:6:"/media";s:7:"Default";s:14:"/mnt/user/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:346:"One folder that holds your downloads and your movie, show and music libraries, for example /mnt/user/data with torrents, usenet and media below it. Mounted once, so hardlinks work and a torrent does not take its space twice. Change it to the folder you use. nexcrate offers only folders mounted like this for libraries and downloads, never /data.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"/mnt/user/data";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:168:"The zone the container runs in, for example Europe/Berlin. The calendar, the planning of upcoming episodes and the timestamps of backups use it. Leave blank to use UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:13:"NEXCRATE_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:340:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8390. On host networking the port inside the container is the port on your server, so use this to move nexcrate off 8390 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:19:"NEXCRATE_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:265:"Encrypts the stored credentials, such as the API keys of indexers and download clients. Leave blank: nexcrate creates one on first start and keeps it in /data/secret.key. Back it up together with the data directory; without it the stored credentials cannot be read.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:22:"NEXCRATE_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:241:"auto marks the session cookie Secure when the request arrived over https. Use on only if a proxy terminates TLS and forwards plain http, and never if nexcrate should also be reachable over http, or nobody stays signed in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Log Mode";s:6:"Target";s:18:"NEXCRATE_LOG_LEVEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:162:"Fixes the log mode: quiet, normal, detailed or trace. Leave blank to use the mode chosen in the interface. Meant for the case that nexcrate does not start at all.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"URL Base";s:6:"Target";s:17:"NEXCRATE_URL_BASE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Serve nexcrate under a sub path behind a reverse proxy, such as /nexcrate. Leave blank for the root.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:19:"FORWARDED_ALLOW_IPS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:311:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nexcrate that a request came in over https. Leave blank when nexcrate is not behind a proxy; blank trusts nobody.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/nexcrate.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:3:{i:0;s:14:"MediaApp-Video";i:1;s:14:"MediaApp-Music";i:2;s:11:"Downloaders";}s:9:"downloads";i:113;s:9:"FirstSeen";i:1790381369;s:10:"LastUpdate";i:1791886373;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:42:"MediaApp:Video MediaApp:Music Downloaders:";s:2:"ID";i:343;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:8:"nexcrate";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:8:"nexcrate";s:6:"random";i:2127487074;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexcrate-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:344;a:39:{s:4:"Name";s:7:"nexdeck";s:10:"Repository";s:25:"ghcr.io/derkezorm/nexdeck";s:8:"Registry";s:59:"https://github.com/DerKezorm/nexdeck/pkgs/container/nexdeck";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/DerKezorm/nexdeck/issues";s:6:"GitHub";s:36:"https://github.com/DerKezorm/nexdeck";s:6:"ReadMe";s:43:"https://github.com/DerKezorm/nexdeck#readme";s:7:"Project";s:36:"https://github.com/DerKezorm/nexdeck";s:8:"Overview";s:555:"nexdeck is a live dashboard for the homelab. Its cards show what the services behind it are doing right now: Unraid, Proxmox and Docker, the media and download stack, DNS filters, backups, cameras and many more. One container, a single SQLite file.Administrators can act from the cards, for example start and stop containers or pause downloads, and every action is logged. Boards can be shared with members or shown on a wall display as a kiosk, and nexdeck can send a notification when something fails. The interface is available in English and German.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexdeck.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexdeck.png";s:4:"Date";s:10:"2026-09-16";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"5175";s:4:"Mode";s:3:"tcp";s:11:"Description";s:47:"Port you reach nexdeck at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5175";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/nexdeck";s:4:"Mode";s:2:"rw";s:11:"Description";s:141:"Holds the SQLite database, uploaded pictures and the generated key. Back up this folder, and keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/nexdeck";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker Socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"rw";s:11:"Description";s:264:"Optional. Lets nexdeck show the containers on this server, start and stop them and follow their logs. Access to the socket amounts to root on the server; inside nexdeck only administrators can act on containers. Clear this path if you do not want the Docker cards.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/var/run/docker.sock";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:119:"Time zone of the server side, for example Europe/Berlin. Clocks in the browser follow the browser. Leave blank for UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:18:"NEXDECK_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:169:"How browsers reach nexdeck, for example https://deck.example.com. Needed for sign-in with an identity provider and for Web Push. It can also be set later inside nexdeck.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:18:"NEXDECK_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:304:"Encrypts the stored API keys and signs sessions. Leave blank: nexdeck creates one on first start and keeps it in /data/secret.key. Setting it here moves the key out of the data folder, so a stolen copy of that folder alone is worthless. Never change it afterwards, every stored credential is bound to it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Docker Group ID";s:6:"Target";s:10:"DOCKER_GID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Group that owns the Docker socket on this server. Leave blank, nexdeck reads it from the socket at start. Only set it if the Docker cards answer permission denied.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:12:"NEXDECK_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:339:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexdeck off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:17:"NEXDECK_LOG_LEVEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:188:"Leave blank. The level is chosen inside nexdeck, where a deep level switches itself back off. A value here fixes the level and greys that switch out. Only set it if nexdeck will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:23:"NEXDECK_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:304:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-Proto and X-Forwarded-Host (the rightmost value) are believed when nexdeck builds its own address without a public URL. Leave blank when nexdeck is not behind a proxy or a public URL is set.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/nexdeck.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:9:"downloads";i:196;s:9:"FirstSeen";i:1789615119;s:10:"LastUpdate";i:1791922886;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:344;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:7:"nexdeck";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:7:"nexdeck";s:6:"random";i:426677886;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexdeck-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:345;a:39:{s:4:"Name";s:8:"nexdiary";s:10:"Repository";s:26:"ghcr.io/derkezorm/nexdiary";s:8:"Registry";s:61:"https://github.com/DerKezorm/nexdiary/pkgs/container/nexdiary";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/DerKezorm/nexdiary/issues";s:6:"GitHub";s:37:"https://github.com/DerKezorm/nexdiary";s:6:"ReadMe";s:44:"https://github.com/DerKezorm/nexdiary#readme";s:7:"Project";s:37:"https://github.com/DerKezorm/nexdiary";s:8:"Overview";s:1301:"nexdiary is a diary for the family on your own server. Jot things down during the day without minding the spelling, and in the evening turn the notes into a page: by yourself, or with an AI that only orders and smooths and invents nothing. Every person sees only their own diary, and the operator manages the accounts without ever seeing what is written in them.Every day gets a cover picture (your own photo or one of 256 drawn illustrations), values from 1 to 10 for whatever you want to rate, a question of the day for when nothing comes to mind, a journal as a blog or a timeline with search, and statistics worked out on the server from your own days only. Single days can be shared with chosen people of the family, read-only, with a heart as the only reaction. Photos can come from your own Immich. Reminders arrive by Web Push, and the app installs to the home screen of a phone.Everything you write is encrypted in the database with a key of each person. A second factor is required from the start, passkeys are supported, and accounts come by invitation or through OpenID Connect (one-button setup for authentik). The AI is off until the operator chooses a service, a local model works, and nothing is sent without a press of the button. German and English, light and dark, five colours.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexdiary.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexdiary.png";s:4:"Date";s:10:"2026-10-08";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8550";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"Port you reach nexdiary at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8550";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/nexdiary";s:4:"Mode";s:2:"rw";s:11:"Description";s:360:"Holds the SQLite database with accounts, days and notes, the photos, the key secret.key, backups and logs. It also holds keys/master.key, the master key that unlocks everything people write: without it no backup can be read, so keep a copy of it apart from your backups (Settings, Backups, Encryption). Keep this folder on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nexdiary";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Time zone for timestamps in the log, for example Europe/Berlin. Leave blank for UTC. People's own time zones come from their browsers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Setup Code";s:6:"Target";s:20:"NEXDIARY_SETUP_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:164:"The code the first account needs to become the operator. Leave blank: nexdiary makes a new one at every start until it is set up and writes it to the container log.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:19:"NEXDIARY_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:275:"The address people use to reach nexdiary, for example https://diary.example.com when it sits behind a reverse proxy. Used for invitation links and the return address of OpenID Connect. Leave blank to take the address of the request; the same can be set later in the settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:24:"NEXDIARY_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:361:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nexdiary that a request came in over https; without it every sign-in seems to come from the proxy and the brake against password guessing cannot tell people apart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:13:"NEXDIARY_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:340:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexdiary off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:19:"NEXDIARY_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:170:"Protects the server-side secrets (the OpenID Connect client secret, the mail password). Leave blank: nexdiary creates one on first start and keeps it in /data/secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:22:"NEXDIARY_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:336:"auto marks the session cookie Secure when the request arrived over https, also behind a proxy listed under Trusted Proxies that sends X-Forwarded-Proto. Use on only if a proxy terminates TLS and forwards plain http without that header, and never if nexdiary should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/nexdiary.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:1:{i:0;s:12:"Productivity";}s:9:"downloads";i:108;s:9:"FirstSeen";i:1791447388;s:10:"LastUpdate";i:1791886376;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:13:"Productivity:";s:2:"ID";i:345;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:8:"nexdiary";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:8:"nexdiary";s:6:"random";i:971858569;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexdiary-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:346;a:39:{s:4:"Name";s:7:"nexlore";s:10:"Repository";s:25:"ghcr.io/derkezorm/nexlore";s:8:"Registry";s:59:"https://github.com/DerKezorm/nexlore/pkgs/container/nexlore";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/DerKezorm/nexlore/issues";s:6:"GitHub";s:36:"https://github.com/DerKezorm/nexlore";s:6:"ReadMe";s:43:"https://github.com/DerKezorm/nexlore#readme";s:7:"Project";s:36:"https://github.com/DerKezorm/nexlore";s:8:"Overview";s:875:"nexlore is a notes app for your own server, in the browser: Markdown files on your disk, written in a real editor (WYSIWYG, slash menu, tables, callouts, properties), linked with [[wiki links]] and backlinks, and laid out as a map you zoom into, from all your spaces down to a single note. The files stay plain Markdown, so Obsidian, Syncthing or any editor can work on the same folder at the same time.Daily notes with a calendar, tasks with due dates and repeats, templates, table and board views, canvases in the open JSON Canvas format, full text search with operators, versions and a trash. Spaces with read, write and manage rights, accounts by invitation or OpenID Connect (one-button setup for authentik), an optional second factor, comments, public pages, MCP for AI helpers, an API, backups and a log. English and German, light and dark, installable on the phone.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexlore.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexlore.png";s:4:"Date";s:10:"2026-10-04";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8470";s:4:"Mode";s:3:"tcp";s:11:"Description";s:47:"Port you reach nexlore at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8470";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/nexlore";s:4:"Mode";s:2:"rw";s:11:"Description";s:244:"Holds the SQLite database with accounts, spaces, versions and the search index, the trash, the key secret.key, backups and logs, and the notes in /data/vault unless Notes Folder points elsewhere. Keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/nexlore";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:117:"Time zone for daily notes, tasks due today and timestamps in the log, for example Europe/Berlin. Leave blank for UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Setup Code";s:6:"Target";s:19:"NEXLORE_SETUP_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:163:"The code the first account needs to become the operator. Leave blank: nexlore makes a new one at every start until it is set up and writes it to the container log.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:18:"NEXLORE_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:288:"The address people use to reach nexlore, for example https://notes.example.com when it sits behind a reverse proxy. Used for invitation links, public pages and the return address of OpenID Connect. Leave blank to take the address of the request; the same can be set later in the settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:23:"NEXLORE_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:360:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nexlore that a request came in over https; without it every sign-in seems to come from the proxy and the brake against password guessing cannot tell people apart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Notes Folder";s:6:"Target";s:17:"NEXLORE_VAULT_DIR";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:259:"Container path of the folder with the notes, if they should not live in /data/vault: add a path mapping for that folder first (for example to /vault) and enter the container path here. Other programs may work on the same folder; nexlore notices their changes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Watch by Polling";s:6:"Target";s:21:"NEXLORE_WATCH_POLLING";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:123:"true if the notes folder delivers no change notifications (some network mounts): nexlore then looks for changes by polling.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:12:"NEXLORE_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:339:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexlore off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:18:"NEXLORE_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:199:"Protects the server-side secrets (the OpenID Connect client secret, the mail password, AI keys, second-factor seeds). Leave blank: nexlore creates one on first start and keeps it in /data/secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:21:"NEXLORE_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:335:"auto marks the session cookie Secure when the request arrived over https, also behind a proxy listed under Trusted Proxies that sends X-Forwarded-Proto. Use on only if a proxy terminates TLS and forwards plain http without that header, and never if nexlore should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/nexlore.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:109;s:9:"FirstSeen";i:1791202349;s:10:"LastUpdate";i:1791886389;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:346;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:7:"nexlore";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:7:"nexlore";s:6:"random";i:276390491;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexlore-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:347;a:40:{s:4:"Name";s:7:"nexmail";s:10:"Repository";s:25:"ghcr.io/derkezorm/nexmail";s:8:"Registry";s:59:"https://github.com/DerKezorm/nexmail/pkgs/container/nexmail";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/DerKezorm/nexmail/issues";s:6:"GitHub";s:36:"https://github.com/DerKezorm/nexmail";s:6:"ReadMe";s:43:"https://github.com/DerKezorm/nexmail#readme";s:7:"Project";s:36:"https://github.com/DerKezorm/nexmail";s:8:"Overview";s:628:"nexmail is a self-hosted email client in the browser. It brings several IMAP mailboxes together in one window: iCloud, Google, Microsoft or any other provider. One container, a single SQLite file, no second database and no cloud service that gets to see your mail.It reads, writes, searches, labels, schedules and sends, keeps a calendar over CalDAV, syncs address books over CardDAV and can reach you with the browser closed. Every member of the household gets their own account and mailboxes. The interface is available in English and German.nexmail is a mail client, not a mail server. Your mail stays with your provider.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexmail.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexmail.png";s:4:"Date";s:10:"2026-09-16";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"5174";s:4:"Mode";s:3:"tcp";s:11:"Description";s:47:"Port you reach nexmail at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5174";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/nexmail";s:4:"Mode";s:2:"rw";s:11:"Description";s:169:"Holds the SQLite database, attachments and the key that encrypts your stored mailbox passwords. Back up this folder, and keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/nexmail";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:16:"NEXMAIL_ZEITZONE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:170:"Time zone for dates in the interface and for scheduled sending, for example Europe/Berlin. A container runs in UTC; leave this blank to set the zone later inside nexmail.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:12:"NEXMAIL_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:339:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexmail off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:18:"NEXMAIL_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:317:"Encrypts your stored mailbox passwords. Leave blank: nexmail creates one on first start and keeps it in /data/secret.key. Setting it here moves the key out of the data folder, so a stolen copy of that folder alone is worthless. You then have to back up the key yourself, because without it the database is unreadable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"URL Base";s:6:"Target";s:16:"NEXMAIL_URL_BASE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:158:"Only needed to serve nexmail under a sub-path behind a reverse proxy, for example /nexmail for https://example.com/nexmail/. Leave blank to serve at the root.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:21:"NEXMAIL_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:236:"auto marks the session cookie Secure when the request arrived over https. Use on only if a proxy terminates TLS and forwards plain http, and never if nexmail should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Caller Address";s:6:"Target";s:17:"NEXMAIL_CLIENT_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:495:"Only needed if failed sign-ins should be counted per address as well as per account. Leaving this blank is always safe. Set direct if nexmail is reachable without a proxy, proxy if exactly one sits in front, or proxy:2 for two. If this says direct while a proxy sits in front, every request looks like the same address and one typo locks everyone out. With proxy or proxy:2, nexmail also believes X-Forwarded-Proto from that proxy (the rightmost value), so it knows a request came in over https.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Sync Interval (seconds)";s:6:"Target";s:21:"NEXMAIL_TAKT_SEKUNDEN";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:168:"How often nexmail checks for new mail on its own. 0 turns the background sync off, mail then arrives on click. Below 30 seconds would be impolite towards your provider.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Session Days";s:6:"Target";s:20:"NEXMAIL_SITZUNG_TAGE";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:42:"How many days a sign-in lasts without use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:17:"NEXMAIL_LOG_STUFE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:198:"Emergency override: leise, normal, ausfuehrlich or alles. Leave blank, the level is set inside the app and the deep levels switch themselves back off. Only set this if nexmail will not start at all.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/nexmail.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:17:"Network-Messenger";}s:5:"stars";i:1;s:9:"downloads";i:106;s:9:"FirstSeen";i:1789615119;s:10:"LastUpdate";i:1791886391;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:31:"Productivity: Network:Messenger";s:2:"ID";i:347;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:7:"nexmail";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:7:"nexmail";s:6:"random";i:597736266;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexmail-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:348;a:39:{s:4:"Name";s:8:"nexpaper";s:10:"Repository";s:26:"ghcr.io/derkezorm/nexpaper";s:8:"Registry";s:61:"https://github.com/DerKezorm/nexpaper/pkgs/container/nexpaper";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/DerKezorm/nexpaper/issues";s:6:"GitHub";s:37:"https://github.com/DerKezorm/nexpaper";s:6:"ReadMe";s:44:"https://github.com/DerKezorm/nexpaper#readme";s:7:"Project";s:37:"https://github.com/DerKezorm/nexpaper";s:8:"Overview";s:1407:"Paperless-ngx for the home, the simple version. nexpaper is a light filing cabinet for the papers of a household or a small firm, on your own server: upload, find, done. One container, no Redis, no Celery and no Postgres, and an import that takes over what you already have in Paperless-ngx.Everything new waits in an inbox with the fields filled in, whether it came from the browser, a photo taken on the phone, a scanner's folder, a mailbox or Paperless, and one click files it. Scans are read and become searchable PDFs while the original stays exactly as it came, with its checksum. The search understands parts of words and filters. Pages can be turned, deleted, ordered, joined and split, and every change is a new version. Everybody has a vault of their own, the operator makes shared ones for the household or the business, and single documents can be shared with a person or, for somebody without an account, as a link that ends.For small firms, e-invoices (ZUGFeRD, Factur-X, XRechnung) are read from their data, a history shows who changed what, and an export for the tax adviser is a ZIP with the PDFs and a list. A second factor is required from the start, passkeys are supported, and accounts come by invitation or through OpenID Connect (one-button setup for authentik). An open API serves the apps that will come. nexpaper is an independent project and not affiliated with Paperless-ngx.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexpaper.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexpaper.png";s:4:"Date";s:10:"2026-10-11";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8560";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"Port you reach nexpaper at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8560";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/nexpaper";s:4:"Mode";s:2:"rw";s:11:"Description";s:306:"Holds the SQLite database with accounts and the search index, the documents as plain files in dokumente/, the key secret.key, backups and logs. A backup made by nexpaper does not hold the documents: copy this folder with the backup your server makes anyway. Keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nexpaper";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Time zone for timestamps in the log, for example Europe/Berlin. Leave blank for UTC. People's own time zones come from their browsers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Setup Code";s:6:"Target";s:20:"NEXPAPER_SETUP_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:164:"The code the first account needs to become the operator. Leave blank: nexpaper makes a new one at every start until it is set up and writes it to the container log.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:19:"NEXPAPER_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:275:"The address people use to reach nexpaper, for example https://paper.example.com when it sits behind a reverse proxy. Used for invitation links and the return address of OpenID Connect. Leave blank to take the address of the request; the same can be set later in the settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:24:"NEXPAPER_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:361:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nexpaper that a request came in over https; without it every sign-in seems to come from the proxy and the brake against password guessing cannot tell people apart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:13:"NEXPAPER_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:340:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexpaper off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:19:"NEXPAPER_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:182:"Protects the server-side secrets (the OpenID Connect client secret, the mail password, the AI key). Leave blank: nexpaper creates one on first start and keeps it in /data/secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:22:"NEXPAPER_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:336:"auto marks the session cookie Secure when the request arrived over https, also behind a proxy listed under Trusted Proxies that sends X-Forwarded-Proto. Use on only if a proxy terminates TLS and forwards plain http without that header, and never if nexpaper should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/nexpaper.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:434;s:9:"FirstSeen";i:1791745164;s:10:"LastUpdate";i:1791929199;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:348;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:8:"nexpaper";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:8:"nexpaper";s:6:"random";i:803389618;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexpaper-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:349;a:40:{s:4:"Name";s:8:"nexpulse";s:10:"Repository";s:26:"ghcr.io/derkezorm/nexpulse";s:8:"Registry";s:61:"https://github.com/DerKezorm/nexpulse/pkgs/container/nexpulse";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/DerKezorm/nexpulse/issues";s:6:"GitHub";s:37:"https://github.com/DerKezorm/nexpulse";s:6:"ReadMe";s:44:"https://github.com/DerKezorm/nexpulse#readme";s:7:"Project";s:37:"https://github.com/DerKezorm/nexpulse";s:8:"Overview";s:624:"nexpulse is a speed test tracker for the homelab. It measures your internet connection on a schedule, shows every test live on a gauge, keeps the history with charts and averages, and tells you over ntfy, Gotify or a webhook when the line is slower than your plan.It measures with Cloudflare out of the box, with public or your own LibreSpeed servers, and optionally with Ookla. Schedules can run every few minutes, daily, by cron, or several times a day at random times to find the busy hours. An API with read or run keys feeds dashboards like nexdeck or Home Assistant. The interface is available in English and German.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexpulse.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexpulse.png";s:4:"Date";s:10:"2026-09-19";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8440";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"Port you reach nexpulse at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8440";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/nexpulse";s:4:"Mode";s:2:"rw";s:11:"Description";s:124:"Holds the SQLite database with all results and the key that signs sessions. Keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nexpulse";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:159:"Schedules run at the wall clock time of this zone, for example Europe/Berlin. Leave blank to pick the zone later in the settings; until then nexpulse uses UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:13:"NEXPULSE_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:340:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nexpulse off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:19:"NEXPULSE_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:138:"Signs sessions and encrypts stored notification tokens. Leave blank: nexpulse creates one on first start and keeps it in /data/secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:22:"NEXPULSE_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:267:"Only matters with a password. auto marks the session cookie Secure when the request arrived over https. Use on only if a proxy terminates TLS and forwards plain http, and never if nexpulse should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:24:"NEXPULSE_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:386:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nexpulse that a request came in over https; without it every sign-in seems to come from the proxy and the brake against password guessing cannot tell people apart. Requires nexpulse 0.4.3.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/nexpulse.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:18:"Network-Management";i:1;s:15:"Tools-Utilities";}s:5:"stars";i:1;s:9:"downloads";i:105;s:9:"FirstSeen";i:1790002781;s:10:"LastUpdate";i:1791886398;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:34:"Network:Management Tools:Utilities";s:2:"ID";i:349;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:8:"nexpulse";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:8:"nexpulse";s:6:"random";i:1438015538;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexpulse-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:350;a:40:{s:4:"Name";s:7:"nexsift";s:10:"Repository";s:25:"ghcr.io/derkezorm/nexsift";s:8:"Registry";s:59:"https://github.com/DerKezorm/nexsift/pkgs/container/nexsift";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/DerKezorm/nexsift/issues";s:6:"GitHub";s:36:"https://github.com/DerKezorm/nexsift";s:6:"ReadMe";s:43:"https://github.com/DerKezorm/nexsift#readme";s:7:"Project";s:36:"https://github.com/DerKezorm/nexsift";s:8:"Overview";s:1160:"nexsift is the filter for your homelab's notifications. Every service reports to nexsift instead of to your phone: Proxmox, Unraid, Uptime Kuma, Watchtower, Home Assistant, the NAS, the UPS. nexsift collects everything in one inbox, sorts it into info, warning and critical, bundles the routine into one line per source and passes on only what matters, through ntfy, Gotify, Telegram, Apprise, a webhook or straight to the phone as a Web Push notification.Senders need no plugin and no change, because nexsift answers like the services they already know: a Gotify server, an ntfy server, a Discord webhook, a mail server, a syslog server or a plain webhook. All-clears close problems instead of opening new lines, quiet hours and a storm guard keep the phone calm when many things fail at once, and rules decide level, bundling and push. One operator account with a password, optionally sign-in through several OpenID Connect providers side by side, Microsoft Entra ID among them (one-button setup for authentik), encrypted backups, a log without message content or tokens, read-only API keys for dashboards. The interface is available in English and German.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexsift.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexsift.png";s:4:"Date";s:10:"2026-10-02";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8490";s:4:"Mode";s:3:"tcp";s:11:"Description";s:109:"Port you reach nexsift at. Also takes nexsift's own webhooks and Discord-style webhooks. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8490";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Gotify Port";s:6:"Target";s:4:"8001";s:7:"Default";s:4:"8491";s:4:"Mode";s:3:"tcp";s:11:"Description";s:156:"Answers like a Gotify server (POST /message), for Watchtower and everything else built on shoutrrr. Remove this port to close the door. Container port: 8001";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8491";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"ntfy Port";s:6:"Target";s:4:"8002";s:7:"Default";s:4:"8492";s:4:"Mode";s:3:"tcp";s:11:"Description";s:167:"Answers like an ntfy server (POST /topic), including the subscription Home Assistant's ntfy integration opens. Remove this port to close the door. Container port: 8002";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8492";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"SMTP Port";s:6:"Target";s:4:"2525";s:7:"Default";s:4:"2525";s:4:"Mode";s:3:"tcp";s:11:"Description";s:200:"Plain SMTP without sign-in, for a UPS, a printer or an old router that can only send mail. Map 25 here if a device cannot change its mail port. Remove this port to close the door. Container port: 2525";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2525";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Syslog Port (UDP)";s:6:"Target";s:4:"5514";s:7:"Default";s:4:"5514";s:4:"Mode";s:3:"udp";s:11:"Description";s:194:"Syslog over UDP (RFC 3164 and 5424). Map 514 here if a device cannot change its syslog port and Unraid's own syslog server is off. Use the same number as the TCP port below. Container port: 5514";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5514";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Syslog Port (TCP)";s:6:"Target";s:4:"5514";s:7:"Default";s:4:"5514";s:4:"Mode";s:3:"tcp";s:11:"Description";s:80:"Syslog over TCP. Use the same number as the UDP port above. Container port: 5514";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5514";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/nexsift";s:4:"Mode";s:2:"rw";s:11:"Description";s:155:"Holds the SQLite database with sources, rules, targets and messages, the key secret.key, backups and logs. Keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/nexsift";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:96:"The clock the quiet hours of push targets go by, for example Europe/Berlin. Leave blank for UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Ports as seen from outside";s:6:"Target";s:20:"NEXSIFT_PUBLIC_PORTS";s:7:"Default";s:52:"web=8490,gotify=8491,ntfy=8492,smtp=2525,syslog=5514";s:4:"Mode";s:0:"";s:11:"Description";s:181:"The host ports above, for the setup hints on the sources page. Keep it in line whenever you change a port, or the hints send devices to the wrong number. Nothing else depends on it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:52:"web=8490,gotify=8491,ntfy=8492,smtp=2525,syslog=5514";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:18:"NEXSIFT_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:286:"The address people and senders use to reach nexsift, for example https://nexsift.example.com when it sits behind a reverse proxy. Used for the setup hints and the return address of OpenID Connect. Leave blank to take the address of the request; the setting under Settings wins when set.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:23:"NEXSIFT_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:353:"Addresses or networks of reverse proxies whose X-Forwarded-For and X-Forwarded-Proto are believed, comma separated, for example 172.17.0.0/16. Only they can tell nexsift that a request came in over https. Leave blank when nexsift is not behind a proxy; blank trusts nobody, 127.0.0.1 included. A proxy on the same server with host networking: 127.0.0.1.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:18:"NEXSIFT_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:276:"Protects the stored secrets: source tokens, push target credentials, the OpenID Connect client secret and the Web Push keys. Leave blank: nexsift creates one on first start and keeps it in /data/secret.key, and the backup archive carries it. When set, it wins over secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:21:"NEXSIFT_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:335:"auto marks the session cookie Secure when the request arrived over https, also behind a proxy listed under Trusted Proxies that sends X-Forwarded-Proto. Use on only if a proxy terminates TLS and forwards plain http without that header, and never if nexsift should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/nexsift.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:17:"Network-Messenger";}s:5:"stars";i:1;s:9:"downloads";i:108;s:9:"FirstSeen";i:1790969388;s:10:"LastUpdate";i:1791884343;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:33:"Tools:Utilities Network:Messenger";s:2:"ID";i:350;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:7:"nexsift";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:7:"nexsift";s:6:"random";i:1544150322;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nexsift-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:351;a:39:{s:4:"Name";s:8:"nextrmnl";s:10:"Repository";s:26:"ghcr.io/derkezorm/nextrmnl";s:8:"Registry";s:61:"https://github.com/DerKezorm/nextrmnl/pkgs/container/nextrmnl";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/DerKezorm/nextrmnl/issues";s:6:"GitHub";s:37:"https://github.com/DerKezorm/nextrmnl";s:6:"ReadMe";s:44:"https://github.com/DerKezorm/nextrmnl#readme";s:7:"Project";s:37:"https://github.com/DerKezorm/nextrmnl";s:8:"Overview";s:817:"nextrmnl is SSH and SFTP in the browser for the machines in your own network: a terminal (xterm.js) with tabs, jump hosts and copy and paste the way PuTTY does it, plus file transfer next to it. Accounts with a vault each for keys and passwords, sealed with the account's password so that not even the operator can read it. Host keys are checked and remembered, unknown hosts are shown with their fingerprint first.Connections can be shared between accounts without sharing access, sign-in works with a password, an optional second factor from an authenticator app, or OpenID Connect (one-button setup for authentik). By default nextrmnl only connects into private networks. Backups as encrypted ZIP files, a log that never contains terminal content or credentials. The interface is available in English and German.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nextrmnl.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nextrmnl.png";s:4:"Date";s:10:"2026-09-26";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8460";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"Port you reach nextrmnl at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8460";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/nextrmnl";s:4:"Mode";s:2:"rw";s:11:"Description";s:162:"Holds the SQLite database with accounts, connections and the sealed vaults, the key secret.key, backups and logs. Keep it on a local disk, not on a network share.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/nextrmnl";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:108:"Time zone for timestamps in the log and the session history, for example Europe/Berlin. Leave blank for UTC.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:19:"NEXTRMNL_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:286:"The address people use to reach nextrmnl, for example https://nextrmnl.example.com when it sits behind a reverse proxy. Used for invitation links and the return address of OpenID Connect. Leave blank to take the address of the request; the same can be set later under Settings, Sign-in.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:13:"NEXTRMNL_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:340:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking the port inside the container is the port on your server, so use this to move nextrmnl off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:19:"NEXTRMNL_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:248:"Protects the server-side secrets (the OpenID Connect client secret, second-factor seeds). Leave blank: nextrmnl creates one on first start and keeps it in /data/secret.key. The vaults do not depend on it; they open with the account's password only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Secure Cookie";s:6:"Target";s:22:"NEXTRMNL_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:336:"auto marks the session cookie Secure when the request arrived over https, also behind a proxy listed under Trusted Proxies that sends X-Forwarded-Proto. Use on only if a proxy terminates TLS and forwards plain http without that header, and never if nextrmnl should also be reachable over http, or nobody can sign in. off never marks it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted Proxies";s:6:"Target";s:24:"NEXTRMNL_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:290:"Addresses or networks of your reverse proxies, comma separated, for example 172.16.0.0/12. Only their X-Forwarded-For and X-Forwarded-Proto (the rightmost value) are believed, so only they can tell nextrmnl that a request came in over https. Leave blank when nextrmnl is not behind a proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/nextrmnl.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:18:"Network-Management";}s:9:"downloads";i:115;s:9:"FirstSeen";i:1790410256;s:10:"LastUpdate";i:1791886366;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:34:"Tools:Utilities Network:Management";s:2:"ID";i:351;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:8:"nextrmnl";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:8:"nextrmnl";s:6:"random";i:1227626759;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-nextrmnl-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:352;a:40:{s:4:"Name";s:7:"Nexview";s:10:"Repository";s:25:"ghcr.io/derkezorm/nexview";s:8:"Registry";s:59:"https://github.com/DerKezorm/nexview/pkgs/container/nexview";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/DerKezorm/nexview/issues";s:6:"GitHub";s:36:"https://github.com/DerKezorm/nexview";s:6:"ReadMe";s:43:"https://github.com/DerKezorm/nexview#readme";s:7:"Project";s:36:"https://github.com/DerKezorm/nexview";s:8:"Overview";s:683:"Nexview is a self-hosted media discovery dashboard for a household - family, flatmates, a circle of friends. It shows new releases from TMDB, marks what is already in your library, and hands requests to Radarr (movies) and Sonarr (shows).Everyone gets their own account with roles, approvals, quotas, per-user blocklists and an age restriction, so children can browse a view of their own. The interface is available in English and German.Nexview downloads nothing itself and stores no media. It is the front door to a setup you already run - it does not replace any part of it.Without a TMDB key Nexview starts with sample data, so you can look around before deciding anything.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/templates/nexview.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerKezorm/unraid-templates/main/icons/nexview.png";s:4:"Date";s:10:"2026-08-29";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"5173";s:4:"Mode";s:3:"tcp";s:11:"Description";s:47:"Port you reach Nexview at. Container port: 8000";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5173";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Data (Container Path: /data)";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/nexview";s:4:"Mode";s:2:"rw";s:11:"Description";s:121:"Holds the SQLite database, the encryption key for your stored API credentials, and profile pictures. Back up this folder.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/nexview";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:69:"User id that should own the files in /data. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Group id that should own the files in /data. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time Zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:85:"Time zone used for the log and for dates in the interface, for example Europe/Berlin.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Container Port (host networking only)";s:6:"Target";s:12:"NEXVIEW_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:362:"Leave this empty unless you switched Network Type to Host. In bridge mode the WebUI Port above already does the job and setting this will break it, because the mapping still points at 8000. On host networking there is no mapping - the port inside the container is the port on your server - so use this to move Nexview off 8000 if something else is already there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:18:"NEXVIEW_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:164:"Signs login tokens and encrypts your stored Radarr, Sonarr and TMDB credentials. Leave blank: Nexview generates one on first start and keeps it in /data/secret.key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Caller Address";s:6:"Target";s:17:"NEXVIEW_CLIENT_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:655:"Only needed if you want failed sign-ins counted per address as well as per account. Nexview cannot tell on its own whether a reverse proxy sits in front of it, and behind one every request looks like it comes from the same address - so leaving this blank is always safe, and accounts are still counted. Set direct if Nexview is reachable without a proxy, proxy if exactly one sits in front, or proxy:2 for two (for example Cloudflare and then your own). Your proxy must pass X-Forwarded-For; most do by default. With proxy or proxy:2, Nexview also believes X-Forwarded-Proto from that proxy (the rightmost value), so it knows a request came in over https.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:17:"NEXVIEW_LOG_LEVEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:197:"Emergency override: quiet, normal, detailed or trace. Leave blank - the level is set inside the app and turns itself back down after troubleshooting. Only set this if Nexview will not start at all.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"URL Base";s:6:"Target";s:16:"NEXVIEW_URL_BASE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:467:"Only needed to serve Nexview under a sub-path of a shared domain behind a reverse proxy, for example /nexview for https://example.com/nexview/. Leave blank to serve at the root, exactly as before. Both common proxy setups work - passing the path through unchanged and stripping the prefix. Remember to include the prefix in the public address inside Nexview's settings, or links in outgoing mail lead nowhere. Proxy examples: README, section 'Behind a reverse proxy'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Access Token Minutes";s:6:"Target";s:28:"NEXVIEW_ACCESS_TOKEN_MINUTES";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:54:"How long a sign-in stays valid before it is refreshed.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Refresh Token Days";s:6:"Target";s:26:"NEXVIEW_REFRESH_TOKEN_DAYS";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:71:"How long someone stays signed in without entering their password again.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/nexview.xml";s:4:"Repo";s:22:"DerKezorm's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:5:"stars";i:1;s:9:"downloads";i:95;s:9:"FirstSeen";i:1787601958;s:10:"LastUpdate";i:1791886405;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:352;s:11:"Displayable";b:1;s:6:"Author";s:9:"derkezorm";s:13:"DockerHubName";s:7:"nexview";s:8:"RepoName";s:22:"DerKezorm's Repository";s:10:"SortAuthor";s:9:"derkezorm";s:8:"SortName";s:7:"Nexview";s:6:"random";i:1536520398;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/DerKezormsRepository/derkezorm-Nexview-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:353;a:39:{s:6:"Plugin";b:1;s:9:"PluginURL";s:92:"https://raw.githubusercontent.com/DerekChan65535/unraid-disk-activity/main/disk.activity.plg";s:12:"PluginAuthor";s:14:"DerekChan65535";s:4:"Date";s:10:"2026-05-20";s:4:"Name";s:13:"Disk Activity";s:6:"MinVer";s:5:"7.3.0";s:7:"Project";s:54:"https://github.com/DerekChan65535/unraid-disk-activity";s:7:"Support";s:115:"https://forums.unraid.net/topic/197765-plugin-disk-activity-real-time-io-utilization-column-for-array-pool-devices/";s:4:"Icon";s:83:"https://raw.githubusercontent.com/DerekChan65535/unraid-disk-activity/main/icon.png";s:7:"License";s:43:"MIT License - Copyright 2026 DerekChan65535";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/DerekChan65535/unraid-disk-activity/main/disk.activity.xml";s:12:"TemplatePath";s:37:"/tmp/GitHub/AppFeed/disk.activity.xml";s:4:"Repo";s:27:"DerekChen65535's Repository";s:8:"Overview";s:455:"Adds a real-time I/O utilization column to the Main page array and pool device tables.
Each disk row shows a live activity bar (0-100%) updated every 2 seconds.
Supports Array Devices, Pool Devices (including ZFS pools), and Boot Device.
Summary rows display the average activity across all pool members.
Three display modes: progress bar, colored percentage, or plain text.
Configurable averaging window: Instant (2s), 10 seconds, 1 minute, or 5 minutes.";s:10:"Repository";s:92:"https://raw.githubusercontent.com/DerekChan65535/unraid-disk-activity/main/disk.activity.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:13:"pluginVersion";s:10:"2026.09.22";s:6:"MaxVer";s:5:"7.9.9";s:6:"Author";s:14:"DerekChan65535";s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:1747;s:9:"FirstSeen";i:1780606903;s:14:"LastUpdateScan";i:1792411842;s:11:"pluginStats";a:13:{i:10;i:126;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:844;s:2:"07";i:359;s:2:"08";i:197;s:2:"09";i:221;s:1:"T";i:1747;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:353;s:11:"Displayable";b:1;s:13:"DockerHubName";s:13:"disk activity";s:8:"RepoName";s:27:"DerekChen65535's Repository";s:10:"SortAuthor";s:14:"DerekChan65535";s:8:"SortName";s:13:"Disk Activity";s:6:"random";i:685153848;s:9:"Blacklist";b:0;s:4:"Path";s:207:"/tmp/community.applications/tempFiles/templates-community-apps/DerekChen65535sRepository/DerekChan65535-DiskActivity-//raw.githubusercontent.com/DerekChan65535/unraid-disk-activity/main/disk.activity.plg.xml";s:10:"Deprecated";b:0;s:10:"DonateText";s:15:"Buy me a coffee";s:10:"DonateLink";s:32:"https://ko-fi.com/derekchen65535";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:354;a:40:{s:4:"Name";s:12:"tdarr-review";s:10:"Repository";s:36:"ghcr.io/desadius/tdarr-review:latest";s:8:"Registry";s:68:"https://github.com/Desadius/Tdarr-Review/pkgs/container/tdarr-review";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/Desadius/Tdarr-Review/issues";s:7:"Project";s:40:"https://github.com/Desadius/Tdarr-Review";s:6:"ReadMe";s:73:"https://github.com/Desadius/Tdarr-Review/blob/main/docs/INSTALL-UNRAID.md";s:7:"License";s:58:"https://github.com/Desadius/Tdarr-Review/blob/main/LICENSE";s:8:"Overview";s:681:"Review Tdarr transcodes before replacing originals. A guided process combines picture, audio and synchronized video samples with saved manual checks. Approve completed assessments individually or in batches, record rejection reasons and track savings. Optional manual Radarr replacement requests preserve the original in quarantine. Czech and English interfaces. Linux amd64. Requires a separately installed Tdarr server, its DB2 directory and a separate folder containing completed results. Set PUBLIC_ORIGIN and TDARR_URL for your server before installing. Optional Recovery runs inside this container and is Off by default (RECOVERY_MODE). Approval writes to your media library.";s:5:"WebUI";s:23:"http://[IP]:[PORT:8270]";s:4:"Icon";s:76:"https://raw.githubusercontent.com/Desadius/Tdarr-Review/main/assets/icon.svg";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/Desadius/Tdarr-Review/main/templates/tdarr-review.xml";s:4:"Beta";s:4:"true";s:8:"Requires";s:177:"Linux amd64; Tdarr server; readable DB2 directory; completed transcodes in a separate writable review directory. UID 99 / GID 100 must have access to the selected host mappings.";s:16:"ExtraSearchTerms";s:49:"tdarr review transcode approval radarr quarantine";s:11:"ExtraParams";s:220:"--user=99:100 --read-only --cap-drop=ALL --security-opt=no-new-privileges --cpus=2 --memory=2g --pids-limit=256 --tmpfs=/tmp:rw,noexec,nosuid,size=128m --restart=unless-stopped --log-opt=max-size=10m --log-opt=max-file=3";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI port";s:6:"Target";s:4:"8270";s:7:"Default";s:4:"8270";s:4:"Mode";s:3:"tcp";s:11:"Description";s:80:"Host port for Review. If changed, update PUBLIC_ORIGIN to the exact browser URL.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8270";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Browser origin (required)";s:6:"Target";s:13:"PUBLIC_ORIGIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Enter the exact origin used in your browser, for example http://YOUR_UNRAID_IP:8270. Include the selected host port; no trailing path.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Tdarr server URL (required)";s:6:"Target";s:9:"TDARR_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:150:"Enter the Tdarr server API URL reachable from this container, for example http://YOUR_UNRAID_IP:8266. This is the server API port, not its WebUI port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Application state";s:6:"Target";s:5:"/data";s:7:"Default";s:36:"/mnt/cache/appdata/tdarr-review/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:145:"Persistent Review settings, access key, history and journals. Use one Review container per state directory. Must be writable by UID 99 / GID 100.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:36:"/mnt/cache/appdata/tdarr-review/data";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Media parent";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"rw";s:11:"Description";s:202:"Parent of your movie library. The default expects films in media/movies. Review needs write access for approval and quarantine outside the Plex library. Configure MEDIA_ROOT if your folder name differs.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/media";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Results awaiting review";s:6:"Target";s:7:"/review";s:7:"Default";s:30:"/mnt/cache/tdarr-review-output";s:4:"Mode";s:2:"rw";s:11:"Description";s:171:"Separate host folder containing completed Tdarr results awaiting approval. Never select the original movie library. Use your existing results folder if already configured.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/cache/tdarr-review-output";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Tdarr DB2 directory";s:6:"Target";s:6:"/tdarr";s:7:"Default";s:41:"/mnt/cache/appdata/tdarr/server/Tdarr/DB2";s:4:"Mode";s:2:"ro";s:11:"Description";s:153:"Directory containing SQL/database.db and its WAL/SHM files, mounted read-only. Locate your actual Tdarr DB2 directory; do not map only the database file.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:41:"/mnt/cache/appdata/tdarr/server/Tdarr/DB2";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Recovery mode";s:6:"Target";s:13:"RECOVERY_MODE";s:7:"Default";s:17:"off|verify|repair";s:4:"Mode";s:0:"";s:11:"Description";s:294:"Optional automatic repair of corrupted originals. off: Recovery does not run. verify: confirm corrupted originals without changing them. repair: repair confirmed corruptions within the configured limits. verify and repair also need /data/recovery/config.json. Applies after a container restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"off";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Movie root inside Review";s:6:"Target";s:10:"MEDIA_ROOT";s:7:"Default";s:13:"/media/movies";s:4:"Mode";s:0:"";s:11:"Description";s:151:"Container path to your movie library inside the Media parent mapping. Configure the matching source roots used by Tdarr in Review Settings after login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"/media/movies";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Result root inside Review";s:6:"Target";s:11:"REVIEW_ROOT";s:7:"Default";s:7:"/rev