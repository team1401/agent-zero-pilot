_SEAFILE_MYSQL_ROOT_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:183:"Root password of your MariaDB, used once on the first start to create the three Seafile databases and the database user. You can clear it afterwards. Not needed with Built-in MariaDB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Built-in Redis";s:6:"Target";s:13:"BUILTIN_REDIS";s:7:"Default";s:10:"false|true";s:4:"Mode";s:0:"";s:11:"Description";s:100:"true runs Redis inside this container. Seafile only keeps a cache there, nothing is written to disk.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Redis host";s:6:"Target";s:10:"REDIS_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:68:"IP or name of your Redis server. Leave it empty with Built-in Redis.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Notification server";s:6:"Target";s:26:"ENABLE_NOTIFICATION_SERVER";s:7:"Default";s:10:"false|true";s:4:"Mode";s:0:"";s:11:"Description";s:187:"true starts the notification server in this container, so the desktop and mobile clients see changes when they happen. A reverse proxy has to pass WebSocket connections for /notification.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database port";s:6:"Target";s:21:"SEAFILE_MYSQL_DB_PORT";s:7:"Default";s:4:"3306";s:4:"Mode";s:0:"";s:11:"Description";s:37:"Port of your MariaDB or MySQL server.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5: