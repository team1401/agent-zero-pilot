"https://github.com/kaedinger/unspin/releases/latest/download/unspin.plg";s:12:"PluginAuthor";s:9:"kaedinger";s:4:"Name";s:6:"Unspin";s:7:"Support";s:93:"https://forums.unraid.net/topic/198091-plugin-unspin-rudimentary-hot-file-tiering-for-unraid/";s:4:"Icon";s:71:"https://raw.githubusercontent.com/kaedinger/unspin/main/images/icon.png";s:16:"ExtraSearchTerms";s:15:"hotfile tiering";s:2:"CA";s:5:"AddOn";s:4:"Repo";s:22:"kaedinger's Repository";s:6:"MinVer";s:5:"7.0.0";s:8:"Overview";s:603:"Unspin runs a lightweight C++ daemon that monitors file accesses via fanotify on your array disks. When a file exceeds configurable access thresholds it gets promoted to your cache/NVMe pool.
  
  Features:
  - Event-driven promotion via fanotify (no polling or cron)
  - Three promotion rules: small-file first-access, large-file streaming burst, periodic open detection
  - Mover/rsync-aware: pauses automatically during transfers
  - Hot-tier fill guard, dry-run mode, exclude patterns
  - Stackable pause locks for backup scripts, remotely accessible via ssh
  - Live log viewer in the settings page";s:10:"Screenshot";a:3:{i:0;s:80:"https://raw.githubusercontent.com/kaedinger/unspin/main/images/scr1_settings.png";i:1;s:80:"https://raw.githubusercontent.com/kaedinger/unspin/main/images/scr2_settings.png";i:2;s:75:"https://raw.githubusercontent.com/kaedinger/unspin/main/images/scr3_log.png";}s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/kaedinger/unraid-ca-xml-templates/main/unspin.xml";s:12:"TemplatePath";s:30:"/tmp/GitHub/AppFeed/unspin.xml";s:10:"Repository";s:71:"https://github.com/kaedinger/unspin/releases/latest/download/unspin.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:13:"pluginVersion";s:16:"2026.10.17.48740";s:6:"Author";s:9:"kaedinger";s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:44;s:9:"FirstSeen";i:1790344094;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:18;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:26;s:1:"T";i:44;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:2816;s:11:"Displayable";b:1;s:13:"DockerHubName";s:6:"unspin";s:8:"RepoName";s:22:"kaedinger's Repository";s:10:"SortAuthor";s:9:"kaedinger";s:8:"SortName";s:6:"Unspin";s:6:"random";i:1859582565;s:9:"Blacklist";b:0;s:4:"Path";s:170:"/tmp/community.applications/tempFiles/templates-community-apps/kaedingersRepository/kaedinger-Unspin-//github.com/kaedinger/unspin/releases/latest/download/unspin.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:51:"If you appreciate my work please consider donating.";s:10:"DonateLink";s:31:"https://www.paypal.me/kaedinger";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2817;a:40:{s:4:"Name";s:15:"peptide-pitstop";s:10:"Repository";s:37:"ghcr.io/kavo91/peptide-pitstop:latest";s:8:"Registry";s:72:"https://github.com/kavo91/peptide-pitstop/pkgs/container/peptide-pitstop";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/kavo91/peptide-pitstop/issues";s:7:"Project";s:41:"https://github.com/kavo91/peptide-pitstop";s:8:"Overview";s:644:"Peptide Pitstop is a free, open-source, self-hosted peptide & GLP-1 tracker. Log doses, titration schedules, protocols, blood-work, and wellness metrics in a single-user private dashboard. Data stays on your server in an encrypted SQLite database (AES-256-GCM field encryption). First run opens a /setup wizard to create your password + TOTP.Required environment variables (PT_FIELD_KEY and AUTH_SECRET) MUST be set to long random secrets before first run - see the Project page for how to generate them. Set COOKIE_SECURE to false if you access the UI over plain HTTP on your LAN (without a reverse proxy / HTTPS), otherwise login will fail.";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:95:"https://raw.githubusercontent.com/kavo91/peptide-pitstop/main/deploy/unraid/peptide-pitstop.xml";s:4:"Icon";s:60:"https://peptidepitstop.com/public/icons/icon-pitstop-512.png";s:8:"Requires";s:329:"You MUST set the PT_FIELD_KEY and AUTH_SECRET variables to strong random secrets before starting the container. Generate PT_FIELD_KEY (base64 32-byte key) with: openssl rand -base64 32 -- Generate AUTH_SECRET with: openssl rand -hex 32 -- Keep both secret and back them up; losing PT_FIELD_KEY makes encrypted data unrecoverable.";s:7:"License";s:8:"AGPL-3.0";s:7:"WebPage";s:26:"https://peptidepitstop.com";s:16:"ExtraSearchTerms";s:92:"peptide GLP-1 tracker semaglutide tirzepatide health titration dose log self-hosted wellness";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:41:"HTTP port for the Peptide Pitstop web UI.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a