ory";s:10:"SortAuthor";s:6:"apache";s:8:"SortName";s:18:"apache tika server";s:6:"random";i:1513212514;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/SkylinarsRepository/apache-apachetikaserver-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:3.079;s:12:"trendAverage";d:6.1046;s:10:"DonateText";s:57:"If you find my work helpful, consider buying me a coffee!";s:10:"DonateLink";s:26:"https://ko-fi.com/skylinar";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1181;a:50:{s:4:"Name";s:15:"Bgutil-Provider";s:10:"Repository";s:42:"brainicism/bgutil-ytdlp-pot-provider:1.3.2";s:8:"Registry";s:61:"https://hub.docker.com/r/brainicism/bgutil-ytdlp-pot-provider";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:68:"https://forums.unraid.net/topic/193655-support-skylinars-repository/";s:6:"ReadMe";s:80:"https://github.com/Skylinar/unraid_templates/blob/main/README.md#bgutil-provider";s:7:"Project";s:55:"https://github.com/Brainicism/bgutil-ytdlp-pot-provider";s:6:"GitHub";s:55:"https://github.com/Brainicism/bgutil-ytdlp-pot-provider";s:8:"Overview";s:1035:"BgUtils POT Provider is a proof-of-origin (POT) token provider HTTP server for yt-dlp. It generates tokens that help yt-dlp downloads from YouTube appear more legitimate, which may help avoid 'Sign in to confirm you're not a bot' errors and HTTP 403 responses. Commonly used together with Tube Archivist, which has a built-in integration (set 'PO Token Provider URL' in Application settings to http://YOUR-Unraid-IP:4416).

WARNING - NEVER EXPOSE THIS SERVICE TO THE INTERNET:
The token server is unauthenticated by design. It must never be published to the internet or exposed through a reverse proxy. Accessible tokens from untrusted clients could be misused, resources consumed and potentially remote code execution triggered. Keep it on the local network only and do not create a reverse proxy entry for it.

