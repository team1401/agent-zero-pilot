elps turn your Unraid server into a Monero / cryptocurrency mining rig. Now optionally works with GPU algorithms as well.";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://forums.unraid.net/topic/105051-support-lnxd-xmrig/";s:4:"Icon";s:71:"https://raw.githubusercontent.com/lnxd/docker-xmrig/main/xmrig-logo.png";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Pool";s:6:"Target";s:4:"POOL";s:7:"Default";s:31:"xmr-us-east1.nanopool.org:14444";s:4:"Mode";s:0:"";s:11:"Description";s:62:"Address for your mining pool. Eg. 'xmr-au1.nanopool.org:14444'";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"xmr-au1.nanopool.org:14444";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Wallet";s:6:"Target";s:6:"WALLET";s:7:"Default";s:95:"84e8UJvXHDGVfE5HZDQfhn3Kh3RGJKebz31G7D4H24TLPMe9x7bQLBw8iyBhNx9USXB8MhvhBe3DyVW1LcuVAf4jBiADNLw";s:4:"Mode";s:0:"";s:11:"Description";s:366:"Wallet address for receiving mined coin. If you are privacy conscious, you can redact this in logs posted to the support thread by replacing it with *****WALLET*****. If you use Monero, sharing this address will only allow people to send you Monero and possibly identify you if you send someone else Monero, but being a privacy oriented coin it's entirely up to you.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:95:"84e8UJvXHDGVfE5HZDQfhn3Kh3RGJKebz31G7D4H24TLPMe9x7bQLBw8iyBhNx9USXB8MhvhBe3DyVW1LcuVAf4jBiADNLw";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Worker name";s:6:"Target";s:6:"WORKER";s:7:"Default";s:6:"Unraid";s:4:"Mode";s:0:"";s:11:"Description";s:585:"Enter a name for your worker. Some pools use a hidden option with this (Nanopool included) that allows you to change your payment threshold on their website. If you want to use this option, you can change this to 'workername/email', eg. 'Unraid/test@example.com', where test@example.com is your own email address. This option is basically a password. Please take note that if you post your logs in the support thread you would be best to redact the email address, eg. change out the instances of your email with ***@***.*** to prevent your email address being posted in a public forum.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"Unraid";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Additional XMRig Arguments";s:6:"Target";s:10:"ADDITIONAL";s:7:"Default";s:10:"--no-color";s:4:"Mode";s:0:"";s:11:"Description";s:394:"Please leave '--no-colour', as Unraid's webUI log viewer does not respond well to this option being disabled. | If you plan on using an AMD card for GPU mining, please add '--opencl'; the field would then read '--no-colour --opencl', please don't miss the variables below. | If you plan on using an Nvidia card for GPU mining, please add '--cuda'; the field would then read '--no-colour --cuda'";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"--no-color";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Donation %";s:6:"Target";s:6:"DONATE";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:80:"% that you would like to donate. Enter a whole number between 0-100, no symbols.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Donation to";s:6:"Target";s:3:"FEE";s:7:"Default";s:8:"lnxd-fee";s:4:"Mode";s:0:"";s:11:"Description";s:104:"Select where you would like to donate the developer fee. Options are 'dev-fee', 'lnxd-fee' and 'no-fee'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"lnxd-fee";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name"