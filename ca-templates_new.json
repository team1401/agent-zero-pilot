tegory";s:14:"MediaApp:Video";s:2:"ID";i:4991;s:11:"Displayable";b:0;s:6:"Author";s:15:"zombifiedturkey";s:13:"DockerHubName";s:8:"fancyfin";s:8:"RepoName";s:37:"ZombifiedTurkey Fancyfin's Repository";s:10:"SortAuthor";s:15:"zombifiedturkey";s:8:"SortName";s:8:"Fancyfin";s:6:"random";i:1894167911;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:71:"/tmp/community.applications/tempFiles/templates-community-apps/4991.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"BranchName";s:4:"edge";s:17:"BranchDescription";s:93:"The latest development build. It follows every change to the main branch and may be unstable.";s:11:"Description";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4992;a:37:{s:4:"Name";s:4:"YAMZ";s:10:"Repository";s:35:"ghcr.io/zombifiedturkey/yamz:latest";s:8:"Registry";s:59:"https://github.com/zombifiedturkey/YAMZ/pkgs/container/yamz";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:46:"https://github.com/zombifiedturkey/YAMZ/issues";s:7:"Project";s:39:"https://github.com/zombifiedturkey/YAMZ";s:8:"Overview";s:649:"YAMZ (Yet Another Media Zombie) is a good-looking browser for your movie and TV collection. Connect Plex or Jellyfin and get a poster wall with ratings, cast and photos, a Gaps page that finds what's missing from your franchises and TV seasons, Discover (Popular, Upcoming, Recent and Essentials by genre and decade), your own Lists, a release Calendar, Plex Watchlist sync, and one-click adding to Radarr and Sonarr. Everything is stored in /config and protected by its own sign-in. Open the WebUI and create your account on first run. Note: YAMZ is tested day to day with Plex. Jellyfin support should work but still needs more real-world testing.";s:5:"WebUI";s:24:"http://[IP]:[PORT:7979]/";s:11:"TemplateURL";s:75:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/unraid/yamz.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/unraid/yamz-icon.png";s:10:"Screenshot";a:6:{i:0;s:76:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/library.jpg";i:1;s:76:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/details.jpg";i:2;s:80:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/collections.jpg";i:3;s:75:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/actors.jpg";i:4;s:77:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/discover.jpg";i:5;s:77:"https://raw.githubusercontent.com/zombifiedturkey/YAMZ/main/docs/calendar.jpg";}s:5:"Video";s:43:"https://www.youtube.com/watch?v=bnb8neIcp1s";s:8:"Requires";s:137:"A Plex or Jellyfin server reachable from this container (or plain media folders). Radarr, Sonarr, TMDB and OMDb keys are optional extras.";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI port";s:6:"Target";s:4:"7979";s:7:"Default";s:4:"7979";s:4:"Mode";s:3:"tcp";s:11:"Description";s:32:"Port for the YAMZ web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7979";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:22:"/mnt/user/appdata/yamz";s:4:"Mode";s:2:"rw";s:11:"Description";s:56:"Where YAMZ keeps its settings, lists, account and cache.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:22:"/mnt/user/appdata/yamz";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:51:"User ID YAMZ runs as (Unraid default: 99 = nobody).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:52:"Group ID YAMZ runs as (Unraid default: 100 = users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Sign-in";s:6:"Target";s:9:"YAMZ_AUTH";s:7:"Default";s:7:"on|none";s:4:"Mode";s:0:"";s:11:"Description";s:119:"Keep 'on'. Choose 'none' ONLY if a reverse proxy in front of YAMZ already requires a login (Authelia, Authentik, etc.).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"on";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Behind a reverse proxy";s:6:"Target";s:16:"YAMZ_TRUST_PROXY";s:7:"Default";s:10:"false|true";s:4:"Mode";s:0:"";s:11:"Description";s:187:"Set to true when you reach YAMZ through a reverse proxy (SWAG, Nginx Proxy Manager, Traefik, Caddy). Enables secure cookies over https and correct client addresses for sign-in protection.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:30:"Allow self-signed certificates";s:6:"Target";s:22:"YAMZ_ALLOW_SELF_SIGNED";s:7:"Default";s:10:"false|true";s:4:"Mode";s:0:"";s:11:"Description";s:94:"Set to true if your Plex, Jellyfin, Radarr or Sonarr use https with a self-signed certificate.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Base path";s:6:"Target";s:14:"YAMZ_BASE_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:122:"Only needed if your reverse proxy serves YAMZ under a sub-folder (e.g. /yamz) WITHOUT stripping it. Leave empty otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Initial username";s:6:"Target";s:9:"YAMZ_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:85:"Optional. Creates this account on first start instead of the in-browser setup screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Initial password";s:6:"Target";s:13:"YAMZ_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:108:"Optional. Password for the initial account (at least 8 characters). You can remove it after the first start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:35:"/tmp/GitHub/AppFeed/unraid/yamz.xml";s:4:"Repo";s:28:"ZombifiedTurkey's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1792138032;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:4992;s:11:"Displayable";b:1;s:6:"Author";s:15:"zombifiedturkey";s:13:"DockerHubName";s:4:"yamz";s:8:"RepoName";s:28:"ZombifiedTurkey's Repository";s:10:"SortAuthor";s:15:"zombifiedturkey";s:8:"SortName";s:4:"YAMZ";s:6:"random";i:659123340;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:121:"/tmp/community.applications/tempFiles/templates-community-apps/ZombifiedTurkeysRepository/zombifiedturkey-YAMZ-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4993;a:38:{s:4:"Name";s:8:"heddohon";s:10:"Repository";s:32:"ghcr.io/zorcerer/heddohon:latest";s:8:"Registry";s:60:"https://github.com/zorcerer/heddohon/pkgs/container/heddohon";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:6:"MinVer";s:4:"6.12";s:7:"Support";s:43:"https://github.com/zorcerer/heddohon/issues";s:7:"Project";s:36:"https://github.com/zorcerer/heddohon";s:6:"ReadMe";s:66:"https://raw.githubusercontent.com/zorcerer/heddohon/main/README.md";s:11:"TemplateURL";s:79:"https://raw.githubusercontent.com/zorcerer/heddohon/main/templates/heddohon.xml";s:4:"Icon";s:77:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/icon.png";s:10:"Screenshot";a:7:{i:0;s:78:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/album.jpg";i:1;s:79:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/lyrics.jpg";i:2;s:88:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/recommendations.jpg";i:3;s:82:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/listening.jpg";i:4;s:78:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/share.jpg";i:5;s:85:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/phone-player.jpg";i:6;s:84:"https://raw.githubusercontent.com/zorcerer/heddohon/main/docs/assets/phone-album.jpg";}s:16:"ExtraSearchTerms";s:76:"navidrome subsonic jellyfin music player flac lossless lyrics radio scrobble";s:7:"License";s:3:"MIT";s:4:"Date";s:10:"2026-10-16";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:8:"Overview";s:1102:"A music player for a Navidrome, Subsonic or Jellyfin library, rendered on the server.

Audio and artwork are fetched by Heddohon rather than by the browser, so the music server never has to be reachable from the devices you play on: one hostname is exposed and the library stays where it is. Sign-in is a live call to the music server, so there is no second set of accounts to keep.

Streams the original file by default, up to FLAC 24/192, with no transcoding or resampling, and shows what is being decoded. Transcoding to MP3, Opus or AAC is a setting of each account.

Synced lyrics, crossfade, a 10-band equaliser, ReplayGain, internet radio from the stations Navidrome lists, and a listening history with statistics, kept on this server. Links to songs, albums and playlists play without an account, and a link to listen together plays what the host plays. The queue and settings follow the account between devices, one browser can control another, and accounts that choose to can see what each other is playing. There is a phone layout, an installable app, and desktop apps for Linux and Windows.";s:8:"Requires";s:1122:"Nothing has to be filled in before the first start. With Secret and both music server URLs left empty, Heddohon prints a setup code to its log (Logs, on the container's icon) and serves a setup page at its address, which makes the secret and asks for the music server and the address Heddohon is opened at. To skip the setup page, fill in Secret (openssl rand -base64 48; changing it later signs everyone out), a music server URL as the container reaches it (http://192.168.1.10:4533) and Public URL exactly as the browser shows it (http://192.168.1.10:3000, or https://music.example.com behind a reverse proxy); over plain http, also set Secure cookie (Advanced) to false. The appdata folder is given to PUID and PGID (Advanced, 99 and 100) when the container starts. A container made from this template before 0.7.0 has --user 99:100 under Extra Parameters: remove it, or the folder has to be that user's already (chown -R 99:100 /mnt/user/appdata/heddohon). The database is SQLite in appdata unless the PostgreSQL settings (Advanced) are filled in. Every setting: https://github.com/zorcerer/heddohon/wiki/Configuration";s:6:"Config";a:45:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:32:"Port the interface is served on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:26:"/mnt/user/appdata/heddohon";s:4:"Mode";s:2:"rw";s:11:"Description";s:96:"Holds the cover cache and the log files, and the SQLite database unless a PostgreSQL URL is set.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/heddohon";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:6:"Secret";s:6:"Target";s:15:"HEDDOHON_SECRET";s:7:"Default";s:0:"";s:11:"Description";s:213:"Encrypts stored music-server credentials and derives session keys. Minimum 32 characters: openssl rand -base64 48. Changing it signs everyone out. Left empty, the first-run setup makes one and saves it in appdata.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Navidrome / Subsonic URL";s:6:"Target";s:21:"HEDDOHON_SUBSONIC_URL";s:7:"Default";s:0:"";s:11:"Description";s:169:"Base URL of your Navidrome or Subsonic server, resolved by this container and not by the browser, such as http://192.168.1.10:4533. Leave empty if you only use Jellyfin.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Jellyfin URL";s:6:"Target";s:21:"HEDDOHON_JELLYFIN_URL";s:7:"Default";s:0:"";s:11:"Description";s:106:"Base URL of your Jellyfin server, such as http://192.168.1.10:8096. Leave empty if you only use Navidrome.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:6:"ORIGIN";s:7:"Default";s:0:"";s:11:"Description";s:386:"The address you open Heddohon at, exactly as the browser shows it, with its scheme and port: http://192.168.1.10:3000 on the LAN, or https://music.example.com behind a reverse proxy. Sign-in and every other change are refused from an address that does not match. Left empty, the address is asked for by the first-run setup and can be changed by an administrator under Settings, Storage.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Secure cookie";s:6:"Target";s:22:"HEDDOHON_COOKIE_SECURE";s:7:"Default";s:4:"auto";s:11:"Description";s:172:"auto marks the session cookie Secure, which in this image is always, whatever the scheme. Set false if you reach this over plain http on the LAN, or sign-in will not stick.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Session hours";s:6:"Target";s:22:"HEDDOHON_SESSION_HOURS";s:7:"Default";s:3:"720";s:11:"Description";s:77:"How long a sign-in lasts, in hours. 720 is 30 days. Not extended by activity.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"720";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Application name";s:6:"Target";s:17:"HEDDOHON_APP_NAME";s:7:"Default";s:8:"Heddohon";s:11:"Description";s:47:"Shown on the sign-in screen and in the sidebar.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"Heddohon";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Navidrome label";s:6:"Target";s:23:"HEDDOHON_SUBSONIC_LABEL";s:7:"Default";s:9:"Navidrome";s:11:"Description";s:49:"Name shown for this server on the sign-in screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"Navidrome";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Jellyfin label";s:6:"Target";s:23:"HEDDOHON_JELLYFIN_LABEL";s:7:"Default";s:8:"Jellyfin";s:11:"Description";s:49:"Name shown for this server on the sign-in screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"Jellyfin";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Sign-in hint";s:6:"Target";s:19:"HEDDOHON_LOGIN_HINT";s:7:"Default";s:0:"";s:11:"Description";s:87:"An optional line of text on the sign-in screen, for telling users which account to use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Cover cache";s:6:"Target";s:23:"HEDDOHON_COVER_CACHE_MB";s:7:"Default";s:3:"512";s:11:"Description";s:138:"Megabytes of cover art kept under the appdata path. The least recently used files are dropped once it is passed. 0 switches the cache off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"512";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Upstream timeout";s:6:"Target";s:28:"HEDDOHON_UPSTREAM_TIMEOUT_MS";s:7:"Default";s:5:"20000";s:11:"Description";s:101:"Milliseconds to wait on the music server before giving up. A stream has no limit once it has started.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"20000";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Shared links";s:6:"Target";s:16:"HEDDOHON_SHARING";s:7:"Default";s:4:"true";s:11:"Description";s:306:"true lets accounts share a song, an album or a playlist by link, playable by anyone with the link for 1, 7 or 30 days, and start a session to listen together (which also needs Remote control). false hides the share buttons and stops existing links from opening; they open again if this is set back to true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Downloads";s:6:"Target";s:18:"HEDDOHON_DOWNLOADS";s:7:"Default";s:4:"true";s:11:"Description";s:89:"The Download original link in the player's track details. false removes it and its route.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Remote control";s:6:"Target";s:23:"HEDDOHON_REMOTE_CONTROL";s:7:"Default";s:4:"true";s:11:"Description";s:243:"The player's Devices button: control playback on another browser signed in to the same account and, with the Navidrome plugin, pick a track up from another app. false removes it and its routes, and with it Listening now and listening together.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:17;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Listening now";s:6:"Target";s:18:"HEDDOHON_LISTENERS";s:7:"Default";s:4:"true";s:11:"Description";s:237:"Lets accounts on this server see what each other is playing. An account is shown only after it turns this on under Settings, Account, where it also sets a display name and a picture. false removes it and its routes. Needs Remote control.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Default theme";s:6:"Target";s:22:"HEDDOHON_DEFAULT_THEME";s:7:"Default";s:8:"terminal";s:11:"Description";s:158:"The theme an account starts in, and the one the sign-in page is drawn in: terminal, liquid, paper or phosphor. Each account can change its own under Settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"terminal";}i:19;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"User ID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:121:"The user the server runs as, and the owner the appdata folder is given when the container starts. 99 is nobody on Unraid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:20;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Group ID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:122:"The group the server runs as, and the group the appdata folder is given when the container starts. 100 is users on Unraid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:21;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"First-run setup";s:6:"Target";s:14:"HEDDOHON_SETUP";s:7:"Default";s:4:"true";s:11:"Description";s:216:"When the Secret or every music server address is left empty, Heddohon prints a code to its log as it starts and serves a setup page that takes the code. false switches that off: a start without them is then an error.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:22;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Folder view";s:6:"Target";s:16:"HEDDOHON_FOLDERS";s:7:"Default";s:4:"true";s:11:"Description";s:126:"The Folders page, which browses the library as it is laid out on disk. false removes the page, its links and playing a folder.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:23;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Internet radio";s:6:"Target";s:14:"HEDDOHON_RADIO";s:7:"Default";s:4:"true";s:11:"Description";s:149:"The Radio page, for the internet radio stations Navidrome lists. A station is played through this server, which fetches its stream. false removes it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:24;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:35:"Radio stations on private addresses";s:6:"Target";s:22:"HEDDOHON_RADIO_PRIVATE";s:7:"Default";s:5:"false";s:11:"Description";s:149:"true allows a station whose stream is on a private or loopback address, for a stream served on your own network. Otherwise such a station is refused.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:25;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"Navidrome plugin token";s:6:"Target";s:31:"HEDDOHON_NAVIDROME_PLUGIN_TOKEN";s:7:"Default";s:0:"";s:11:"Description";s:449:"Optional. Set it to let the Heddohon plugin for Navidrome (heddohon.ndp, from github.com/zorcerer/heddohon-navidrome-plugin) tell this server what is played in other apps: those plays go into the listening history, an import brings in the whole scrobble history, and the Devices button lists the other apps. At least 32 characters and not the Secret: openssl rand -hex 32. The plugin's settings in Navidrome take the same value. Empty leaves it off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:26;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"AI assistants (MCP)";s:6:"Target";s:12:"HEDDOHON_MCP";s:7:"Default";s:0:"";s:11:"Description";s:499:"true lets each account make a token under Settings, AI, for an AI assistant that speaks the Model Context Protocol, such as Claude Code. The assistant then searches that account's library at /api/mcp and, if the token allows it, makes and changes playlists, favourites and ratings. What it reads goes to whoever runs its model. Left empty, it is off until the first-run setup or an administrator under Settings, AI, turns it on; true or false here decides it, and Settings does not offer the switch.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:27;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"Lyrics from LRCLIB";s:6:"Target";s:22:"HEDDOHON_LYRICS_LRCLIB";s:7:"Default";s:5:"false";s:11:"Description";s:174:"true fetches lyrics from LRCLIB for tracks the music server has none for, sending the artist, title, album and length of each such track to LRCLIB when its lyrics are opened.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:28;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"LRCLIB URL";s:6:"Target";s:26:"HEDDOHON_LYRICS_LRCLIB_URL";s:7:"Default";s:18:"https://lrclib.net";s:11:"Description";s:121:"The LRCLIB to ask. Filled in with lrclib.net; change it for a self-hosted one. Only read when Lyrics from LRCLIB is true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:18:"https://lrclib.net";}i:29;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:33:"Headphone corrections from AutoEq";s:6:"Target";s:15:"HEDDOHON_AUTOEQ";s:7:"Default";s:5:"false";s:11:"Description";s:246:"true lets listeners search the AutoEq database for their headphones under Settings, Playback, Equaliser. The server fetches the index once a day and each correction chosen from GitHub, which learns this server's address and the headphones chosen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:30;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"AutoEq URL";s:6:"Target";s:19:"HEDDOHON_AUTOEQ_URL";s:7:"Default";s:69:"https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results";s:11:"Description";s:151:"AutoEq's results directory to read. Filled in with the one on GitHub; change it for a mirror. Only read when Headphone corrections from AutoEq is true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:69:"https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results";}i:31;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:26:"Plays to a Discord channel";s:6:"Target";s:16:"HEDDOHON_DISCORD";s:7:"Default";s:5:"false";s:11:"Description";s:220:"true lets an account paste a Discord webhook address under Settings, Account, and posts each track it plays to that channel. The server then sends the title, artist, album and cover of what that account plays to Discord.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:32;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"ListenBrainz from this server";s:6:"Target";s:21:"HEDDOHON_LISTENBRAINZ";s:7:"Default";s:5:"false";s:11:"Description";s:291:"true lets each account paste a ListenBrainz user token of its own under Settings, Account, and scrobbles what it plays. The server then sends the title, artist and album of what that account plays to ListenBrainz. An account that linked ListenBrainz through Navidrome keeps that one instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:33;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"ListenBrainz URL";s:6:"Target";s:25:"HEDDOHON_LISTENBRAINZ_URL";s:7:"Default";s:28:"https://api.listenbrainz.org";s:11:"Description";s:155:"The ListenBrainz API to send to. Filled in with listenbrainz.org; change it for a server of your own. Only read when ListenBrainz from this server is true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"https://api.listenbrainz.org";}i:34;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Log level";s:6:"Target";s:18:"HEDDOHON_LOG_LEVEL";s:7:"Default";s:5:"error";s:11:"Description";s:163:"error, warn, info or debug. The default writes nothing while the server is working. debug times every call to the music server, for working out why a page is slow.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"error";}i:35;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"Log format";s:6:"Target";s:19:"HEDDOHON_LOG_FORMAT";s:7:"Default";s:4:"text";s:11:"Description";s:85:"text writes key=value lines. json writes one JSON object a line, for a log collector.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"text";}i:36;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"Slow request, in milliseconds";s:6:"Target";s:20:"HEDDOHON_LOG_SLOW_MS";s:7:"Default";s:4:"2000";s:11:"Description";s:107:"A request that takes this long or longer is logged as request-slow, at the warn level. 0 switches that off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2000";}i:37;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"Log files kept, in days";s:6:"Target";s:22:"HEDDOHON_LOG_KEEP_DAYS";s:7:"Default";s:1:"7";s:11:"Description";s:165:"The log is also written to the logs folder in the data directory, one file a day. This is how many days of files are kept; older ones are deleted. 0 writes no files.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"7";}i:38;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Android app fingerprints";s:6:"Target";s:29:"HEDDOHON_ANDROID_FINGERPRINTS";s:7:"Default";s:0:"";s:11:"Description";s:222:"Optional. The server already vouches for the released Android app, so it opens without an address bar. For an app you built and signed yourself, put its certificate's SHA-256 fingerprint here (several separated by commas).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:39;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"PostgreSQL U