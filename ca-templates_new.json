vice to use for the RTLSDR";s:4:"Type";s:6:"Device";s:4:"Mode";s:2:"ro";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"/dev/bus/usb";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"RTLSDR - Gain";s:6:"Target";s:18:"RTLSDRAIRBAND_GAIN";s:7:"Default";s:2:"25";s:11:"Description";s:26:"Gain to use for the RTLSDR";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"25";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"RTLSDR - Correction";s:6:"Target";s:24:"RTLSDRAIRBAND_CORRECTION";s:7:"Default";s:1:"0";s:11:"Description";s:203:"Use this if your dongle has a non-zero frequency tuning error, which requires correcting. Put correction value in ppm here. If the dongle tunes too high, this value shall be positive, negative otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"RTLSDR - Serial";s:6:"Target";s:20:"RTLSDRAIRBAND_SERIAL";s:7:"Default";s:0:"";s:11:"Description";s:142:"Used to have rtlsdr-airband use the correct dongle if more than one present. Enter the serial of the dongle to be used. Leave empty otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"RTLSDR - Mode";s:6:"Target";s:18:"RTLSDRAIRBAND_MODE";s:7:"Default";s:17:"multichannel|scan";s:11:"Description";s:100:"If you are tuning a single frequency, set multichannel. If you are tuning more than one, set as scan";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"RTLSDR - Frequency";s:6:"Target";s:19:"RTLSDRAIRBAND_FREQS";s:7:"Default";s:0:"";s:11:"Description";s:167:"If you are setti