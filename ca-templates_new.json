hell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:44:"https://github.com/Ferdinand99/tofarr/issues";s:7:"Project";s:37:"https://github.com/Ferdinand99/tofarr";s:8:"Overview";s:825:"Tofarr is an unofficial companion app for the Tofa media server. It builds Tofa collections from TMDB, Trakt and IMDb lists, Tofa's own discovery shelves or a list of TMDB ids, keeps them in the order of the source, and updates them on a schedule. A Discover page shows posters with an In library badge, and with Seerr connected you can request titles you do not have. Nothing is written until you have seen a preview.

Setup: open the web UI and create your login, then open Settings and enter your Tofa address (for example http://192.168.1.10:33333, not the relay) and an admin API key from Tofa under Server, Settings, API keys. A free TMDB API key is needed for TMDB and IMDb sources, a Trakt client ID for Trakt, and a Seerr address and key for requests. The variables below are optional defaults for the same settings.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:88:"https://raw.githubusercontent.com/Ferdinand99/unraid-templates/main/templates/tofarr.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/Ferdinand99/Tofarr/main/unraid/tofarr-icon.png";s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:90:"Host port for the web UI. Only change the host side; the container always listens on 8080.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Config Directory";s:6:"Target";s:7:"/config";s:7:"Default";s:24:"/mnt/user/appdata/tofarr";s:4:"Mode";s:2:"rw";s:11:"Description";s:77:"Where the SQLite database (collection definitions and run history) is stored.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/tofarr";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"TOFA_URL";s:6:"Target";s:8:"TOFA_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:149:"Optional. Can also be set in the web UI. Direct address of your Tofa server, e.g. http://192.168.1.10:33333 (API keys do not work through the relay).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"TOFA_API_KEY";s:6:"Target";s:12:"TOFA_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Optional. Can also be set in the web UI. Admin API key from Tofa Server &gt; Settings &gt; API keys (shown once when created).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"TMDB_API_KEY";s:6:"Target";s:12:"TMDB_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:101:"Free API key from themoviedb.org/settings/api. Needed for TMDB collection, list and discover sources.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"TRAKT_CLIENT_ID";s:6:"Target";s:15:"TRAKT_CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:86:"Client ID of a Trakt app (trakt.tv/oauth/applications). Needed for Trakt list sources.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"SEERR_URL";s:6:"Target";s:9:"SEERR_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:104:"Optional. Address of your Seerr, e.g. http://192.168.1.10:5055. Lets you request titles you do not have.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"SEERR_API_KEY";s:6:"Target";s:13:"SEERR_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Optional. Seerr API key (Seerr, Settings, General).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"AUTH_RESET";s:6:"Target";s:10:"AUTH_RESET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:129:"Forgot the password? Set this to true for one start. It removes the login so you can create a new one. Clear it again afterwards.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:98:"User id the app runs as, so files in the config folder get the right owner. 99 is Unraid's nobody.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:54:"Group id the app runs as. 100 is Unraid's users group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:11:"Europe/Oslo";s:4:"Mode";s:0:"";s:11:"Description";s:44:"Container timezone, used for run timestamps.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"Europe/Oslo";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/templates/tofarr.xml";s:4:"Repo";s:24:"Ferdinand99's Repository";s:12:"CategoryList";a:2:{i:0;s:17:"MediaServer-Other";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1791745164;s:8:"Category";s:33:"MediaServer:Other Tools:Utilities";s:2:"ID";i:426;s:11:"Displayable";b:1;s:6:"Author";s:11:"ferdinand99";s:13:"DockerHubName";s:6:"tofarr";s:8:"RepoName";s:24:"Ferdinand99's Repository";s:10:"SortAuthor";s:11:"ferdinand99";s:8:"SortName";s:6:"Tofarr";s:6:"random";i:2041084638;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/Ferdinand99sRepository/ferdinand99-Tofarr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:427;a:55:{s:4:"Name";s:12:"Gluetun-Full";s:10:"Repository";s:21:"qmcgaw/gluetun:latest";s:8:"Registry";s:39:"https://hub.docker.com/r/qmcgaw/gluetun";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:72:"https://forums.unraid.net/topic/199320-support-fiddlyrumpus-gluetun-full";s:7:"Project";s:36:"https://github.com/passteque/gluetun";s:6:"ReadMe";s:58:"https://github.com/passteque/gluetun/blob/master/README.md";s:8:"Overview";s:597:"Gluetun - Lightweight swiss-army-knife-like VPN client to multiple VPN service providers.

VPN client in a thin Docker container for multiple VPN providers, written in Go, and using OpenVPN or Wireguard, DNS over TLS, with a few proxy servers built-in.

