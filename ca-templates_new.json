true";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1779;a:35:{s:4:"Name";s:8:"openclaw";s:10:"Repository";s:37:"ghcr.io/cookiesncache/openclaw:latest";s:8:"Registry";s:72:"https://github.com/cookiesncache/docker-openclaw/pkgs/container/openclaw";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:104:"https://forums.unraid.net/topic/199671-support-openclaw-linuxserverio-style-openclaw-gateway-unofficial/";s:7:"Project";s:48:"https://github.com/cookiesncache/docker-openclaw";s:8:"Overview";s:833:"Unofficial, LinuxServer.io-style Docker image for the OpenClaw AI assistant gateway (upstream: https://github.com/openclaw/openclaw) - not affiliated with OpenClaw or LinuxServer.io. Uses the PUID/PGID + s6-overlay model so /config is owned by your chosen UID/GID with no manual chown; on Unraid keep PUID=99 / PGID=100 to match appdata ownership. Provide a gateway token and (optionally) an Anthropic API key. The Control UI is served on port 18789. The gateway serves plain HTTP and relies on a front TLS terminator (Tailscale serve or a reverse proxy) for HTTPS - do not expose port 18789 directly to the internet. Device pairing needs a secure context: open the UI via its https URL and set OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS to that URL. amd64 only; image tracks upstream, checked daily and rebuilt only when something changed.";s:5:"WebUI";s:25:"http://[IP]:[PORT:18789]/";s:11:"TemplateURL";s:91:"https://raw.githubusercontent.com/cookiesncache/docker-openclaw/main/templates/openclaw.xml";s:4:"Icon";s:99:"https://raw.githubusercontent.com/selfhosters/unRAID-CA-templates/master/templates/img/openclaw.png";s:6:"Config";a:20:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:5:"18789";s:7:"Default";s:5:"18789";s:4:"Mode";s:3:"tcp";s:11:"Description";s:34:"OpenClaw gateway / Control UI port";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"18789";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:26:"/mnt/user/appdata/openclaw";s:4:"Mode";s:2:"rw";s:11:"Description";s:79:"Persistent config, state and workspace (the container's ~/.openclaw lives here)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/openclaw";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:55:"User ID that owns /config. Unraid default: 99 (nobody).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:56:"Group ID that owns /config. Unraid default: 100 (users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"022";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Umask for files the container creates.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"022";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:43:"Container timezone (e.g. America/New_York).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"OPENCLAW_GATEWAY_TOKEN";s:6:"Target";s:22:"OPENCLAW_GATEWAY_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:67:"Auth token for the gateway. Generate one with: openssl rand -hex 24";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"ANTHROPIC_API_KEY";s:6:"Target";s:17:"ANTHROPIC_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:70:"Anthropic API key (sk-ant-...). Leave blank if configured another way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:35:"OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS";s:6:"Target";s:35:"OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:202:"Comma-separated allowed origins for the Control UI (CSRF/origin protection on a non-loopback bind). Set to the URL you reach the UI from, e.g. https://openclaw.YOUR-TAILNET.ts.net. Strongly recommended.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"OPENCLAW_GATEWAY_BIND";s:6:"Target";s:21:"OPENCLAW_GATEWAY_BIND";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:714:"Advanced. Which bind MODE the gateway listens on for INBOUND connections: auto, loopback, lan, tailnet or custom. This is a mode name, not a host address; legacy values like 127.0.0.1 or 0.0.0.0 are normalized to loopback / lan for you. Leave empty: the container uses loopback when Tailscale Serve is enabled (Serve runs inside the container and proxies to loopback) and lan otherwise. Set to lan if something else must reach in - a reverse proxy, a dashboard widget, or another container using the OpenAI-compatible endpoints - or if you enable Tailscale but keep the published 18789 port, because a published port cannot reach a loopback-bound process. Does not affect OpenClaw reaching OUT to other containers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"OPENAI_API_KEY";s:6:"Target";s:14:"OPENAI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:49:"Optional. OpenAI API key, if using OpenAI models.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"OPENROUTER_API_KEY";s:6:"Target";s:18:"OPENROUTER_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:29:"Optional. OpenRouter API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"GEMINI_API_KEY";s:6:"Target";s:14:"GEMINI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Optional. Google Gemini API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"GROQ_API_KEY";s:6:"Target";s:12:"GROQ_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:23:"Optional. Groq API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"XAI_API_KEY";s:6:"Target";s:11:"XAI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:29:"Optional. xAI (Grok) API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"ZAI_API_KEY";s:6:"Target";s:11:"ZAI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:23:"Optional. Z.AI API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s