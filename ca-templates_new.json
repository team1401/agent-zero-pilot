r ADMIN_EMAIL / ADMIN_PASSWORD).";s:5:"WebUI";s:24:"http://[IP]:[PORT:8090]/";s:11:"TemplateURL";s:76:"https://raw.githubusercontent.com/Oroshi-zz/Forge_90/main/unraid/forge90.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/Oroshi-zz/Forge_90/main/server/public/icon.png";s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:4:"8090";s:7:"Default";s:4:"8090";s:4:"Mode";s:3:"tcp";s:11:"Description";s:26:"Port you open FORGE 90 on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8090";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App data";s:6:"Target";s:9:"/app/data";s:7:"Default";s:25:"/mnt/user/appdata/forge90";s:4:"Mode";s:2:"rw";s:11:"Description";s:62:"Accounts, settings and every user's plan. Back this folder up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/forge90";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"APP_URL";s:6:"Target";s:7:"APP_URL";s:7:"Default";s:24:"http://192.168.1.10:8090";s:4:"Mode";s:0:"";s:11:"Description";s:155:"The address people open FORGE 90 at (used in invite and password-reset links). Use your Unraid IP and port, or your https:// domain behind a reverse proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"http://192.168.1.10:8090";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"SMTP_USER";s:6:"Target";s:9:"SMTP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:58:"Gmail account that sends invite and password-reset emails.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"SMTP_PASS";s:6:"Target";s:9:"SMTP_PASS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:103:"16-letter Gmail App Password for