//github.com/pacnpal/compressatorium/issues/new";s:7:"Project";s:42:"https://github.com/pacnpal/compressatorium";s:8:"Overview";s:496:"Compressatorium is a multi-tool game disc image converter with a web UI. Supports CHDMAN (CD/DVD/LaserDisc to CHD), Dolphin-tool (GameCube/Wii ISO/GCZ/WIA/RVZ/WBFS), and z3ds_compressor (3DS ROM compression). Features batch conversion with progress tracking, nested directory scanning, compressed archive support (ZIP, 7z, RAR), smart duplicate handling, verification, and a REST API. Mount multiple volumes under /data/ to organize different game libraries (e.g. /data/library1, /data/library2).";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/pacnpal/unraid-templates/main/compressatorium.xml";s:4:"Icon";s:86:"https://github.com/pacnpal/compressatorium/blob/latest/static/images/logo.png?raw=true";s:11:"ExtraParams";s:18:"--cap-add SYS_NICE";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8090";s:4:"Mode";s:3:"tcp";s:11:"Description";s:26:"Port for the web interface";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8090";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:33:"/mnt/user/appdata/compressatorium";s:4:"Mode";s:2:"rw";s:11:"Description";s:63:"Persistent application data (verified files DB, metadata cache)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/compressatorium";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Games";s:6:"Target";s:11:"/data/games";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:200:"Primary game library. Add additional volumes under /data/ for separate libraries. All directories under /data in the container will be automatically mounted, and you can browse and use subdirectories.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"More Games";s:6:"Target";s:12:"/data/games2";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:33:"Optional: Additional game library";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:8:"LOGLEVEL";s:7:"Default";s:4:"INFO";s:4:"Mode";s:0:"";s:11:"Description";s:35:"Logs to be shown in the docker logs";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"INFO";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Maximum Concurrent Jobs";s:6:"Target";s:19:"MAX_CONCURRENT_JOBS";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:34:"Number of parallel conversion jobs";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:39:"/tmp/GitHub/AppFeed/compressatorium.xml";s:4:"Repo";s:20:"pacnpal's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:5:"Other";}s:9:"downloads";i:24889;s:13:"downloadtrend";a:4:{i:0;i:10491;i:1;i:13093;i:2;i:19131;i:3;i:24889;}s:8:"trending";d:23.135;s:6:"trends";a:3:{i:0;d:19.873;i:1;d:31.561;i:2;d:23.135;}s:10:"trendsDate";a:3:{i:0;i:1785926957;i:1;i:1788523586;i:2;i:1791198847;}s:9:"FirstSeen";i:1775472717;s:10:"LastUpdate";i:1788029848;s:14:"LastUpdateScan";i:1791198847;s:11:"topTrending";d:3.2620000000000005;s:8:"Category";s:22:"Tools:Utilities Other:";s:2:"ID";i:4183;s:11:"Displayable";b:1;s:6:"Author";s:7:"pacnpal";s:13:"DockerHubName";s:15:"compressatorium";s:8:"RepoName";s:20:"pacnpal's Repository";s:10:"SortAuthor";s:7:"pacnpal";s:8:"SortName";s:15:"Compressatorium";s:6:"random";i:710331532;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/pacnpalsRepository/pacnpal-Compressatorium-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:3.262;s:12:"trendAverage";d:24.8563;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4184;a:37:{s:4:"Name";s:11:"mcpelevator";s:10:"Repository";s:34:"ghcr.io/pacnpal/mcpelevator:latest";s:8:"Registry";s:65:"https://github.com/pacnpal/mcpelevator/pkgs/container/mcpelevator";s:7:"Network";s:4:"host";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:49:"https://github.com/pacnpal/mcpelevator/issues/new";s:7:"Project";s:38:"https://github.com/pacnpal/mcpelevator";s:6:"ReadMe";s:63:"https://github.com/pacnpal/mcpelevator/blob/main/docs/unraid.md";s:8:"Overview";s:1884:"Elevate MCP servers into authenticated HTTP endpoints - self-hosted, in one container. Most MCP servers ship as stdio programs (npx/uvx commands) that phones and remote clients can't spawn. mcpelevator runs them for you and exposes each as a remote Streamable HTTP endpoint that Claude mobile (or any MCP client) on your network can connect to: add a server in the web UI, press start, copy the URL. Batteries included (Node/npx + Python/uv preinstalled), with process supervision, live logs, a registry browser for one-click installs, bearer-token auth, and a Host/Origin guard. Already-remote MCP servers can be proxied behind the same auth too.

DOCKER RUNNER (advanced, opt-in, requires mcpelevator 1.1.0+): mcpelevator can also run MCP servers packaged as Docker images. It is OFF by default and ROOT-EQUIVALENT - to use it, set the Docker Runner variable to true AND give it a Docker endpoint, EITHER by adding a Path mapping /var/run/docker.sock -> /var/run/docker.sock (sibling model, hands the host daemon to mcpelevator) OR by setting the Docker Host variable to a separate dind daemon (stronger isolation, no host-socket mount; because this container uses HOST networking, point Docker Host at localhost or the host IP where dind publishes its port, NOT a container name like 'dind'). The docker runner and CLI ship in 1.1.0 - on an older image the toggle does nothing. See the Unraid guide for the walkthrough.

FIRST LOGIN: this template enables LAN access, which turns control-plane auth on - the admin token is minted on first start and printed ONCE to the container log. Open the log, copy the token, and log in at http://[Unraid-ip]:8080. Host networking is used so the LAN-access gate sees real client IPs (with bridge + port publishing every client would look like the Docker gateway). Full guide: https://github.com/pacnpal/mcpelevator/blob/main/docs/Unraid.md";s:5:"WebUI";s:17:"http://[IP]:8080/";s:11:"TemplateURL";s:79:"https://raw.githubusercontent.com/pacnpal/unraid-templates/main/mcpelevator.xml";s:4:"Icon";s:81:"https://raw.githubusercontent.com/pacnpal/mcpelevator/main/assets/mcpelevator.png";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:9:"MCPE_PORT";s:7:"Default";s:4:"8080";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Port the control plane binds on the host. Host networking has no port mapping, so this variable IS the host port - change it if 8080 is already taken, and update the container's WebUI field to match so the WebUI link keeps working.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/mcpelevator";s:4:"Mode";s:2:"rw";s:11:"Description";s:133:"Persistent data: SQLite database (servers, tokens, settings) and the npm/uv package caches so installed MCP servers survive restarts.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/mcpelevator";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Allow LAN Access";s:6:"Target";s:22:"MCPE_ALLOW_PRIVATE_LAN";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:370:"First-boot seed for the 'allow access from devices on your local network' setting, so this headless box is reachable at http://[unraid-ip]:8080 right away. Enabling it turns control-plane auth ON: the admin token is printed ONCE to the container log on first start - copy it there to log in. Only seeds the first boot; the toggle in Settings is authoritative afterwards.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Admin Token (break-glass)";s:6:"Target";s:16:"MCPE_ADMIN_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:215:"Optional. A control-plane token that is always accepted on /api. Leave empty normally (a token is minted and printed to the log on first start); set it to recover from a lost token or for automation, then remove it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Public Base URL";s:6:"Target";s:20:"MCPE_PUBLIC_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:240:"Optional. Absolute URL clients use to reach this instance when it sits behind a tunnel or reverse proxy (e.g. https://mcp.example.com). The copy menu hands out endpoint URLs based on it, and its hostname is trusted by the Host/Origin guard.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Extra Allowed Hosts";s:6:"Target";s:18:"MCPE_ALLOWED_HOSTS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:175:"Optional. Comma-separated extra hostnames the Host/Origin guard always trusts (e.g. a reverse-proxy hostname that resolves to this box). Not needed for plain LAN access by IP.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Docker Runner (root-equivalent)";s:6:"Target";s:18:"MCPE_DOCKER_RUNNER";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:809:"OPT-IN and ROOT-EQUIVALENT. Requires mcpelevator 1.1.0 or newer (the docker runner and CLI ship in 1.1.0; on an older image this toggle does nothing). First-boot seed for the docker runner, which launches MCP servers packaged as Docker images on a mounted Docker daemon. Anything that can reach the Docker socket is effectively root on the host, so enable this only if you trust every image you run. It needs a Docker endpoint - EITHER add a Path mount manually (click 'Add another Path, Port, Variable...' at the bottom of this page) with Container Path and Host Path both set to /var/run/docker.sock (sibling-container model), OR set the 'Docker Host' variable below to a separate dind daemon (stronger isolation, no host-socket mount). OFF by default; the Settings toggle is authoritative after first boot.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Docker Host (docker runner, optional)";s:6:"Target";s:11:"DOCKER_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:803:"Optional, and only used by the Docker Runner. Leave EMPTY for the sibling model - the runner then uses the mounted /var/run/docker.sock (empty behaves exactly like unset; no effect). Set it to a separate/dind daemon endpoint (e.g. tcp://localhost:2375) to run launched images on that daemon instead of the host's, so images never touch Unraid's own Docker (stronger isolation, no host-socket mount). NOTE: this container uses HOST networking, so it can't resolve Docker service names like 'dind' - point it at localhost or the host's IP where the dind container publishes its port. SECURITY: a plaintext tcp://...:2375 endpoint is unauthenticated and root-equivalent - only use it on a strictly private, non-routable network and never publish it; for anything less contained front dind with TLS on 2376.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Mint Admin Token On Boot";s:6:"Target";s:21:"MCPE_MINT_ADMIN_TOKEN";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:209:"Recovery hatch: set to true to mint a fresh admin token on boot and print it to the container log (existing tokens keep working). Set back to false after grabbing it, or a new token is minted on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Max Running Servers";s:6:"Target";s:16:"MCPE_MAX_RUNNING";s:7:"Default";s:2:"50";s:4:"Mode";s:0:"";s:11:"Description";s:40:"Cap on concurrently running MCP servers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"50";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Start Timeout (seconds)";s:6:"Target";s:20:"MCPE_START_TIMEOUT_S";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:136:"Readiness timeout per server start - generous by default to cover npx/uvx cold-start package installs. Raise it for very large packages.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:35:"/tmp/GitHub/AppFeed/mcpelevator.xml";s:4:"Repo";s:20:"pacnpal's Repository";s:12:"CategoryList";a:3:{i:0;s:15:"Tools-Utilities";i:1;s:11:"Network-Web";i:2;s:13:"Network-Proxy";}s:4:"Beta";s:4:"true";s:9:"FirstSeen";i:1783713899;s:8:"Category";s:41:"Tools:Utilities Network:Web Network:Proxy";s:2:"ID";i:4184;s:11:"Displayable";b:1;s:6:"Author";s:7:"pacnpal";s:13:"DockerHubName";s:11:"mcpelevator";s:8:"RepoName";s:20:"pacnpal's Repository";s:10:"SortAuthor";s:7:"pacnpal";s:8:"SortName";s:11:"mcpelevator";s:6:"random";i:863434956;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/pacnpalsRepository/pacnpal-mcpelevator-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4185;a:38:{s:4:"Name";s:15:"SimpleGuardHome";s:10:"Repository";s:30:"pacnpal/simpleguardhome:latest";s:8:"Registry";s:48:"https://hub.docker.com/r/pacnpal/simpleguardhome";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:53:"https://github.com/pacnpal/simpleguardhome/issues/new";s:7:"Project";s:42:"https://github.com/pacnpal/simpleguardhome";s:8:"Overview";s:305:"A modern web application for checking and adding domains to custom filtering rules in AdGuard Home. Built with FastAPI and modern JavaScript, following the official AdGuard Home OpenAPI specification. Meant as a simple AdGuard Home web interface for users to check if a domain is blocked, and then add it.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/pacnpal/unraid-templates/main/simpleguardhome.xml";s:4:"Icon";s:100:"https://raw.githubusercontent.com/pacnpal/simpleguardhome/refs/heads/main/static/simpleguardhome.png";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Adguard Home URL";s:6:"Target";s:12:"ADGUARD_HOST";s:7:"Default";s:23:"http://[IP or Hostname]";s:4:"Mode";s:0:"";s:11:"Description";s:108:"The full URL of your hosted Adguard Home instance, with the protocol (http or https) prepended without port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Adguard Home Port";s:6:"Target";s:12:"ADGUARD_PORT";s:7:"Default";s:4:"3000";s:4:"Mode";s:0:"";s:11:"Description";s:55:"The