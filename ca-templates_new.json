tent.com/wastedpadre/verbatim/main/frontend/public/icon-192.png";s:11:"TemplateURL";s:82:"https://raw.githubusercontent.com/wastedpadre/verbatim/main/templates/verbatim.xml";s:8:"Overview";s:829:"Generates English closed captions from the English dub audio track of your
    own media.

    Dubtitles are hard to find because almost every "English" subtitle file is
    a translation of the Japanese audio - the dub script is a different
    adaptation and rarely matches what is actually spoken. Verbatim
    transcribes the dub itself using faster-whisper on your GPU.

    Requires the Nvidia Driver plugin from Community Applications and a CUDA
    capable card with at least 6 GB of VRAM. The transcription model holds
    roughly 4.7 GB while a job runs, so watch for contention if the same card
    also does Plex or Jellyfin hardware transcoding.

    Everything runs locally. An optional pass can send cue text to the Gemini
    API to repair misheard words; it is disabled by default and needs your own
    API key.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"ExtraParams";s:16:"--runtime=nvidia";s:8:"Requires";s:63:"Nvidia Driver plugin, and a CUDA GPU with 6 GB or more of VRAM.";s:6:"Config";a:18:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:36:"Port for the Verbatim web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Media Library";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"rw";s:11:"Description";s:85:"Your video library. Needs write access because the .srt is written next to each file.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/media";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:7:"/config";s:7:"Default";s:26:"/mnt/user/appdata/verbatim";s:4:"Mode";s:2:"rw";s:11:"Description";s:104:"Job database, saved settings, and the speech model (about 3 GB on first run). Keep this on a cache pool.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/verbatim";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"NVIDIA_VISIBLE_DEVICES";s:6:"Target";s:22:"NVIDIA_VISIBLE_DEVICES";s:7:"Default";s:3:"all";s:11:"Description";s:90:"Use 'all', or paste a specific GPU UUID from Settings -&gt; Nvidia Driver to pin one card.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"all";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:26:"NVIDIA_DRIVER_CAPABILITIES";s:6:"Target";s:26:"NVIDIA_DRIVER_CAPABILITIES";s:7:"Default";s:15:"compute,utility";s:11:"Description";s:75:"Must include 'compute'. Without it the container runs on CPU with no error.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"compute,utility";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"Model Size";s:6:"Target";s:10:"MODEL_SIZE";s:7:"Default";s:8:"large-v3";s:11:"Description";s:110:"large-v3 for best accuracy (~4.7 GB VRAM). distil-large-v3 is about twice as fast. medium.en is lighter still.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"large-v3";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Compute Type";s:6:"Target";s:12:"COMPUTE_TYPE";s:7:"Default";s:7:"float16";s:11:"Description";s:260:"float16 is standard and works everywhere. int8_float16 roughly halves VRAM (~2.6 GB) on an 8 GB card shared with GPU transcoding, but NOT on RTX 50-series: Blackwell has no int8 cuBLAS path and jobs fail with CUBLAS_STATUS_NOT_SUPPORTED. Stay on float16 there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"float16";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:6:"Device";s:6:"Target";s:6:"DEVICE";s:7:"Default";s:4:"cuda";s:11:"Description";s:59:"cuda or cpu. CPU works but takes roughly ten times as long.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"cuda";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Concurrent Jobs";s:6:"Target";s:11:"CONCURRENCY";s:7:"Default";s:1:"1";s:11:"Description";s:102:"Leave at 1 for a single GPU. Two jobs on one card contend for VRAM and will run out of memory on 8 GB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Media Roots";s:6:"Target";s:11:"MEDIA_ROOTS";s:7:"Default";s:6:"/media";s:11:"Description";s:72:"Container-side paths to browse. Comma-separated if you add more volumes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"/media";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Output Suffix";s:6:"Target";s:13:"OUTPUT_SUFFIX";s:7:"Default";s:17:".en.dubtitles.srt";s:11:"Description";s:155:"Filename suffix for generated subtitles. Jellyfin selects the sidecar automatically; in Plex you must pick 'English (SRT External)' from the subtitle menu.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:17:".en.dubtitles.srt";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Word Repair Provider";s:6:"Target";s:15:"POLISH_PROVIDER";s:7:"Default";s:6:"gemini";s:11:"Description";s:135:"gemini, openai or anthropic. Only the matching API key below is used. Everything here is also editable live on the app's Settings page.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"gemini";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"OpenAI API Key";s:6:"Target";s:14:"OPENAI_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:46:"Only needed when the provider above is openai.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"Anthropic API Key";s:6:"Target";s:17:"ANTHROPIC_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:49:"Only needed when the provider above is anthropic.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"Sonarr Path Translation";s:6:"Target";s:15:"SONARR_PATH_MAP";s:7:"Default";s:0:"";s:11:"Description";s:110:"Only needed when Sonarr and Verbatim mount the library at different paths. Format: /sonarr/path:/verbatim/path";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"adv