;s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/theodorecharles/Galleria/issues";s:7:"Project";s:25:"https://galleria.website/";s:8:"Overview";s:377:"Galleria is a modern, self-hosted photography portfolio platform built with React, TypeScript, and Express. Features include image optimization, album management, analytics, Google OAuth authentication, AI title generation (optional), MFA/Passkey support, and a beautiful responsive UI. Perfect for photographers who want full control over their portfolio without monthly fees.";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/theodorecharles/unraid-templates/master/galleria.xml";s:4:"Icon";s:102:"https://raw.githubusercontent.com/theodorecharles/Galleria/refs/heads/master/config/icons/icon-512.png";s:8:"Requires";s:1385:"<br>&nbsp;&nbsp;&nbsp;&nbsp;Open the WebUI and create a username and password. No email or domain is required.<br>&nbsp;&nbsp;&nbsp;&nbsp;For a reverse proxy, forward your one domain to the WebUI port (container port 3000).<br>&nbsp;&nbsp;&nbsp;&nbsp;Domain is optional; include https:// when setting it. Enable SSL in your reverse proxy.<br>&nbsp;&nbsp;&nbsp;&nbsp;Keep your existing Data Directory mapping when updating.<br>&nbsp;&nbsp;&nbsp;&nbsp;Existing split-domain setups remain supported: keep FRONTEND_DOMAIN, BACKEND_DOMAIN,<br>&nbsp;&nbsp;&nbsp;&nbsp;and the API port mapping in your installed container configuration.<br><br>&nbsp;&nbsp;&nbsp;&nbsp;  NVIDIA GPU Hardware Encoding (Optional):<br>&nbsp;&nbsp;&nbsp;&nbsp;  For faster video transcoding with NVIDIA GPUs, manually add these to your container:<br>&nbsp;&nbsp;&nbsp;&nbsp;  1. Edit the container and click &quot;Advanced View&quot; in the top right<br>&nbsp;&nbsp;&nbsp;&nbsp;  2. In &quot;Extra Parameters&quot; add: --runtime=nvidia<br>&nbsp;&nbsp;&nbsp;&nbsp;  3. Add two new variables (Config Type: Variable):<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; - NVIDIA_DRIVER_CAPABILITIES = all<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; - NVIDIA_VISIBLE_DEVICES = (your GPU UUID or &quot;all&quot;)<br><br>&nbsp;&nbsp;&nbsp;&nbsp;  To find your GPU UUID, run in Unraid terminal: nvidia-smi -L<br>";s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:27:"Frontend web interface port";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"API Port (Optional, Legacy)";s:6:"Target";s:4:"3001";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:108:"Optional backend port for existing split-domain reverse proxies. New installations only need the WebUI port.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Data Directory";s:6:"Target";s:9:"/app/data";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:55:"Directory for photos, database, and configuration files";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/galleria";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Domain (Optional)";s:6:"Target";s:6:"DOMAIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:188:"Optional public URL, e.g. https://photos.example.com. Leave blank for access by IP or your reverse proxy hostname. Proxy all traffic to the WebUI port; a separate API domain is not needed.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:32:"/tmp/GitHub/AppFeed/galleria.xml";s:4:"Repo";s:20:"paloooz's Repository";s:12:"Categor