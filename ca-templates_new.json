ls-logo.png";s:4:"Date";s:10:"2026-09-09";s:6:"Config";a:21:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:3:"443";s:7:"Default";s:3:"443";s:4:"Mode";s:3:"tcp";s:11:"Description";s:10:"HTTPS port";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Port: 80";s:6:"Target";s:2:"80";s:7:"Default";s:2:"80";s:4:"Mode";s:3:"tcp";s:11:"Description";s:66:"HTTP port (required for HTTP validation and HTTP - HTTPS redirect)";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Port: 443";s:6:"Target";s:3:"443";s:7:"Default";s:3:"443";s:4:"Mode";s:3:"udp";s:11:"Description";s:67:"QUIC (HTTP/3) port. Must be enabled in the default and proxy confs.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:23:"Persistent config files";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:3:"URL";s:6:"Target";s:3:"URL";s:7:"Default";s:11:"example.com";s:11:"Description";s:114:"Top url you have control over (e.g. `example.com` if you own it, or `customsubdomain.example.com` if dynamic dns).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"VALIDATION";s:6:"Target";s:10:"VALIDATION";s:7:"Default";s:8:"http|dns";s:11:"Description";s:116:"Certbot validation method to use, options are `http` or `dns` (`dns` method also requires `DNSPLUGIN` variable set).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"SUBDOMAINS";s:6:"Target";s:10:"SUBDOMAINS";s:7:"Default";s:4:"www,";s:11:"Description";s:198:"Subdomains you'd like the cert to cover (comma separated, no spaces) ie. `www,ftp,cloud`. For a wildcard cert, set this *exactly* to `wildcard` (wildcard cert is available via `dns` validation only)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"CERTPROVIDER";s:6:"Target";s:12:"CERTPROVIDER";s:7:"Default";s:0:"";s:11:"Description";s:227:"Optionally define the cert provider. Set to `zerossl` for ZeroSSL certs (requires existing ZeroSSL account(https://app.zerossl.com/signup) and the e-mail address entered in `EMAIL` env var). Otherwise defaults to Let's Encrypt.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"CERT_PROFILE";s:6:"Target";s:12:"CERT_PROFILE";s:7:"Default";s:0:"";s:11:"Description";s:231:"Optionally define a cert profile to use for cert generation. This is useful if you want to use a custom cert profile instead of the default one. Currently only supported for Let's Encrypt. See https://letsencrypt.org/docs/profiles/";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"DNSPLUGIN";s:6:"Target";s:9:"DNSPLUGIN";s:7:"Default";s:10:"cloudflare";s:11:"Description";s:669:"Required if `VALIDATION` is set to `dns`. Options are `acmedns`, `aliyun`, `azure`, `bunny`, `cloudflare`, `cpanel`, `desec`, `digitalocean`, `directadmin`, `dnsimple`, `dnsmadeeasy`, `dnspod`, `do`, `domeneshop`, `dreamhost`, `duckdns`, `dynu`, `freedns`, `gandi`, `gehirn`, `glesys`, `godaddy`, `google`, `he`, `hetzner`, `hetzner-cloud`, `infomaniak`, `inwx`, `ionos`, `linode`, `loopia`, `luadns`, `mijn-host`, `namecheap`, `netcup`, `njalla`, `nsone`, `ovh`, `porkbun`, `rfc2136`, `route53`, `sakuracloud`, `standalone`, `transip`, and `vultr`. Also need to enter the credentials into the corresponding ini (or json for some plugins) file under `/config/dns-conf`.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"PROPAGATION";s:6:"Target";s:11:"PROPAGATION";s:7:"Default";s:0:"";s:11:"Description";s:82:"Optionally override (in seconds) the default propagation time for the dns plugins.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:5:"EMAIL";s:6:"Target";s:5:"EMAIL";s:7:"Default";s:0:"";s:11:"Description";s:86:"Optional e-mail address used for cert expiration notifications (Required for ZeroSSL).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"ONLY_SUBDOMAINS";s:6:"Target";s:15:"ONLY_SUBDOMAINS";s:7:"Default";s:5:"false";s:11:"Description";s:168:"If you wish to get certs only for certain subdomains, but not the main domain (main domain may be hosted on another machine and cannot be validated), set this to `true`";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"EXTRA_DOMAINS";s:6:"Target";s:13:"EXTRA_DOMAINS";s:7:"Default";s:0:"";s:11:"Description";s:122:"Additional fully qualified domain names (comma separated, no spaces) ie. `example.net,subdomain.example.net,*.example.org`";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"fal