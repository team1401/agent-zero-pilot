;i:317;s:11:"Displayable";b:1;s:6:"Author";s:8:"daneng66";s:13:"DockerHubName";s:8:"cleanarr";s:8:"RepoName";s:28:"Daneng66_Unraid's Repository";s:10:"SortAuthor";s:8:"daneng66";s:8:"SortName";s:8:"Cleanarr";s:6:"random";i:1008680899;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:117:"/tmp/community.applications/tempFiles/templates-community-apps/Daneng66UnraidsRepository/daneng66-Cleanarr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:318;a:35:{s:4:"Name";s:5:"Siftr";s:10:"Repository";s:29:"ghcr.io/daneng66/siftr:latest";s:8:"Registry";s:54:"https://github.com/Daneng66/Siftr/pkgs/container/siftr";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:40:"https://github.com/Daneng66/Siftr/issues";s:7:"Project";s:33:"https://github.com/Daneng66/Siftr";s:8:"Overview";s:427:"Siftr is a self-hosted photo and video manager that helps you sift through your library with smart renaming, organizing, and deduplication. Exact and perceptual duplicate detection (for both photos and videos) is powered by czkawka, video thumbnails/metadata use ffmpeg, and EXIF write-back uses exiftool—all bundled in the image, nothing else to install. Point the /data volume at where your media lives and open the web UI.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:70:"https://raw.githubusercontent.com/Daneng66/Siftr/main/unraid/siftr.xml";s:4:"Icon";s:75:"https://raw.githubusercontent.com/Daneng66/Siftr/main/unraid/siftr-icon.png";s:6:"MinVer";s:5:"6.9.2";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:42:"Port the Siftr web interface is served on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:5:"/data";s:7:"Default";s:23:"/mnt/user/appdata/siftr";s:4:"Mode";s:2:"rw";s:11:"Description";s:156:"Working data: the SQLite database, generated thumbnails, and the .trash holding area for removed duplicates. Keep this on a fast share (e.g. cache/appdata).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:23:"/mnt/user/appdata/siftr";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Photo Library";s:6:"Target";s:12:"/data/photos";s:7:"Default";s:16:"/mnt/user/Photos";s:4:"Mode";s:2:"rw";s:11:"Description";s:181:"Your photo library. Siftr reads, renames, organizes and writes EXIF here, so it must be read/write. Mapped inside /data so it can live on a large array share separate from App Data.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"/mnt/user/Photos";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Trash Folder";s:6:"Target";s:12:"/data/.trash";s:7:"Default";s:30:"/mnt/user/appdata/siftr/.trash";s:4:"Mode";s:2:"rw";s:11:"Description";s:211:"Holding area for duplicates removed via 'Move to trash' (reversible deletion). By default it lives inside App Data; map it to a separate share to keep trashed files off your appdata or to recover them elsewhere.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/siftr/.trash";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Enable Similar-Image Dedup";s:6:"Target";s:13:"DEDUP_SIMILAR";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Also run czkawka's perceptual (near-duplicate) image pass in addition to exact hash matching. Slower. Set to true to enable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Similar-Image Preset";s:6:"Target";s:20:"CZKAWKA_IMAGE_PRESET";s:7:"Default";s:4:"High";s:4:"Mode";s:0:"";s:11:"Description";s:152:"czkawka similarity sensitivity for the perceptual pass: Minimal, VeryLow, Low, Medium, High, or VeryHigh. Only used when similar-image dedup is enabled.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"High";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Enable Similar-Video Dedup";s:6:"Target";s:19:"DEDUP_SIMILAR_VIDEO";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Also run czkawka's perceptual (near-duplicate) video pass, e.g. to catch the same clip re-encoded at a different bitrate/resolution. Slower. Set to true to enable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Similar-Video Tolerance";s:6:"Target";s:23:"CZKAWKA_VIDEO_TOLERANCE";s:7:"Default";s:2:"10";s:4:"Mode";s:0:"";s:11:"Description";s:138:"czkawka frame-difference tolerance for the perceptual video pass, 0 (strict) to 20 (loose). Only used when similar-video dedup is enabled.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"10";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Scan On Startup";s:6:"Target";s:15:"SCAN_ON_STARTUP";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:108:"Scan the photo library for new/changed files when the container starts. Set to false to only scan on demand.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Scan Concurrency";s:6:"Target";s:16:"SCAN_CONCURRENCY";s:7:"Default";s:1:"4";s:4:"Mode";s:0:"";s:11:"Description";s:110:"How many photos to hash and thumbnail in parallel during a scan. Raise on powerful CPUs, lower to reduce load.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"4";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Thumbnail Size";s:6:"Target";s:10:"THUMB_SIZE";s:7:"Default";s:3:"256";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Edge length in pixels of generated grid thumbnails.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"256";}}s:12:"TemplatePath";s:36:"/tmp/GitHub/AppFeed/unraid/siftr.xml";s:4:"Repo";s:21:"Daneng66's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"MediaApp-Photos";i:1;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1782144839;s:8:"Category";s:31:"MediaApp:Photos Tools:Utilities";s:2:"ID";i:318;s:11:"Displayable";b:1;s:6:"Author";s:8:"daneng66";s:13:"DockerHubName";s:5:"siftr";s:8:"RepoName";s:21:"Daneng66's Repository";s:10:"SortAuthor";s:8:"daneng66";s:8:"SortName";s:5:"Siftr";s:6:"random";i:915787651;s:9:"Blacklist";b:0;s:4:"Path";s:108:"/tmp/community.applications/tempFiles/templates-community-apps/Daneng66sRepository/daneng66-Siftr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:319;a:46:{s:4:"Name";s:17:"DiscordSoundboard";s:10:"Repository";s:28:"davefurrer/discordsoundboard";s:8:"Registry";s:53:"https://hub.docker.com/r/davefurrer/discordsoundboard";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:66:"https://forums.unraid.net/topic/121933-support-discord-soundboard/";s:7:"Project";s:48:"https://github.com/Darkside138/DiscordSoundboard";s:8:"Overview";s:567:"Simple soundboard for discord. You can trigger sounds by commands typed in the Discord chat, or you can choose the sound from the web UI. You will need to create a bot account that the bot will use to join and play sounds. The bot can only play sounds/respond to commands for servers it has been give