:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:65:"https://forums.unraid.net/topic/200036-unraid-templates-nebur692/";s:7:"Project";s:34:"https://github.com/zitadel/zitadel";s:8:"Overview";s:957:"ZITADEL v4 Login UI — the interactive sign-in pages (username/password, MFA, WebAuthn, etc.) for a ZITADEL v4 core instance.

Since v4, ZITADEL split its interactive login pages out of the main API container into this separate service. Without it, every login attempt against a v4 "zitadel" container fails with a 404 on /ui/v2/login/login — this template exists to fix exactly that.

REQUIRES the companion "zitadel" template from the same repository to already be running, using the exact same Bootstrap Volume path, since this container reads the login-client.pat token that ZITADEL writes there on its first start.

Your reverse proxy needs a path-based rule so that requests to "/" and "/ui/v2/login/*" reach this container's port 3000, while everything else keeps going to the "zitadel" container's port 8080. See the setup guide below for an Nginx Proxy Manager example.

Full setup guide: https://github.com/Nebur692/Unraid-sso-templates";s:5:"WebUI";s:36:"http://[IP]:[PORT:3000]/ui/v2/login/";s:11:"TemplateURL";s:97:"https://raw.githubusercontent.com/Nebur692/unraid-community-apps/main/templates/zitadel-login.xml";s:4:"Icon";s:92:"https://raw.githubusercontent.com/Nebur692/unraid-community-apps/main/icons/zitadel-icon.png";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:8:"Requires";s:128:"The companion &quot;zitadel&quot; template (v4 core/API), already started at least once, sharing the same Bootstrap Volume path.";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"ZITADEL API URL";s:6:"Target";s:15:"ZITADEL_API_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:152:"REQUIRED. Internal address of your 'zitadel' core container's API, e.g. http://192.168.1.50:8080 (its LAN/container IP and port, not the public domain).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Public Base Path";s:6:"Target";s:21:"NEXT_PUBLIC_BASE_PATH";s:7:"Default";s:12:"/ui/v2/login";s:4:"Mode";s:0:"";s:11:"Description";s:102:"Do not change unless you know why — must match the path your reverse proxy routes to this container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"/ui/v2/login";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Service User Token File";s:6:"Target";s:31:"ZITADEL_SERVICE_USER_TOKEN_FILE";s:7:"Default";s:35:"/zitadel/bootstrap/login-client.pat";s:4:"Mode";s:0:"";s:11:"Description";s:209:"CRITICAL, do not change. Path inside this container where the login-client.pat token (written by the 'zitadel' core container on its first start) will be read from. Must match the Bootstrap Volume mount below.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/zitadel/bootstrap/login-client.pat";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Custom Request Headers";s:6:"Target";s:22:"CUSTOM_REQUEST_HEADERS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:135:"REQUIRED behind a reverse proxy. Format: Host:your-domain,X-Forwarded-Proto:https — e.g. Host:sso.example.com,X-Forwarded-Proto:https";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:38:"Bootstrap Volume (shared with zitadel)";s:6:"Target";s:18:"/zitadel/bootstrap";s:7:"Default";s:35:"/mnt/user/appdata/zitadel/bootstrap";s:4:"Mode";s:2:"ro";s:11:"Description";s:122:"Must be the EXACT same host path used as the Bootstrap Volume in the companion 'zitadel' template, mounted read-only here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/zitadel/bootstrap";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Login UI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:121:"Internal port. Route your reverse proxy's '/' and '/ui/v2/login/*' paths here — do not expose directly to the internet.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}}s:12:"TemplatePath";s:47:"/tmp/GitHub/AppFeed/templates/zitadel-login.xml";s:4:"Repo";s:21:"Nebur692's Repository";s:12:"CategoryList";a:2:{i:0;s:8:"Security";i:1;s:18:"Network-Management";}s:9:"FirstSeen";i:1791813236;s:8:"Category";s:28:"Security: Network:Management";s:2:"ID";i:931;s:11:"Displayable";b:1;s:6:"Author";s:7:"zitadel";s:13:"DockerHubName";s:13:"zitadel-login";s:8:"RepoName";s:21:"Nebur692's Repository";s:10:"SortAuthor";s:7:"zitadel";s:8:"SortName";s:13:"zitadel login";s:6:"random";i:529603271;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/Nebur692sRepository/zitadel-zitadellogin-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateLink";s:36:"https://github.com/sponsors/Nebur692";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:932;a:40:{s:4:"Name";s:7:"zitadel";s:10:"Repository";s:30:"ghcr.io/zitadel/zitadel:latest";s:8:"Registry";s:57:"https://github.com/zitadel/zitadel/pkgs/container/zitadel";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:65:"https://forums.unraid.net/topic/200036-unraid-templates-nebur692/";s:7:"Project";s:34:"https://github.com/zitadel/zitadel";s:8:"Overview";s:1239:"ZITADEL is a self-hosted identity infrastructure platform: SSO (OIDC/SAML), MFA, and user management for your own apps and services.

This template deploys the ZITADEL v4 core/API service only. Since v4, the interactive login pages were split into a separate service (zitadel-login) that MUST be deployed alongside this one, or logging in will fail with a 404 on /ui/v2/login/login. See the companion "zitadel-login" template from the same repository.

Requires an external Postgres 14+ database (not included in this template) and a 32-character Master Key.

IMPORTANT: besides filling in the "Master Key" field below, you MUST also replace the placeholder in "Post Arguments" (under Extra Parameters, near the bottom of the Add Container page) with that exact same key — ZITADEL has a known bug where the environment variable alone isn't reliably read with the start-from-init command, and the container will crash-loop with "no master key provided" if you skip this.

Default admin login after first start: zitadel-admin@zitadel.your external domain / Password1! — you will be asked to change this password on first login (unless you disable that below).

