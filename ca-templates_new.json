eeds a fresh install; can also be set in the app's Settings screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Seerr URL";s:6:"Target";s:9:"SEERR_URL";s:7:"Default";s:32:"http://host.docker.internal:5055";s:4:"Mode";s:0:"";s:11:"Description";s:186:"Overseerr/Jellyseerr address (optional). Required for TV and optional for movies; leave blank for a Radarr-only setup. Seeds a fresh install — the app's saved connection wins once set.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Seerr API Key";s:6:"Target";s:13:"SEERR_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:138:"Seerr → Settings → General → API Key. Treat it like a password. Seeds a fresh install; can also be set in the app's Settings screen.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:31:"/tmp/GitHub/AppFeed/fliparr.xml";s:4:"Repo";s:21:"Jamisonf's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:2372;s:9:"FirstSeen";i:1787199018;s:10:"LastUpdate";i:1787670976;s:14:"LastUpdateScan";i:1792397309;s:8:"Category";s:30:"MediaApp:Video Tools:Utilities";s:2:"ID";i:664;s:11:"Displayable";b:1;s:6:"Author";s:11:"jamisonfitz";s:13:"DockerHubName";s:7:"fliparr";s:8:"RepoName";s:21:"Jamisonf's Repository";s:10:"SortAuthor";s:11:"jamisonfitz";s:8:"SortName";s:7:"Fliparr";s:6:"random";i:725692882;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/JamisonfsRepository/jamisonfitz-Fliparr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:665;a:39:{s:4:"Name";s:11:"AIOMetadata";s:10:"Repository";s:34:"ghcr.io/cedya77/aiometadata:latest";s:8:"Registry";s:65:"https://github.com/cedya77/aiometadata/pkgs/container/aiometadata";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:45:"https://github.com/cedya77/aiometadata/issues";s:7:"Project";s:38:"https://github.com/cedya77/aiometadata";s:8:"Overview";s:261:"AIOMetadata is a Stremio metadata addon. Redis is required for caching; SQLite (default) or PostgreSQL for storage. Most options (API keys, providers, catalogs, passwords) are set in the /configure web UI and stored in the database—not as container variables.";s:5:"WebUI";s:23:"http://[IP]:[PORT:3232]";s:4:"Icon";s:89:"https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/master/logos/aiometadata.png";s:11:"TemplateURL";s:91:"https://raw.githubusercontent.com/JamsRepos/Unraid-Templates/main/templates/aiometadata.xml";s:10:"Maintainer";a:1:{s:7:"WebPage";s:28:"https://github.com/JamsRepos";}s:8:"Requires";s:859:"<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Redis is required. Point REDIS_URL at your Redis instance (e.g. redis://container-name:6379 on a custom network, or redis://your-server-ip:6379). <br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Set HOST_NAME to the public URL Stremio will use (HTTPS via reverse proxy is typical). <br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;After the container is up, open /configure to set TMDB and other API keys, providers, and security options. <br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Optional env overrides (TMDB_API, LOG_LEVEL, OAuth redirects, cache tuning, etc.) are documented here: https://github.com/cedya77/aiometadata/blob/dev/docs/ENVIRONMENT_VARIABLES.md — add them via &quot;Add another Path, Port, Variable, Label or Device&quot; if you need them. <br>&nbsp;&nbsp;&nbsp;&nbsp;";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"3232";s:7:"Default";s:4:"3232";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"Host port mapped to the addon (container listens on 3232).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3232";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Data Folder";s:6:"Target";s:15:"/app/addon/data";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:66:"Persistent addon data (SQLite DB when using default DATABASE_URI).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:34:"/mnt/user/appdata/aiometadata/data";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Host Name";s:6:"Target";s:9:"HOST_NAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:96:"Public URL where the addon is reachable (include https://). Used for manifest and resource URLs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Database URI";s:6:"Target";s:12:"DATABASE_URI";s:7:"Default";s:29:"sqlite://addon/data/db.sqlite";s:4:"Mode";s:0:"";s:11:"Description";s:80:"SQLite default matches the Data Folder mount. Use postgresql://... for Postgres.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"sqlite://addon/data/db.sqlite";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Redis URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:18:"redis://redis:6379";s:4:"Mode";s:0:"";s:11:"Description";s:78:"Redis URL for caching. Change host if your Redis container is not named redis.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:18:"redis://redis:6379";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/aiometadata.xml";s:4:"Repo";s:25:"LubricantJam's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;