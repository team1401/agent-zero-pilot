N days. Can also be changed from Settings in the UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Max DB Size (MB)";s:6:"Target";s:19:"RETENTION_MAX_DB_MB";s:7:"Default";s:4:"2048";s:11:"Description";s:89:"Hard cap on on-disk SQLite size. When exceeded, the oldest syslog rows are pruned to fit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2048";}}s:12:"TemplatePath";s:50:"/tmp/GitHub/AppFeed/unraid/templates/firesight.xml";s:4:"Repo";s:22:"Tjindarrr's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:13:"Network-Other";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1782746545;s:8:"Category";s:26:"Tools:System Network:Other";s:2:"ID";i:1302;s:11:"Displayable";b:1;s:6:"Author";s:8:"tjindarr";s:13:"DockerHubName";s:9:"firesight";s:8:"RepoName";s:22:"Tjindarrr's Repository";s:10:"SortAuthor";s:8:"tjindarr";s:8:"SortName";s:9:"FireSight";s:6:"random";i:412512253;s:9:"Blacklist";b:0;s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/TjindarrrsRepository/tjindarr-FireSight-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1303;a:35:{s:4:"Name";s:27:"cf-managed-network-endpoint";s:10:"Repository";s:51:"ghcr.io/tom-joad/cf-managed-network-endpoint:latest";s:8:"Registry";s:15:"https://ghcr.io";s:7:"Network";s:3:"br0";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:55:"https://github.com/Tom-Joad/cf-managed-network-endpoint";s:7:"Project";s:55:"https://github.com/Tom-Joad/cf-managed-network-endpoint";s:11:"TemplateURL";s:106:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/templates/cf-managed-network-endpoint.xml";s:4:"Icon";s:102:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/icons/cf-managed-network-endpoint.png";s:8:"Overview";s:1034:"TLS endpoint for Cloudflare Zero Trust "Managed Networks". Serves a self-signed
    certificate on port 6443; the Cloudflare WARP client compares its SHA-256 fingerprint
    to tell whether a device is on the home network. No application logic.

    The certificate is created once, on the very first start, and kept in the Config
    folder (keys/). As long as that folder survives, the fingerprint stays the same across
    restarts and image updates. NEVER delete it: a new certificate means a new fingerprint,
    and network detection breaks silently. Include the appdata folder in your backups.

    The fingerprint is printed in the container log on every start (Unraid: container icon
    -> Logs).

    Upgrading from a version before 1.0.0: keep the old /certs path below for the first
    start, so the existing certificate is taken over. Then remove it.

    Network: a custom VLAN interface (e.g. br0.10) must exist on the machine; set a static
    IP outside the DHCP pool in this container's "Fixed IP address" setting.";s:11:"ExtraParams";s:32:"--security-opt no-new-privileges";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:45:"/mnt/user/appdata/cf-managed-network-endpoint";s:4:"Mode";s:2:"rw";s:11:"Description";s:148:"Holds the key pair (keys/) and the nginx config. NEVER delete it: a new certificate means a new fingerprint and Cloudflare network detection breaks.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"Old certificate volume (upgrade only)";s:6:"Target";s:6:"/certs";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:134:"Only when upgrading from a version before 1.0.0: your old .../certs folder, read once to take over the certificate. Remove afterwards.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:36:"User that owns the key pair (nobody)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:30:"Group for the key pair (users)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"002";s:4:"Mode";s:0:"";s:11:"Description";s:30:"Permissions mask for new files";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:41:"Time zone for the log, e.g. Europe/Berlin";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:61:"/tmp/GitHub/AppFeed/templates/cf-managed-network-endpoint.xml";s:4:"Repo";s:20:"Tomjoad's Repository";s:12:"CategoryList";a:2:{i:0;s:13:"Network-Other";i:1;s:8:"Security";}s:9:"CAComment";s:124:"This template is set up to use a custom network. You may have to adjust the network or IP address etc to match your system  ";s:9:"FirstSeen";i:1791202349;s:8:"Category";s:23:"Network:Other Security:";s:2:"ID";i:1303;s:11:"Displayable";b:1;s:6:"Author";s:8:"tom-joad";s:13:"DockerHubName";s:27:"cf-managed-network-endpoint";s:8:"RepoName";s:20:"Tomjoad's Repository";s:10:"SortAuthor";s:8:"tom-joad";s:8:"SortName";s:27:"cf managed network endpoint";s:6:"random";i:128922226;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/TomjoadsRepository/tomjoad-cfmanagednetworkendpoint-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1304;a:36:{s:4:"Name";s:11:"PanaControl";s:10:"Repository";s:35:"ghcr.io/tom-joad/panacontrol:latest";s:8:"Registry";s:15:"https://ghcr.io";s:7:"Network";s:3:"br0";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:39:"https://github.com/Tom-Joad/PanaControl";s:7:"Project";s:39:"https://github.com/Tom-Joad/PanaControl";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/templates/panacontrol.xml";s:4:"Icon";s:86:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/icons/panacontrol.png";s:8:"Overview";s:1367:"Remote control for LUMIX cameras over the cam.cgi protocol: live view in the browser,
    autofocus, start and stop video recording, ISO, and the current aperture as a reading.
    Developed against a DC-GH6 with firmware 3.01.

    Give the container its own address on the LAN (network br0, fixed IP). The camera sends
    the live view by UDP to exactly the address the request came from, so camera and
    container must be in the same subnet: with a router or a separate VLAN in between, the
    control works but no picture arrives. Don't use bridge with port mapping: a frame of
    about 23 KB travels as one UDP datagram in 17 IP fragments, and Docker's NAT drops whole
    frames when one fragment is lost. Host networking works too.

    The web interface is on port 8080 of the container's address. It has no login: whoever
    reaches it controls the camera. For access from outside, put a reverse proxy with
    authentication in front.

    Stopping: --stop-timeout 30 gives the app time to release the camera's remote session.
    A hard kill locks the camera out until it is switched off and on again.

    Based on linuxserver.io's Alpine image. The app writes no files and runs as PUID:PGID,
    never as root. Upgrading from 1.x: remove --read-only, --cap-drop ALL and the --cap-add
    options from Extra Parameters, or the container won't start.";s:11:"ExtraParams";s:50:"--stop-timeout 30 --security-opt no-new-privileges";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"LUMIX_CAMERA_IP";s:6:"Target";s:15:"LUMIX_CAMERA_IP";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:65:"The camera's address on the local network, for example 192.0.2.10";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:42:"User the app runs as (99 = nobody). Not 0.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:43:"Group the app runs as (100 = users). Not 0.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:2:"TZ";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:67:"Time zone for the time stamps in the log, for example Europe/Berlin";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"002";s:4:"Mode";s:0:"";s:11:"Description";s:95:"File mode mask. The app writes no files; kept for consistency with other linuxserver.io images.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"LUMIX_DEVICE_NAME";s:6:"Target";s:17:"LUMIX_DEVICE_NAME";s:7:"Default";s:12:"lumix-remote";s:4:"Mode";s:0:"";s:11:"Description";s:54:"Name shown on the camera's display during registration";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"LUMIX_STREAM_PORT";s:6:"Target";s:17:"LUMIX_STREAM_PORT";s:7:"Default";s:5:"49199";s:4:"Mode";s:0:"";s:11:"Description";s:58:"UDP port for the live view, on the container's own address";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"LUMIX_WEB_HOST";s:6:"Target";s:14:"LUMIX_WEB_HOST";s:7:"Default";s:7:"0.0.0.0";s:4:"Mode";s:0:"";s:11:"Description";s:99:"Where the interface listens inside the container. 0.0.0.0 opens it to the network; it has no login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"LUMIX_WEB_PORT";s:6:"Target";s:14:"LUMIX_WEB_PORT";s:7:"Default";s:4:"8080";s:4:"Mode";s:0:"";s:11:"Description";s:52:"Port of the interface on the container's own address";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"LUMIX_LOG_LEVEL";s:6:"Target";s:15:"LUMIX_LOG_LEVEL";s:7:"Default";s:4:"INFO";s:4:"Mode";s:0:"";s:11:"Description";s:25:"DEBUG for troubleshooting";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/panacontrol.xml";s:4:"Repo";s:20:"Tomjoad's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"MediaApp-Photos";i:1;s:15:"Tools-Utilities";}s:9:"CAComment";s:124:"This template is set up to use a custom network. You may have to adjust the network or IP address etc to match your system  ";s:9:"FirstSeen";i:1792397309;s:8:"Category";s:31:"MediaApp:Photos Tools:Utilities";s:2:"ID";i:1304;s:11:"Displayable";b:1;s:6:"Author";s:8:"tom-joad";s:13:"DockerHubName";s:11:"panacontrol";s:8:"RepoName";s:20:"Tomjoad's Repository";s:10:"SortAuthor";s:8:"tom-joad";s:8:"SortName";s:11:"PanaControl";s:6:"random";i:951215162;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/TomjoadsRepository/tomjoad-PanaControl-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1305;a:34:{s:4:"Name";s:10:"scanbutler";s:10:"Repository";s:34:"ghcr.io/tom-joad/scanbutler:latest";s:8:"Registry";s:15:"https://ghcr.io";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:38:"https://github.com/Tom-Joad/scanbutler";s:7:"Project";s:38:"https://github.com/Tom-Joad/scanbutler";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/templates/scanbutler.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/Tom-Joad/unraid-templates/main/icons/scanbutler.png";s:8:"Overview";s:723:"Turns scanned paper into searchable PDFs, one per document, named by topic and date. The
    Stacks input splits large scans (hundreds of pages, no separator sheets) into documents by
    content. The Scanner input takes files from a document scanner, one document per file, and
    gives them the same OCR and naming. Uses Mistral OCR (batch API) and a Mistral chat model;
    the text layer comes from a fresh Tesseract pass. No web UI: progress is in the container
    log, and a review.md per stack in the Work folder lists uncertain splits. An optional third
    input only adds the text layer and uploads to Paperless-ngx. Optionally reports the queue to
    a webhook such as Home Assistant. Needs a Mistral API key.";s:11:"ExtraParams";s:44:"--security-opt no-new-privileges --memory=4g";s:6:"Config";a:33:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Stacks";s:6:"Target";s:12:"/data/stacks";s:7:"Default";s:37:"/mnt/user/Documents/scanbutler/stacks";s:4:"Mode";s:2:"rw";s:11:"Description";s:77:"Large scans to split. inbox/, output/, archive/ and failed/ are created here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Scanner";s:6:"Target";s:13:"/data/scanner";s:7:"Default";s:38:"/mnt/user/Documents/scanbutler/scanner";s:4:"Mode";s:2:"rw";s:11:"Description";s:106:"Scanner input, one document per file. Point the scanner's network-folder target at inbox/ below this path.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Paperless";s:6:"Target";s:15:"/data/paperless";s:7:"Default";s:40:"/mnt/user/Documents/scanbutler/paperless";s:4:"Mode";s:2:"rw";s:11:"Description";s:107:"Optional Paperless-ngx input (needs PAPERLESS_URL): files get the text layer and are uploaded to Paperless.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Paperless 2";s:6:"Target";s:17:"/data/paperless-2";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:131:"Optional second Paperless input (needs PAPERLESS_2_TOKEN): uploads as another Paperless user, so its documents belong to that user.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:28:"/mnt/user/appdata/scanbutler";s:4:"Mode";s:2:"rw";s:11:"Description";s:173:"Per-stack OCR text, plan.json, review.md and temporary page images (several GB while a large stack is processed). Holds full document text: delete stacks you no longer need.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:33:"User that owns new files (nobody)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:27:"Group for new files (users)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"002";s:4:"Mode";s:0:"";s:11:"Description";s:62:"002: new files are writable for the users group, e.g. over SMB";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"MISTRAL_API_KEY";s:6:"Target";s:15:"MISTRAL_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:88:"Mistral API key. Not needed when the stacks are off and SCANNER_NAMING is off (OCR only)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"MISTRAL_LLM_MODEL";s:6:"Target";s:17:"MISTRAL_LLM_MODEL";s:7:"Default";s:20:"mistral-large-latest";s:4:"Mode";s:0:"";s:11:"Description";s:30:"Model for splitting and naming";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9