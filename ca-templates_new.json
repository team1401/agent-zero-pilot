tory";s:36:"ghcr.io/metatana/metatana-app:stable";s:8:"Registry";s:72:"https://github.com/orgs/metatana/packages/container/package/metatana-app";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/metatana/support/discussions";s:7:"Project";s:20:"https://metatana.com";s:8:"Overview";s:1209:"MetaTana turns the movie, TV, and anime folders you already own into a clean, complete media library.Add a folder and MetaTana identifies each title with trusted metadata providers and optional AI assistance. It fixes names and metadata, adds artwork, subtitles, trailers, cast, and crew, and writes player-ready NFO files. You review the result before anything moves.Library health keeps wrong matches, missing posters, duplicate copies, inconsistent naming, and incomplete seasons visible. Rename history gives you a safe way back after file changes.MetaTana is local-first, metadata-only, and downloader-agnostic. It runs on your hardware, works alongside Plex, Jellyfin, Emby, and Kodi, and does not care how the files arrived.Setup notes:- Map App Data to /app/data so your library, settings, and thumbnails survive a container update.- Map your media share under /media. Use Read/Write so MetaTana can organize files, or Read Only to scan without changing anything.- PUID 99 and PGID 100 are Unraid's usual nobody:users identity for share access.- Sign in with an email code on first run. A free account is enough for local library features.- Full guide: https://metatana.com/install/Unraid";s:5:"WebUI";s:24:"http://[IP]:[PORT:3000]/";s:4:"Icon";s:41:"https://metatana.com/catalog/icon-128.png";s:10:"Screenshot";a:4:{i:0;s:53:"https://metatana.com/catalog/screenshot-1-library.png";i:1;s:55:"https://metatana.com/catalog/screenshot-2-first-run.png";i:2;s:50:"https://metatana.com/catalog/screenshot-3-home.png";i:3;s:52:"https://metatana.com/catalog/screenshot-4-detail.png";}s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/metatana/unraid-templates/main/templates/metatana.xml";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:89:"Port for the MetaTana web interface. Change only the host side if 3000 is already in use.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Data";s:6:"Target";s:9:"/app/data";s:7:"Default";s:26:"/mnt/user/appdata/metatana";s:4:"Mode";s:2:"rw";s:11:"Description";s:99:"Persistent MetaTana state: database, settings, thumbnails, and logs. Must stay mapped to /app/data.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/metatana";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/Media";s:4:"Mode";s:2:"rw";s:11:"Description";s:218:"Your media library. Use Read/Write so MetaTana can rename files and write artwork and NFOs, or switch to Read Only to scan without changing anything. Map only the shares MetaTana needs. Unraid paths are case-sensitive.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/Media";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"User ID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:116:"User ID the app runs as. 99 is Unraid's usual nobody account. Use an ID that already has access to your media share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Group ID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:115:"Group ID the app runs as. 100 is Unraid's usual users group. Use an ID that already has access to your media share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Install Channel";s:6:"Target";s:24:"METATANA_INSTALL_CHANNEL";s:7:"Default";s:6:"unraid";s:4:"Mode";s:0:"";s:11:"Description";s:80:"Tells MetaTana it was installed from Unraid Community Applications. Leave as is.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"unraid";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Media Roots";s:6:"Target";s:10:"MEDIA_DIRS";s:7:"Default";s:6:"/media";s:4:"Mode";s:0:"";s:11:"Description";s:219:"Optional. Comma-separated media roots inside the container. The image already defaults to /media, so leave this blank unless you map media somewhere else. This does not create a source; add sources in the web interface.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/metatana.xml";s:4:"Repo";s:23:"watari_dev's Repository";s:12:"CategoryList";a:1:{i:0;s:14:"MediaApp-Other";}s:8:"Official";b:1;s:9:"FirstSeen";i:1784952247;s:8:"Category";s:14:"MediaApp:Other";s:2:"ID";i:3374;s:11:"Displayable";b:1;s:6:"Author";s:8:"metatana";s:13:"DockerHubName";s:8:"metatana";s:8:"RepoName";s:23:"watari_dev's Repository";s:10:"SortAuthor";s:8:"metatana";s:8:"SortName";s:8:"MetaTana";s:6:"random";i:265657011;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:112:"/tmp/community.applications/tempFiles/templates-community-apps/wataridevsRepository/metatana-MetaTana-stable.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3375;a:38:{s:4:"Name";s:18:"FFmpeg-Easy-Unraid";s:10:"Repository";s:28:"metronade/ffmpeg-easy-unraid";s:8:"Registry";s:53:"https://hub.docker.com/r/metronade/ffmpeg-easy-unraid";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:77:"https://forums.unraid.net/topic/196288-support-metronade-ffmpeg-easy-unraid//";s:7:"Project";s:47:"https://github.com/metronade/ffmpeg-easy-unraid";s:8:"Overview";s:1231:"FFmpeg-Easy-Unraid is a "Set and Forget" Batch Transcoder designed for Unraid.
    
    [b]Features:[/b]
    * [b]Run-Once Workflow:[/b] This container scans /import on startup, processes the queue, and stops. [b]To process new files, simply restart the container.[/b] It does not monitor continuously.
    * [b]Structure:[/b] Recursively scans directories and preserves the exact folder structure (Great for TV Series).
    * [b]Codecs:[/b] H.265 (HEVC) and AV1. (Note: AV1 requires modern GPU hardware like RTX 40xx or Intel Arc).
    * [b]Hardware:[/b] CPU, Nvidia (NVENC), Intel (QuickSync/Arc).
    * [b]Safety:[/b] Detects CPU pinning. Limits threads to 50% if no pinning is detected to prevent server freeze.
    
    [span style='color: #E80000; font-weight: bold;']IMPORTANT FOR NVIDIA USERS:[/span]
    To enable GPU support, you MUST enable "Advanced View" (top right) and add [b]--runtime=nvidia[/b] to the "Extra Parameters" field! You must also set the "Nvidia Visible Devices" variable.
    
    [span style='color: #0078D7; font-weight: bold;']IMPORTANT FOR INTEL GPU USERS:[/span]
