;s:8:"Registry";s:49:"https://registry.hub.docker.com/r/jlesage/makemkv";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:54:"https://forums.unraid.net/topic/58352-support-makemkv/";s:6:"ReadMe";s:48:"https://github.com/jlesage/docker-makemkv#readme";s:6:"GitHub";s:41:"https://github.com/jlesage/docker-makemkv";s:8:"Overview";s:1397:"MakeMKV is your one-click solution to convert video that you own into free and patents-unencumbered format that can be played everywhere. MakeMKV is a format converter, otherwise called "transcoder". It converts the video clips from proprietary (and usually encrypted) disc into a set of MKV files, preserving most information but not changing it in any way. The MKV format can store multiple video/audio tracks with all meta-information and preserve chapters.

The graphical user interface (GUI) of the application can be accessed through a modern web browser, requiring no installation or configuration on the client side, or via any VNC client.

The container is built against Alpine Linux to provide an efficient image in terms of size and resource usage.

A fully automated mode is also available: insert a DVD or Blu-ray disc into an optical drive and let MakeMKV rips it without any user interaction.

For a complete documentation of this container, see https://github.com/jlesage/docker-makemkv#readme

**NOTE**: For the container to have access to your optical drive(s), you need to add them to your container configuration. This is done by adding a new "Device". An optical drive is represented by two Linux device files: "/dev/srX" and "/dev/sgY". For optimal performance, the container needs both of them. To determine the right devices to use, start the container and look at its log.";s:5:"WebUI";s:23:"http://[IP]:[PORT:5800]";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/jlesage/docker-templates/master/jlesage/makemkv.xml";s:4:"Icon";s:97:"https://raw.githubusercontent.com/jlesage/docker-templates/master/jlesage/images/makemkv-icon.png";s:7:"Project";s:23:"https://www.makemkv.com";s:4:"Date";s:10:"2026-09-23";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:44:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Config Directory";s:6:"Target";s:7:"/config";s:7:"Default";s:25:"/mnt/user/appdata/makemkv";s:4:"Mode";s:2:"rw";s:11:"Description";s:89:"Stores the application's configuration, state, logs, and any files requiring persistency.";s:4:"Type";s:4:"Path";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"True";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Storage";s:6:"Target";s:8:"/storage";s:7:"Default";s:9:"/mnt/user";s:4:"Mode";s:2:"ro";s:11:"Description";s:75:"Contains files from the host that need to be accessible to the application.";s:4:"Type";s:4:"Path";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"True";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Output Directory";s:6:"Target";s:7:"/output";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:43:"This is where extracted videos are written.";s:4:"Type";s:4:"Path";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"True";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"User ID";s:6:"Target";s:7:"USER_ID";s:7:"Default";s: