henmedia/layerling/pkgs/container/layerling";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Project";s:37:"https://github.com/henmedia/layerling";s:7:"Support";s:49:"https://github.com/jbat66/unraid-templates/issues";s:6:"ReadMe";s:72:"https://raw.githubusercontent.com/jbat66/unraid-templates/main/README.md";s:8:"Overview";s:926:"Easy 3D CAD for 3D printing
  
  Drop a shape, cut a hole, round an edge, print it. In your browser, with no account and no CAD background. 
  
  Who It Is For;
  You own a 3D printer. You want a part that fits something, not a career in CAD. layerling works the way you already think: put a shape on the plate, drag it to size, turn a second shape into a hole, group the two, export, print. There is nothing to learn before you start and nothing to sign up for – open the page and build. Your designs stay in your own browser: no account, no cloud, nothing uploaded anywhere.
  
  Coming From Tinkercad;
  layerling sits a step beyond Tinkercad towards Fusion 360: it is operated the same way, so you will recognise everything – the plate, the shapes, solids and holes, group and ungroup, bundle, Alt-drag for a copy – but it does not stop where Tinkercad does. Things you have been missing are waiting for you.";s:16:"ExtraSearchTerms";s:40:"CAD 3D printing modeling design STL STEP";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/jbat66/unraid-templates/main/templates/layerling.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/henmedia/layerling/main/apps/web/public/favicon.ico";s:7:"License";s:8:"AGPL-3.0";s:11:"ExtraParams";s:13:"--user=99:100";s:6:"Config";a:3:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:68:"Host port for the Layerling web interface. Change if already in use.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Shared Projects";s:6:"Target";s:16:"/shared-projects";s:7:"Default";s:36:"/mnt/user/appdata/layerling/projects";s:4:"Mode";s:2:"rw";s:11:"Description";s:152:"Persistent server-saved designs. This host directory must be writable by UID 99 and GID 100. Browser-only designs are stored separately in each browser.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:36:"/mnt/user/appdata/layerling/projects";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:35:"Shared Projects Container Directory";s:6:"Target";s:29:"LAYERLING_SHARED_PROJECTS_DIR";s:7:"Default";s:16:"/shared-projects";s:11:"Description";s:87:"Must match the container path of the Shared Projects mapping. Normally leave unchanged.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value