Everything except the port and data path below is configured from the web UI after first start — Bazarr connection, translation engines (Ollama, llama.cpp, Gemini, NVIDIA NIM, OpenRouter, Groq), scheduling, and all other settings persist in Subtitlarr's own database, not container environment variables.

No media path needs to be mapped into this container — only the /data path below, which is Subtitlarr's own small SQLite database, not your library.";s:5:"WebUI";s:24:"http://[IP]:[PORT:7777]/";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/GerardUmbert/Subtitlarr/master/unraid/subtitlarr.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/GerardUmbert/Subtitlarr/master/unraid/icon.png";s:11:"ExtraParams";s:97:"--memory=2g --memory-swap=2g --restart=unless-stopped --log-opt max-size=10m --log-opt max-file=3";s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"7777";s:7:"Default";s:4:"7777";s:4:"Mode";s:3:"tcp";s:11:"Description";s:369:"Host port mapped to the container's internal port 7777 — keep this matching 7777 on both sides. Unraid's built-in Tailscale hook auto-configures Serve to proxy to the HOST-mapped port number, so a mismatched mapping (e.g. a different host port than the container's actual internal port) breaks the Tailscale hostname URL even though local/LAN access still works fine.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:28:"/mnt/user/appdata/subtitlarr";s:4:"Mode";s:2:"rw";s:11:"Description";s:138:"Subtitlarr's own SQLite database (queue, run history, settings, engine instances). NOT a media path — do not point this at your library.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/subtitlarr";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:142:"User ID the app runs as inside the container — must own (or have write access to) the Data path above. Unraid's default 'nobody' user is 99.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:85:"Group ID the app runs as inside the container. Unraid's default 'users' group is 100.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/unraid/subtitlarr.xml";s:4:"Repo";s:26:"Gerard Umbert's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Other";i:1;s:14:"MediaApp-Video";}s:9:"FirstSeen";i:1787185369;s:8:"Category";s:29:"MediaApp:Other MediaApp:Video";s:2:"ID";i:501;s:11:"Displayable";b:1;s:6:"Author";s:12:"gerardumbert";s:13:"DockerHubName";s:10:"subtitlarr";s:8:"RepoName";s:26:"Gerard Umbert's Repository";s:10:"SortAuthor";s:12:"gerardumbert";s:8:"SortName";s:10:"Subtitlarr";s:6:"random";i:635086588;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:121:"/tmp/community.applications/tempFiles/templates-community-apps/GerardUmbertsRepository/gerardumbert-Subtitlarr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:502;a:51:{s:4:"Name";s:23:"geometrikks-timescaledb";s:10:"Repository";s:29:"timescale/timescaledb-ha:pg18";s:8:"Registry";s:49:"https://hub.docker.com/r/timescale/timescaledb-ha";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:89:"https://raw.githubusercontent.com/GilbN/geometrikks/main/resources/static/pwa-512x512.png";s:8:"Overview";s:297:"TimescaleDB (PostgreSQL + TimescaleDB + PostGIS) database for GeoMetrikks. Install this container first, set a POSTGRES_PASSWORD below, then install the "geometrikks" app template and use the same password there. This container has no web UI - it exists purely as the GeoMetrikks database backend.";s:7:"Support";s:43:"https://github.com/GilbN/geometrikks/issues";s:7:"Project";s:36:"https://github.com/GilbN/geometrikks";s:11:"TemplateURL";s:110:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/templates/geometrikks-timescaledb.xml";s:6:"ReadMe";s:82:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/README.md";s:16:"ExtraSearchTerms";s:58:"postgres postgresql postgis timescale geometrikks database";s:8:"Requires";s:428:"Must be reachable from the geometrikks app container. This template exposes port 5432 to the host/LAN so the app container (run separately) can reach it via the Unraid server's IP address. The database runs as Unraid's nobody:users (99:100), which is who owns the Appdata folder Unraid creates, so no manual chown is needed. Do not run Unraid's &quot;New Permissions&quot; tool against the folder while the container is running.";s:7:"License";s:133:"Apache-2.0 (TimescaleDB Community License for TimescaleDB extension - see https://github.com/timescale/timescaledb/blob/main/LICENSE)";s:4:"Date";s:10:"2026-10-07";s:11:"ExtraParams";s:54:"--restart=unless-stopped --shm-size=512m --user 99:100";s:8:"PostArgs";s:93:"-c timescaledb.max_background_workers=40 -c max_parallel_workers=8 -c max_worker_processes=51";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"DB Port";s:6:"Target";s:4:"5432";s:7:"Default";s:4:"5432";s:4:"Mode";s:3:"tcp";s:11:"Description";s:115:"PostgreSQL port. Exposed to the host/LAN so the geometrikks app container can connect using the Unraid server's IP.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:26:"/home/postgres/pgdata/data";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:258:"Database data directory. 
bPerformance tip:/b For best performance, use a path that bypasses the Unraid array (e.g. /mnt/cache/appdata or /mnt/appdata if configured). Paths under /mnt/user go through a FUSE layer that significantly slows database operations.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"POSTGRES_PASSWORD";s:6:"Target";s:17:"POSTGRES_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:92:"Database password. Must match the DB_PASSWORD value you set in the geometrikks app template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"POSTGRES_USER";s:6:"Target";s:13:"POSTGRES_USER";s:7:"Default";s:7:"geouser";s:11:"Description";s:108:"Database user. Must match DB_USER in the geometrikks app template - only change if you also change it there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"POSTGRES_DB";s:6:"Target";s:11:"POSTGRES_DB";s:7:"Default";s:11:"geometrikks";s:11:"Description";s:112:"Database name. Must match DB_DATABASE in the geometrikks app template - only change if you also change it there.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:57:"/tmp/GitHub/AppFeed/templates/geometrikks-timescaledb.xml";s:4:"Repo";s:18:"GilbN's Repository";s:12:"CategoryList";a:1:{i:0;s:18:"Network-Management";}s:16:"ChangeLogPresent";s:1:"1";s:5:"stars";i:35;s:9:"downloads";i:36432482;s:13:"downloadtrend";a:7:{i:0;i:26605487;i:1;i:28604381;i:2;i:31492225;i:3;i:31975508;i:4;i:32534949;i:5;i:33450942;i:6;i:36432482;}s:8:"trending";d:8.184;s:6:"trends";a:7:{i:0;d:8.571;i:1;d:6.988;i:2;d:9.17;i:3;d:1.511;i:4;d:1.72;i:5;d:2.738;i:6;d:8.184;}s:10:"trendsDate";a:7:{i:0;i:1773968970;i:1;i:1776568256;i:2;i:1780681722;i:3;i:1783281837;i:4;i:1785926957;i:5;i:1788523586;i:6;i:1791198847;}s:9:"FirstSeen";i:1745188784;s:10:"LastUpdate";i:1790870172;s:14:"LastUpdateScan";i:1791198847;s:11:"topTrending";d:-0.38700000000000045;s:13:"topPerforming";d:8.184;s:8:"Category";s:18:"Network:Management";s:2:"ID";i:502;s:11:"Displayable";b:1;s:6:"Author";s:9:"timescale";s:13:"DockerHubName";s:23:"geometrikks-timescaledb";s:8:"RepoName";s:18:"GilbN's Repository";s:10:"SortAuthor";s:9:"timescale";s:8:"SortName";s:23:"geometrikks timescaledb";s:6:"random";i:325078133;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:121:"/tmp/community.applications/tempFiles/templates-community-apps/GilbNsRepository/timescale-geometrikkstimescaledb-pg18.xml";s:10:"Deprecated";b:0;s:10:"trendDelta";d:-0.387;s:12:"trendAverage";d:5.5546;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:503;a:42:{s:4:"Name";s:11:"geometrikks";s:10:"Repository";s:32:"ghcr.io/gilbn/geometrikks:latest";s:8:"Registry";s:63:"https://github.com/GilbN/geometrikks/pkgs/container/geometrikks";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:89:"https://raw.githubusercontent.com/GilbN/geometrikks/main/resources/static/pwa-512x512.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:8:"Overview";s:1849:"GeoMetrikks tails your reverse proxy's access logs, looks up where every request came from with MaxMind GeoLite2, and shows the result on a live map and a traffic analytics dashboard. It reads nginx, Traefik JSON and Caddy JSON logs, detected per file, from a file or from Grafana Loki. The only outbound traffic is the GeoLite2 download and a public-IP lookup that places this server on the map, which you can turn off.[br][br]Features:[br]• Live map with heatmap and marker views, and routes that fly in as requests arrive[br]• Overview and analytics for requests, bandwidth, latency, status mix, top URLs and user agents, plus a Top ASNs view of the networks your traffic comes from[br]• Searchable access log history with filters and sorting, a live tail, and a debug view of the raw lines behind parse failures[br]• CrowdSec integration: active bans next to the traffic that caused them, ban or unban IPs and ranges from the UI, and abuse reports for hosting providers[br]• Password login, or OpenID Connect sign-in against Authelia, Authentik, Keycloak, Pocket ID or Google[br]• Multi-source ingestion: tail several files from one instance, or run headless agents on other hosts that write into the same database and show up on Settings > Agents[br]• Batch import of rotated and archived logs[br]• Application logs in the UI, plus a login log that fail2ban and CrowdSec can parse[br][br]Requirements:[br]• A TimescaleDB + PostGIS database. Install the companion "geometrikks-timescaledb" template from this repository first, or point the container at your own instance.[br]• A free MaxMind GeoLite2 account (https://www.maxmind.com/en/geolite2/signup) for the GeoIP databases.[br]• A free CARTO basemaps API key (https://carto.com/basemaps/apikey) for the map tiles.[br][br]See the repository README for full setup steps.";s:7:"Support";s:43:"https://github.com/GilbN/geometrikks/issues";s:7:"Project";s:36:"https://github.com/GilbN/geometrikks";s:11:"TemplateURL";s:98:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/templates/geometrikks.xml";s:6:"ReadMe";s:82:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/README.md";s:16:"ExtraSearchTerms";s:101:"nginx traefik caddy geoip asn analytics traffic map log parser crowdsec timescaledb oidc sso authelia";s:8:"Requires";s:376:"Requires a reachable TimescaleDB+PostGIS database (see the companion geometrikks-timescaledb template), a free MaxMind GeoLite2 account for GeoIP downloads, and a free CARTO basemaps API key for the map.<br>  Nginx access logs need a specific log_format. Traefik and Caddy JSON access logs are read as they come. See the repository README for the nginx log_format to use.<br>";s:7:"License";s:3:"MIT";s:4:"Date";s:10:"2026-10-18";s:10:"Screenshot";a:9:{i:0;s:82:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/live.png";i:1;s:81:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/map.png";i:2;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/dashboard.png";i:3;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/analytics.png";i:4;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/live-tail.png";i:5;s:89:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/access-logs.png";i:6;s:86:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/geo-logs.png";i:7;s:88:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/debug-logs.png";i:8;s:86:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/crowdsec.png";}s:11:"ExtraParams";s:42:"--restart=unless-stopped --stop-timeout=20";s:6:"Config";a:70:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:37:"HTTP port for the GeoMetrikks web UI.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Access Logs";s:6:"Target";s:15:"/var/log/access";s:7:"Default";s:33:"/mnt/cache/appdata/swag/log/nginx";s:4:"Mode";s:2:"ro";s:11:"Description";s:343:"Host directory holding your reverse proxy's access logs, mounted read-only. The default assumes SWAG. Point it at wherever nginx, Nginx Proxy Manager, Traefik or Caddy writes instead. The files must be readable by PUID:PGID. Whichever proxy you run, the container-side path stays /var/log/access, so that is what LOGPARSER_LOG_PATHS refers to.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"LOGPARSER_LOG_PATHS";s:6:"Target";s:19:"LOGPARSER_LOG_PATHS";s:7:"Default";s:26:"/var/log/access/access.log";s:11:"Description";s:217:"Access log file(s) to tail, named as the container sees them under /var/log/access. Single path, or a JSON list [&quot;/var/log/access/access.log&quot;, &quot;/var/log/access/site2/access.log&quot;] for several files.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"GeoIP Data";s:6:"Target";s:15:"/app/data/geoip";s:7:"Default";s:36:"/mnt/cache/appdata/geometrikks/geoip";s:4:"Mode";s:2:"rw";s:11:"Description";s:182:"Persistent storage for the downloaded MaxMind GeoLite2 City and ASN databases. The container fixes ownership of this folder to PUID:PGID on every start, so no manual chown is needed.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_HOST";s:6:"Target";s:7:"DB_HOST";s:7:"Default";s:0:"";s:11:"Description";s:280:"IP address of your TimescaleDB container, typically your Unraid server's IP if you installed the companion geometrikks-timescaledb template. Do not use localhost or 127.0.0.1, which is this container itself. The database container must be running and its port reachable from here.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"DB_PASSWORD";s:6:"Target";s:11:"DB_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:88:"Database password. Must match POSTGRES_PASSWORD in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAXMINDDB_USER_ID";s:6:"Target";s:17:"MAXMINDDB_USER_ID";s:7:"Default";s:0:"";s:11:"Description";s:117:"MaxMind account ID, used to download the GeoLite2 databases. Free account: https://www.maxmind.com/en/geolite2/signup";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"MAXMINDDB_LICENSE_KEY";s:6:"Target";s:21:"MAXMINDDB_LICENSE_KEY";s:7:"Default";s:0:"";s:11:"Description";s:99:"MaxMind license key, used to download the GeoLite2 databases. Create it under your MaxMind account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAP_CARTO_API_KEY";s:6:"Target";s:17:"MAP_CARTO_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:248:"CARTO basemaps API key, sent with every basemap request the browser makes. CARTO's terms require one per deployment and keyless tiles may stop working. Free at https://carto.com/basemaps/apikey. Not a secret: anyone who can open the map can see it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"APP_ADMIN_USER";s:6:"Target";s:14:"APP_ADMIN_USER";s:7:"Default";s:5:"admin";s:11:"Description";s:22:"Web UI login username.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_ADMIN_PASSWORD";s:6:"Target";s:18:"APP_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:292:"Web UI login password. Leave it blank only if you set APP_AUTH_DISABLED=true or configured OIDC_* below; otherwise the container refuses to start. With OIDC configured, a password set here keeps the password form next to the provider button, so you can still log in when the provider is down.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"LOGPARSER_IGNORE_IPS";s:6:"Target";s:20:"LOGPARSER_IGNORE_IPS";s:7:"Default";s:0:"";s:11:"Description";s:288:"IPs/CIDRs the parser drops entirely - no geo event, access log or debug row. Use it to keep your own WAN traffic through the reverse proxy out of the data(LAN traffic is never ingested), e.g. 88.99.77.66. Single value, comma-separated, or a JSON list. Empty (default): nothing is ignored.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_PORT";s:6:"Target";s:7:"DB_PORT";s:7:"Default";s:4:"5432";s:11:"Description";s:14:"Database port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_USER";s:6:"Target";s:7:"DB_USER";s:7:"Default";s:7:"geouser";s:11:"Description";s:80:"Database user. Must match POSTGRES_USER in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"DB_DATABASE";s:6:"Target";s:11:"DB_DATABASE";s:7:"Default";s:11:"geometrikks";s:11:"Description";s:78:"Database name. Must match POSTGRES_DB in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:345:"User ID the app runs as. The container starts as root only long enough to remap its internal user and fix ownership of the GeoIP and App Logs folders, then drops privileges. 99 is Unraid's 'nobody' - keep it so the appdata folders match the rest of your shares, and so nginx logs written by SWAG/NPM (which also default to 99:100) stay readable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:56:"Group ID the app runs as. 100 is Unraid's 'users' group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Logs";s:6:"Target";s:9:"/app/logs";s:7:"Default";s:35:"/mnt/cache/appdata/geometrikks/logs";s:4:"Mode";s:2:"rw";s:11:"Description";s:294:"Where GeoMetrikks writes its own logs: geometrikks.log (structured JSONL) and login.log (plain text, fail2ban/CrowdSec-friendly), plus their gzipped archives. Mounting this keeps logs across container recreation and lets host-side tools read login.log. Ownership is fixed to PUID:PGID on start.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"LOG_LEVEL";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"INFO";s:11:"Description";s:56:"Application log verbosity (DEBUG, INFO, WARNING, ERROR).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOGPARSER_SERVER_NAME";s:6:"Target";s:21:"LOGPARSER_SERVER_NAME";s:7:"Default";s:6:"Unraid";s:11:"Description";s:422:"A name you choose for this server, recorded on every request it ingests. It is not your nginx server_name. A JSON list matched to LOGPARSER_LOG_PATHS by position names each file separately, e.g. [&quot;edge-01&quot;, &quot;edge-02&quot;], and the UI then filters them as separate servers. Replaces LOGPARSER_HOST_NAME: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOGPARSER_LOG_FORMATS";s:6:"Target";s:21:"LOGPARSER_LOG_FORMATS";s:7:"Default";s:4:"auto";s:11:"Description";s:246:"Format of the file(s) above: auto (detected per file), geometrikks-json, nginx, traefik-json or caddy-json. One value covers every path, or give a JSON list matched to LOGPARSER_LOG_PATHS by position. Leave at auto unless detection gets it wrong.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"APP_INSTANCE_NAME";s:6:"Target";s:17:"APP_INSTANCE_NAME";s:7:"Default";s:0:"";s:11:"Description";s:311:"Name this container goes by on Settings &gt; Agents, which lists every GeoMetrikks instance writing to the database. Blank: it shows as head, or as agent with APP_MODE=agent. Give every agent its own name, because two unnamed agents share one and overwrite each other's status. Up to 255 characters, no slashes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_SESSION_SECURE";s:6:"Target";s:18:"APP_SESSION_SECURE";s:7:"Default";s:5:"false";s:11:"Description";s:303:"Mark the session cookie Secure so browsers only send it over HTTPS. Set true when you reach the UI through a TLS reverse proxy; leave false if you browse to http://server-ip:8000 directly, or you will not be able to log in. An https OIDC_REDIRECT_URI requires true, and the app will not start otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:23;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"APP_TRUSTED_PROXIES";s:6:"Target";s:19:"APP_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:11:"Description";s:206:"Reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For, e.g. 172.17.0.0/16 for Unraid's docker bridge. Single value, comma-separated, or a JSON list. Empty (default): forwarded headers are never trusted.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:24;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"APP_AUTH_DISABLED";s:6:"Target";s:17:"APP_AUTH_DISABLED";s:7:"Default";s:5:"false";s:11:"Description";s:292:"Set true ONLY if this container sits behind an authenticating reverse proxy (Authelia, Tailscale, etc). There is then no login and no session: anyone who can reach the container has full access. It cannot be combined with the OIDC_* settings below, and the app will not start if you set both.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:25;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:28:"ANALYTICS_RAW_RETENTION_DAYS";s:6:"Target";s:28:"ANALYTICS_RAW_RETENTION_DAYS";s:7:"Default";s:3:"180";s:11:"Description";s:49:"Days to keep raw geo_events and access_logs data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:26;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"CROWDSEC_LAPI_URL";s:6:"Target";s:17:"CROWDSEC_LAPI_URL";s:7:"Default";s:0:"";s:11:"Description";s:172:"CrowdSec Local API base URL, including http:// or https://, e.g. http://crowdsec:8080. Without the scheme the connection fails. Leave blank to disable CrowdSec integration.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:27;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"CROWDSEC_BOUNCER_API_KEY";s:6:"Target";s:24:"CROWDSEC_BOUNCER_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:92:"Bouncer API key (cscli bouncers add geometrikks) - grants read access to CrowdSec decisions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:28;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"CROWDSEC_MACHINE_ID";s:6:"Target";s:19:"CROWDSEC_MACHINE_ID";s:7:"Default";s:0:"";s:11:"Description";s:156:"Machine ID (cscli machines add) - optional, enables ban/unban from the GeoMetrikks UI. Set it together with the machine password, or the app will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:29;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"CROWDSEC_MACHINE_PASSWORD";s:6:"Target";s:25:"CROWDSEC_MACHINE_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:135:"Machine password - optional, enables ban/unban from the GeoMetrikks UI. Set it together with the machine ID, or the app will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:30;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"OIDC_ISSUER";s:6:"Target";s:11:"OIDC_ISSUER";s:7:"Default";s:0:"";s:11:"Description";s:371:"Issuer URL of your identity provider, e.g. https://auth.example.com. Leave blank to keep OIDC off. GeoMetrikks reads {issuer}/.well-known/openid-configuration and the token's iss claim must match this value exactly. Must be https unless the host is localhost. Filling in this plus the client id, secret and redirect URI puts a 'Sign in with ...' button on the login page.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:31;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"OIDC_CLIENT_ID";s:6:"Target";s:14:"OIDC_CLIENT_ID";s:7:"Default";s:0:"";s:11:"Description";s:165:"Client id of the confidential client you registered for GeoMetrikks at the provider. The authorization code flow with PKCE is used, so a public client will not work.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:32;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_CLIENT_SECRET";s:6:"Target";s:18:"OIDC_CLIENT_SECRET";s:7:"Default";s:0:"";s:11:"Description";s:30:"Client secret for that client.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:33;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"OIDC_REDIRECT_URI";s:6:"Target";s:17:"OIDC_REDIRECT_URI";s:7:"Default";s:0:"";s:11:"Description";s:302:"The exact callback URL registered at the provider: this container's public address plus /api/v1/auth/oidc/callback, e.g. https://geo.example.com/api/v1/auth/oidc/callback. It has to end in that path, and plain http is only accepted on localhost. With an https URL you also need APP_SESSION_SECURE=true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:34;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_ALLOWED_USERS";s:6:"Target";s:18:"OIDC_ALLOWED_USERS";s:7:"Default";s:0:"";s:11:"Description";s:352:"Who may sign in, as verified email addresses or subject identifiers. Single value, comma-separated, or a JSON list. An email only matches when the provider marks it verified. At least one of OIDC_ALLOWED_USERS and OIDC_ALLOWED_GROUPS is required: without an allow list, everyone the provider authenticates would get in, which for Google means everyone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:35;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"OIDC_ALLOWED_GROUPS";s:6:"Target";s:19:"OIDC_ALLOWED_GROUPS";s:7:"Default";s:0:"";s:11:"Description";s:181:"Groups allowed to sign in; being in any one of them is enough. Same formats as OIDC_ALLOWED_USERS. The provider has to send the group claim, so keep the groups scope in OIDC_SCOPES.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:36;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"OIDC_SCOPES";s:6:"Target";s:11:"OIDC_SCOPES";s:7:"Default";s:27:"openid profile email groups";s:11:"Description";s:283:"Space-separated scopes requested at login; openid is mandatory. Authelia works with the default. Google rejects the groups scope, and Authentik only sends groups if you add the mapping yourself, so use 'openid profile email' for those and allow people by email in OIDC_ALLOWED_USERS.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:37;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"CROWDSEC_DEFAULT_BAN_DURATION";s:6:"Target";s:29:"CROWDSEC_DEFAULT_BAN_DURATION";s:7:"Default";s:2:"4h";s:11:"Description";s:54:"Default duration for manual bans (Go duration string).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:38;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"CROWDSEC_REQUEST_TIMEOUT";s:6:"Target";s:24:"CROWDSEC_REQUEST_TIMEOUT";s:7:"Default";s:4:"10.0";s:11:"Description";s:32:"LAPI request timeout in seconds.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:39;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"CROWDSEC_VERIFY_TLS";s:6:"Target";s:19:"CROWDSEC_VERIFY_TLS";s:7:"Default";s:4:"true";s:11:"Description";s:32:"Verify TLS when LAPI uses https.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:40;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"CROWDSEC_STREAM_POLL_INTERVAL";s:6:"Target";s:29:"CROWDSEC_STREAM_POLL_INTERVAL";s:7:"Default";s:4:"15.0";s:11:"Description";s:69:"Seconds between decision-stream polls feeding live ban/unban updates.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:41;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"OIDC_GROUPS_CLAIM";s:6:"Target";s:17:"OIDC_GROUPS_CLAIM";s:7:"Default";s:6:"groups";s:11:"Description";s:178:"Claim that carries group membership. It is read from the ID token and from the userinfo endpoint, so providers that only serve groups from userinfo (Authelia) need nothing extra.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:42;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_PROVIDER_NAME";s:6:"Target";s:18:"OIDC_PROVIDER_NAME";s:7:"Default";s:3:"SSO";s:11:"Description";s:49:"Label on the login button: 'Sign in with {name}'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:43;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"OIDC_LOGOUT_IDP";s:6:"Target";s:15:"OIDC_LOGOUT_IDP";s:7:"Default";s:5:"false";s:11:"Description";s:358:"On logout, also end the session at the provider. This only works when the provider's discovery document advertises an end_session_endpoint; Authelia 4.39 and Google do not, so leave it false there. Before enabling it, register {your app URL}/signed-out as the post-logout redirect URI at the provider. Logout always clears the GeoMetrikks session either way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:44;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"OIDC_CA_BUNDLE";s:6:"Target";s:14:"OIDC_CA_BUNDLE";s:7:"Default";s:0:"";s:11:"Description";s:403:"PEM file holding the CA that signed your provider's certificate, for a provider behind an internal CA. Give the path as the container sees it and add a path mapping for the file yourself, e.g. host /mnt/user/appdata/geometrikks/certs/ca.pem to container /app/certs/ca.pem, readable by PUID:PGID. The app refuses to start when the file is missing. There is no switch to turn certificate verification off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:45;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"LOGPARSER_ENABLED";s:6:"Target";s:17:"LOGPARSER_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:117:"Tail and ingest the access logs. Set false for an instance that only serves the UI over data another instance writes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:46;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"LOGPARSER_POLL_INTERVAL";s:6:"Target";s:23:"LOGPARSER_POLL_INTERVAL";s:7:"Default";s:2:"10";s:11:"Description";s:145:"Interval in seconds to poll the log file for new entries. Lower it (1.0 is the app default) for a snappier live map, at the cost of more wakeups.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:47;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"LOGPARSER_BATCH_SIZE";s:6:"Target";s:20:"LOGPARSER_BATCH_SIZE";s:7:"Default";s:3:"100";s:11:"Description";s:35:"Max records before a forced commit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:48;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"LOGPARSER_COMMIT_INTERVAL";s:6:"Target";s:25:"LOGPARSER_COMMIT_INTERVAL";s:7:"Default";s:3:"5.0";s:11:"Description";s:54:"Max time interval in seconds between database commits.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:49;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:27:"LOGPARSER_STORE_DEBUG_LINES";s:6:"Target";s:27:"LOGPARSER_STORE_DEBUG_LINES";s:7:"Default";s:5:"false";s:11:"Description";s:68:"Store all raw log lines in the debug table, not just malformed ones.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:50;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"GEOIP_ASN_ENABLED";s:6:"Target";s:17:"GEOIP_ASN_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:238:"Download the GeoLite2 ASN database alongside the City one and record the network and organization behind each request. This is what fills the Top ASNs view. Uses the same MaxMind credentials; without them the app ingests without ASN data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:51;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"GEOIP_REFRESH_DAYS";s:6:"Target";s:18:"GEOIP_REFRESH_DAYS";s:7:"Default";s:1:"7";s:11:"Description";s:66:"Re-download the GeoLite2 databases when older than this many days.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:52;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"GEOIP_LOCALES";s:6:"Target";s:13:"GEOIP_LOCALES";s:7:"Default";s:16:"[&quot;en&quot;]";s:11:"Description";s:34:"JSON list of GeoIP locales to use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:53;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"MAP_DEFAULT_VIEW";s:6:"Target";s:16:"MAP_DEFAULT_VIEW";s:7:"Default";s:0:"";s:11:"Description";s:209:"Where the map opens, as latitude,longitude or latitude,longitude,zoom (zoom 0-22, default 3), e.g. 71.129982,27.653369,15. Unset: the map opens on your server locations, or the whole world when there are none.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:54;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:31:"MAP_AUTO_DETECT_SERVER_LOCATION";s:6:"Target";s:31:"MAP_AUTO_DETECT_SERVER_LOCATION";s:7:"Default";s:4:"true";s:11:"Description";s:273:"Look up this server's public IP at startup and geolocate it, so the map knows where live request routes end. Set false to skip the lookup. Replaces MAP_AUTO_DETECT_HOME: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:55;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAP_PUBLIC_IP_URL";s:6:"Target";s:17:"MAP_PUBLIC_IP_URL";s:7:"Default";s:35:"https://api64.ipify.org?format=json";s:11:"Description";s:80:"JSON endpoint used for public-IP discovery; response must contain an 'ip' field.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:56;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:33:"MAP_SERVER_LOCATION_REFRESH_HOURS";s:6:"Target";s:33:"MAP_SERVER_LOCATION_REFRESH_HOURS";s:7:"Default";s:2:"24";s:11:"Description";s:218:"Hours between re-detecting this server's public IP and updating its map location. Replaces MAP_HOME_REFRESH_HOURS: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:57;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"MAP_SERVER_LOCATIONS";s:6:"Target";s:20:"MAP_SERVER_LOCATIONS";s:7:"Default";s:2:"{}";s:11:"Description";s:491:"Fixed map locations per server name, as a JSON object of latitude/longitude pairs, e.g. {&quot;edge-01&quot;: [59.91, 10.75]}. Use it for a server whose public IP geolocates wrong (CGNAT, VPN), or whose logs are shipped from another machine. An entry here beats the location the server detects for itself. Delete the entry and its row goes at the next start. Replaces MAP_HOME_LOCATIONS: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:58;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:30:"ANALYTICS_DEBUG_RETENTION_DAYS";s:6:"Target";s:30:"ANALYTICS_DEBUG_RETENTION_DAYS";s:7:"Default";s:2:"30";s:11:"Description";s:35:"Days to keep access_log_debug data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:59;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:31:"ANALYTICS_HOURLY_RETENTION_DAYS";s:6:"Target";s:31:"ANALYTICS_HOURLY_RETENTION_DAYS";s:7:"Default";s:2:"60";s:11:"Description";s:46:"Days to keep hourly continuous aggregate data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:60;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:39:"ANALYTICS_CAGG_REFRESH_INTERVAL_MINUTES";s:6:"Target";s:39:"ANALYTICS_CAGG_REFRESH_INTERVAL_MINUTES";s:7:"Default";s:1:"5";s:11:"Description";s:47:"Minutes between continuous aggregate refreshes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:61;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:32:"ANALYTICS_COMPRESSION_AFTER_DAYS";s:6:"Target";s:32:"ANALYTICS_COMPRESSION_AFTER_DAYS";s:7:"Default";s:1:"7";s:11:"Description";s:47:"Days after which to compress hypertable chunks.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:62;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"SCHEDULER_ENABLED";s:6:"Target";s:17:"SCHEDULER_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:34:"Enable scheduled background tasks.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:63;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"LOG_MAIN_MAX_BYTES";s:6:"Target";s:18:"LOG_MAIN_MAX_BYTES";s:7:"Default";s:8:"10485760";s:11:"Description";s:95:"Rotate the main JSONL log (geometrikks.log) when it exceeds this size in bytes. Default 10 MiB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:64;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOG_MAIN_BACKUP_COUNT";s:6:"Target";s:21:"LOG_MAIN_BACKUP_COUNT";s:7:"Default";s:1:"5";s:11:"Description";s:44:"Number of gzipped main-log archives to keep.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:65;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"LOG_LOGIN_MAX_BYTES";s:6:"Target";s:19:"LOG_LOGIN_MAX_BYTES";s:7:"Default";s:8:"10485760";s:11:"Description";s:84:"Rotate the login log (login.log) when it exceeds this size in bytes. Default 10 MiB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:66;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"LOG_LOGIN_BACKUP_COUNT";s:6:"Target";s:22:"LOG_LOGIN_BACKUP_COUNT";s:7:"Default";s:1:"5";s:11:"Description";s:45:"Number of gzipped login-log archives to keep.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:67;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"DB_STARTUP_WAIT_SECONDS";s:6:"Target";s:23:"DB_STARTUP_WAIT_SECONDS";s:7:"Default";s:2:"30";s:11:"Description";s:179:"How long startup waits for the database before serving in degraded mode. 0 probes once. The app keeps retrying in the background and recovers on its own when the database answers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:68;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"APP_MODE";s:6:"Target";s:8:"APP_MODE";s:7:"Default";s:4:"full";s:11:"Description";s:385:"full runs everything: web UI, API, migrations, scheduler, CrowdSec and ingestion. agent is headless. It tails, geolocates and writes into a shared database and serves only /health and /health/ready, so the WebUI port and the admin login do nothing. Set agent only on an extra copy of this container that feeds a full instance elsewhere, and give it the same image tag as that instance.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:69;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_PROXY_ADVISORY";s:6:"Target";s:18:"APP_PROXY_ADVISORY";s:7:"Default";s:4:"true";s:11:"Description";s:292:"Warn on Settings &gt; Status when recent traffic for a tailed file comes from CDN or private addresses, which means the proxy is logging the hop in front of it rather than the visitor. Set false when that traffic mix is deliberate, such as Tailscale-only access or a CDN you front on purpose.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/geometrikks.xml";s:4:"Repo";s:18:"GilbN's Repository";s:12:"CategoryList";a:1:{i:0;s:18:"Network-Management";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1784546231;s:8:"Category";s:18:"Network:Management";s:2:"ID";i:503;s:11:"Displayable";b:1;s:6:"Author";s:5:"gilbn";s:13:"DockerHubName";s:11:"geometrikks";s:8:"RepoName";s:18:"GilbN's Repository";s:10:"SortAuthor";s:5:"gilbn";s:8:"SortName";s:11:"geometrikks";s:6:"random";i:296917888;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:108:"/tmp/community.applications/tempFiles/templates-community-apps/GilbNsRepository/gilbn-geometrikks-latest.xml";s:10:"Deprecated";b:0;s:13:"BranchDefault";s:6:"latest";s:8:"BranchID";a:1:{i:0;i:504;}s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:504;a:44:{s:4:"Name";s:11:"geometrikks";s:10:"Repository";s:33:"ghcr.io/gilbn/geometrikks:develop";s:8:"Registry";s:63:"https://github.com/GilbN/geometrikks/pkgs/container/geometrikks";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:89:"https://raw.githubusercontent.com/GilbN/geometrikks/main/resources/static/pwa-512x512.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:8:"Overview";s:1849:"GeoMetrikks tails your reverse proxy's access logs, looks up where every request came from with MaxMind GeoLite2, and shows the result on a live map and a traffic analytics dashboard. It reads nginx, Traefik JSON and Caddy JSON logs, detected per file, from a file or from Grafana Loki. The only outbound traffic is the GeoLite2 download and a public-IP lookup that places this server on the map, which you can turn off.[br][br]Features:[br]• Live map with heatmap and marker views, and routes that fly in as requests arrive[br]• Overview and analytics for requests, bandwidth, latency, status mix, top URLs and user agents, plus a Top ASNs view of the networks your traffic comes from[br]• Searchable access log history with filters and sorting, a live tail, and a debug view of the raw lines behind parse failures[br]• CrowdSec integration: active bans next to the traffic that caused them, ban or unban IPs and ranges from the UI, and abuse reports for hosting providers[br]• Password login, or OpenID Connect sign-in against Authelia, Authentik, Keycloak, Pocket ID or Google[br]• Multi-source ingestion: tail several files from one instance, or run headless agents on other hosts that write into the same database and show up on Settings > Agents[br]• Batch import of rotated and archived logs[br]• Application logs in the UI, plus a login log that fail2ban and CrowdSec can parse[br][br]Requirements:[br]• A TimescaleDB + PostGIS database. Install the companion "geometrikks-timescaledb" template from this repository first, or point the container at your own instance.[br]• A free MaxMind GeoLite2 account (https://www.maxmind.com/en/geolite2/signup) for the GeoIP databases.[br]• A free CARTO basemaps API key (https://carto.com/basemaps/apikey) for the map tiles.[br][br]See the repository README for full setup steps.";s:7:"Support";s:43:"https://github.com/GilbN/geometrikks/issues";s:7:"Project";s:36:"https://github.com/GilbN/geometrikks";s:11:"TemplateURL";s:98:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/templates/geometrikks.xml";s:6:"ReadMe";s:82:"https://raw.githubusercontent.com/GilbN/geometrikks-unraid-template/main/README.md";s:16:"ExtraSearchTerms";s:101:"nginx traefik caddy geoip asn analytics traffic map log parser crowdsec timescaledb oidc sso authelia";s:8:"Requires";s:376:"Requires a reachable TimescaleDB+PostGIS database (see the companion geometrikks-timescaledb template), a free MaxMind GeoLite2 account for GeoIP downloads, and a free CARTO basemaps API key for the map.<br>  Nginx access logs need a specific log_format. Traefik and Caddy JSON access logs are read as they come. See the repository README for the nginx log_format to use.<br>";s:7:"License";s:3:"MIT";s:4:"Date";s:10:"2026-10-18";s:10:"Screenshot";a:9:{i:0;s:82:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/live.png";i:1;s:81:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/map.png";i:2;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/dashboard.png";i:3;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/analytics.png";i:4;s:87:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/live-tail.png";i:5;s:89:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/access-logs.png";i:6;s:86:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/geo-logs.png";i:7;s:88:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/debug-logs.png";i:8;s:86:"https://raw.githubusercontent.com/GilbN/geometrikks/main/data/screenshots/crowdsec.png";}s:11:"ExtraParams";s:42:"--restart=unless-stopped --stop-timeout=20";s:6:"Config";a:70:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:37:"HTTP port for the GeoMetrikks web UI.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Access Logs";s:6:"Target";s:15:"/var/log/access";s:7:"Default";s:33:"/mnt/cache/appdata/swag/log/nginx";s:4:"Mode";s:2:"ro";s:11:"Description";s:343:"Host directory holding your reverse proxy's access logs, mounted read-only. The default assumes SWAG. Point it at wherever nginx, Nginx Proxy Manager, Traefik or Caddy writes instead. The files must be readable by PUID:PGID. Whichever proxy you run, the container-side path stays /var/log/access, so that is what LOGPARSER_LOG_PATHS refers to.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"LOGPARSER_LOG_PATHS";s:6:"Target";s:19:"LOGPARSER_LOG_PATHS";s:7:"Default";s:26:"/var/log/access/access.log";s:11:"Description";s:217:"Access log file(s) to tail, named as the container sees them under /var/log/access. Single path, or a JSON list [&quot;/var/log/access/access.log&quot;, &quot;/var/log/access/site2/access.log&quot;] for several files.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"GeoIP Data";s:6:"Target";s:15:"/app/data/geoip";s:7:"Default";s:36:"/mnt/cache/appdata/geometrikks/geoip";s:4:"Mode";s:2:"rw";s:11:"Description";s:182:"Persistent storage for the downloaded MaxMind GeoLite2 City and ASN databases. The container fixes ownership of this folder to PUID:PGID on every start, so no manual chown is needed.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_HOST";s:6:"Target";s:7:"DB_HOST";s:7:"Default";s:0:"";s:11:"Description";s:280:"IP address of your TimescaleDB container, typically your Unraid server's IP if you installed the companion geometrikks-timescaledb template. Do not use localhost or 127.0.0.1, which is this container itself. The database container must be running and its port reachable from here.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"DB_PASSWORD";s:6:"Target";s:11:"DB_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:88:"Database password. Must match POSTGRES_PASSWORD in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAXMINDDB_USER_ID";s:6:"Target";s:17:"MAXMINDDB_USER_ID";s:7:"Default";s:0:"";s:11:"Description";s:117:"MaxMind account ID, used to download the GeoLite2 databases. Free account: https://www.maxmind.com/en/geolite2/signup";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"MAXMINDDB_LICENSE_KEY";s:6:"Target";s:21:"MAXMINDDB_LICENSE_KEY";s:7:"Default";s:0:"";s:11:"Description";s:99:"MaxMind license key, used to download the GeoLite2 databases. Create it under your MaxMind account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAP_CARTO_API_KEY";s:6:"Target";s:17:"MAP_CARTO_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:248:"CARTO basemaps API key, sent with every basemap request the browser makes. CARTO's terms require one per deployment and keyless tiles may stop working. Free at https://carto.com/basemaps/apikey. Not a secret: anyone who can open the map can see it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"APP_ADMIN_USER";s:6:"Target";s:14:"APP_ADMIN_USER";s:7:"Default";s:5:"admin";s:11:"Description";s:22:"Web UI login username.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_ADMIN_PASSWORD";s:6:"Target";s:18:"APP_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:292:"Web UI login password. Leave it blank only if you set APP_AUTH_DISABLED=true or configured OIDC_* below; otherwise the container refuses to start. With OIDC configured, a password set here keeps the password form next to the provider button, so you can still log in when the provider is down.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"LOGPARSER_IGNORE_IPS";s:6:"Target";s:20:"LOGPARSER_IGNORE_IPS";s:7:"Default";s:0:"";s:11:"Description";s:288:"IPs/CIDRs the parser drops entirely - no geo event, access log or debug row. Use it to keep your own WAN traffic through the reverse proxy out of the data(LAN traffic is never ingested), e.g. 88.99.77.66. Single value, comma-separated, or a JSON list. Empty (default): nothing is ignored.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_PORT";s:6:"Target";s:7:"DB_PORT";s:7:"Default";s:4:"5432";s:11:"Description";s:14:"Database port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:7:"DB_USER";s:6:"Target";s:7:"DB_USER";s:7:"Default";s:7:"geouser";s:11:"Description";s:80:"Database user. Must match POSTGRES_USER in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"DB_DATABASE";s:6:"Target";s:11:"DB_DATABASE";s:7:"Default";s:11:"geometrikks";s:11:"Description";s:78:"Database name. Must match POSTGRES_DB in the geometrikks-timescaledb template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:345:"User ID the app runs as. The container starts as root only long enough to remap its internal user and fix ownership of the GeoIP and App Logs folders, then drops privileges. 99 is Unraid's 'nobody' - keep it so the appdata folders match the rest of your shares, and so nginx logs written by SWAG/NPM (which also default to 99:100) stay readable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:56:"Group ID the app runs as. 100 is Unraid's 'users' group.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App Logs";s:6:"Target";s:9:"/app/logs";s:7:"Default";s:35:"/mnt/cache/appdata/geometrikks/logs";s:4:"Mode";s:2:"rw";s:11:"Description";s:294:"Where GeoMetrikks writes its own logs: geometrikks.log (structured JSONL) and login.log (plain text, fail2ban/CrowdSec-friendly), plus their gzipped archives. Mounting this keeps logs across container recreation and lets host-side tools read login.log. Ownership is fixed to PUID:PGID on start.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"LOG_LEVEL";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"INFO";s:11:"Description";s:56:"Application log verbosity (DEBUG, INFO, WARNING, ERROR).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOGPARSER_SERVER_NAME";s:6:"Target";s:21:"LOGPARSER_SERVER_NAME";s:7:"Default";s:6:"Unraid";s:11:"Description";s:422:"A name you choose for this server, recorded on every request it ingests. It is not your nginx server_name. A JSON list matched to LOGPARSER_LOG_PATHS by position names each file separately, e.g. [&quot;edge-01&quot;, &quot;edge-02&quot;], and the UI then filters them as separate servers. Replaces LOGPARSER_HOST_NAME: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOGPARSER_LOG_FORMATS";s:6:"Target";s:21:"LOGPARSER_LOG_FORMATS";s:7:"Default";s:4:"auto";s:11:"Description";s:246:"Format of the file(s) above: auto (detected per file), geometrikks-json, nginx, traefik-json or caddy-json. One value covers every path, or give a JSON list matched to LOGPARSER_LOG_PATHS by position. Leave at auto unless detection gets it wrong.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"APP_INSTANCE_NAME";s:6:"Target";s:17:"APP_INSTANCE_NAME";s:7:"Default";s:0:"";s:11:"Description";s:311:"Name this container goes by on Settings &gt; Agents, which lists every GeoMetrikks instance writing to the database. Blank: it shows as head, or as agent with APP_MODE=agent. Give every agent its own name, because two unnamed agents share one and overwrite each other's status. Up to 255 characters, no slashes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_SESSION_SECURE";s:6:"Target";s:18:"APP_SESSION_SECURE";s:7:"Default";s:5:"false";s:11:"Description";s:303:"Mark the session cookie Secure so browsers only send it over HTTPS. Set true when you reach the UI through a TLS reverse proxy; leave false if you browse to http://server-ip:8000 directly, or you will not be able to log in. An https OIDC_REDIRECT_URI requires true, and the app will not start otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:23;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"APP_TRUSTED_PROXIES";s:6:"Target";s:19:"APP_TRUSTED_PROXIES";s:7:"Default";s:0:"";s:11:"Description";s:206:"Reverse-proxy IPs/CIDRs allowed to supply X-Forwarded-For, e.g. 172.17.0.0/16 for Unraid's docker bridge. Single value, comma-separated, or a JSON list. Empty (default): forwarded headers are never trusted.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:24;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"APP_AUTH_DISABLED";s:6:"Target";s:17:"APP_AUTH_DISABLED";s:7:"Default";s:5:"false";s:11:"Description";s:292:"Set true ONLY if this container sits behind an authenticating reverse proxy (Authelia, Tailscale, etc). There is then no login and no session: anyone who can reach the container has full access. It cannot be combined with the OIDC_* settings below, and the app will not start if you set both.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:25;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:28:"ANALYTICS_RAW_RETENTION_DAYS";s:6:"Target";s:28:"ANALYTICS_RAW_RETENTION_DAYS";s:7:"Default";s:3:"180";s:11:"Description";s:49:"Days to keep raw geo_events and access_logs data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:26;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"CROWDSEC_LAPI_URL";s:6:"Target";s:17:"CROWDSEC_LAPI_URL";s:7:"Default";s:0:"";s:11:"Description";s:172:"CrowdSec Local API base URL, including http:// or https://, e.g. http://crowdsec:8080. Without the scheme the connection fails. Leave blank to disable CrowdSec integration.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:27;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"CROWDSEC_BOUNCER_API_KEY";s:6:"Target";s:24:"CROWDSEC_BOUNCER_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:92:"Bouncer API key (cscli bouncers add geometrikks) - grants read access to CrowdSec decisions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:28;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"CROWDSEC_MACHINE_ID";s:6:"Target";s:19:"CROWDSEC_MACHINE_ID";s:7:"Default";s:0:"";s:11:"Description";s:156:"Machine ID (cscli machines add) - optional, enables ban/unban from the GeoMetrikks UI. Set it together with the machine password, or the app will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:29;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"CROWDSEC_MACHINE_PASSWORD";s:6:"Target";s:25:"CROWDSEC_MACHINE_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:135:"Machine password - optional, enables ban/unban from the GeoMetrikks UI. Set it together with the machine ID, or the app will not start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:30;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"OIDC_ISSUER";s:6:"Target";s:11:"OIDC_ISSUER";s:7:"Default";s:0:"";s:11:"Description";s:371:"Issuer URL of your identity provider, e.g. https://auth.example.com. Leave blank to keep OIDC off. GeoMetrikks reads {issuer}/.well-known/openid-configuration and the token's iss claim must match this value exactly. Must be https unless the host is localhost. Filling in this plus the client id, secret and redirect URI puts a 'Sign in with ...' button on the login page.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:31;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"OIDC_CLIENT_ID";s:6:"Target";s:14:"OIDC_CLIENT_ID";s:7:"Default";s:0:"";s:11:"Description";s:165:"Client id of the confidential client you registered for GeoMetrikks at the provider. The authorization code flow with PKCE is used, so a public client will not work.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:32;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_CLIENT_SECRET";s:6:"Target";s:18:"OIDC_CLIENT_SECRET";s:7:"Default";s:0:"";s:11:"Description";s:30:"Client secret for that client.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:33;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"OIDC_REDIRECT_URI";s:6:"Target";s:17:"OIDC_REDIRECT_URI";s:7:"Default";s:0:"";s:11:"Description";s:302:"The exact callback URL registered at the provider: this container's public address plus /api/v1/auth/oidc/callback, e.g. https://geo.example.com/api/v1/auth/oidc/callback. It has to end in that path, and plain http is only accepted on localhost. With an https URL you also need APP_SESSION_SECURE=true.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:34;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_ALLOWED_USERS";s:6:"Target";s:18:"OIDC_ALLOWED_USERS";s:7:"Default";s:0:"";s:11:"Description";s:352:"Who may sign in, as verified email addresses or subject identifiers. Single value, comma-separated, or a JSON list. An email only matches when the provider marks it verified. At least one of OIDC_ALLOWED_USERS and OIDC_ALLOWED_GROUPS is required: without an allow list, everyone the provider authenticates would get in, which for Google means everyone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:35;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"OIDC_ALLOWED_GROUPS";s:6:"Target";s:19:"OIDC_ALLOWED_GROUPS";s:7:"Default";s:0:"";s:11:"Description";s:181:"Groups allowed to sign in; being in any one of them is enough. Same formats as OIDC_ALLOWED_USERS. The provider has to send the group claim, so keep the groups scope in OIDC_SCOPES.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:36;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"OIDC_SCOPES";s:6:"Target";s:11:"OIDC_SCOPES";s:7:"Default";s:27:"openid profile email groups";s:11:"Description";s:283:"Space-separated scopes requested at login; openid is mandatory. Authelia works with the default. Google rejects the groups scope, and Authentik only sends groups if you add the mapping yourself, so use 'openid profile email' for those and allow people by email in OIDC_ALLOWED_USERS.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:37;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"CROWDSEC_DEFAULT_BAN_DURATION";s:6:"Target";s:29:"CROWDSEC_DEFAULT_BAN_DURATION";s:7:"Default";s:2:"4h";s:11:"Description";s:54:"Default duration for manual bans (Go duration string).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:38;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"CROWDSEC_REQUEST_TIMEOUT";s:6:"Target";s:24:"CROWDSEC_REQUEST_TIMEOUT";s:7:"Default";s:4:"10.0";s:11:"Description";s:32:"LAPI request timeout in seconds.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:39;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"CROWDSEC_VERIFY_TLS";s:6:"Target";s:19:"CROWDSEC_VERIFY_TLS";s:7:"Default";s:4:"true";s:11:"Description";s:32:"Verify TLS when LAPI uses https.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:40;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:29:"CROWDSEC_STREAM_POLL_INTERVAL";s:6:"Target";s:29:"CROWDSEC_STREAM_POLL_INTERVAL";s:7:"Default";s:4:"15.0";s:11:"Description";s:69:"Seconds between decision-stream polls feeding live ban/unban updates.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:41;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"OIDC_GROUPS_CLAIM";s:6:"Target";s:17:"OIDC_GROUPS_CLAIM";s:7:"Default";s:6:"groups";s:11:"Description";s:178:"Claim that carries group membership. It is read from the ID token and from the userinfo endpoint, so providers that only serve groups from userinfo (Authelia) need nothing extra.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:42;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"OIDC_PROVIDER_NAME";s:6:"Target";s:18:"OIDC_PROVIDER_NAME";s:7:"Default";s:3:"SSO";s:11:"Description";s:49:"Label on the login button: 'Sign in with {name}'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:43;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"OIDC_LOGOUT_IDP";s:6:"Target";s:15:"OIDC_LOGOUT_IDP";s:7:"Default";s:5:"false";s:11:"Description";s:358:"On logout, also end the session at the provider. This only works when the provider's discovery document advertises an end_session_endpoint; Authelia 4.39 and Google do not, so leave it false there. Before enabling it, register {your app URL}/signed-out as the post-logout redirect URI at the provider. Logout always clears the GeoMetrikks session either way.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:44;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"OIDC_CA_BUNDLE";s:6:"Target";s:14:"OIDC_CA_BUNDLE";s:7:"Default";s:0:"";s:11:"Description";s:403:"PEM file holding the CA that signed your provider's certificate, for a provider behind an internal CA. Give the path as the container sees it and add a path mapping for the file yourself, e.g. host /mnt/user/appdata/geometrikks/certs/ca.pem to container /app/certs/ca.pem, readable by PUID:PGID. The app refuses to start when the file is missing. There is no switch to turn certificate verification off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:45;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"LOGPARSER_ENABLED";s:6:"Target";s:17:"LOGPARSER_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:117:"Tail and ingest the access logs. Set false for an instance that only serves the UI over data another instance writes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:46;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"LOGPARSER_POLL_INTERVAL";s:6:"Target";s:23:"LOGPARSER_POLL_INTERVAL";s:7:"Default";s:2:"10";s:11:"Description";s:145:"Interval in seconds to poll the log file for new entries. Lower it (1.0 is the app default) for a snappier live map, at the cost of more wakeups.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:47;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"LOGPARSER_BATCH_SIZE";s:6:"Target";s:20:"LOGPARSER_BATCH_SIZE";s:7:"Default";s:3:"100";s:11:"Description";s:35:"Max records before a forced commit.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:48;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:25:"LOGPARSER_COMMIT_INTERVAL";s:6:"Target";s:25:"LOGPARSER_COMMIT_INTERVAL";s:7:"Default";s:3:"5.0";s:11:"Description";s:54:"Max time interval in seconds between database commits.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:49;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:27:"LOGPARSER_STORE_DEBUG_LINES";s:6:"Target";s:27:"LOGPARSER_STORE_DEBUG_LINES";s:7:"Default";s:5:"false";s:11:"Description";s:68:"Store all raw log lines in the debug table, not just malformed ones.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:50;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"GEOIP_ASN_ENABLED";s:6:"Target";s:17:"GEOIP_ASN_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:238:"Download the GeoLite2 ASN database alongside the City one and record the network and organization behind each request. This is what fills the Top ASNs view. Uses the same MaxMind credentials; without them the app ingests without ASN data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:51;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"GEOIP_REFRESH_DAYS";s:6:"Target";s:18:"GEOIP_REFRESH_DAYS";s:7:"Default";s:1:"7";s:11:"Description";s:66:"Re-download the GeoLite2 databases when older than this many days.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:52;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"GEOIP_LOCALES";s:6:"Target";s:13:"GEOIP_LOCALES";s:7:"Default";s:16:"[&quot;en&quot;]";s:11:"Description";s:34:"JSON list of GeoIP locales to use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:53;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"MAP_DEFAULT_VIEW";s:6:"Target";s:16:"MAP_DEFAULT_VIEW";s:7:"Default";s:0:"";s:11:"Description";s:209:"Where the map opens, as latitude,longitude or latitude,longitude,zoom (zoom 0-22, default 3), e.g. 71.129982,27.653369,15. Unset: the map opens on your server locations, or the whole world when there are none.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:54;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:31:"MAP_AUTO_DETECT_SERVER_LOCATION";s:6:"Target";s:31:"MAP_AUTO_DETECT_SERVER_LOCATION";s:7:"Default";s:4:"true";s:11:"Description";s:273:"Look up this server's public IP at startup and geolocate it, so the map knows where live request routes end. Set false to skip the lookup. Replaces MAP_AUTO_DETECT_HOME: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:55;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"MAP_PUBLIC_IP_URL";s:6:"Target";s:17:"MAP_PUBLIC_IP_URL";s:7:"Default";s:35:"https://api64.ipify.org?format=json";s:11:"Description";s:80:"JSON endpoint used for public-IP discovery; response must contain an 'ip' field.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:56;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:33:"MAP_SERVER_LOCATION_REFRESH_HOURS";s:6:"Target";s:33:"MAP_SERVER_LOCATION_REFRESH_HOURS";s:7:"Default";s:2:"24";s:11:"Description";s:218:"Hours between re-detecting this server's public IP and updating its map location. Replaces MAP_HOME_REFRESH_HOURS: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:57;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"MAP_SERVER_LOCATIONS";s:6:"Target";s:20:"MAP_SERVER_LOCATIONS";s:7:"Default";s:2:"{}";s:11:"Description";s:491:"Fixed map locations per server name, as a JSON object of latitude/longitude pairs, e.g. {&quot;edge-01&quot;: [59.91, 10.75]}. Use it for a server whose public IP geolocates wrong (CGNAT, VPN), or whose logs are shipped from another machine. An entry here beats the location the server detects for itself. Delete the entry and its row goes at the next start. Replaces MAP_HOME_LOCATIONS: copy your value here and delete the old variable, because the app refuses to start when the two differ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:58;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:30:"ANALYTICS_DEBUG_RETENTION_DAYS";s:6:"Target";s:30:"ANALYTICS_DEBUG_RETENTION_DAYS";s:7:"Default";s:2:"30";s:11:"Description";s:35:"Days to keep access_log_debug data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:59;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:31:"ANALYTICS_HOURLY_RETENTION_DAYS";s:6:"Target";s:31:"ANALYTICS_HOURLY_RETENTION_DAYS";s:7:"Default";s:2:"60";s:11:"Description";s:46:"Days to keep hourly continuous aggregate data.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:60;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:39:"ANALYTICS_CAGG_REFRESH_INTERVAL_MINUTES";s:6:"Target";s:39:"ANALYTICS_CAGG_REFRESH_INTERVAL_MINUTES";s:7:"Default";s:1:"5";s:11:"Description";s:47:"Minutes between continuous aggregate refreshes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:61;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:32:"ANALYTICS_COMPRESSION_AFTER_DAYS";s:6:"Target";s:32:"ANALYTICS_COMPRESSION_AFTER_DAYS";s:7:"Default";s:1:"7";s:11:"Description";s:47:"Days after which to compress hypertable chunks.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:62;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"SCHEDULER_ENABLED";s:6:"Target";s:17:"SCHEDULER_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:34:"Enable scheduled background tasks.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:63;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"LOG_MAIN_MAX_BYTES";s:6:"Target";s:18:"LOG_MAIN_MAX_BYTES";s:7:"Default";s:8:"10485760";s:11:"Description";s:95:"Rotate the main JSONL log (geometrikks.log) when it exceeds this size in bytes. Default 10 MiB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:64;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"LOG_MAIN_BACKUP_COUNT";s:6:"Target";s:21:"LOG_MAIN_BACKUP_COUNT";s:7:"Default";s:1:"5";s:11:"Description";s:44:"Number of gzipped main-log archives to keep.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:65;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:19:"LOG_LOGIN_MAX_BYTES";s:6:"Target";s:19:"LOG_LOGIN_MAX_BYTES";s:7:"Default";s:8:"10485760";s:11:"Description";s:84:"Rotate the login log (login.log) when it exceeds this size in bytes. Default 10 MiB.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:66;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"LOG_LOGIN_BACKUP_COUNT";s:6:"Target";s:22:"LOG_LOGIN_BACKUP_COUNT";s:7:"Default";s:1:"5";s:11:"Description";s:45:"Number of gzipped login-log archives to keep.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:67;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"DB_STARTUP_WAIT_SECONDS";s:6:"Target";s:23:"DB_STARTUP_WAIT_SECONDS";s:7:"Default";s:2:"30";s:11:"Description";s:179:"How long startup waits for the database before serving in degraded mode. 0 probes once. The app keeps retrying in the background and recovers on its own when the database answers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:68;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"APP_MODE";s:6:"Target";s:8:"APP_MODE";s:7:"Default";s:4:"full";s:11:"Description";s:385:"full runs everything: web UI, API, migrations, scheduler, CrowdSec and ingestion. agent is headless. It tails, geolocates and writes into a shared database and serves only /health and /health/ready, so the WebUI port and the admin login do nothing. Set agent only on an extra copy of this container that feeds a full instance elsewhere, and give it the same image tag as that instance.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:69;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"APP_PROXY_ADVISORY";s:6:"Target";s:18:"APP_PROXY_ADVISORY";s:7:"Default";s:4:"true";s:11:"Description";s:292:"Warn on Settings &gt; Status when recent traffic for a tailed file comes from CDN or private addresses, which means the proxy is logging the hop in front of it rather than the visitor. Set false when that traffic mix is deliberate, such as Tailscale-only access or a CDN you front on purpose.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/geometrikks.xml";s:4:"Repo";s:18:"GilbN's Repository";s:12:"CategoryList";a:1:{i:0;s:18:"Network-Management";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1784546231;s:8:"Category";s:18:"Network:Management";s:2:"ID";i:504;s:11:"Displayable";b:0;s:6:"Author";s:5:"gilbn";s:13:"DockerHubName";s:11:"geometrikks";s:8:"RepoName";s:18:"GilbN's Repository";s:10:"SortAuthor";s:5:"gilbn";s:8:"SortName";s:11:"geometrikks";s:6:"random";i:296917888;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:70:"/tmp/community.applications/tempFiles/templates-community-apps/504.xml";s:10:"Deprecated";b:0;s:10:"BranchName";s:7:"develop";s:17:"BranchDescription";s:42:"Latest development build. May be unstable.";s:11:"Description";N;s:4:"Beta";s:4:"true";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:505;a:39:{s:4:"Name";s:11:"fritzfluxdb";s:10:"Repository";s:28:"giiibates/fritzfluxdb:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/giiibates/fritzfluxdb";s:7:"Network";s:6:"bridge";s:5:"MyMAC";s:0:"";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/Gill-Bates/fritzfluxdb/issues";s:7:"Project";s:41:"https://github.com/Gill-Bates/fritzfluxdb";s:8:"Overview";s:461:"Daemon that reads metrics from an AVM Fritz!Box (DSL/Cable, WLAN, VPN, home automation, logs) and writes them to InfluxDB v1, InfluxDB v2, or QuestDB. No Web UI. Configured entirely via environment variables. Grafana dashboards included.

Pick your backend with "Database Type", then fill in the shared "Database ..." fields. QuestDB Open Source supports optional HTTP basic authentication, not API tokens.

