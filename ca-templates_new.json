ption";s:71:"Root directory inside the container where converted videos are written.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:43;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:46:"Automatic Video Converter: Output Subdirectory";s:6:"Target";s:34:"AUTOMATED_CONVERSION_OUTPUT_SUBDIR";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:360:"Subdirectory of the output folder where converted videos are written. By default, videos are saved directly to `/output/`. If set to `Home/Movies`, videos are written to `/output/Home/Movies`. Use `SAME_AS_SRC` to match the source subfolder. For example, if the source is `/watch/Movies/MyMovie/MyMovie.mkv`, the output is written to `/output/Movies/MyMovie/`.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:44;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:48:"Automatic Video Converter: Overwrite Destination";s:6:"Target";s:37:"AUTOMATED_CONVERSION_OVERWRITE_OUTPUT";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:65:"When set to `1`, allows overwriting an existing destination file.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:45;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:50:"Automatic Video Converter: Source File Stable Time";s:6:"Target";s:39:"AUTOMATED_CONVERSION_SOURCE_STABLE_TIME";s:7:"Default";s:1:"5";s:4:"Mode";s:0:"";s:11:"Description";s:159:"Time (in seconds) during which properties (e.g., size, time) of a video file in the watch folder must remain unchanged to avoid processing a file being copied.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:46;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:49:"Automatic Video Converter: Minimum Title Duration";s:6:"Target";s:40:"AUTOMATED_CONVERSION_SOURCE_MIN