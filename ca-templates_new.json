h your laptop. Speaks LocalSend Protocol v2.2. Clients can never browse the NAS: the web UI picks what gets sent, and received files land only in the share you choose. IMPORTANT: THIS TEMPLATE USES HOST NETWORKING ON PURPOSE — LocalSend discovers devices via multicast UDP 53317, which Docker bridge/NAT breaks. Do NOT switch to bridge: devices will stop finding each other automatically.";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/alexindigo/unraid-templates/main/templates/docker-localsend-nas.xml";s:4:"Icon";s:88:"https://raw.githubusercontent.com/alexindigo/unraid-templates/main/img/localsend-nas.png";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:69:"Web UI port. Host networking: no mapping, container port = host port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"LocalSend";s:6:"Target";s:5:"53317";s:7:"Default";s:5:"53317";s:4:"Mode";s:3:"tcp";s:11:"Description";s:68:"LocalSend protocol port (HTTPS). Must be reachable by other devices.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"53317";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"LocalSend discovery";s:6:"Target";s:5:"53317";s:7:"Default";s:5:"53317";s:4:"Mode";s:3:"udp";s:11:"Description";s:65:"LocalSend discovery (multicast UDP). Required for auto-discovery.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"53317";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:31:"/mnt/user/appdata/localsend-nas";s:4:"Mode";s:2:"rw";s:11:"Description";s:49:"Device identity, settings.json and saved targets.";s:4:"Type";s:4:"Path";