"value";s:13:"Europe/Berlin";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"LOG_LEVEL";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:55:"Pino log level: trace, debug, info, warn, error, fatal.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"TRUST_PROXY";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:8:"loopback";s:4:"Mode";s:0:"";s:11:"Description";s:450:"Only needed behind an EXTERNAL reverse proxy (Traefik / NPM / Caddy on another host or in another container). Controls how far X-Forwarded-* headers are trusted. Default 'loopback' trusts them only for requests arriving via 127.0.0.1/::1. Use a comma-separated list of trusted CIDRs/IPs for an external proxy, or 'true' to trust any hop. Hop counts (e.g. '1') are NOT supported and are ignored with a startup warning. Leave empty to keep the default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Headless Mode (no Web UI)";s:6:"Target";s:25:"UMLAUTADAPTARREX_HEADLESS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:462:"Optional. Set to 1 to run WITHOUT the Next.js Web UI (and without the self-forking supervisor) as a single process, saving roughly a third / ~50-90 MB RAM. ONLY for an already-configured instance: complete the setup wizard once with the Web UI first, then set this to 1. On an unconfigured database the container refuses to start with an explanatory message. When enabled you can remove the 'Web UI Port' mapping (5007). Leave empty to keep the Web UI (default).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:10:"Screenshot";a:2:{i:0;s:99:"https://raw.githubusercontent.com/xpsony/UmlautAdaptarrEX-Unraid-