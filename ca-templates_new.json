sitory";s:122:"ghcr.io/felixapel/cwa-ebook-translate-plugin:2.4.2@sha256:03bccc8524af49529281d61688f801423695622968b785090a022ab5d4b0b46c";s:8:"Registry";s:90:"https://github.com/felixapel/book-translator-hub/pkgs/container/cwa-ebook-translate-plugin";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:55:"https://github.com/felixapel/book-translator-hub/issues";s:7:"Project";s:48:"https://github.com/felixapel/book-translator-hub";s:6:"ReadMe";s:97:"https://github.com/felixapel/book-translator-hub/blob/main/docs/install/community-applications.md";s:8:"Overview";s:837:"Bilingual paragraph-level LLM translation overlay for stock Calibre-Web Automated (CWA). Read CWA through this container's proxy port and translate EPUB chapters in place with a local OpenAI-compatible LLM (vLLM, Ollama, LM Studio). Uses your existing CWA login (native session validation); the translation API is never published.[br][br]Certified profile: Unraid 7.3.2 x86_64, CWA 4.x, local LLM. Before the first start, create the appdata folder for the non-root container user: [code]mkdir -p /mnt/user/appdata/book-translator-hub/data && chown 101:102 /mnt/user/appdata/book-translator-hub/data && chmod 0700 /mnt/user/appdata/book-translator-hub/data[/code] Put this container on the same custom Docker network as CWA to use the CWA container name, or use CWA's host IP and port. Keep CWA's "Allow Reverse Proxy Authentication" off.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/felixapel/unraid-templates/main/book-translator-hub.xml";s:4:"Icon";s:95:"https://raw.githubusercontent.com/felixapel/unraid-templates/main/icons/book-translator-hub.png";s:11:"ExtraParams";s:168:"--user 101:102 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m,uid=101,gid=102,mode=700 --cap-drop ALL --security-opt no-new-privileges:true --restart unless-stopped";s:8:"Requires";s:172:"Stock Calibre-Web Automated 4.x and a local OpenAI-compatible LLM endpoint. Create the appdata folder owned by 101:102 with mode 0700 before the first start (see Overview).";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:9:"/app/data";s:7:"Default";s:42:"/mnt/user/appdata/book-translator-hub/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:154:"Private translation cache. Must exist before the first start, owned by 101:102 with mode 0700 (see Overview). Never point it at an old v2.1.x data folder.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:42:"/mnt/user/appdata/book-translator-hub/data";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Reader Proxy Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8385";s:4:"Mode";s:3:"tcp";s:11:"Description";s:128:"Open CWA through this port (or route your reader domain to it) to get the translation overlay. The API port 8390 stays internal.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8385";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"CWA URL";s:6:"Target";s:12:"CWA_UPSTREAM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Base URL of your CWA container, e.g. http://calibre-web-automated:8083 (same custom network) or http://192.168.1.10:8083 (host IP).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"CWA Session Check URL";s:6:"Target";s:15:"BT_CWA_AUTH_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:155:"The same CWA base URL followed by /ajax/emailstat, e.g. http://calibre-web-automated:8083/ajax/emailstat. Used to validate the reader's existing CWA login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Public Reader Origin";s:6:"Target";s:16:"BT_PUBLIC_ORIGIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:116:"Exact origin readers use in the browser, without a path, e.g. http://192.168.1.10:8385 or https://books.example.com.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"LLM Model";s:6:"Target";s:9:"LLM_MODEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:78:"Model name served by your local endpoint, exactly as listed by its /v1/models.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Local LLM URL";s:6:"Target";s:12:"BT_LOCAL_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:151:"Absolute OpenAI-compatible chat completions URL, e.g. http://192.168.1.10:8000/v1/chat/completions. Use the host IP or a container name, not localhost.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"LLM Provider";s:6:"Target";s:12:"LLM_PROVIDER";s:7:"Default";s:5:"local";s:4:"Mode";s:0:"";s:11:"Description";s:25:"Certified profile: local.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"local";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Runtime Role";s:6:"Target";s:7:"BT_ROLE";s:7:"Default";s:3:"all";s:4:"Mode";s:0:"";s:11:"Description";s:45:"Combined API and reader proxy. Do not change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"all";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Auth Mode";s:6:"Target";s:12:"BT_AUTH_MODE";s:7:"Default";s:11:"cwa_session";s:4:"Mode";s:0:"";s:11:"Description";s:57:"Validates the reader's native CWA session. Do not change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"cwa_session";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Browser Auth Mode";s:6:"Target";s:20:"BT_BROWSER_AUTH_MODE";s:7:"Default";s:11:"cwa_session";s:4:"Mode";s:0:"";s:11:"Description";s:14:"Do not change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"cwa_session";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Browser Credentials";s:6:"Target";s:22:"BT_BROWSER_CREDENTIALS";s:7:"Default";s:11:"same-origin";s:4:"Mode";s:0:"";s:11:"Description";s:14:"Do not change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"same-origin";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:4:"Mode";s:0:"";s:11:"Description";s:19:"Container timezone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"Etc/UTC";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/book-translator-hub.xml";s:4:"Repo";s:22:"felixapel's Repository";s:12:"CategoryList";a:3:{i:0;s:12:"Productivity";i:1;s:14:"MediaApp-Books";i:2;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1791274300;s:8:"Category";s:44:"Productivity: MediaApp:Books Tools:Utilities";s:2:"ID";i:2078;s:11:"Displayable";b:1;s:6:"Author";s:9:"felixapel";s:13:"DockerHubName";s:19:"book-translator-hub";s:8:"RepoName";s:22:"felixapel's Repository";s:10:"SortAuthor";s:9:"felixapel";s:8:"SortName";s:19:"book translator hub";s:6:"random";i:1256553511;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:128:"/tmp/community.applications/tempFiles/templates-community-apps/felixapelsRepository/felixapel-booktranslatorhub-2.4.2@sha256.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:67:"Support self-hosted reading tools and library forensics development";s:10:"DonateLink";s:27:"https://ko-fi.com/felixapel";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2079;a:39:{s:4:"Name";s:8:"AspireUI";s:10:"Repository";s:30:"ghcr.io/fgilde/aspireui:latest";s:8:"Registry";s:58:"https://github.com/fgilde/AspireUI/pkgs/container/aspireui";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:74:"https://raw.githubusercontent.com/fgilde/AspireUI/master/docs/aspireui.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:899:"AspireUI is a self-hosted app platform and visual builder for container stacks. Install apps from a
    built-in store of 140+ apps, deploy any docker-compose repository straight from Git, and manage what
    runs: logs, env vars, ports, volumes, scheduled backups, notifications and your own domains (with
    Let's Encrypt HTTPS via Nginx Proxy Manager). It is also a visual editor for .NET Aspire AppHost
    projects - drag resources onto a canvas, generate real C# code, run it, or publish Docker Compose.

    AspireUI drives the host Docker daemon, so the /var/run/docker.sock mapping is required for the Run
    and Hosting features. That is root-equivalent access to this server: keep the WebUI off the public
