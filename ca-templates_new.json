{i:0;s:13:"Network-Other";i:1;s:12:"Tools-System";i:2;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.10.16";s:6:"Author";s:8:"Nebur692";s:16:"ChangeLogPresent";s:1:"1";s:4:"Icon";s:0:"";s:9:"downloads";i:5;s:9:"FirstSeen";i:1791935079;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:5;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:0;s:1:"T";i:5;}s:8:"Category";s:35:"Network:Other Tools:System Plugins:";s:2:"ID";i:927;s:11:"Displayable";b:1;s:13:"DockerHubName";s:14:"failover guard";s:8:"RepoName";s:21:"Nebur692's Repository";s:10:"SortAuthor";s:8:"Nebur692";s:8:"SortName";s:14:"Failover Guard";s:6:"random";i:1377500342;s:9:"Blacklist";b:0;s:4:"Path";s:199:"/tmp/community.applications/tempFiles/templates-community-apps/Nebur692sRepository/Nebur692-FailoverGuard-//raw.githubusercontent.com/Nebur692/failover-guard-unraid-plugin/main/failover-guard.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateLink";s:36:"https://github.com/sponsors/Nebur692";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:928;a:37:{s:4:"Name";s:17:"ha-login-approval";s:10:"Repository";s:41:"ghcr.io/nebur692/ha-login-approval:latest";s:8:"Registry";s:42:"https://ghcr.io/nebur692/ha-login-approval";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:74:"https://forums.unraid.net/topic/200264-support-ha-login-approval-nebur692/";s:7:"Project";s:45:"https://github.com/Nebur692/ha-login-approval";s:8:"Overview";s:922:"Approve or reject sign-ins from a Home Assistant push notification. Truly PASSWORDLESS login, acting as a generic OIDC identity provider compatible with ZITADEL, Keycloak, Authentik, or any standard OIDC-capable relying party. Includes one-time recovery codes, IP blocking after 3 failed attempts, optional GeoIP enrichment, and a full admin panel.

Full step-by-step guide (registering the IDP in ZITADEL/Keycloak/Authentik, the admin panel, every variable): https://github.com/Nebur692/ha-login-approval

Admin panel: http://IP:8000/admin

IMPORTANT if you run this behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy...): set "Trusted proxies" below to your proxy's address. Until you do, this service uses the address it is connected from, so every notification and audit entry will show the proxy instead of the visitor, and location lookups will be meaningless. Sign-in itself keeps working either way.";s:5:"WebUI";s:29:"http://[IP]:[PORT:8000]/admin";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/Nebur692/unraid-community-apps/main/templates/ha-login-approval.xml";s:4:"Icon";s:107:"https://raw.githubusercontent.com/Nebur692/ha-login-approval/main/.github/images/ha-login-approval_logo.png";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:8:"Requires";s:220:"Home Assistant (with the Companion App installed on at least one device) and an OIDC-capable identity provider (ZITADEL, Keycloak, Authentik...) where you'll register this service as a generic external identity provider.";s:6:"Config";a:23:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"HA Base URL";s:6:"Target";s:11:"HA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:228:"REQUIRED. Your Home Assistant's internal URL, no trailing slash. Example: http://192.168.1.50:8123. This container calls Home Assistant's REST API and WebSocket to send push notifications and read the approve/reject action back.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"HA Token";s:6:"Target";s:8:"HA_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:241:"REQUIRED. A Home Assistant long-lived access token (Profile -> Security -> Long-Lived Access Tokens, at the bottom of the page). Needs permission to call notify.* services and to read mobile_app_notification_action events over the WebSocket.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Username";s:6:"Target";s:14:"ADMIN_USERNAME";s:7:"Default";s:5:"admin";s:4:"Mode";s:0:"";s:11:"Description";s:76:"Username for this container's own /admin panel, entered on its sign-in page.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"admin";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:14:"ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:172:"REQUIRED. Password for the /admin panel, paired with Admin Username above. At least 12 characters and not a default one, or the panel stays off (sign-ins are not affected).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Web/API Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:150:"Internal port. Used for the /admin panel and as the base for the identity provider's own URLs (authorize/token/jwks, built from IDP Issuer URL below).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8000";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Persistent data";s:6:"Target";s:5:"/data";s:7:"Default";s:35:"/mnt/user/appdata/ha-login-approval";s:4:"Mode";s:2:"rw";s:11:"Description";s:263:"Persistent folder for this service's own SQLite database (the account directory, recovery codes, audit log, IP blocks, branding) and for the optional GeoIP .mmdb files. Without this volume, everything resets whenever the container is recreated — do not skip it.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/ha-login-approval";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"IDP Issuer URL";s:6:"Target";s:14:"IDP_ISSUER_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:510:"REQUIRED. The PUBLIC https:// URL your identity provider (ZITADEL/Keycloak/Authentik) and the browser of whoever is signing in both use to reach this service. Must be a real domain behind a reverse proxy with a valid TLS certificate (nginx, Nginx Proxy Manager, Traefik, Caddy...) — NOT a local/LAN IP address, or nobody will be able to sign in from outside your own network. Example: https://login.yourdomain.com. Used as the OIDC issuer (iss claim) and to build the /authorize, /token, and /jwks.json URLs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"IDP Client ID";s:6:"Target";s:13:"IDP_CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:329:"REQUIRED. The identifier your identity provider will present when authenticating against this service's /token endpoint. You make this value up yourself (e.g. ha-login-approval) — it must exactly match the Client ID you enter when registering this service as a generic external OIDC provider in your ZITADEL/Keycloak/Authentik.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"IDP Client Secret";s:6:"Target";s:17:"IDP_CLIENT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:197:"REQUIRED. A long, random secret you generate yourself, paired with IDP Client ID above — again, it must exactly match what you enter on the identity provider's side when registering this service.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"IDP Client Redirect URI";s:6:"Target";s:23:"IDP_CLIENT_REDIRECT_URI";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:254:"REQUIRED. The exact callback URL your identity provider redirects to after a successful login (for ZITADEL, typically https://your-zitadel-domain/idps/callback). Validated on every request — a mismatch is rejected outright, to prevent an open redirect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"User ID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:116:"The service runs as this user, never as root. On start it hands its data folder to this user. 99 is Unraid's nobody.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Group ID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:56:"The service runs with this group. 100 is Unraid's users.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Trusted proxies";s:6:"Target";s:15:"TRUSTED_PROXIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:582:"STRONGLY RECOMMENDED if you run this behind a reverse proxy. JSON array of the reverse proxies this service reads X-Forwarded-For / X-Real-IP from, as IPs or CIDRs — for example [&quot;192.168.1.10&quot;] or [&quot;172.18.0.0/16&quot;]. Those headers are how a proxy reports who called it, and they are only trusted when the request actually arrives from an address listed here; otherwise the connecting address is used, so a visitor cannot fake their own IP. Left empty, notifications, the audit log, IP blocking and GeoIP lookups will all show your proxy instead of the visitor.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Approval Timeout Seconds";s:6:"Target";s:24:"APPROVAL_TIMEOUT_SECONDS";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:114:"How many seconds to wait for an approve/reject tap on the phone before giving up and treating the login as failed.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:30:"Recovery/retry delay (seconds)";s:6:"Target";s:36:"BRIDGE_RECOVERY_UNLOCK_DELAY_SECONDS";s:7:"Default";s:2:"60";s:4:"Mode";s:0:"";s:11:"Description";s:230:"Seconds with no response before the bridge page offers to resend the notification or use a one-time recovery code instead. The original approval keeps waiting in the background too, so a late tap on the phone still works normally.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"60";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"IP block threshold";s:6:"Target";s:18:"IP_BLOCK_THRESHOLD";s:7:"Default";s:1:"3";s:4:"Mode";s:0:"";s:11:"Description";s:274:"Consecutive failures (an explicit Reject, or a wrong recovery code — same account plus same IP) before that account+IP pair is blocked. Not a time window, a straight consecutive-failure counter; any success resets it back to zero. Unblock manually from /admin/blocked-ips.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"3";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Recovery code batch size";s:6:"Target";s:24:"RECOVERY_CODE_BATCH_SIZE";s:7:"Default";s:2:"10";s:4:"Mode";s:0:"";s:11:"Description";s:165:"How many one-time recovery codes get generated at once from the /admin/recovery panel. Generating a new batch instantly invalidates every code from the previous one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"10";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Recovery code low warning";s:6:"Target";s:25:"RECOVERY_CODE_LOW_WARNING";s:7:"Default";s:1:"3";s:4:"Mode";s:0:"";s:11:"Description";s:141:"Push a warning notification once this many unused recovery codes (or fewer) remain for an account, so you notice before running out entirely.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"3";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:36:"MaxMind Account ID (GeoIP, optional)";s:6:"Target";s:16:"GEOIP_ACCOUNT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:305:"OPTIONAL. A free MaxMind (maxmind.com) account ID, used to download the self-hosted GeoLite2-City/ASN databases and add city/country/ISP to both the audit log and the push notification itself. Left empty, that part of the audit log and notification just stays blank — login still works exactly the same.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:37:"MaxMind License Key (GeoIP, optional)";s:6:"Target";s:17:"GEOIP_LICENSE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:110:"OPTIONAL, used together with the Account ID above. The license key generated in your MaxMind account settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"ZITADEL URL (app name, optional)";s:6:"Target";s:15:"ZITADEL_API_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:234:"OPTIONAL, ZITADEL only. Your ZITADEL's base URL (e.g. https://sso.example.com), so the approval notification can say which app is being signed in to. Needs the two fields below too. Left empty, the notification simply has no app line.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:51:"ZITADEL service user client ID (app name, optional)";s:6:"Target";s:21:"ZITADEL_API_CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:124:"OPTIONAL. Client ID of a ZITADEL service user with the read-only IAM_OWNER_VIEWER role. It only reads ZITADEL's event store.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:55:"ZITADEL service user client secret (app name, optional)";s:6:"Target";s:25:"ZITADEL_API_CLIENT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:50:"OPTIONAL. Client secret of that same service user.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:51:"/tmp/GitHub/AppFeed/templates/ha-login-approval.xml";s:4:"Repo";s:21:"Nebur692's Repository";s:12:"CategoryList";a:1:{i:0;s:8:"Security";}s:9:"FirstSeen";i:1791813236;s:8:"Category";s:9:"Security:";s:2:"ID";i:928;s:11:"Displayable";b:1;s:6:"Author";s:8:"nebur692";s:13:"DockerHubName";s:17:"ha-login-approval";s:8:"RepoName";s:21:"Nebur692's Repository";s:10:"SortAuthor";s:8:"nebur692";s:8:"SortName";s:17:"ha login approval";s:6:"random";i:1017900037;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:118:"/tmp/community.applications/tempFiles/templates-community-apps/Nebur692sRepository/nebur692-haloginapproval-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateLink";s:36:"https://github.com/sponsors/Nebur692";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:929;a:35:{s:4:"Name";s:19:"ha-pass-invitations";s:10:"Repository";s:43:"ghcr.io/nebur692/ha-pass-invitations:latest";s:8:"Registry";s:82:"https://github.com/Nebur692/ha-pass-invitations/pkgs/container/ha-pass-invitations";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:75:"https://forums.unraid.net/topic/200003-support-hapass-invitations-nebur692/";s:7:"Project";s:47:"https://github.com/Nebur692/ha-pass-invitations";s:8:"Overview";s:1114:"Shareable, schedulable guest links for controlling specific Home Assistant entities - lights, locks, thermostats, fans, and more. Guests get a mobile-friendly PWA, no HA account or app install needed.

Fork of Rohithkadaveru/ha-pass adding: advance/recurring access windows (schedule a link today that only activates on a future date, or repeats weekly), automatic link delivery via any notify.* service, button/input_button support (for gate/door relay helper entities), local-network-only command execution for access-type domains (lock/cover/button/input_button - the link stays viewable from anywhere, but triggering the action requires being on the configured home network), and single-device link binding (the first browser to open a link claims it, so it can't be casually forwarded).

Requires an existing Home Assistant instance reachable from this container and a Long-Lived Access Token (HA Profile -> Security -> Long-Lived Access Tokens). This is a standalone Docker container, not a Home Assistant Supervisor add-on - it works with Home Assistant Core installs that don't have Supervisor/add-ons.";s:5:"WebUI";s:39:"http://[IP]:[PORT:5880]/admin/dashboard";s:11:"TemplateURL";s:103:"https://raw.githubusercontent.com/Nebur692/unraid-community-apps/main/templates/ha-pass-invitations.xml";s:4:"Icon";s:81:"https://raw.githubusercontent.com/Nebur692/ha-pass-invitations/main/docs/icon.png";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"5880";s:7:"Default";s:4:"5880";s:4:"Mode";s:3:"tcp";s:11:"Description";s:44:"Port for the admin dashboard and guest links";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5880";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:37:"/mnt/user/appdata/ha-pass-invitations";s:4:"Mode";s:2:"rw";s:11:"Description";s:36:"SQLite database (tokens, access log)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:37:"/mnt/user/appdata/ha-pass-invitations";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"HA_BASE_URL";s:6:"Target";s:11:"HA_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:91:"Base URL of your Home Assistant instance, e.g. http://192.168.1.10:8123 (no trailing slash)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"HA_TOKEN";s:6:"Target";s:8:"HA_TOKEN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:94:"Home Assistant Long-Lived Access Token (Profile -&gt; Security -&gt; Long-Lived Access Tokens)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"