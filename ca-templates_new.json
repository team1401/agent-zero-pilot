:4:"Name";s:11:"Trust Proxy";s:6:"Target";s:22:"JUSTTPRINT_TRUST_PROXY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:76:"Number of reverse proxies in front (usually 1). Leave empty without a proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Thumbnail Rendering";s:6:"Target";s:14:"JUSTTPRINT_GPU";s:7:"Default";s:23:"auto|nvidia|swiftshader";s:4:"Mode";s:0:"";s:11:"Description";s:74:"auto uses an NVIDIA GPU when one is passed in, else the CPU (swiftshader).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:20:"JUSTTPRINT_LOG_LEVEL";s:7:"Default";s:21:"info|warn|error|debug";s:4:"Mode";s:0:"";s:11:"Description";s:33:"How much the container log shows.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/unraid/justtprint.xml";s:4:"Repo";s:24:"acefire2123's Repository";s:12:"CategoryList";a:3:{i:0;s:15:"Tools-Utilities";i:1;s:17:"MediaServer-Other";i:2;s:12:"Productivity";}s:9:"downloads";i:588;s:9:"FirstSeen";i:1791953108;s:10:"LastUpdate";i:1791936766;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:47:"Tools:Utilities MediaServer:Other Productivity:";s:2:"ID";i:3485;s:11:"Displayable";b:1;s:6:"Author";s:7:"ace2123";s:13:"DockerHubName";s:10:"justtprint";s:8:"RepoName";s:24:"acefire2123's Repository";s:10:"SortAuthor";s:7:"ace2123";s:8:"SortName";s:10:"JusttPrint";s:6:"random";i:295735162;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/acefire2123sRepository/ace2123-JusttPrint-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3486;a:34:{s:4:"Name";s:5:"Quven";s:10:"Repository";s:28:"ghcr.io/nickayl/quven:latest";s:8:"Registry";s:53:"https://github.com/nickayl/Quven/pkgs/container/quven";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:60:"https://forums.unraid.net/topic/200728-support-quven-server/";s:7:"Project";s:16:"https://quven.tv";s:8:"Overview";s:2157:"Quven is a self-hosted media server for films, TV shows and documentaries, with native desktop,
    Android, Apple and television clients rather than a browser-only interface.

    The container is the Server-only lane: it scans the media you mount, matches it against the
    metadata providers and streams it, either direct or through HLS when the client needs it.

    Two things differ from most containers in Community Applications, both on purpose.

    The server runs as UID/GID 10001 on a read-only root filesystem with every capability dropped, so
    the appdata directory has to belong to that user before the first start. From a terminal:

    mkdir -p /mnt/user/appdata/quven && chown -R 10001:10001 /mnt/user/appdata/quven

    The media share is mounted read-write so the subtitles Quven generates land beside the film,
    which needs the share writable by uid 10001. Set the mode to read-only if you would rather the
    server never wrote there; a scan writes nothing either way.

    Host networking is used because the server answers LAN discovery from the native clients, on port
    5181. There is no page to open in a browser here. Quven's clients are native, and app.quven.tv
    reaches a linked server through the managed relay rather than through this port.

    Once the container is up, link it to your Quven Account, which is what lets a client sign in:

    docker exec -it Quven /app/Quven.Local.Server account link

    Open the URL it prints, approve the server, and the clients on your network will find it.

    The Repository follows the latest tag, so each new Quven release reaches the server when you
    update the container from the Docker tab. Keep it on latest, because a version number written
    there holds the server on that release and no later correction reaches it.

    Hardware transcoding is not offered here. The server runs unprivileged, so a render node alone is
    not enough: it also needs the host's render and video group IDs, which are specific to your
    machine and which this template cannot guess. Use the Docker Compose bundle on quven.tv for a
    VA-API, NVIDIA or Raspberry Pi setup.";s:11:"TemplateURL";s:73:"https://raw.githubusercontent.com/nickayl/unraid-templates/main/quven.xml";s:4:"Icon";s:25:"https://quven.tv/logo.png";s:11:"ExtraParams";s:139:"--init --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --user=10001:10001 --tmpfs=/tmp:mode=1777,size=4g --stop-timeout=45";s:6:"Config";a:3:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:23:"/mnt/user/appdata/quven";s:4:"Mode";s:2:"rw";s:11:"Description";s:122:"Database, configuration, artwork cache and generated subtitle assets. Must be owned by 10001:10001 before the first start.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:23:"/mnt/user/appdata/quven";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"rw";s:11:"Description";s:81:"The media root Quven scans. Writable so generated subtitles land beside the film.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/media";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"ASPNETCORE_URLS";s:6:"Target";s:15:"ASPNETCORE_URLS";s:7:"Default";s:19:"http://0.0.0.0:5181";s:4:"Mode";s:0:"";s:11:"Description";s:99:"Bind address of the server. Host networking is in use, so this is the port it binds, not a mapping.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"http://0.0.0.0:5181";}}s:12:"TemplatePath";s:29:"/tmp/GitHub/AppFeed/quven.xml";s:4:"Repo";s:20:"nickayl's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Video";i:1;s:17:"MediaServer-Video";}s:9:"FirstSeen";i:1787659498;s:8:"Category";s:32:"MediaApp:Video MediaServer:Video";s:2:"ID";i:3486;s:11:"Displayable";b:1;s:6:"Author";s:7:"nickayl";s:13:"DockerHubName";s:5:"quven";s:8:"RepoN