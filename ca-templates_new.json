k";s:5:"False";}s:5:"value";s:0:"";}i:34;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Automatic Disc Ripper: Eject";s:6:"Target";s:22:"AUTO_DISC_RIPPER_EJECT";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:75:"When set to `1`, disc is ejected from the drive when ripping is terminated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:35;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Automatic Disc Ripper: Parallel";s:6:"Target";s:29:"AUTO_DISC_RIPPER_PARALLEL_RIP";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:139:"When set to `1`, discs from all available optical drives are ripped in parallel. Else, each disc from optical drives is ripped one at time.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:36;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Automatic Disc Ripper: Interval";s:6:"Target";s:25:"AUTO_DISC_RIPPER_INTERVAL";s:7:"Default";s:1:"5";s:4:"Mode";s:0:"";s:11:"Description";s:95:"Interval, in seconds, the automatic disc ripper checks for the presence of a DVD/Blu-ray discs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:37;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:43:"Automatic Disc Ripper: Minimum Title Length";s:6:"Target";s:33:"AUTO_DISC_RIPPER_MIN_TITLE_LENGTH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:168:"Titles with a length less than this value are ignored. Length is in seconds. By default, no value is set, meaning that value from MakeMKV's configuration file is taken.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"False";s:4:"Mask";s:5:"False";}s:5:"value";s:0:"";}i:38;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:39:"Automatic Disc Ripper: Blu-ray Rip Mode";s:6:"Target";s:24:"AUTO_DISC_RIPPER_BD_MODE";s:7:"Default";s:3:"mkv";s:4:"Mode";s:0:"";s