:4:"Mask";s:5:"false";}s:5:"value";s:23:"/app/config/dynamic.yml";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:34:"Config Directory Path (multi-file)";s:6:"Target";s:10:"CONFIG_DIR";s:7:"Default";s:0:"";s:11:"Description";s:219:"Path inside the container to a directory containing multiple .yml config files. All .yml files in this directory will be loaded. Use instead of CONFIG_PATH when managing multiple files. Leave blank if using CONFIG_PATH.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:28:"Config Paths (explicit list)";s:6:"Target";s:12:"CONFIG_PATHS";s:7:"Default";s:0:"";s:11:"Description";s:222:"Comma-separated list of full config file paths inside the container. Use instead of CONFIG_PATH for 2-5 named files. Example: /app/config/routes.yml,/app/config/services.yml. Leave blank if using CONFIG_PATH or CONFIG_DIR.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Certs Tab - acme.json";s:6:"Target";s:14:"/app/acme.json";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:257:"Optional: path to your Traefik acme.json file on the host. Required for the Certs tab. Read-only is enough to see certificates and which of them nothing uses. Set it read-write, together with a Restart Method, to also remove certificates from the Certs tab.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:41:"Static Config / Plugins Tab - traefik.yml";s:6:"Target";s:16:"/app/traefik.yml";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:278:"Optional: path to your Traefik static config file (traefik.yml) on the host. Required for the Plugins tab and the Static Config editor. Mount read-write to allow editing; read-only enables the Plugins tab only. Also set the Static Config Path variable below to /app/traefik.yml.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:18:"Static Config Path";s:6:"Target";s:18:"STATIC_CONFIG_PATH";s:7:"Default";s:0:"";s:11:"Description";s:196:"Path inside the container to the static config (traefik.yml) you mounted above. Set to /app/traefik.yml to enable the Static Config editor and Plugins tab. Leave blank if not mounting traefik.yml.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Logs Tab - access.log";s:6:"Target";s:20:"/app/logs/access.log";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:186:"Optional: path to your Traefik access log file on the host. Required for the Logs tab. Enable access logging in traefik.yml first: accessLog: filePath: /logs/access.log. Mount read-only.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Restart Method";s:6:"Target";s:14:"RESTART_METHOD";s:7:"Default";s:5:"proxy";s:11:"Description";s:267:"How Traefik Manager restarts Traefik after a static config change. Options: proxy (socket proxy - recommended), socket (direct Docker socket), poison-pill (signal file, requires watcher sidecar). Removing this field falls back to proxy, it does not turn restarts off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"proxy";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:22:"Traefik Container Name";s:6:"Target";s:17:"TRAEFIK_CONTAINER";s:7:"Default";s:7:"traefik";s:11:"Description";s:94:"Name of the Traefik Docker container to restart. Used by the proxy and socket restart methods.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"traefik";}i:17;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:26:"Docker Host (socket proxy)";s:6:"Target";s:11:"DOCKER_HOST";s:7:"Default";s:0:"";s:11:"Description";s:122:"Docker host URL for the socket proxy restart method. Example: tcp://socket-proxy:2375. Only set when RESTART_METHOD=proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:30:"Signal File Path (poison pill)";s:6:"Target";s:16:"SIGNAL_FILE_PATH";s:7:"Default";s:20:"/signals/restart.sig";s:11:"Description";s:205:"Path to the signal file written by Traefik Manager to trigger a Traefik restart. Only used when RESTART_METHOD=poison-pill. Mount a shared volume to /signals in both this container and the watcher sidecar.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:20:"/signals/restart.sig";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Docker Socket (direct)";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:127:"Optional: mount the Docker socket for the direct socket restart method (RESTART_METHOD=socket). Host path: /var/run/docker.sock";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Restart Signals Volume";s:6:"Target";s:8:"/signals";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:201:"Optional: only for Restart Method poison-pill. Map a shared path here and at the same target in your watcher container, then point Signal File Path inside it. Leave blank for the other restart methods.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:14:"ADMIN_PASSWORD";s:7:"Default";s:0:"";s:11:"Description";s:134:"Optional: set a fixed admin password. If left empty a temporary password is generated on first start - check the container log for it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Cookie Secure";s:6:"Target";s:13:"COOKIE_SECURE";s:7:"Default";s:5:"false";s:11:"Description";s:160:"Set to true when accessing Traefik Manager over HTTPS (e.g. behind a Traefik reverse proxy with TLS). Required for session cookies to work correctly over HTTPS.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:23;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Auth Enabled";s:6:"Target";s:12:"AUTH_ENABLED";s:7:"Default";s:4:"true";s:11:"Description";s:147:"Set to false to disable built-in login. Only use this when Traefik Manager is protected by an external auth provider such as Authentik or Authelia.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:24;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:17:"CrowdSec LAPI URL";s:6:"Target";s:17:"CROWDSEC_LAPI_URL";s:7:"Default";s:0:"";s:11:"Description";s:117:"Optional: CrowdSec Local API URL (e.g. http://crowdsec:8080) to enable the CrowdSec tab. Can also be set in Settings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:25;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"CrowdSec API Key";s:6:"Target";s:16:"CROWDSEC_API_KEY";s:7:"Default";s:0:"";s:11:"Description";s:109:"Optional: CrowdSec bouncer API key, used to read decisions. Generate with: cscli bouncers add traefik-manager";s:4:"Type";s:8