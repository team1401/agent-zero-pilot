";s:13:"DockerHubName";s:17:"comfyui-intel-xpu";s:8:"RepoName";s:42:"heroeswearkapes Community Apps' Repository";s:10:"SortAuthor";s:15:"heroeswearkapes";s:8:"SortName";s:17:"ComfyUI Intel XPU";s:6:"random";i:1079650168;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:144:"/tmp/community.applications/tempFiles/templates-community-apps/heroeswearkapesCommunityAppsRepository/heroeswearkapes-ComfyUIIntelXPU-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2206;a:37:{s:4:"Name";s:17:"FFmpeg-SSH-Worker";s:10:"Repository";s:40:"heroeswearkapes/ffmpeg-ssh-worker:latest";s:8:"Registry";s:58:"https://hub.docker.com/r/heroeswearkapes/ffmpeg-ssh-worker";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:59:"https://github.com/heroeswearkapes/ffmpeg-ssh-worker/issues";s:7:"Project";s:52:"https://github.com/heroeswearkapes/ffmpeg-ssh-worker";s:8:"Overview";s:590:"FFmpeg SSH Worker is a lightweight, CPU-based FFmpeg rendering worker with SSH public-key authentication, designed for automation workflows.

Originally created as the rendering node for an n8n workflow that automatically assembled YouTube Shorts, the worker can be used by n8n or any other automation platform, script, or application capable of executing commands over SSH.

Provides FFmpeg, OpenSSH, persistent SSH host keys, a shared /work directory, and common media-processing utilities.

CPU rendering only. No GPU passthrough is required.

Supports both amd64 and arm64 Docker hosts.";s:11:"TemplateURL";s:108:"https://raw.githubusercontent.com/heroeswearkapes/unraid-community-apps/main/templates/ffmpeg-ssh-worker.xml";s:4:"Icon";s:104:"https://raw.githubusercontent.com/heroeswearkapes/unraid-community-apps/main/icons/ffmpeg-ssh-worker.png";s:8:"Requires";s:915:"<br>FFmpeg SSH Worker uses SSH public-key authentication.<br><br>The SSH username is:<br><br>worker<br><br>Password authentication and root SSH login are disabled.<br><br>After installation, place your SSH PUBLIC key in:<br><br>/mnt/user/appdata/ffmpeg-ssh-worker/authorized_keys<br><br>Only the public key should be placed in authorized_keys. Never place your SSH private key in the container configuration directory.<br><br>If you do not already have an SSH key pair, one can be generated from another system with:<br><br>ssh-keygen -t ed25519<br><br>After adding authorized_keys, restart the container.<br><br>With the default port configuration, connect using:<br><br>ssh -p 2222 worker@YOUR-UNRAID-IP<br><br>The /work directory is the shared FFmpeg workspace used for source media, intermediate files, and completed renders.<br><br>FFmpeg SSH Worker performs CPU-based media processing. No GPU is required.<br>";s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SSH Port";s:6:"Target";s:2:"22";s:7:"Default";s:4:"2222";s:4:"Mode";s:3:"tcp";s:11:"Description";s:99:"Host port used to connect to the FFmpeg worker over SSH. Example: ssh -p 2222 worker@YOUR-UNRAID-IP";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2222";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Configuration";s:6:"Target";s:7:"/config";s:7:"Default";s:35:"/mnt/user/appdata/ffmpeg-ssh-worker";s:4:"Mode";s:2:"rw";s:11:"Description";s:144:"Persistent SSH configuration. Place your public SSH key in authorized_keys within this directory. Persistent SSH host keys are also stored here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/ffmpeg-ssh-worker";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Work Directory";s:6:"Target";s:5:"/work";s:7:"Default";s:21:"/mnt/user/ffmpeg-work";s:4:"Mode";s:2:"rw";s:11:"Description";s:144:"Shared workspace for source media, intermediate files, and completed FFmpeg renders. The worker account must have write access to this location.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:21:"/mnt/user/ffmpeg-work";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:87:"Timezone used inside the container. Use a valid IANA timezone such as America/New_York.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}}s:12:"TemplatePath";s:51:"/tmp/GitHub/AppFeed/templates/ffmpeg-ssh-worker.xml";s:4:"Repo";s:42:"heroeswearkapes Community Apps' Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Other";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:854;s:9:"FirstSeen";i:1787692865;s:10:"LastUpdate";i:1787690061;s:14:"LastUpdateScan";i:1790295260;s:8:"Category";s:30:"MediaApp:Other Tools:Utilities";s:2:"ID";i:2206;s:11:"Displayable";b:1;s:6:"Author";s:15:"heroeswearkapes";s:13:"DockerHubName";s:17:"ffmpeg-ssh-worker";s:8:"RepoName";s:42:"heroeswearkapes Community Apps' Repository";s:10:"SortAuthor";s:15:"heroeswearkapes";s:8:"SortName";s:17:"FFmpeg SSH Worker";s:6:"random";i:213551908;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:144:"/tmp/community.applications/tempFiles/templates-community-apps/heroeswearkapesCommunityAppsRepository/heroeswearkapes-FFmpegSSHWorker-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2207;a:37:{s:4:"Name";s:22:"Schedules-Direct-XMLTV";s:10:"Repository";s:45:"heroeswearkapes/schedules-direct-xmltv:latest";s:8:"Registry";s:63:"https://hub.docker.com/r/heroeswearkapes/schedules-direct-xmltv";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:64:"https://github.com/heroeswearkapes/schedules-direct-xmltv/issues";s:7:"Project";s:57:"https://github.com/heroeswearkapes/schedules-direct-xmltv";s:8:"Overview";s:458:"Schedules Direct XMLTV automatically downloads TV guide data from Schedules Direct, converts it to XMLTV format, refreshes the guide on a schedule, and serves the resulting tvxml.xml file over HTTP.

Designed for use with Threadfin, Jellyfin, Plex, Emby, TVHeadend, and other applications that accept an XMLTV guide URL.

Supports first-run setup mode so a lineup ID does not need to be known before installation.

Supports both amd64 and arm64 Docker hosts.";s:11:"TemplateURL";s:113:"https://raw.githubusercontent.com/heroeswearkapes/unraid-community-apps/main/templates/schedules-direct-xmltv.xml";s:4:"Icon";s:93:"https://raw.githubusercontent.com/heroeswearkapes/schedules-direct-xmltv/main/assets/icon.png";s:8:"Requires";s:1065:"<br>A valid Schedules Direct subscription is required.<br><br>If you already know your Schedules Direct lineup ID, enter it in the Schedules Direct Lineups field during installation.<br><br>If you do not know your lineup ID, leave Schedules Direct Lineups blank. The container will start in setup mode.<br><br>After the container starts, open either the Unraid Terminal or the container Console and run:<br><br>tv_grab_zz_sdjson --configure --config-file /tmp/sdjson-setup.conf<br><br>If using the Unraid Terminal instead of the container Console, run:<br><br>docker exec -it Schedules-Direct-XMLTV tv_grab_zz_sdjson --configure --config-file /tmp/sdjson-setup.conf<br><br>The configuration wizard will allow you to search for and add a Schedules Direct lineup using your country and ZIP/postal code.<br><br>After discovering your lineup ID, edit the container, enter the lineup ID in Schedules Direct Lineups, apply the changes, and restart the container.<br><br>The generated XMLTV guide will then be available at:<br><br>http://YOUR-UNRAID-IP:51969/tvxml.xml<br>";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"XMLTV HTTP Port";s:6:"Target";s:2:"80";s:7:"Default";s:5:"51969";s:4:"Mode";s:3:"tcp";s:11:"Description";s:53:"Host port used to serve the generated tvxml.xml file.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"51969";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Schedules Direct Username";s:6:"Target";s:11:"SD_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Your Schedules Direct account username.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Schedules Direct Password";s:6:"Target";s:11:"SD_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Your Schedules Direct account password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Schedules Direct Lineups";s:6:"Target";s:10:"SD_LINEUPS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:242:"Optional comma-separated Schedules Direct lineup IDs. Leave blank during initial setup if you do not know your lineup ID yet. After the container starts, use the SD-JSON configuration wizard to discover or add a lineup. Example: USA-OTA-10001";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Guide Days";s:6:"Target";s:13:"SD_FETCH_DAYS";s:7:"Default";s:1:"2";s:4:"Mode";s:0:"";s:11:"Description";s:69:"Number of days of guide data to download during each synchronization.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"2";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:72:"Timezone used by the container and the scheduled midnight guide refresh.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"XMLTV Data";s:6:"Target";s:13:"/var/www/html";s:7:"Default";s:40:"/mnt/user/appdata/schedules-direct-xmltv";s:4:"Mode";s:2:"rw";s:11:"Description";s:79:"Persistent storage for generated XMLTV data and Schedules Direct configuration.";s:4:"Type";s:4:"Path";s:7