:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:0.629;s:12:"trendAverage";d:0.7971;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4933;a:39:{s:4:"Name";s:6:"Strata";s:10:"Repository";s:33:"ghcr.io/williamkunz/strata:latest";s:8:"Registry";s:66:"https://github.com/williamkunz/strata-docker/pkgs/container/strata";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:51:"https://github.com/williamkunz/strata-docker/issues";s:7:"Project";s:34:"https://github.com/Niko1221/Strata";s:6:"ReadMe";s:74:"https://raw.githubusercontent.com/williamkunz/strata-docker/main/README.md";s:8:"Overview";s:1125:"Strata runs the Qwen3.8-Flash-Next mixture-of-experts model on one NVIDIA GPU plus system RAM, and serves an OpenAI- and Anthropic-compatible API, a chat page and a live monitor.

Requirements: the Nvidia Driver plugin on driver 580 or newer; an RTX 20/30/40/50 card with 12 GB of VRAM or more; an AVX2 CPU; 48-62 GB of free RAM depending on the model; 70-90 GB of disk on an SSD pool.

First start: downloads the model (about 70 GB for IQ2_XS) and sets it up, which can take a few hours. Watch the log; it resumes if it stops. Later starts go straight to serving, and loading the model into RAM takes 1-3 minutes.

Changing settings later: switching Model or Model family needs nothing extra. Changing context, vision, KV cache, API key or low-RAM mode for a model already set up needs Reinstall = 1 for one start (nothing is downloaded again), then set it back to 0.

No API key by default: anyone who can reach the port can use the model. Keep it LAN-only, or set an API key.

This is an unofficial image built from Strata's own Dockerfile. Report template or image problems at the Support link, not to the Strata project.";s:16:"ExtraSearchTerms";s:69:"llm qwen local ai openai anthropic api inference chat nvidia cuda gpu";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/williamkunz/strata-docker/main/templates/strata.xml";s:4:"Icon";s:73:"https://raw.githubusercontent.com/williamkunz/strata-docker/main/icon.png";s:7:"License";s:3:"MIT";s:11:"ExtraParams";s:54:"--runtime=nvidia --ulimit memlock=-1 --stop-timeout 60";s:8:"Requires";s:186:"**Nvidia Driver plugin** on driver 580 or newer. Do not pin CPUs: the engine sets its own thread affinity and breaks inside a cpuset. Do not set a memory limit unless Low-RAM mode is on.";s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"WebUI / API port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:88:"Chat page, monitor and the /v1 API. No API key is set by default, so keep this LAN-only.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/cache/appdata/strata";s:4:"Mode";s:2:"rw";s:11:"Description";s:234:"The model, the prepared pack, the MTP layer and the install config: 70-90 GB depending on the model. Use a direct pool path (/mnt/cache/... or /mnt/POOLNAME/...), not /mnt/user: the engine reads experts from these files while it runs.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/cache/appdata/strata";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GPU";s:6:"Target";s:22:"NVIDIA_VISIBLE_DEVICES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:171:"Your card's UUID (GPU-xxxxxxxx-...) from the Nvidia Driver plugin page or nvidia-smi -L. Name one card; 'all' on a two-card server makes setup split the model across both.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Model";s:6:"Target";s:5:"MODEL";s:7:"Default";s:42:"IQ2_XS|Q2_0|IQ3_XXS|IQ3_S|IQ1_M|UD-Q4_K_XL";s:4:"Mode";s:0:"";s:11:"Description";s:216:"IQ2_XS (recommended): 68 GB download, 48 GB RAM. Q2_0: fastest, 48 GB RAM (qwen only). IQ3_XXS: better, 60 GB RAM. IQ3_S: best quality, 62 GB RAM. IQ1_M: coder family only, 32 GB RAM. UD-Q4_K_XL: unsloth family only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"IQ2_XS";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Model family";s:6:"Target";s:6:"FAMILY";s:7:"Default";s:30:"qwen|swift|coder|unsloth|nvfp4";s:4:"Mode";s:0:"";s:11:"Description";s:125:"qwen (default); swift (thinks shorter); coder (for code, fewer experts); unsloth and nvfp4 need their own models (see Model).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"qwen";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Context length";s:6:"Target";s:7:"CONTEXT";s:7:"Default";s:51:"32768|8192|65536|131072|204800|262144|393216|524288";s:4:"Mode";s:0:"";s:11:"Description";s:137:"Tokens per conversation. Longer costs RAM; setup caps it if the RAM is short. Changing it for a model already set up needs Reinstall = 1.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"32768";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Vision";s:6:"Target";s:6:"VISION";s:7:"Default";s:10:"no|yes|cpu";s:4:"Mode";s:0:"";s:11:"Description";s:135:"Image input: yes runs the image encoder on the GPU, cpu runs it on the CPU. Changing it for a model already set up needs Reinstall = 1.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"no";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"API key";s:6:"Target";s:7:"API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Empty = no key. When set, /v1/* requires it as Authorization: Bearer or x-api-key; /health and the chat page stay open. Setting or changing it for a model already set up needs Reinstall = 1.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Reinstall";s:6:"Target";s:9:"REINSTALL";s:7:"Default";s:3:"0|1";s:4:"Mode";s:0:"";s:11:"Description";s:168:"1 = run setup again on the next start to apply changed context, vision, KV cache, API key or low-RAM settings. Nothing is downloaded again. Set it back to 0 afterwards.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"KV cache type";s:6:"Target";s:2:"KV";s:7:"Default";s:14:"int8|q4_0|k8v4";s:4:"Mode";s:0:"";s:11:"Description";s:143:"int8 (default); q4_0 halves the KV memory, slightly less precise; k8v4 keeps its KV in VRAM from 64K context up. Needs Reinstall = 1 to change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"int8";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Low-RAM mode";s:6:"Target";s:7:"LOW_RAM";s:7:"Default";s:11:"auto|on|off";s:4:"Mode";s:0:"";s:11:"Description";s:205:"on maps the experts from the pack on disk instead of keeping them in RAM. Required if you give the container a memory limit: setup sees the server's total RAM, not the limit. Needs Reinstall = 1 to change.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"NVIDIA driver capabilities";s:6:"Target";s:26:"NVIDIA_DRIVER_CAPABILITIES";s:7:"Default";s:15:"compute,utility";s:4:"Mode";s:0:"";s:11:"Description";s:45:"Must include utility: setup needs nvidia-smi.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"compute,utility";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/templates/strata.xml";s:4:"Repo";s:23:"MadeOfCard's Repository";s:12:"CategoryList";a:1:{i:0;s:2:"AI";}s:9:"FirstSeen";i:1792079717;s:8:"Category";s:3:"AI:";s:2:"ID";i:4933;s:11:"Displayable";b:1;s:6:"Author";s:11:"williamkunz";s:13:"DockerHubName";s:6:"strata";s:8:"RepoName";s:23:"MadeOfCard's Repository";s:10:"SortAuthor";s:11:"williamkunz";s:8:"SortName";s:6:"Strata";s:6:"random";i:1770018661;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/MadeOfCardsRepository/williamkunz-Strata-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4934;a:41:{s:4:"Name";s:9:"Cantinarr";s:10:"Repository";s:34:"ghcr.io/windoze95/cantinarr:latest";s:8:"Registry";s:35:"https://ghcr.io/windoze95/cantinarr";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:85:"https://raw.githubusercontent.com/windoze95/cantinarr/main/app/web/icons/Icon-512.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8585]/";s:8:"Overview";s:1154:"Cantinarr brings media requests and server management into one app. Household members browse and request movies, shows, books, and music, follow downloads, and get notified when content is ready. Admins manage Radarr, Sonarr, Chaptarr, Lidarr, and download clients, review approvals, and investigate stuck downloads from a phone or browser.[br][br]Connect the services you use after setup. The web app runs in the same container, and the companion iPhone and Android apps connect to your server. Plex, Jellyfin, Emby, Audiobookshelf, Tautulli, and Tracearr integrations are available. Import Doctor explains common download problems and offers fixes for an administrator to review.[br][br]AI is optional. Connect a provider if you want an assistant for library questions and requests or an agent that investigates persistent download problems. Administrators choose what it may do. Cantinarr also offers MCP tools for authorized clients.[br][br]The container serves its web app and API on port 8585. Service credentials stay server-side and are encrypted at rest. Sign-in uses connect links by default, with passwords and passkeys available when enabled.";s:7:"Support";s:45:"https://github.com/windoze95/cantinarr/issues";s:7:"Project";s:38:"https://github.com/windoze95/cantinarr";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/templates/cantinarr.xml";s:6:"ReadMe";s:68:"https://raw.githubusercontent.com/windoze95/cantinarr/main/README.md";s:16:"ExtraSearchTerms";s:164:"radarr sonarr chaptarr lidarr readarr requests request manager overseerr jellyseerr ombi petio movies tv books music albums ebooks audiobooks plex tmdb trakt ai mcp";s:8:"Requires";s:159:"Nothing beyond this container. Radarr, Sonarr, Chaptarr, download clients, Tautulli, and Plex are all optional and are added from the admin UI after first run.";s:4:"Date";s:10:"2026-09-04";s:6:"MinVer";s:3:"6.1";s:7:"License";s:6:"AGPLv3";s:10:"Screenshot";a:7:{i:0;s:93:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/01-discover.jpg";i:1;s:99:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/05-phone-discover.jpg";i:2;s:92:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/04-request.png";i:3;s:98:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/06-phone-seasons.jpg";i:4;s:99:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/03-sonarr-library.jpg";i:5;s:100:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/07-phone-downloads.jpg";i:6;s:91:"https://raw.githubusercontent.com/windoze95/cantinarr-unraid/main/screenshots/02-issues.png";}s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8585";s:7:"Default";s:4:"8585";s:4:"Mode";s:3:"tcp";s:11:"Description";s:138:"Port for the Cantinarr web app and API. The container always listens on 8585; change only the host side if something else already uses it.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8585";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:7:"/config";s:7:"Default";s:27:"/mnt/user/appdata/cantinarr";s:4:"Mode";s:2:"rw";s:11:"Description";s:217:"Cantinarr's database and its generated encryption key. Instance API keys, download-client passwords, and AI credentials are AES-256-GCM encrypted with that key, so back up this folder and keep it out of public shares.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/cantinarr";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"Push gateway URL";s:6:"Target";s:26:"CANTINARR_PUSH_GATEWAY_URL";s:7:"Default";s:26:"https://push.cantinarr.com";s:11:"Description";s:383:"Enables push notifications to the iOS and Android apps. Leave it set and the server enrolls itself on first start and stores its own key in the appdata volume, with no signup and no account. Clear the field to disable push entirely, or point it at your own gateway. The relay's former address, https://push.julian.codes, still works and is rewritten to the new one by current images.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"https://push.cantinarr.com";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Arr webhook callback URL";s:6:"Target";s:26:"CANTINARR_ARR_CALLBACK_URL";s:7:"Default";s:0:"";s:11:"Description";s:543:"Origin your Radarr, Sonarr, and Chaptarr containers POST webhooks back to, so it has to be reachable from those containers. For example http://192.168.1.10:8585, or http://cantinarr:8585 on a shared Docker network. Leave blank to use whatever address you browse to. Set it explicitly behind a reverse proxy, because forwarded headers are deliberately ignored. This is not the address people reach Cantinarr at; set that in the app under Settings, External Address. Formerly named CANTINARR_PUBLIC_URL, which existing containers can keep using.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:35:"Media library (optional, read-only)";s:6:"Target";s:6:"/media";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:252:"Only needed if you want signed-in users to download completed files (ebooks, audiobooks, movies, episodes, tracks) from your library. Map the share holding that library here, then set Media roots below to /media. Leave blank to keep file downloads off.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Media roots";s:6:"Target";s:21:"CANTINARR_MEDIA_ROOTS";s:7:"Default";s:0:"";s:11:"Description";s:278:"Comma-separated container paths that completed-media downloads may serve from. Empty keeps downloads disabled. After mapping the read-only library above, set this to /media, then map each arr-reported path to a folder beneath it in that instance's settings. A bare / is refused.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:16:"MCP OAuth issuer";s:6:"Target";s:22:"CANTINARR_OAUTH_ISSUER";s:7:"Default";s:0:"";s:11:"Description";s:285:"Only needed if you expose Cantinarr's Model Context Protocol endpoint to external AI clients through a reverse proxy. Set it to the canonical external HTTPS origin, for example https://cantinarr.example.com, and keep it stable, because changing it makes existing MCP clients reconnect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:250:"User id the server runs as. On every start the container makes the appdata folder belong to this user, so its database and encryption key are owned by that user on the array (99 is Unraid's nobody). Leave blank to run as root, the previous behaviour.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:85:"Group id to pair with PUID (100 is Unraid's users group). Ignored when PUID is blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/cantinarr.xml";s:4:"Repo";s:22:"windoze95's Repository";s:12:"CategoryList";a:4:{i:0;s:14:"MediaApp-Video";i:1;s:14:"MediaApp-Books";i:2;s:14:"MediaApp-Music";i:3;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1786939518;s:8:"Category";s:60:"MediaApp:Video MediaApp:Books MediaApp:Music Tools:Utilities";s:2:"ID";i:4934;s:11:"Displayable";b:1;s:6:"Author";s:9:"windoze95";s:13:"DockerHubName";s:9:"cantinarr";s:8:"RepoName";s:22:"windoze95's Repository";s:10:"SortAuthor";s:9:"windoze95";s:8:"SortName";s:9:"Cantinarr";s:6:"random";i:1286671433;s:9:"Blacklist";b:0;s:4:"Path";s:114:"/tmp/community.applications/temp