Log temperatures and medicines in seconds, see at a glance when the next dose can be given (from the timings you set from each medicine's label), and get reminders and alerts. Includes a web app for any browser, and works with the NestHealth iPhone app. Accounts for each parent, passkeys over HTTPS, Web Push, and webhooks for ntfy, Home Assistant, Discord and Slack.

After starting, open the WebUI and create the first account: it becomes the admin, who adds the rest of the family. NestHealth is a logbook, not medical advice, and it never calculates doses.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/mahansford/nesthealth-server/main/unraid/nesthealth.xml";s:4:"Icon";s:102:"https://raw.githubusercontent.com/mahansford/nesthealth-server/main/.github/assets/nesthealth-icon.png";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:53:"Port for the web app and the iPhone app's connection.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:28:"/mnt/user/appdata/nesthealth";s:4:"Mode";s:2:"rw";s:11:"Description";s:45:"The database and photos. Back this folder up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/nesthealth";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/London";s:4:"Mode";s:0:"";s:11:"Description";s:89:"Used for the times shown in notifications, for example Europe/London or America/New_York.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/London";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:51:"User ID the server runs as (99 is Unraid's nobody).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:52:"Group ID the server runs as (100 is Unraid's users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:10:"PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Optional. The HTTPS address your family uses (for example https://health.example.com). Set it if passkeys fail behind a reverse proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Web Push contact";s:6:"Target";s:13:"VAPID_SUBJECT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:90:"Optional. A contact address sent to Web Push services, for example mailto:you@example.com.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/unraid/nesthealth.xml";s:4:"Repo";s:24:"hansford909's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"downloads";i:399;s:9:"FirstSeen";i:1790424747;s:10:"LastUpdate";i:1790419570;s:14:"LastUpdateScan";i:1790424747;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:3265;s:11:"Displayable";b:1;s:6:"Author";s:11:"hansford909";s:13:"DockerHubName";s:10:"nesthealth";s:8:"RepoName";s:24:"hansford909's Repository";s:10:"SortAuthor";s:11:"hansford909";s:8:"SortName";s:10:"NestHealth";s:6:"random";i:156747478;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/hansford909sRepository/hansford909-NestHealth-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:3266;a:42:{s:4:"Name";s:7:"questly";s:10:"Repository";s:26:"hansford909/questly:latest";s:8:"Registry";s:44:"https://hub.docker.com/r/hansford909/questly";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"Shell";s:2:"sh";s:4:"Icon";s:87:"https://raw.githubusercontent.com/mahansford/questly/main/app/static/icons/icon-512.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8000]";s:8:"Overview";s:1218:"A family points-and-rewards app. Grown-ups award points for quests and good behaviour; kids spend them in a shop of rewards you stock yourself.

Kids sign in by tapping their face and typing a 4-6 digit PIN, or no PIN at all for the youngest. They get a quest list with big Done buttons, a progress bar counting down to the next reward they cannot quite afford, and a shop showing what they can buy now. Grown-ups get quick award buttons, a quest board, a shop editor, and one approvals page for everything waiting on them. Every point movement is written to a ledger with a running balance.

The interface is mobile-first and installs to a phone or tablet home screen.

IMPORTANT - this container needs a MongoDB 5 or newer server, which is not included. Install one from Community Apps first, then point MONGO_URI at it. Questly keeps no local state, so there is no appdata path to configure and nothing to back up except the database.

