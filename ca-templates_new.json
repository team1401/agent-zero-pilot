ml";s:7:"Default";s:39:"/mnt/user/appdata/anubis/botPolicy.yaml";s:11:"Description";s:28:"Path to the bot policy file.";s:4:"Type";s:4:"Path";s:4:"Mode";s:2:"ro";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:39:"/mnt/user/appdata/anubis/botPolicy.yaml";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Base Prefix";s:6:"Target";s:11:"BASE_PREFIX";s:7:"Default";s:0:"";s:11:"Description";s:237:"If set, adds a global prefix to all Anubis endpoints. For example, setting this to /myapp would make Anubis accessible at /myapp/ instead of /. This is useful when running Anubis behind a reverse proxy that routes based on path prefixes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Bind Port";s:6:"Target";s:4:"BIND";s:7:"Default";s:5:":8923";s:11:"Description";s:37:"Internal bind port to the host system";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:":8923";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:12:"Bind Network";s:6:"Target";s:12:"BIND_NETWORK";s:7:"Default";s:3:"tcp";s:11:"Description";s:41:"The address family that Anubis listens on";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"tcp";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Cookie - Domain";s:6:"Target";s:13:"COOKIE_DOMAIN";s:7:"Default";s:0:"";s:11:"Description";s:191:"The domain the Anubis challenge pass cookie should be set to. This should be set to the domain you bought from your registrar (EG: techaro.lol if your webapp is running on anubis.techaro.lol)";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:23:"Cookie - Dynamic Domain";s:6:"Target";s:21:"COOKIE_DYNAMIC_DOMAIN";s:7:"Default";s:10:"false|true";s:11:"Description";s:213:"If set to true, automatically set cookie domain fields based on the hostname of the request. EG: if you are making a request to anubis.techaro.lol, the Anubis cookie will be valid for any subdomain of techaro.lol.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:24:"Cookie - Expiration Time";s:6:"Target";s:22:"COOKIE_EXPIRATION_TIME";s:7:"Default";s:4:"168h";s:11:"Description";s:57:"The amount of time the authorization cookie is valid for.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"168h";}i:10;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:20:"Cookie - Partitioned";s:6:"Target";s:18:"COOKIE_PARTITIONED";s:7:"Default";s:10:"false|true";s:11:"Description";s:157:"If set to true, enables the partitioned (CHIPS) flag, meaning that Anubis inside an iframe has a different set of cookies than the domain hosting the iframe.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Cookie - Secure";s:6:"Target";s:13:"COOKIE_SECURE";s:7:"Default";s:10:"true|false";s:11:"Description";s:195:"If set to true, enables the Secure flag, meaning that the cookies will only be transmitted over HTTPS. If Anubis is used in an unsecure context (plain HTTP), this will be need to be set to false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:10:"Difficulty";s:6:"Target";s:10:"DIFFICULTY";s:7:"Default";s:1:"4";s:11:"Description";s:102:"The difficulty of the challenge, or the number of leading zeroes that must be in successful responses.";s:4:"Type";s:8:"Variable";