eapps";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1310;a:41:{s:4:"Name";s:9:"LiftTrace";s:10:"Repository";s:34:"ghcr.io/traceapps/lifttrace:latest";s:8:"Registry";s:70:"https://github.com/orgs/TraceApps/packages/container/package/lifttrace";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/TraceApps/lifttrace/discussions";s:7:"Project";s:38:"https://github.com/TraceApps/lifttrace";s:8:"Overview";s:1007:"LiftTrace is a self-hosted weightlifting tracker. Log sets with weight, reps and RPE, run multi-week programs from starter templates or your own, and pick exercises from a library drawn from wger, Free Exercise DB and ExerciseDB, plus your own custom exercises. Statistics cover progress per exercise, records, volume, frequency and body weight, with automatic PR detection and dated progress photos. Trainer accounts can prescribe workouts to athletes, and you can import your history from Strong, Hevy, FitNotes, Jefit or Garmin FIT files. Multi-user with OIDC single sign-on and a native Android app. No telemetry and no accounts on external services; your data stays in your appdata folder.

