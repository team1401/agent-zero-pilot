I";s:24:"http://[IP]:[PORT:8485]/";s:11:"TemplateURL";s:84:"https://raw.githubusercontent.com/max-prime-math/typr/main/templates/typr-server.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/max-prime-math/typr/main/public/icons/icon-512.png";s:11:"ExtraParams";s:212:"--restart=unless-stopped --user=1000:1000 --read-only --tmpfs=/tmp:rw,nosuid,nodev,noexec,size=536870912 --cap-drop=ALL --security-opt=no-new-privileges:true --pids-limit=256 --memory=2g --memory-swap=2g --cpus=2";s:4:"Date";s:10:"2026-08-19";s:8:"Requires";s:750:"Use only on a trusted LAN or private VPN with mutually trusted documents. Never expose either port to the public Internet. Choose a unique management password of at least 24 characters; use trusted HTTPS when the management network is not physically trusted. Remote Typr use requires a client-trusted HTTPS reverse proxy with WebSocket support and firewall/VPN restriction. For Tailscale, keep the container's Use Tailscale switch off and use host-level Tailscale Serve; never use Funnel. Stock Unraid may use the explicit volume-free stateless fallback; any mapped workspace requires working Landlock support and otherwise fails closed. On stock fallback deployments, management users/API keys are session-only and reset when the container restarts.";s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Typr Server port";s:6:"Target";s:4:"8484";s:7:"Default";s:4:"8484";s:4:"Mode";s:3:"tcp";s:11:"Description";s:93:"Host port used by the reverse proxy and local status checks. Container port must remain 8484.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8484";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Management GUI port";s:6:"Target";s:4:"8485";s:7:"Default";s:4:"8485";s:4:"Mode";s:3:"tcp";s:11:"Description";s:136:"Host port for the management GUI. Container port must remain 8485. Keep it restricted to a trusted LAN/VPN and never expose it publicly.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8485";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Management listen address";s:6:"Target";s:30:"TYPR_COMPANION_MANAGEMENT_HOST";s:7:"Default";s:7:"0.0.0.0";s:4:"Mode";s:0:"";s:11:"Description";s:153:"Required container listen address for the mapped GUI port. Keep 0.0.0.0 in bridge mode; remote mode refuses startup without a strong management password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"0.0.0.0";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Management password";s:6:"Target";s:34:"TYPR_COMPANION_MANAGEMENT_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:138:"Required administrator password for the GUI; at least 24 characters. The browser username is typr. This is separate from service API keys.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Allowed Typr origins";s:6:"Target";s:30:"TYPR_COMPANION_ALLOWED_ORIGINS";s:7:"Default";s:56:"https://typr.ca,https://beta.typr.ca,https://dev.typr.ca";s:4:"Mode";s:0:"";s:11:"Description";s:164:"Comma-separated exact browser origins, including scheme, host, and port with no path or trailing slash. Add the self-hosted Typr origin. CORS is not authentication.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:56:"https://typr.ca,https://beta.typr.ca,https://dev.typr.ca";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Allow stateless Unraid fallback";s:6:"Target";s:42:"TYPR_COMPANION_ALLOW_UNSANDBOXED_STATELESS";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:191:"Keep exactly 1 on stock Unraid: if Landlock is unavailable, allow trusted-document compilation only when no host workspace is mounted. A