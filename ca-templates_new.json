is plugin is an independent Unraid integration that packages the official binary, not an upstream project.";s:9:"PluginURL";s:66:"https://raw.githubusercontent.com/Greite/unraid-btop/main/btop.plg";s:7:"Support";s:44:"https://github.com/Greite/unraid-btop/issues";s:7:"Project";s:37:"https://github.com/Greite/unraid-btop";s:6:"ReadMe";s:67:"https://raw.githubusercontent.com/Greite/unraid-btop/main/README.md";s:4:"Icon";s:115:"https://raw.githubusercontent.com/Greite/unraid-btop/main/source/btop/usr/local/emhttp/plugins/btop/images/btop.png";s:11:"TemplateURL";s:76:"https://raw.githubusercontent.com/Greite/unraid-templates/main/btop/btop.xml";s:12:"TemplatePath";s:33:"/tmp/GitHub/AppFeed/btop/btop.xml";s:4:"Repo";s:25:"GreiteTurtle's Repository";s:10:"Repository";s:66:"https://raw.githubusercontent.com/Greite/unraid-btop/main/btop.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:10:"2026.07.23";s:6:"MinVer";s:6:"6.12.0";s:6:"Author";N;s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:1030;s:9:"FirstSeen";i:1783469233;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:110;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:432;s:2:"08";i:269;s:2:"09";i:219;s:1:"T";i:1030;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:568;s:11:"Displayable";b:1;s:13:"DockerHubName";s:4:"btop";s:8:"RepoName";s:25:"GreiteTurtle's Repository";s:10:"SortAuthor";N;s:8:"SortName";s:4:"btop";s:6:"random";i:2005571964;s:9:"Blacklist";b:0;s:4:"Path";s:157:"/tmp/community.applications/tempFiles/templates-community-apps/GreiteTurtlesRepository/-btop-//raw.githubusercontent.com/Greite/unraid-btop/main/btop.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:569;a:34:{s:4:"Name";s:15:"database-backup";s:10:"Repository";s:37:"ghcr.io/greite/database-backup:latest";s:8:"Registry";s:72:"https://github.com/Greite/database-backup/pkgs/container/database-backup";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/Greite/database-backup/issues";s:7:"Project";s:41:"https://github.com/Greite/database-backup";s:6:"ReadMe";s:61:"https://github.com/Greite/database-backup/blob/main/README.md";s:8:"Overview";s:1438:"Lightweight Go-powered container to automate PostgreSQL, MariaDB/MySQL, and MongoDB backups on a schedule.

Features:
- Simple YAML configuration with strict validation and a built-in validate command
- Dynamic client install at startup: only the tools your config needs are installed
- Flexible cron scheduling per backup job, with graceful shutdown for in-flight backups
- Streaming gzip compression, atomic file writes, timestamped dumps
- Optional at-rest encryption: gpg-compatible OpenPGP or age (passphrase or public key)
- Configurable per-job retention; old backups are only rotated after a successful run
- Runs unprivileged (PUID/PGID, default 99:100 on Unraid) after client installation; secrets never appear in process arguments
- Built-in healthcheck using native database drivers (no heavy CLI downloads)
- Multiple databases (different types and hosts) handled by a single container
- Multi-architecture (amd64, arm64) and auto-rebuilt on base image security updates

Setup:
1. Copy backups.yml.example from the project repository to your appdata directory and rename it to backups.yml
2. Edit backups.yml with your databases (chmod 600, it contains credentials)
3. Map the file to /config/backups.yml and a host folder to /backups

Upgrading from v1: run the built-in migrate command to convert your old backups.conf to YAML. See https://github.com/Greite/database-backup/blob/main/docs/MIGRATION-V2.md";s:11:"TemplateURL";s:98:"https://raw.githubusercontent.com/Greite/unraid-templates/main/database-backup/database-backup.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/Greite/database-backup/main/public/images/mark.png";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Backups Storage";s:6:"Target";s:8:"/backups";s:7:"Default";s:41:"/mnt/user/appdata/database-backup/backups";s:4:"Mode";s:2:"rw";s:11:"Description";s:187:"Host path where database dumps are written. Files are organized as type/job-name/job-name_timestamp.sql.gz (or .tar.gz for MongoDB), plus a .gpg or .age suffix when encryption is enabled.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:41:"/mnt/user/appdata/database-backup/backups";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Configuration File";s:6:"Target";s:19:"/config/backups.yml";s:7:"Default";s:45:"/mnt/user/appdata/database-backup/backups.yml";s:4:"Mode";s:2:"ro";s:11:"Description";s:388:"Path to the backups.yml file on the host. Get the example from https://github.com/Greite/database-backup/blob/main/backups.yml.example and edit it before starting the container. Keep it chmod 600 and owned by PUID (99 by default) so the container can read it. Upgrading from v1? Convert your backups.conf with the built-in migrate command (see the migration guide linked in the Overview).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:45:"/mnt/user/appdata/database-backup/backups.yml";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Encryption Passphrase";s:6:"Target";s:28:"BACKUP_ENCRYPTION_PASSPHRASE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:192:"Optional. Enables gpg-compatible at-rest encryption of every backup (decrypt with gpg -d). Leave empty to disable, or use the encryption block in backups.yml for more options (age, key files).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:145:"UID the scheduler and dumps run as. The Backups Storage path is chowned to it at startup. 99 = nobody (Unraid default). Requires v2.1.0 or later.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:91:"GID the scheduler and dumps run as. 100 = users (Unraid default). Requires v2.1.0 or later.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:55:"/tmp/GitHub/AppFeed/database-backup/database-backup.xml";s:4:"Repo";s:25:"GreiteTurtle's Repository";s:12:"CategoryList";a:2:{i:0;s:6:"Backup";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1778605912;s:8:"Category";s:23:"Backup: Tools:Utilities";s:2:"ID";i:569;s:11:"Displayable";b:1;s:6:"Author";s:6:"greite";s:13:"DockerHubName";s:15:"database-backup";s:8:"RepoName";s:25:"GreiteTurtle's Repository";s:10:"SortAuthor";s:6:"greite";s:8:"SortName";s:15:"database backup";s:6:"random";i:50199267;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/GreiteTurtlesRepository/greite-databasebackup-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:570;a:35:{s:4:"Name";s:17:"speedtest-monitor";s:10:"Repository";s:39:"ghcr.io/greite/speedtest-monitor:latest";s:8:"Registry";s:40:"https://ghcr.io/greite/speedtest-monitor";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/Greite/speedtest-monitor/issues";s:7:"Project";s:43:"https://github.com/Greite/speedtest-monitor";s:8:"Overview";s:685:"Self-hosted internet speed monitor. Runs Cloudflare Speed Test on a configurable schedule, stores every measurement in SQLite, and serves a dashboard with live updates over WebSocket. Includes alerts (webhook, ntfy, Discord, Slack, SMTP), authentication (local accounts and OIDC), and role-based access (admin / viewer).

On first boot, set AUTH_SECRET (required) and BETTER_AUTH_URL (required when accessed behind a reverse proxy). Either set SPEEDTEST_ADMIN_EMAIL + SPEEDTEST_ADMIN_PASSWORD to seed the first admin, or visit /setup to create it from the UI. All other variables are optional.

