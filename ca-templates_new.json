isplay";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"TRANSPORTTYPE";s:6:"Target";s:13:"TRANSPORTTYPE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:80:"Determines the message transport used to communicate with message endpoints. See";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"CONNECTIONSTRING";s:6:"Target";s:16:"CONNECTIONSTRING";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:152:"Provides the connection information to connect to the chosen transport. The form of this connection string is different for every message transport. See";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"PARTICULARSOFTWARE_LICENSE";s:6:"Target";s:26:"PARTICULARSOFTWARE_LICENSE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:477:"The Particular Software license, which is most easily provided to a container as an environment variable (https://docs.particular.net/nservicebus/licensing/#license-management-environment-variable). The environment variable should contain the full multi-line contents of the license file. A license file can also be volume-mounted to the container. e.g. (/usr/share/ParticularSoftware/license.xml). If no license file is provided, a trial license will be automatically enabled.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"ParticularPlatformFiles";s:6:"Target";s:30:"/usr/share/ParticularSoftware/";s:7:"Default";s:38:"/mnt/cache/appdata/ParticularPlatform/";s:4:"Mode";s:2:"rw";s:11:"Description";s:147:"An optionally shared folder used by all Particular Service Platform c