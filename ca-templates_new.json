et";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:93:"Port for the Chowkidar web interface. Open this port in your browser to access the dashboard.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Config Path";s:6:"Target";s:7:"/config";s:7:"Default";s:27:"/mnt/user/appdata/chowkidar";s:4:"Mode";s:2:"rw";s:11:"Description";s:160:"Directory where Chowkidar stores its config file, SQLite database, and logs. Must be a persistent path — data will be lost on container removal if not mapped.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Docker Socket";s:6:"Target";s:20:"/var/run/docker.sock";s:7:"Default";s:20:"/var/run/docker.sock";s:4:"Mode";s:2:"rw";s:11:"Description";s:154:"Docker socket used to monitor containers and perform actions (restart, stop, etc.). Required — do not change unless you are using a Docker socket proxy.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:20:"CHOWKIDAR_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:294:"Encryption key used to protect notification credentials (webhook URLs, passwords, tokens) stored on disk. Set this to a long random string (e.g. 32+ characters). If left empty, secrets are stored as plaintext. Once set, do not change this value or your saved credentials will become unreadable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"App Data Path";s:6:"Target";s:8:"APP_PATH";s:7:"Default";s:7:"/config";s:4:"Mode";s:0:"";s:11:"Description";s:231:"Internal container path where Chowkidar stores its config, database and logs. Must match the container path of your Config Path volume mapping above. Only change if you have remapped the config volume to a different container path.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:189:"Controls how much detail is written to the log. Options: debug (most verbose, useful for troubleshooting), info (normal operation), warn (warnings only), error (errors only). Default: info.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/chowkidar.xml";s:4:"Repo";s:16:"DMF's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:9:"downloads";i:4423;s:9:"FirstSeen";i:1780350879;s:10:"LastUpdate";i:1786087807;s:14:"LastUpdateScan";i:1790969388;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:1841;s:11:"Displayable";b:1;s:6:"Author";s:15:"darkmatterforge";s:13:"DockerHubName";s:9:"chowkidar";s:8:"RepoName";s:16:"DMF's Repository";s:10:"SortAuthor";s:15:"darkmatterforge";s:8:"SortName";s:9:"chowkidar";s:6:"random";i:1856612273;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/DMFsRepository/darkmatterforge-chowkidar-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1842;a:40:{s:4:"Name";s:9:"BlockSlot";s:10:"Repository";s:39:"ghcr.io/datbird/blockslot-server:latest";s:8:"Registry";s:68:"https://github.com/datbird/blockslot/pkgs/container/blockslot-server";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:43:"https://github.com/datbird/blockslot/issues";s:7:"Project";s:36:"https://github.com/datbird/blockslot";s:6:"ReadMe";s:73:"https://raw.githubusercontent.com/datbird/blockslot/main/server/README.md";s:8:"Overview";s:1546:"You play a game on the PC, pick up the Steam Deck later, and the save is not there. Steam Cloud covers some games and not others. Emulators, non-Steam games and anything from another store are left to you, and a sync folder that copies files both ways will happily overwrite the newer save with the older one.

BlockSlot is the server half of a save sync for your own devices. Each device uploads a game's save when the game closes and restores the newest one before it starts. This container is where those saves live: a small S3 store (Garage) and a web page to look after it. It does not replace Steam Cloud. Games that Steam Cloud already covers can stay with Steam.

Every upload is kept as a snapshot with its history, so nothing is ever overwritten. When two devices both played from the same save, BlockSlot sees it and asks which one to keep, instead of guessing. From the web page you can browse every game, restore any older save to all devices, settle two saves, download a save as a zip, and set the emulator libraries and folders every device shares. A RetroArch or RetroBat saves folder is split into one save per game, so each game keeps its own history.

Install it, open the web page and make the admin account. Then add a device: the page gives you a one-line setup code to paste into that device's BlockSlot app. Each device has its own key, so a lost laptop is one click to revoke. Cloudflare Access sign-in and per-device Cloudflare service tokens are built in, for when you want to reach it from outside your network.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8761]/";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/datbird/unraid-templates/main/templates/blockslot.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/datbird/unraid-templates/main/icons/blockslot.png";s:10:"Screenshot";a:9:{i:0;s:88:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/01-games.png";i:1;s:95:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/02-game-history.png";i:2;s:92:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/03-two-saves.png";i:3;s:90:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/04-library.png";i:4;s:91:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/05-settings.png";i:5;s:90:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/06-devices.png";i:6;s:90:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/07-storage.png";i:7;s:95:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/10-first-device.png";i:8;s:90:"https://raw.githubusercontent.com/datbird/blockslot/main/server/docs/images/08-sign-in.png";}s:16:"ExtraSearchTerms";s:69:"save sync game saves steam deck emulator retroarch retrobat s3 garage";s:8:"Requires";s:256:"The BlockSlot app on each device that plays: BlockSlot for Windows, or the BlockSlot plugin for Decky Loader on a Steam Deck. Both are free downloads on the project's releases page. The server never reads or changes anything outside its own appdata folder.";s:7:"License";s:3:"MIT";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8761";s:7:"Default";s:4:"8761";s:4:"Mode";s:3:"tcp";s:11:"Description";s:58:"The web page: games, saves, settings, devices and storage.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8761";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"S3 Port";s:6:"Target";s:4:"3900";s:7:"Default";s:4:"3900";s:4:"Mode";s:3:"tcp";s:11:"Description";s:55:"Where devices upload and fetch saves (Garage's S3 API).";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3900";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:27:"/mnt/user/appdata/blockslot";s:4:"Mode";s:2:"rw";s:11:"Description";s:93:"Every save, Garage's config and metadata, and the server's own settings. Back this folder up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/blockslot";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"S3 port in setup codes";s:6:"Target";s:24:"BLOCKSLOT_PUBLIC_S3_PORT";s:7:"Default";s:4:"3900";s:4:"Mode";s:0:"";s:11:"Description";s:141:"Only when the S3 port above is not 3900: the port written into device setup codes. Setting a device address on the Devices page overrides it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3900";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/blockslot.xml";s:4:"Repo";s:20:"datbird's Repository";s:12:"CategoryList";a:2:{i:0;s:6:"Backup";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790367189;s:8:"Category";s:23:"Backup: Tools:Utilities";s:2:"ID";i:1842;s:11:"Displayable";b:1;s:6:"Author";s:7:"datbird";s:13:"DockerHubName";s:9:"blockslot";s:8:"RepoName";s:20:"datbird's Repository";s:10:"SortAuthor";s:7:"datbird";s:8:"SortName";s:9:"BlockSlot";s:6:"random";i:379706205;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:110:"/tmp/community.applications/tempFiles/templates-community-apps/datbirdsRepository/datbird-BlockSlot-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1843;a:42:{s:4:"Name";s:13:"CouchElephant";s:10:"Repository";s:36:"ghcr.io/datbird/couchelephant:latest";s:8:"Registry";s:69:"https://github.com/datbird/couchelephant/pkgs/container/couchelephant";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/datbird/couchelephant/issues";s:7:"Project";s:40:"https://github.com/datbird/couchelephant";s:6:"ReadMe";s:70:"https://raw.githubusercontent.com/datbird/couchelephant/main/README.md";s:8:"Overview";s:2359:"Plex's DVR records the wrong broadcast. Ask it to record your team and it will happily pick the repeat that airs two days later, on a channel you do not watch, and tell you nothing about it.

CouchElephant reads the same guide, picks the live broadcast itself, and pins the recording to that exact channel and start time so Plex has nothing left to choose. It sits beside Plex rather than replacing it, and recordings land in your Plex library exactly as they always did.

It also adds passes Plex has no equivalent for. Follow any of 1,300 professional and college teams and it records every game they play. Or build a smart filter out of nested AND, OR and NOT conditions over genre, rating, channel, time and more. Every standard Plex recording option, padding included, is on every pass, and a new sports pass arrives with sensible padding already filled in.

It watches Plex do its own job, too. When Plex stops refreshing its guide nothing breaks and nothing complains: passes keep running, syncs keep succeeding, and the guide gets a day shorter every day until what you wanted is past the end of it. CouchElephant checks every sync, and sends what it finds to Discord, Telegram or Notifiarr. Discord needs no bot, just a webhook URL from your own channel. Add as many destinations as you like and choose which events reach which one, so faults can go to one channel and recordings to another.

It can also follow something the guide has not heard of yet. Plex's guide reaches about twelve days, and no guide source anywhere reaches much further, because no broadcaster has decided that far out. So a series announced for next spring, or the rest of your team's season, has no guide row to match. CouchElephant holds the intention, shows what it is waiting for, and turns it into a real recording the moment Plex's guide carries an airing. Nothing outside the guide ever books anything. Announced series come from TVmaze and a team's published season comes from TheSportsDB. Neither needs a key or an account, so a followed team fills in its whole season, months ahead, out of the box.

Point it at your Plex server under Settings and nothing else is required. A new install starts in preview mode: it shows which airing each rule would take without writing anything to your DVR, so you can see it is right before you let it near the recorder.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8710]/";s:11:"TemplateURL";s:91:"https://raw.githubusercontent.com/datbird/unraid-templates/main/templates/couchelephant.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/datbird/unraid-templates/main/icons/couchelephant.png";s:10:"Screenshot";a:10:{i:0;s:87:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/guide-dark.png";i:1;s:88:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/guide-light.png";i:2;s:90:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/program-panel.png";i:3;s:91:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/record-options.png";i:4;s:83:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/passes.png";i:5;s:89:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/add-schedule.png";i:6;s:89:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/smart-filter.png";i:7;s:99:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/settings-notifications.png";i:8;s:92:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/schedule-agenda.png";i:9;s:90:"https://raw.githubusercontent.com/datbird/couchelephant/main/docs/images/settings-plex.png";}s:16:"ExtraSearchTerms";s:35:"plex dvr recording sports guide epg";s:8:"Requires";s:161:"A Plex Media Server with a DVR and a tuner already set up. CouchElephant does not need to run on the same machine as Plex, and it never touches your media files.";s:7:"License";s:3:"MIT";s:6:"Config";a:3:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8710";s:7:"Default";s:4:"8710";s:4:"Mode";s:3:"tcp";s:11: