ed/issues";s:7:"Project";s:43:"https://github.com/pumpkinpieman/FarFetched";s:8:"Overview";s:529:"FarFetched is a self-hosted browser and paced downloader for free 3D models from Printables, plus a local library organizer for files you have already downloaded from other sources. Browse by category, queue STL/3MF files or whole-model ZIPs, and a background worker saves them to disk at a polite, configurable pace. Authentication is paste-once: drop in your Printables refresh-token cookie under Settings and the app keeps your session alive automatically (you'll only re-paste roughly monthly). Open the WebUI to get started.";s:5:"WebUI";s:30:"http://[IP]:[PORT:80]/home.php";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/pumpkinpieman/farfetched/main/deploy/farfetched.xml";s:4:"Icon";s:79:"https://raw.githubusercontent.com/pumpkinpieman/FarFetched/main/assets/icon.png";s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:2:"80";s:7:"Default";s:4:"8088";s:4:"Mode";s:3:"tcp";s:11:"Description";s:82:"Host port for the FarFetched web interface. Change this to any free port you like.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8088";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Downloads (models)";s:6:"Target";s:10:"/downloads";s:7:"Default";s:26:"/mnt/user/Downloads/models";s:4:"Mode";s:2:"rw";s:11:"Description";s:98:"Host folder where downloaded models are saved (per-source subfolders: printables/, stlflix/, ...).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/Downloads/models";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"App Data (token, db, logs)";s:6:"Target";s:21:"/var/www/html/private";s:7:"Default";s:36:"/mnt/user/appdata/farfetched/private";s:4:"Mode";s:2:"rw";s:11:"Description";s:113:"Persistent storage for the Printables session token, the SQLite queue, and logs. Keep this stable across updates.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:36:"/mnt/user/appdata/farfetched/private";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:28:"Pace (seconds between files)";s:6:"Target";s:22:"FETCHER_DOWNLOAD_DELAY";s:7:"Default";s:3:"120";s:11:"Description";s:87:"Seconds the worker waits between file downloads. 120 is polite; lower at your own risk.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:27:"Download Dir (in container)";s:6:"Target";s:20:"FETCHER_DOWNLOAD_DIR";s:7:"Default";s:10:"/downloads";s:11:"Description";s:106:"Where the worker writes inside the container. Leave as /downloads unless you know why you are changing it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"/downloads";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/deploy/farfetched.xml";s:4:"Repo";s:26:"PumpkinPieMan's Repository";s:12:"CategoryList";a:2:{i:0;s:11:"Downloaders";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1781214628;s:8:"Category";s:28:"Downloaders: Tools:Utilities";s:2:"ID";i:4245;s:11:"Displayable";b:1;s:6:"Author";s:13:"pumpkinpieman";s:13:"DockerHubName";s:10:"farfetched";s:8:"RepoName";s:26:"PumpkinPieMan's Repository";s:10:"SortAuthor";s:13:"pumpkinpieman";s:8:"SortName";s:10:"FarFetched";s:6:"random";i:1834740720;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:123:"/tmp/community.applications/tempFiles/templates-community-apps/PumpkinPieMansRepository/pumpkinpieman-FarFetched-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4246;a:31:{s:4:"Name";s:11:"Sygil-webui";s:10:"Repository";s:20:"hlky/sd-webui:latest";s:8:"Registry";s:45:"https://hub.docker.com/r/tukirito/sygil-webui";s:7:"Support";s:52:"https://github.com/Sygil-Dev/sygil-webui/discussions";s:7:"Project";s:41:"https://github.com/Sygil-Dev/sygil-webui/";s:11:"TemplateURL";s:78:"https://raw.githubusercontent.com/pyrater/docker-templates/master/sd-webui.xml";s:4:"Icon";s:63:"https://github.com/pyrater/docker-templates/raw/master/hlky.png";s:12:"TemplatePath";s:32:"/tmp/GitHub/AppFeed/sd-webui.xml";s:4:"Repo";s:20:"pyrater's Repository";s:4:"Beta";s:4:"true";s:9:"Blacklist";b:1;s:16:"ModeratorComment";s:32:"Blacklisted: Unable to be pulled";s:8:"Overview";s:1318:"/**/ THIS DOCKER TAKES A LONG TIME TO BOOT THE FIRST TIME SEE LOG FOR OUTPUT /**/

Streamlit ui for Stable Diffusion: https://github.com/sd-webui/stable-diffusion-webui/
This now includes all models:

SD v1-4 (ckpt)
Waifu Diffusion (ckpt)
TrinArt (ckpt)
ViT-L-14 (pytorch.bin, used by inference models, is usually ~1.8gb autodownload to ~/.cache/huggingface/transformers)
SD v1-4 (diffusers, used by txt2vid and textual inversion training)
BLIP
CLIP models: ViT-L-14, ViT-H-14, ViT-g-14, used by img2txt
sd-concepts-library: (nearly) 600 pre-trained concepts to use in prompts, autoloaded when the placeholder is used in the prompt.
GFPGAN v1.4 (and other weights that would normally be autodownloaded, detection_Resnet50_Final.pth and parsing_parsenet.pth, ~185MB)
RealESRGAN: RealESRGAN_x4plus and RealESRGAN_x4plus_anime_6B
Latent Diffusion Super Resolution (LDSR)
Notes:

Most models will unload when you use something else, atm there is a config option for img2txt.keep_all_models_loaded: False if you set this to True img2txt models (the CLIP ones, BLIP stays loaded unless you have optimized mode available) will all stay loaded, by default if a model that is loaded is no longer selected it will be unloaded
volume path now mirrors the repo so is /sd/outputs instead of /sd/user_data/outputs";s:9:"FirstSeen";i:1668348524;s:14:"LastUpdateScan";i:1777634041;s:12:"CategoryList";a:0:{}s:8:"Category";s:6:"Other:";s:2:"ID";i:4246;s:11:"Displayable";b:1;s:6:"Author";s:4:"hlky";s:13:"DockerHubName";s:11:"sygil-webui";s:8:"RepoName";s:20:"pyrater's Repository";s:10:"SortAuthor";s:4:"hlky";s:8:"SortName";s:11:"Sygil webui";s:6:"random";i:248459475;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:108:"/tmp/community.applications/tempFiles/templates-community-apps/pyratersRepository/hlky-Sygilwebui-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;}i:4247;a:38:{s:4:"Name";s:5:"StaXX";s:9:"PluginURL";s:62:"https://raw.githubusercontent.com/quadcom/Staxx/main/staxx.plg";s:7:"Support";s:27:"https://staxxfb.quadcom.ca/";s:7:"Project";s:32:"https://github.com/quadcom/Staxx";s:8:"Overview";s:1217:"StaXX is in beta: the core is settled and in daily use, but expect the occasional rough edge, and read the changelog before pressing update.
    [br][br]
    StaXX manages your Docker containers with standard compose files instead of Unraid's own
    template format, and draws those compose files as an ordinary form so you never have to edit
    indented text.
    [br][br]
    Nearly every project publishes a compose file. StaXX takes one as it is, runs it, and shows its
    settings — ports, folders, variables, health checks, start-up order — as boxes you can change,
    with the author's own comments as the help text beside them. The file underneath stays a plain
    compose file that still runs anywhere.
    [br][br]
    It also brings in what you already run: your existing Unraid apps, Compose Manager projects and
    loose containers are imported as copies, with the originals left untouched. Built-in search
    covers Community Applications, Docker Hub and the images already on your server, and shows you
    the compose file before anything starts. Every save is kept and every image that has run is
    kept, so a change can always be undone.
    [br][br]
    Requires Unraid 7.2.0 or newer.";s:4:"Icon";s:72:"https://raw.githubusercontent.com/quadcom/Staxx/main/Logo/staxx-icon.svg";s:4:"Beta";s:4:"true";s:6:"MinVer";s:5:"7.2.0";s:6:"ReadMe";s:39:"https://github.com/quadcom/Staxx#readme";s:10:"Screenshot";a:3:{i:0;s:84:"https://raw.githubusercontent.com/quadcom/Staxx/main/docs/images/stacks-overview.png";i:1;s:81:"https://raw.githubusercontent.com/quadcom/Staxx/main/docs/images/editor-split.jpg";i:2;s:80:"https://raw.githubusercontent.com/quadcom/Staxx/main/docs/images/apps-search.jpg";}s:11:"TemplateURL";s:62:"https://raw.githubusercontent.com/quadcom/Staxx/main/staxx.xml";s:12:"TemplatePath";s:29:"/tmp/GitHub/AppFeed/staxx.xml";s:4:"Repo";s:20:"Quadcom's Repository";s:10:"Repository";s:62:"https://raw.githubusercontent.com/quadcom/Staxx/main/staxx.plg";s:12:"CategoryList";a:2:{i:0;s:12:"Tools-System";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:8:"00.05.01";s:6:"Author";N;s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:120;s:9:"FirstSeen";i:1788558042;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:19;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:101;s:1:"T";i:120;}s:8:"Category";s:21:"Tools:System Plugins:";s:2:"ID";i:4247;s:11:"Displayable";b:1;s:13:"DockerHubName";s:5:"staxx";s:8:"RepoName";s:20:"Quadcom's Repository";s:10:"SortAuthor";N;s:8:"SortName";s:5:"StaXX";s:6:"random";i:571463220;s:9:"Blacklist";b:0;s:4:"Path";s:149:"/tmp/community.applications/tempFiles/templates-community-apps/QuadcomsRepository/-StaXX-//raw.githubusercontent.com/quadcom/Staxx/main/staxx.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4248;a:38:{s:4:"Name";s:9:"Acestream";s:10:"Repository";s:27:"vstavrinov/acestream-engine";s:8:"Registry";s:52:"https://hub.docker.com/r/vstavrinov/acestream-engine";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:1