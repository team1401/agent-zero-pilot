zsRepository/junkerderprovinz-JuiceFS-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2776;a:39:{s:4:"Name";s:12:"KnightLoader";s:10:"Repository";s:36:"junkerderprovinz/knightloader:latest";s:8:"Registry";s:54:"https://hub.docker.com/r/junkerderprovinz/knightloader";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:77:"https://forums.unraid.net/topic/200895-support-junkerderprovinz-knightloader/";s:7:"Project";s:48:"https://github.com/junkerderprovinz/knightloader";s:6:"ReadMe";s:68:"https://github.com/junkerderprovinz/knightloader/blob/main/README.md";s:8:"Overview";s:605:"A download manager that downloads everything and kneels to nothing.

Hosters, debrid services, torrents, Usenet, videos and streams all land in one place. It runs as a container on your server and as a desktop app on Windows, macOS and Linux, and the Android app and the browser extension send it links from wherever you are. They all find each other with the twelve words KnightLoader shows you on its first start, without an account, a domain or a port forward.

Free, no ads, no account, and nothing about you leaves your server. Set a password under Settings, Security before anyone else can reach it.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8749]/";s:11:"TemplateURL";s:97:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/knightloader/knightloader.xml";s:4:"Icon";s:93:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/knightloader/icon.png?v=2";s:11:"ExtraParams";s:38:"--restart unless-stopped --user 99:100";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8749";s:7:"Default";s:4:"8749";s:4:"Mode";s:3:"tcp";s:11:"Description";s:156:"The port of the web interface. Until a password is set under Settings, Security, anyone who can reach it can use it, so do not forward it from the internet.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8749";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:30:"/mnt/user/appdata/knightloader";s:4:"Mode";s:2:"rw";s:11:"Description";s:77:"The database, the settings, the encrypted accounts and the list of instances.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/knightloader";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Downloads";s:6:"Target";s:15:"/data/downloads";s:7:"Default";s:19:"/mnt/user/downloads";s:4:"Mode";s:2:"rw";s:11:"Description";s:100:"Where downloads land. The download folder in Settings is /data/downloads unless you change it there.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/mnt/user/downloads";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Unraid shares";s:6:"Target";s:9:"/mnt/user";s:7:"Default";s:9:"/mnt/user";s:4:"Mode";s:2:"rw";s:11:"Description";s:298:"Every share of this server, at the same path as on Unraid. The folder chooser in Settings then lists them under /mnt/user, so the download folder can be any share, for example /mnt/user/downloads. KnightLoader can then write to every share. Clear this path to keep it to the Downloads folder above.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"/mnt/user";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"App key";s:6:"Target";s:10:"KL_APP_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:359:"64 hexadecimal characters. Open a terminal, run openssl rand -hex 32 and paste the result here. The password hash, the stored accounts and tokens and the backups you download are then sealed with it, so a copy of the appdata folder opens nothing. Keep it with your other passwords: KnightLoader does not start on sealed data with a different key or with none.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Watched folder";s:6:"Target";s:6:"/watch";s:7:"Default";s:38:"/mnt/user/downloads/knightloader-watch";s:4:"Mode";s:2:"rw";s:11:"Description";s:195:"Drop a .txt link list, a .magnet, a .crawljob, a .torrent, a .dlc, .ccf or .rsdf container or an .nzb here and KnightLoader takes it. Set the watched folder in Settings to /watch to switch it on.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:38:"/mnt/user/downloads/knightloader-watch";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Base path";s:6:"Target";s:12:"KL_BASE_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:190:"Only for a reverse proxy that serves KnightLoader in a folder of another host name, for example /kl for https://example.com/kl/. Leave it empty for a host name of its own or the LAN address.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"File permission mask";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:272:"The umask for every file and folder KnightLoader creates. With 000, downloads land as nobody:users with mode 0666 and folders with 0777, the way an Unraid share expects, so the account you use over SMB can move, rename and delete them. Set 022 for restrictive permissions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:49:"/tmp/GitHub/AppFeed/knightloader/knightloader.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"Downloaders";}s:9:"downloads";i:4118;s:9:"FirstSeen";i:1791953108;s:10:"LastUpdate";i:1791931158;s:14:"LastUpdateScan";i:1791953108;s:8:"Category";s:12:"Downloaders:";s:2:"ID";i:2776;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:12:"knightloader";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:12:"KnightLoader";s:6:"random";i:1202219777;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:131:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-KnightLoader-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2777;a:45:{s:4:"Name";s:8:"Krusader";s:10:"Repository";s:32:"junkerderprovinz/krusader:latest";s:8:"Registry";s:50:"https://hub.docker.com/r/junkerderprovinz/krusader";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:6:"ReadMe";s:64:"https://github.com/junkerderprovinz/krusader/blob/main/README.md";s:7:"Support";s:73:"https://forums.unraid.net/topic/198816-support-junkerderprovinz-krusader/";s:7:"Project";s:20:"https://krusader.org";s:8:"Overview";s:1997:"Krusader file manager with native Dark Mode, running on a hardware-accelerated Selkies web desktop. It responds much faster than the noVNC-based Krusader containers (binhex / jlesage / ich777).

What's pre-configured:
• Dark Mode theme for Krusader, Kate and KDE
• Kate as Krusader's external editor
• Kompare for "File → Compare by Content" (side-by-side diff)
• Closing Krusader in the browser starts a fresh one instead of a black screen
• RAR support: right-click → "Extract RAR here" / "to subfolder"
• 7z, ZIP, TAR, GZ, BZ2, XZ, LHA, ARJ, ACE, RPM, CPIO
• Selectable UI language: 33 languages incl. German, English, French, Spanish, Italian, Portuguese (PT/BR), Dutch, Catalan, Basque, Irish, Danish, Swedish, Norwegian, Finnish, Icelandic, Polish, Czech, Slovak, Hungarian, Romanian, Slovenian, Croatian, Serbian, Bulgarian, Ukrainian, Russian, Greek, Turkish, Hebrew, Arabic, Japanese, Korean, Chinese (CN/TW)
• Spell-checking in Kate for ~25 languages via Hunspell

Notes:
• The /storage volume defaults to /mnt, which gives Krusader access to all shares (/mnt/user) and individual disks (/mnt/disk*).
• WebUI opens via HTTPS on port 3001 (self-signed cert, accept it once). The Selkies web client requires a secure connection, so open the WebUI directly over HTTPS (3001) only. Port 3000 (HTTP) is for a reverse proxy that terminates TLS in front of the container. Opened directly in a browser, it shows a "requires a secure connection (HTTPS)" error and does not load.
• PUID/PGID default to 99/100 (nobody/users on Unraid).
• Memory: the desktop follows your browser window, so there is no screen size to set and RAM only grows with the window you actually use.
• Auth: leave "WebUI Username" and "Password" empty to run without login. Set both to enable HTTP-basic auth on the WebUI, which is recommended whenever the container is reachable from anything beyond your LAN.

Source on GitHub: https://github.com/junkerderprovinz/krusader";s:5:"WebUI";s:25:"https://[IP]:[PORT:3001]/";s:11:"TemplateURL";s:89:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/krusader/krusader.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/krusader/icon.png";s:11:"ExtraParams";s:39:"--restart=unless-stopped --shm-size=1gb";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"WebUI Port (HTTPS / Selkies)";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:180:"HTTPS port of the Selkies WebUI (self-signed cert). This is the default WebUI, because the browser only allows clipboard access over HTTPS. Accept the self-signed certificate once.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"WebUI Port (HTTP / Selkies)";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:311:"HTTP port of the Selkies WebUI. For a reverse proxy that terminates TLS in front of the container, not for direct browser access: the Selkies web client requires a secure context, so opening http://IP:3000 directly shows a 'requires a secure connection (HTTPS)' error. For direct access use the HTTPS port 3001.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"AppData (/config)";s:6:"Target";s:7:"/config";s:7:"Default";s:26:"/mnt/user/appdata/krusader";s:4:"Mode";s:2:"rw";s:11:"Description";s:68:"Persistent Krusader configs, history, bookmarks, default-files lock.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/krusader";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Storage (/storage)";s:6:"Target";s:8:"/storage";s:7:"Default";s:4:"/mnt";s:4:"Mode";s:8:"rw,slave";s:11:"Description";s:158:"Main path for file operations. Default /mnt gives access to all shares (/mnt/user) and individual disks (/mnt/disk*). Adjust if you only need specific shares.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"/mnt";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"UI Language (KRUSADER_LANG)";s:6:"Target";s:13:"KRUSADER_LANG";s:7:"Default";s:606:"de = Deutsch|en = English|en_gb = English (UK)|fr = Français|es = Español|it = Italiano|pt = Português|pt_br = Português (Brasil)|nl = Nederlands|ca = Català|eu = Euskara|ga = Gaeilge|da = Dansk|sv = Svenska|nb = Norsk (Bokmål)|fi = Suomi|is = Íslenska|pl = Polski|cs = Čeština|sk = Slovenčina|hu = Magyar|ro = Română|sl = Slovenščina|hr = Hrvatski|sr = Srpski|bg = Български|uk = Українська|ru = Русский|el = Ελληνικά|tr = Türkçe|he = עברית|ar = العربية|ja = 日本語|ko = 한국어|zh = 中文|zh_tw = 中文 (繁體)|system = System default";s:4:"Mode";s:0:"";s:11:"Description";s:291:"Language for the Krusader / Kate UI (33 languages). It also sets the date and number format: 'en' gives US dates, 'en_gb' gives UK dates. The container reads the leading code, so the full label is fine as a value. Pick 'system' for the container default. Re-applied on every container start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"de = Deutsch";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Theme (KRUSADER_THEME)";s:6:"Target";s:14:"KRUSADER_THEME";s:7:"Default";s:10:"dark|light";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Color scheme. 'dark' = Dark Mode, 'light' = Breeze.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"dark";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"Keyboard Layout (KEYBOARD_LAYOUT)";s:6:"Target";s:15:"KEYBOARD_LAYOUT";s:7:"Default";