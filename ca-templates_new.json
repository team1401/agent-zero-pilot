s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Disabled Checks";s:6:"Target";s:19:"API_DISABLED_CHECKS";s:7:"Default";s:0:"";s:11:"Description";s:61:"Optional comma-separated list of Web-Check checks to disable.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:14:"Enabled Checks";s:6:"Target";s:18:"API_ENABLED_CHECKS";s:7:"Default";s:0:"";s:11:"Description";s:62:"Optional comma-separated list of checks to enable exclusively.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:13:"Blocked Hosts";s:6:"Target";s:17:"API_BLOCKED_HOSTS";s:7:"Default";s:0:"";s:11:"Description";s:82:"Optional comma-separated list of hosts or networks that Web-Check must never scan.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:11:"Trust Proxy";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:0:"";s:11:"Description";s:109:"Optional proxy trust configuration when Web-Check is running behind a reverse proxy such as Traefik or Nginx.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/web-check.xml";s:4:"Repo";s:20:"MikaPST's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:7:"Support";s:0:"";s:16:"ChangeLogPresent";s:1:"1";s:5:"stars";i:23;s:9:"downloads";i:3055923;s:9:"FirstSeen";i:1790338240;s:10:"LastUpdate";i:1787871964;s:14:"LastUpdateScan";i:1790338240;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:880;s:11:"Displayable";b:1;s:6:"Author";s:7:"lissy93";s:13:"DockerHubName";s:9:"web-check";s:8:"RepoName";s:20:"MikaPST's Repository";s:10:"SortAuthor";s:7:"lissy93";s:8:"SortName";s:9:"web check";s:6:"random";i:453392660;s:9:"Blacklist";b:0;s:4:"Path";s:109:"/tmp/community.applications/tempFiles/templates-community-apps/MikaPSTsRepository/lissy93-webcheck-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:881;a:39:{s:4:"Name";s:9:"stockinfo";s:10:"Repository";s:26:"mangolila/stockinfo:latest";s:8:"Registry";s:44:"https://hub.docker.com/r/mangolila/stockinfo";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:48:"https://github.com/MikeMitterer/stockinfo/issues";s:7:"Project";s:41:"https://github.com/MikeMitterer/stockinfo";s:8:"Overview";s:2172:"StockInfo provides stock and ETF quotes via a REST API (JSON), caches them in a SQLite database and refreshes them periodically. Backend (FastAPI) and dashboard (Vue) run in a single image on one port — the dashboard is served at the root URL, the API under /quote, /instruments, etc. Default data sources: yfinance (Yahoo), justETF, OpenFIGI. Sources are configurable in sources.yaml and can be replaced by plugins.[br][br]No official APIs: the default sources justETF and Yahoo Finance do not offer a public API for this data. StockInfo reads their public web pages through the open-source libraries justetf-scraping and yfinance. Whoever runs StockInfo is responsible for using the configured sources in line with the providers&apos; terms.[br][br]Do not put StockInfo on the internet. It has no login — anyone who can reach it can change or delete your data. Use it only in your home network. From outside, connect to your home network with a VPN, for example WireGuard or Tailscale.[br][br]Whatever the sources do not deliver can be entered by hand in the expandable detail area of a row — provider, replication, fund size, domicile, currency, TER, volatility and accumulating/distributing. The source always wins: a manual value fills a gap, it never overwrites, and it applies again as soon as the source goes quiet.[br][br]Timezone: the "Timezone" setting (TZ) defaults to UTC — set it to your local zone for correct log timestamps. Valid values (TZ identifier column): https://en.wikipedia.org/wiki/List_of_tz_database_time_zones[br][br]OpenFIGI (optional): resolves an ISIN to the ticker at your preferred exchange (see "Default exchange"). It works without an API key, but only within OpenFIGI&apos;s low anonymous rate limit — once exceeded, resolution falls back to Yahoo search, which may return a different exchange or currency. A free key raises the limit and makes resolution reliable; enter it under "OpenFIGI API key". Register and create a key: https://www.openfigi.com/api[br][br]Support: StockInfo is built for its author&apos;s own use and shared free of charge. Issues are read, but there is no promise of a reply, a fix or a new feature.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:11:"TemplateURL";s:94:"https://raw.githubusercontent.com/MikeMitterer/unraid-templates/master/templates/stockinfo.xml";s:4:"Icon";s:99:"https://raw.githubusercontent.com/MikeMitterer/stockinfo/master/dashboard/public/stockinfo-icon.png";s:10:"Screenshot";a:3:{i:0;s:96:"https://raw.githubusercontent.com/MikeMitterer/stockinfo/master/unraid/screenshots/dashboard.png";i:1;s:98:"https://raw.githubusercontent.com/MikeMitterer/stockinfo/master/unraid/screenshots/detail-area.png";i:2;s:94:"https://raw.githubusercontent.com/MikeMitterer/stockinfo/master/unraid/screenshots/swagger.png";}s:7:"License";s:8:"EUPL-1.2";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8000";s:7:"Default";s:4:"8000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:170:"Host port for dashboard + API (container listens internally on 8000). StockInfo has no login: never open this port on your router; use it in your home network or via VPN.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Data (Cache DB)";s:6:"Target";s:5:"/data";s:7:"Default";s:27:"/mnt/user/appdata/stockinfo";s:4:"Mode";s:2:"rw";s:11:"Description";s:69:"Persistent path for the SQLite cache DB (survives container updates).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/stockinfo";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Refresh interval (hours)";s:6:"Target";s:22:"REFRESH_INTERVAL_HOURS";s:7:"Default";s:1:"6";s:4:"Mode";s:0:"";s:11:"Description";s:63:"Interval of the periodic background refresh of all instruments.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"6";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Cache TTL (hours)";s:6:"Target";s:15:"CACHE_TTL_HOURS";s:7:"Default";s:1:"6";s:4:"Mode";s:0:"";s:11:"Description";s:46:"Age at which a quote is re-fetched on request.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"6";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Metadata TTL (days)";s:6:"Target";s:17:"METADATA_TTL_DAYS";s:7:"Default";s:1:"7";s:4:"Mode";s:0:"";s:11:"Description";s:51:"Refresh cycle for ETF metadata (TER, provider …).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"7";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Default exchange (MIC)";s:6:"Target";s:16:"DEFAULT_EXCHANGE";s:7:"Default";s:4:"XETR";s:4:"Mode";s:0:"";s:11:"Description";s:249:"Preferred exchange (MIC) for ISIN lookups — worldwide. Examples: XETR (Xetra/EUR), XNAS (Nasdaq/USD), XNYS (NYSE/USD), XTSE (Toronto/CAD), XLON (London/GBp), XTKS (Tokyo/JPY), XASX (Sydney/AUD). The quote currency follows from the chosen exchange.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"XETR";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Strict exchange";s:6:"Target";s:15:"STRICT_EXCHANGE";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:250:"If true, only the Default exchange is used — no Yahoo fallback. An ISIN with no listing there returns 404 instead of a substitute exchange/currency. Recommended for non-EUR instances that want honest &quot;not available&quot; over a wrong currency.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"FX rate TTL (hours)";s:6:"Target";s:12:"FX_TTL_HOURS";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:147:"Age at which a foreign-exchange rate (GET /fx, used to convert mixed-currency portfolios) is re-fetched. FX moves continuously — keep this short.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"OpenFIGI API key";s:6:"Target";s:16:"OPENFIGI_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:64:"Optional key for a higher OpenFIGI rate limit (empty = without).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:3:"UTC";s:4:"Mode";s:0:"";s:11:"Description";s:115:"Container timezone for log timestamps. Default UTC — set your local zone, e.g. Europe/Vienna or America/New_York.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"UTC";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/stockinfo.xml";s:4:"Repo";s:34:"UnraidUser-3287583290's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:12:"Productivity";}s:9:"downloads";i:1528;s:9:"FirstSeen";i:1784733520;s:10:"LastUpdate";i:1787138636;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:29:"Tools:Utilities Productivity:";s:2:"ID";i:881;s:11:"Displayable";b:1;s:6:"Author";s:9:"mangolila";s:13:"DockerHubName";s:9:"stockinfo";s:8:"RepoName";s:34:"UnraidUser-3287583290's Repository";s:10:"SortAuthor";s:9:"mangolila";s:8:"SortName";s:9:"stockinfo";s:6:"random";i:1696534447;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/UnraidUser3287583290sRepository/mangolila-stockinfo-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:882;a:40:{s:4:"Name";s:14:"stockportfolio";s:10:"Repository";s:31:"mangolila/stockportfolio:latest";s:8:"Registry";s:49:"https://hub.docker.com/r/mangolila/stockportfolio";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:53:"https://github.com/MikeMitterer/stockportfolio/issues";s:7:"Project";s:46:"https://github.com/MikeMitterer/stockportfolio";s:8:"Overview";s:2005:"Portfolio management with market data, valuation, charts and tolerance-band rebalancing in your browser. Quotes, asset types and price history come from a separate StockInfo API. Trade plans are simulations; no orders are placed.[br][br]Network access: Do not put StockPortfolio or StockInfo on the internet. Use both only in your home network. From outside, connect to your home network with a VPN, for example WireGuard or Tailscale. StockPortfolio forwards StockInfo requests only for signed-in users, but its login does not protect StockInfo's own address: anyone who reaches that address can use StockInfo.[br][br]The StockPortfolio API keeps accounts, sessions and private portfolios in the persistent /data directory. On first start, read the one-time setup code from the container log and create the first admin in the browser. Each account, including another admin, has its own portfolios; the same account loads them in another browser. Export individual backups under Settings - Backup and back up /data. Old browser portfolios require an explicit one-time import by the setup account. Keep the /data mapping stable when updating.[br][br]Set STOCKINFO_API_URL to an address reachable from this container, such as the server LAN address or the StockInfo container name on a shared custom network. The browser only talks to StockPortfolio; StockInfo needs no CORS setting for it. If a reverse proxy in your home network serves the app over HTTPS, set the exact public origin and enable secure cookies. Behind a reverse proxy, pass the live update stream /api/data/events without buffering and keep its idle timeout above the 15-second keep-alive interval.[br][br]The container serves the web app and account API on port 8080 without root privileges. Older images used port 80: update existing port mappings when upgrading.[br][br]Support: StockPortfolio is built for its author&apos;s own use and shared free of charge. Issues are read, but there is no promise of a reply, a fix or a new feature.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:99:"https://raw.githubusercontent.com/MikeMitterer/unraid-templates/master/templates/stockportfolio.xml";s:4:"Icon";s:108:"https://raw.githubusercontent.com/MikeMitterer/stockportfolio/master/frontend/public/stockportfolio-icon.png";s:10:"Screenshot";a:4:{i:0;s:94:"https://raw.githubusercontent.com/MikeMitterer/stockportfolio/master/docs/images/dashboard.png";i:1;s:96:"https://raw.githubusercontent.com/MikeMitterer/stockportfolio/master/docs/images/rebalancing.png";i:2;s:90:"https://raw.githubusercontent.com/MikeMitterer/stockportfolio/master/docs/images/login.png";i:3;s:95:"https://raw.githubusercontent.com/MikeMitterer/stockportfolio/master/docs/images/user-admin.png";}s:7:"License";s:8:"EUPL-1.2";s:8:"Requires";s:60:"A StockInfo API reachable from the StockPortfolio container.";s:6:"Config";a:6:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8088";s:4:"Mode";s:3:"tcp";s:11:"Description";s:210:"Host port for the web app. The container listens on 8080. Keep the host address and port stable to retain the browser storage origin. Never open this port on your router; use it in your home network or via VPN.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8088";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"StockInfo API";s:6:"Target";s:17:"STOCKINFO_API_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:204:"URL of your StockInfo API, reachable from this container (for example http://192.168.1.10:8000 or https://stockinfo.example.com). Required; no built-in public API. Restart the container after changing it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"App data";s:6:"Target";s:5:"/data";s:7:"Default";s:32:"/mnt/user/appdata/stockportfolio";s:4:"Mode";s:2:"rw";s:11:"Description";s:144:"Persistent SQLite data for StockPortfolio accounts, sessions and private portfolios. Back up this directory and keep the mapping during updates.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:32:"/mnt/user/appdata/stockportfolio";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Public origin";s:6:"Target";s:28:"STOCKPORTFOLIO_PUBLIC_ORIGIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:158:"Exact browser origin, including scheme and port, when using a reverse proxy (for example https://portfolio.example.com). No path; a trailing slash is ignored.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Secure c