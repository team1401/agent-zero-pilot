776300;s:14:"LastUpdateScan";i:1790645917;s:8:"Category";s:34:"Network:Management Tools:Utilities";s:2:"ID";i:651;s:11:"Displayable";b:1;s:6:"Author";s:9:"jsonbored";s:13:"DockerHubName";s:10:"signoz-aio";s:8:"RepoName";s:22:"JSONbored's Repository";s:10:"SortAuthor";s:9:"jsonbored";s:8:"SortName";s:10:"signoz aio";s:6:"random";i:230115461;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/JSONboredsRepository/jsonbored-signozaio-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:165:"If these AIO templates save you time, please consider supporting ongoing maintenance via Ko-fi (ko-fi.com/jsonbored) or Buy Me a Coffee (buymeacoffee.com/jsonbored).";s:10:"DonateLink";s:27:"https://ko-fi.com/jsonbored";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:652;a:46:{s:4:"Name";s:15:"simplelogin-aio";s:10:"Repository";s:32:"jsonbored/simplelogin-aio:latest";s:8:"Registry";s:50:"https://hub.docker.com/r/jsonbored/simplelogin-aio";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:51:"https://github.com/JSONbored/simplelogin-aio/issues";s:7:"Project";s:44:"https://github.com/JSONbored/simplelogin-aio";s:8:"Overview";s:1887:"SimpleLogin is an open-source email alias platform that lets you shield your real inbox behind forwarding aliases.

[b]All-In-One Unraid Edition[/b]
`simplelogin-aio` packages the web UI, background jobs, inbound email handler, Postfix, PostgreSQL, and Redis into one Unraid-first container with persistent appdata paths.

[b]Quick Install (Beginners)[/b]
1. Install this template in Unraid.
2. Set [code]URL[/code], [code]EMAIL_DOMAIN[/code], [code]SUPPORT_EMAIL[/code], and [code]FLASK_SECRET[/code].
3. Registration is disabled by default for safety. Temporarily set [code]DISABLE_REGISTRATION[/code] to [code]false[/code] only if you need web sign-up for first boot, then switch it back to [code]true[/code] and restart.
4. Choose an outbound relay mode if your ISP blocks outbound TCP 25.
5. Forward inbound TCP 25 from your router/firewall to the Unraid host if you want internet mail delivery.
6. Start the container, wait for first boot to finish, then add the required DNS records from the setup guide.

[b]Power Users (Advanced View)[/b]
- Advanced View exposes the full official upstream self-hosting environment surface plus wrapper-specific relay and AIO controls.
- Leave defaults in place for the easiest install. Only set overrides you actually need.
- You can point the app at external PostgreSQL or Redis, customize alias domain behavior, enable SSO providers, tune anti-spam and analytics integrations, and provide custom asset/key files through the optional [code]/custom-assets[/code] mount.

[b]Important Notes[/b]
- Current upstream packaging is [code]linux/amd64[/code] only.
- This is still a real self-hosted mail stack. DNS, deliverability, router/firewall port forwarding, and sender reputation still matter.
- For the simplest operation, keep the internal Postgres/Redis/Postfix defaults and only set the small required config set above.";s:5:"WebUI";s:23:"http://[IP]:[PORT:7777]";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/simplelogin-aio.xml";s:6:"ReadMe";s:51:"https://github.com/JSONbored/simplelogin-aio#readme";s:4:"Icon";s:86:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/icons/simplelogin.jpeg";s:16:"ExtraSearchTerms";s:72:"email alias privacy forwarding self-hosted proton mail postfix smtp dkim";s:8:"Requires";s:205:"**For full inbound mail delivery:** a public domain, correct DNS records, and inbound TCP 25 forwarded to your Unraid host. If outbound TCP 25 is blocked, use an SMTP relay mode instead of direct delivery.";s:10:"Screenshot";a:3:{i:0;s:104:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/simplelogin-aio/01-login.png";i:1;s:108:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/simplelogin-aio/02-dashboard.png";i:2;s:107:"https://raw.githubusercontent.com/JSONbored/awesome-unraid/main/screenshots/simplelogin-aio/03-settings.png";}s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:190:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Appdata Directory";s:6:"Target";s:8:"/appdata";s:7:"Default";s:33:"/mnt/user/appdata/simplelogin-aio";s:4:"Mode";s:2:"rw";s:11:"Description";s:114:"Primary persistent directory for PostgreSQL, Redis, DKIM keys, uploads, generated JWT keys, and application state.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/simplelogin-aio";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"PGP Keyring Directory";s:6:"Target";s:4:"/pgp";s:7:"Default";s:37:"/mnt/user/appdata/simplelogin-aio/pgp";s:4:"Mode";s:2:"rw";s:11:"Description";s:91:"Persistent directory for your GnuPG keyring and optional server-generated PGP signing ke