//github.com/matter-js/matterjs-server/blob/main/docs/docker.md";s:11:"TemplateURL";s:112:"https://raw.githubusercontent.com/raccommode/Raccommode-Unraid-Community-Apps/main/templates/matterjs-server.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/matter-js/matterjs-server/main/docs/matter_logo.svg";s:8:"Requires";s:826:"This template uses host networking because Matter device discovery relies on mDNS and link-local traffic. The server binds to all interfaces by default, so protect access with your LAN, firewall, VPN, or reverse proxy, or set Listen Address to a specific IP. The upstream Docker image runs unprivileged by default, but this Unraid template uses --user=0:0 so it can create /data/config and other persistent folders in appdata paths created with restrictive ownership. The image is a drop-in replacement for Python Matter Server, but back up existing data before migration and do not run both servers against the same data directory. For BLE commissioning through the host Bluetooth stack, mount Host D-Bus and set Noble Bindings to dbus; raw HCI access usually requires elevated privileges and is not enabled by this template.";s:7:"License";s:10:"Apache-2.0";s:6:"Config";a:15:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"5580";s:7:"Default";s:4:"5580";s:4:"Mode";s:3:"tcp";s:11:"Description";s:136:"Matter.js Server dashboard and WebSocket API port. With host networking, keep this aligned with the PORT variable. Container port: 5580.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5580";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:33:"/mnt/user/appdata/matterjs-server";s:4:"Mode";s:2:"rw";s:11:"Description";s:143:"Persistent Matter fabric data, server storage, migration data, and optional logs. Back this path up before migrating from Python Matter Server.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/matterjs-server";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Storage Path";s:6:"Target";s:12:"STORAGE_PATH";s:7:"Default";s:5:"/data";s:4:"Mode";s:0:"";s:11:"Description";s:71:"Storage path inside the container. Keep this pointed at the Data mount.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"/data";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Port";s:6:"Target";s:4:"PORT";s:7:"Default";s:4:"5580";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Dashboard and WebSocket server port used inside host networking. Keep this aligned with Web UI Port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5580";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:9:"LOG_LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:72:"Server logging level: critical, error, warning, info, debug, or verbose.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Listen Address";s:6:"Target";s:14:"LISTEN_ADDRESS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:160:"Optional IP address or interface name to bind the WebSocket server. Leave blank to bind all interfaces. Interface names can make the upstream health check fail.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Primary Interface";s:6:"Target";s:17:"PRIMARY_INTERFACE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Optional network interface used for Matter mDNS and link-local communication, for example eth0 or br0. Leave blank for auto-detect.";s:4:"Type";s:8:"Variable";s