skgate is not an Unraid plugin and does not manage Unraid. It needs an OIDC provider for admin sign-in (Authelia, Authentik, Keycloak, Pocket ID, Zitadel and similar). Create a confidential client with the redirect URI PUBLIC_URL/admin/oidc/callback. Put it behind a reverse proxy with HTTPS: MCP clients need a public https address.";s:5:"WebUI";s:29:"http://[IP]:[PORT:8080]/admin";s:11:"TemplateURL";s:73:"https://raw.githubusercontent.com/helv-io/skgate/master/unraid/skgate.xml";s:4:"Icon";s:73:"https://raw.githubusercontent.com/helv-io/skgate/master/unraid/skgate.png";s:11:"ExtraParams";s:95:"--health-cmd="/skgate healthcheck" --health-interval=30s --health-timeout=5s --health-retries=3";s:6:"Config";a:12:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:56:"Port of the web UI and the MCP, OAuth and /v1 endpoints.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"AppData";s:6:"Target";s:5:"/data";s:7:"Default";s:24:"/mnt/user/appdata/skgate";s:4:"Mode";s:2:"rw";s:11:"Description";s:91:"Database (skgate.db), encryption key (secrets.key) and managed upstream data. Back this up.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/mnt/user/appdata/skgate";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:10:"PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:108:"The public https address clients use to reach skgate, no trailing slash. Example: https://skgate.example.com";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"OIDC Issuer";s:6:"Target";s:11:"OIDC_ISSUER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"De