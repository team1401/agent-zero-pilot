";b:0;s:10:"trendDelta";d:1.848;s:12:"trendAverage";d:1.5181;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2166;a:40:{s:4:"Name";s:11:"KaraokeDock";s:10:"Repository";s:28:"haggardj2/karaokedock:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/haggardj2/karaokedock";s:7:"Network";s:6:"bridge";s:5:"MyMAC";s:0:"";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/haggardj2/KaraokeDock/issues";s:7:"Project";s:40:"https://github.com/haggardj2/KaraokeDock";s:6:"ReadMe";s:72:"https://github.com/haggardj2/KaraokeDock/blob/main/docs/unraid_readme.md";s:8:"Overview";s:1214:"KaraokeDock is a self-hosted karaoke system with singer requests, live host controls, rotation and history, MP4 and CDG+MP3 playback, online karaoke search, and break-music playlists.

Requires a separate PostgreSQL database; create the database and user before starting. On default bridge networking, use the Unraid server IP and PostgreSQL's published host port. Container-name DNS requires a shared user-defined Docker network.

Set WEB_APP_URL and ORIGIN to the actual browser-facing URL, not localhost. Trusted HTTPS is required for Google/Facebook sign-in and Host PWA installation. OIDC and optional social login are configured in Admin.

First startup runs database migrations and logs a generated administrator password when creating the initial account. The WebUI opens Admin; use /host for show controls, /player for the display, and /requests for singers. Add /media/karaoke and /media/breakmusic in Admin, then scan. Periodic scanning is enabled separately in Admin.

Keep downloads, uploaded images, exported playlists, and PostgreSQL data on persistent storage. Back up the database before upgrades. Setup and troubleshooting: https://github.com/haggardj2/KaraokeDock/blob/main/docs/Unraid_readme.md";s:7:"License";s:3:"MIT";s:5:"WebUI";s:29:"http://[IP]:[PORT:5173]/admin";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/haggardj2/KaraokeDock/main/dev/unraid-templates/karaokedock-app.xml";s:4:"Icon";s:102:"https://raw.githubusercontent.com/haggardj2/KaraokeDock/main/src/web/public/android-chrome-512x512.png";s:6:"Config";a:19:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"5173";s:7:"Default";s:4:"5173";s:4:"Mode";s:3:"tcp";s:11:"Description";s:93:"Host port for the web interface, API, and WebSocket connections. Only one app port is needed.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5173";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Karaoke Tracks";s:6:"Target";s:14:"/media/karaoke";s:7:"Default";s:32:"/mnt/user/karaoke/Karaoke Tracks";s:4:"Mode";s:2:"ro";s:11:"Description";s:127:"Karaoke media, mounted read-only. Add /media/karaoke as a library in Admin. Supports MP4, ZIP CDG+MP3, and loose CDG+MP3 pairs.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Downloads";s:6:"Target";s:16:"/media/downloads";s:7:"Default";s:27:"/mnt/user/karaoke/downloads";s:4:"Mode";s:2:"rw";s:11:"Description";s:93:"Persistent writable folder for downloaded/imported tracks. Must be writable by the container.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Break Music";s:6:"Target";s:17:"/media/breakmusic";s:7:"Default";s:29:"/mnt/user/karaoke/Break Music";s:4:"Mode";s:2:"ro";s:11:"Description";s:96:"Optional break music, mounted read-only. Add /media/breakmusic as a break-music folder in Admin.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Uploaded Images";s:6:"Target";s:13:"/media/images";s:7:"Default";s:36:"/mnt/user/appdata/karaokedock/images";s:4:"Mode";s:2:"rw";s:11:"Description";s:128:"Persistent writable storage for uploaded player background images. Keep this mapping when recreating or upgrading the container.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Exported Playlists";s:6:"Target";s:16:"/media/playlists";s:7:"Default";s:39:"/mnt/user/appdata/karaokedock/playlists";s:4:"Mode";s:2:"rw";s:11:"Description";s:118:"Persistent writable storage for break-music M3U exports. Saved playlist definitions and ordering remain in PostgreSQL.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database Host";s:6:"Target";s:7:"DB_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:148:"Required: Unraid server IP on default bridge networking, or PostgreSQL container name only when both containers share a user-defined Docker network.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Database Port";s:6:"Target";s:7:"DB_PORT";s:7:"Default";s:4:"5432";s:4:"Mode";s:0:"";s:11:"Description";s:147:"Use PostgreSQL's published host port when DB_HOST is the Unraid IP. Use its internal service port (usually 5432) when connecting by container name.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5432";}i:8;