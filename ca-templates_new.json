:{i:0;s:12:"Tools-System";i:1;s:6:"Backup";i:2;s:7:"Plugins";}s:6:"Plugin";b:1;s:13:"pluginVersion";s:11:"2026.10.03a";s:6:"MinVer";s:5:"7.0.0";s:6:"Author";N;s:9:"downloads";i:673;s:9:"FirstSeen";i:1784808253;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:97;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:155;s:2:"08";i:230;s:2:"09";i:191;s:1:"T";i:673;}s:8:"Category";s:29:"Tools:System Backup: Plugins:";s:2:"ID";i:4363;s:11:"Displayable";b:1;s:13:"DockerHubName";s:12:"unraid rsync";s:8:"RepoName";s:26:"fajkovic.sasa's Repository";s:10:"SortAuthor";N;s:8:"SortName";s:12:"Unraid Rsync";s:6:"random";i:1817630342;s:9:"Blacklist";b:0;s:4:"Path";s:185:"/tmp/community.applications/tempFiles/templates-community-apps/fajkovicsasasRepository/-UnraidRsync-//github.com/sasa-fajkovic/unraid-rsync/releases/latest/download/unraid.rsync.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4364;a:44:{s:4:"Name";s:10:"nightlight";s:10:"Repository";s:16:"sauso/nightlight";s:8:"Registry";s:42:"https://hub.docker.com/r/sauso/nightlight/";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:42:"https://github.com/sauso/nightlight/issues";s:7:"Project";s:35:"https://github.com/sauso/nightlight";s:8:"Overview";s:919:"Nightlight is a self-hosted baby monitor with low-latency multi-camera streaming from RTSP cameras, installable as a web app (PWA) on your phone. No cloud, no subscription - runs entirely on your own network.

One container includes the app, MediaMTX (RTSP to WebRTC/HLS bridge), and FFmpeg (audio transcoding) together.

Nightlight needs a routable LAN address so WebRTC (the low-latency viewing mode) works correctly. Host networking (the default below) is the simplest way to get one and needs no extra setup; a dedicated ipvlan/macvlan address on a custom Docker network is also supported if you'd rather avoid host-mode port conflicts - see the Networking modes section of docs/networking.md (github.com/sauso/nightlight) for both options. Set the data path below to somewhere under your appdata share before starting.

After starting, open the WebUI and you'll be prompted to create the first admin account.";s:5:"WebUI";s:24:"http://[IP]:[PORT:4000]/";s:11:"TemplateURL";s:75:"https://raw.githubusercontent.com/sauso/nightlight/main/unraid-template.xml";s:4:"Icon";s:90:"https://raw.githubusercontent.com/sauso/nightlight/main/frontend/public/icons/icon-512.png";s:11:"ExtraParams";s:61:"--log-opt max-size=10m --log-opt max-file=3 --stop-timeout 30";s:4:"Date";N;s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"4000";s:7:"Default";s:4:"4000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:243:"Used ONLY to build the WebUI link above - with Host networking (the default), changing this number does NOT change the port the app actually listens on. To actually change the port, set the PORT variable below to the SAME number as this field.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"4000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PORT";s:6:"Target";s:4:"PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:198:"OPTIONAL - the port the app actually listens on. Leave blank for the default (4000). If you set this, also change WebUI Port above to the same number, or the WebUI link will point at the wrong port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Data Directory";s:6:"Target";s:9:"/app/data";s:7:"Default";s:28:"/mnt/user/appdata/nightlight";s:4:"Mode";s:2:"rw";s:11:"Description";s:72:"Stores the database and MediaMTX's config (including your added cameras)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/nightlight";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:31:"Recordings Directory (optional)";s:6:"Target";s:11:"/recordings";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:340:"OPTIONAL - where event-recording clips are stored. Leave unset and clips go under the Data Directory (your SSD cache). To keep large clips off the SSD, map this to a folder on your array (e.g. /mnt/user/nightlight-clips) AND set the CLIPS_DIR variable below to /recordings. Retention caps (Settings - Recording) protect the disk either way.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"CLIPS_DIR";s:6:"Target";s:9:"CLIPS_DIR";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:195:"OPTIONAL - set to /recordings only if you mapped the Recordings Directory above to store clips on your array instead of under the Data Directory (a trailing slash is fine). Leave blank otherwise.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:156:"User ID that owns files this container creates in the Data Directory - 99 matches Unraid's own 'nobody' convention, so the default should already be correct";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:157:"Group ID that owns files this container creates in the Data Directory - 100 matches Unraid's own 'users' convention, so the default should already be correct";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"077";s:4:"Mode";s:0:"";s:11:"Description";s:477:"Who else may read files in the Data Directory. 077 (default; blank also means 077) = owner only: the database holds every stored secret, and each start also takes group/other access off existing files. Range 000-077 (owner digit 0); an invalid value logs a warning and 077 is used. Set 022 for the old world-readable modes if a backup job, another container or a named SMB user reads the folder - set it BEFORE upgrading, since after one start at 077 it only affects new files.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"077";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Session lifetime (days)";s:6:"Target";s:16:"SESSION_TTL_DAYS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:610:"OPTIONAL - how many days a sign-in lasts, counted from sign-in (not from last use; there is no idle sign-out). Leave blank for the default (30). Range 7-30 whole days; an invalid value logs a warning and 30 is used. WARNING: a phone is signed out at the same time of day it signed in, this many days later, and gets no Nightlight push alerts until someone opens the app and signs in again (Pushover, ntfy and Gotify are not affected). Lowering it signs out every sign-in older than the new value at its next request; raising it does not lengthen sign-ins already made (one made at 7 still ends on its 7th day).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:3:"UTC";s:4:"Mode";s:0:"";s:11:"Description";s:174:"Your local timezone, e.g. Australia/Melbourne - affects log timestamps and video buffer file names only; the times the app shows follow the timezone in Settings under General";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"UTC";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"JWT Secret";s:6:"Target";s:10:"JWT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:125:"Optional - leave blank and a secure random secret is generated and persisted in the data directory automatically on first run";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Public Host";s:6:"Target";s:11:"PUBLIC_HOST";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:375:"Your public IP or DDNS hostname - only needed if you want Low Latency (WebRTC) mode to work from outside your home network (also requires forwarding UDP port 8189 on your router, or the WebRTC UDP Port below if you changed it). Must be your public IP or a DNS-only name - NOT a Cloudflare-proxied (orange cloud) hostname, which cannot carry UDP. Leave blank for LAN-only use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"WebRTC UDP Port";s:6:"Target";s:15:"WEBRTC_UDP_PORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:355:"OPTIONAL - the UDP port Low Latency (WebRTC) video travels on. Enter the number only, no colon. Leave blank for the default (8189). Change it only to run a second Nightlight on the same server (e.g. staging next to production): give each its own port, and forward that same number on your router (1:1, the port in and out must match). Valid range 1-65535.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Cloudflare Web Analytics";s:6:"Target";s:20:"CLOUDFLARE_ANALYTICS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:778:"OPTIONAL. If you do NOT use Cloudflare Web Analytics, leave this blank: nothing changes. If you serve Nightlight through Cloudflare's proxy with Web Analytics turned on, Cloudflare injects its analytics beacon into every page, and Nightlight's security policy (Content-Security-Policy) BLOCKS that beacon unless this is set to 1 (or true, yes, on); every blocked page load also logs a [csp-report] line (at most 10 a minute). So either set it to 1, or, if you do not want those analytics, turn off Web Analytics' automatic setup for the site in the Cloudflare dashboard. Blank (the default), 0, false, no and off keep it blocked; any other value also blocks it and logs a warning. Before this setting existed the beacon was allowed on every install, so set it if you rely on it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Trusted Proxy";s:6:"Target";s:11:"TRUST_PROXY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:777:"OPTIONAL - leave blank unless you run Nightlight behind a reverse proxy AND that proxy connects from something other than 127.0.0.1 (SWAG reaching it by LAN IP is the common case - see docs/remote-access.md on github.com/sauso/nightlight). Set it to the address your proxy connects FROM, e.g. 10.0.0.20. Accepts an IP or CIDR, a comma-separated list, a hop count (1), or a named range. WARNING: only trust an address you control - too broad a value, or the word true (which trusts every upstream), lets anyone forge X-Forwarded-For and evade the login rate limit. Blank is safe: login attempts are also limited per account. A value Nightlight cannot make sense of is ignored with a warning in the log and the safe default (loopback) is used - it will not stop the app starting.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"STUN Servers";s:6:"Target";s:12:"STUN_SERVERS";s:7:"Default";s:28:"stun:stun.l.google.com:19302";s:4:"Mode";s:0:"";s:11:"Description";s:624:"OPTIONAL - which STUN servers Low Latency (WebRTC) uses, in the browser and in the bundled MediaMTX. STUN is only needed for viewers OUTSIDE your home network who are behind NAT; viewing on your own network never needs it. The default is Google's public server, which learns the viewer's public IP and when each live view connected. Accepts a comma-separated list of stun:host or stun:host:port entries. CLEAR THE FIELD (leave it blank) to use no STUN server at all: nothing then contacts Google or any other STUN server. Entries that are not stun: URLs are ignored with a warning in the log (if none is valid, STUN is off).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:39:"/tmp/GitHub/AppFeed/unraid-template.xml";s:4:"Repo";s:18:"sauso's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:13:"Network-Other";}s:9:"downloads";i:61524;s:13:"downloadtrend";a:2:{i:0;i:43783;i:1;i:61524;}s:8:"trending";d:28.836;s:6:"trends";a:1:{i:0;d:28.836;}s:10:"trendsDate";a:1:{i:0;i:1792397309;}s:9:"FirstSeen";i:1789791280;s:10:"LastUpdate";i:1792327658;s:14:"LastUpdateScan";i:1792397309;s:8:"Category";s:29:"HomeAutomation: Network:Other";s:2:"ID";i:4364;s:11:"Displayable";b:1;s:6:"Author";s:5:"sauso";s:13:"DockerHubName";s:10:"nightlight";s:8:"RepoName";s:18:"sauso's Repository";s:10:"SortAuthor";s:5:"sauso";s:8:"SortName";s:10:"nightlight";s:6:"random";i:349975590;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:107:"/tmp/community.applications/tempFiles/templates-community-apps/sausosRepository/sauso-nightlight-latest.xml";s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:122:"Nightlight is free and open source. If it helps you keep watch over your little ones, consider supporting its development.";s:10:"DonateLink";s:61:"https://www.paypal.com/donate/?hosted_button_id=VGCB7WFYPJQ3G"