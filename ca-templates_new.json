ory";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:8:"Security";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1786680294;s:8:"Category";s:25:"HomeAutomation: Security:";s:2:"ID";i:2134;s:11:"Displayable";b:1;s:6:"Author";s:8:"gaming09";s:13:"DockerHubName";s:18:"amcrest-ptz-bridge";s:8:"RepoName";s:21:"gaming09's Repository";s:10:"SortAuthor";s:8:"gaming09";s:8:"SortName";s:18:"Amcrest PTZ Bridge";s:6:"random";i:202479350;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/gaming09sRepository/gaming09-AmcrestPTZBridge-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2135;a:34:{s:4:"Name";s:19:"claude-in-container";s:10:"Repository";s:43:"ghcr.io/ganesh35/claude-in-container:latest";s:8:"Registry";s:82:"https://github.com/ganesh35/claude-in-container/pkgs/container/claude-in-container";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:54:"https://github.com/ganesh35/claude-in-container/issues";s:7:"Project";s:47:"https://github.com/ganesh35/claude-in-container";s:8:"Overview";s:1047:"Always-on Claude Code in tmux, reachable from phone or browser via Remote Control. Claude sees only the Data folder, which holds your projects and, in .home, its login, settings and runtime-installed tools.

Before installing: create the Data folder owned by the user in Extra Parameters (default --user 99:100), e.g. mkdir -p DIR && chown 99:100 DIR. To build the image yourself instead of pulling it, see the project README.

Tools with a version set below install into the Data folder on first start. Several containers can share one Data folder: give each its own container name and Remote Control name, set Continue to false on all but one, and keep the tool versions identical across them.

Routines (optional, off by default): set Routines to a crontab path such as /data/routines, with lines like 0 8 * * * routine prompt; replies land in DATA/routines-output. Clear the field to switch them off.

