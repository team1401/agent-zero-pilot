:4:"Name";s:30:"Models &amp; G-code (/storage)";s:6:"Target";s:8:"/storage";s:7:"Default";s:9:"/mnt/user";s:4:"Mode";s:8:"rw,slave";s:11:"Description";s:196:"Where you keep your STL/3MF models and where sliced G-code is saved. Default /mnt/user gives access to all shares. Import models and export G-code under /storage inside PrusaSlicer's file dialogs.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"/mnt/user";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Username";s:6:"Target";s:11:"CUSTOM_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:173:"Optional. Username for HTTP-basic-auth on the WebUI. Leave EMPTY together with the password for no login. Set both fields to enable login (recommended outside trusted LANs).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Password";s:6:"Target";s:8:"PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:185:"Optional. Password for HTTP-basic-auth on the WebUI. Leave EMPTY together with the username for no login. STRONGLY recommended whenever the container is reachable from outside your LAN.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Timezone (TZ)";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/Vienna";s:4:"Mode";s:0:"";s:11:"Description";s:179:"Container timezone (affects log timestamps and file mtimes). Use this instead of a /etc/localtime bind-mount, because the LSIO base image manages /etc/localtime internally via TZ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Vienna";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"User ID (PUID)";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:59:"User-ID PrusaSlicer runs as. Default 99 (nobody on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Group ID (PGID)";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:40:"Group-ID. Default 100 (users on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:15:"000|022|002|077";s:4:"Mode";s:0:"";s:11:"Description";s:212:"Permission mask for newly created files. The default 000 lets every container user read and write them, which is what you want when other containers touch the same shares. Set 022 or 077 for stricter permissions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:47:"/tmp/GitHub/AppFeed/prusaslicer/prusaslicer.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:12:"Productivity";}s:9:"downloads";i:7263;s:9:"FirstSeen";i:1784649851;s:10:"LastUpdate";i:1789637657;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:29:"Tools:Utilities Productivity:";s:2:"ID";i:2783;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:11:"prusaslicer";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:11:"PrusaSlicer";s:6:"random";i:64022483;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:130:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-PrusaSlicer-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2784;a:48:{s:4:"Name";s:6:"RustFS";s:4:"Beta";s:4:"true";s:10:"Repository";s:20:"rustfs/rustfs:latest";s:8:"Registry";s:38:"https://hub.docker.com/r/rustfs/rustfs";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:6:"ReadMe";s:74:"https://github.com/junkerderprovinz/unraid-apps/blob/main/rustfs/README.md";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:32:"https://github.com/rustfs/rustfs";s:8:"Overview";s:1260:"RustFS is an S3-compatible object store written in Rust, Apache-2.0, and one of the alternatives people have been looking at since MinIO's open edition stopped moving. This template runs the official image with the two settings it needs on Unraid.

THIS IS A PRE-RELEASE. RustFS has published a hundred releases and not one of them is stable: alphas, betas and release candidates only. Do not put data here that exists nowhere else.

Why this template exists: started as it comes, the container does not run on Unraid at all. It runs as its own built-in user id 10001, so on a share owned by nobody:users it cannot write and dies at startup with "Permission denied". This template runs it as 99:100 instead, which fixes it. It also makes the credentials required fields, because without them the image falls back to a built-in default account and says so twice in its own log.

Ports: 9000 is the S3 endpoint every client connects to. 9001 is the built-in web console.

First start: the log runs to a handful of warnings and then goes quiet, which is what a working start looks like here. There is no "server is listening" line. If you see "Permission denied" instead, the Data folder is not writable by 99:100, or the Logs folder is mapped and is not.";s:5:"WebUI";s:23:"http://[IP]:[PORT:9001]";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/rustfs/rustfs.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/rustfs/icon.png";s:11:"ExtraParams";s:38:"--restart=unless-stopped --user 99:100";s:8:"Requires";s:266:"Set an Access Key and Secret Key below. Left empty the container stops at startup, and removed entirely RustFS falls back to a built-in default account that is the same in every copy of the image. This is a pre-release: keep a second copy of anything you store here.";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"S3 API Port";s:6:"Target";s:4:"9000";s:7:"Default";s:4:"9000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:72:"The S3 endpoint every client (rclone, restic, aws-cli, ...) connects to.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Console Port";s:6:"Target";s:4:"9001";s:7:"Default";s:4:"9001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:51:"The built-in web console. This is what WebUI opens.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9001";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:29:"/mnt/user/appdata/rustfs/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:102:"Where the objects live. Must be writable by 99:100, which is what this template runs the container as.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/rustfs/data";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Logs";s:6:"Target";s:5:"/logs";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:253:"Optional, and deliberately empty by default. Mapped, RustFS writes its log to a file there and the container log keeps only three lines, so Unraid's log view shows you almost nothing. Unmapped, everything goes to the container log where you can read it.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Access Key";s:6:"Target";s:17:"RUSTFS_ACCESS_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:263:"The access key your S3 clients use. Required: left empty, the container stops at startup with 'RUSTFS_ACCESS_KEY must not be empty'. Removing the field entirely is worse, because then RustFS uses its built-in default account, identical in every copy of the image.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Secret Key";s:6:"Target";s:17:"RUSTFS_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:128:"The secret key, paired with the access key above. Use a real generated secret (e.g. openssl rand -hex 24), not a short password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Console CORS Origins";s:6:"Target";s:35:"RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS";s:7:"Default";s:1:"*";s:4:"Mode";s:0:"";s:11:"Description";s:153:"Which origins the web console accepts. The image ships with * (any). Narrow it to your own address if the console is reachable from outside your network.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"*";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log Level";s:6:"Target";s:23:"RUSTFS_OBS_LOGGER_LEVEL";s:7:"Default";s:4:"warn";s:4:"Mode";s:0:"";s:11:"Description";s:69:"How much RustFS writes to its log: error, warn, info, debug or trace.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"warn";}}s:12:"TemplatePath";s:37:"/tmp/GitHub/AppFeed/rustfs/rustfs.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:4:{i:0;s:6:"Backup";i:1;s:5:"Cloud";i:2;s:11:"Network-Web";i:3;s:15:"Tools-Utilities";}s:8:"Official";b:1;s:5:"stars";i:53;s:9:"downloads";i:14941490;s:13:"downloadtrend";a:2:{i:0;i:10487963;i:1;i:14941490;}s:6:"trends";a:1:{i:0;d:29.806;}s:10:"trendsDate";a:1:{i:0;i:1792262791;}s:9:"FirstSeen";i:1789615119;s:10:"LastUpdate";i:1791003778;s:14:"LastUpdateScan";i:1792262791;s:8:"Category";s:42:"Backup: Cloud: Network:Web Tools:Utilities";s:2:"ID";i:2784;s:11:"Displayable";b:1;s:6:"Author";s:6:"rustfs";s:13:"DockerHubName";s:6:"rustfs";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:6:"rustfs";s:8:"SortName";s:6:"RustFS";s:6:"random";i:335248505;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/rustfs-RustFS-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2785;a:41:{s:4:"Name";s:7:"Seafile";s:4:"Beta";s:4:"true";s:10:"Repository";s:31:"junkerderprovinz/seafile:latest";s:8:"Registry";s:49:"https://hub.docker.com/r/junkerderprovinz/seafile";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:6:"ReadMe";s:63:"https://github.com/junkerderprovinz/seafile/blob/main/README.md";s:7:"Support";s:75:"https://forums.unraid.net/topic/200798-support-junkerderprovinz-seafile-14/";s:7:"Project";s:23:"https://www.seafile.com";s:8:"Overview";s:2074:"Seafile is a file sync and share server with desktop and mobile clients, libraries you can encrypt on the client, and built-in wikis. This is the official Seafile image, installable from this one template.

The official image expects MariaDB, Redis and the notification server as separate containers on a shared Docker network, plus a JWT key you generate by hand. Here the JWT key, the database password and, if you leave it empty, the admin password are generated on the first start and kept in secrets.env in the Data folder. MariaDB, Redis and the notification server can each run inside this container when you switch them on below.

Getting started:
• Set the Server hostname to the address your clients will use, such as 192.168.1.10:8000 or seafile.example.com.
• Already running MariaDB? Enter its host and root password. The root password is only used once, to create the Seafile databases.
• No MariaDB or Redis? Set Built-in MariaDB and Built-in Redis to true and leave their host fields empty.
• The first start takes about a minute. Seafile is ready when the log says "Seahub is started". A generated admin password is printed in the log.

Office files in the browser:
• Install Euro-Office, Collabora or OnlyOffice as its own container, then set "Web office suite", "Office document server URL" and, for Euro-Office and OnlyOffice, "Office JWT secret" below. Documents then open and save inside Seafile.
• Collabora also needs Seafile's address in its aliasgroup1 variable. The README has a table with the values for all three.

This image runs Seafile 14, which upstream still calls testing, and Seafile cannot be downgraded. Back up the Data folder and the database before every update.

Coming from another Seafile template? The Data folder has the same layout, so point Data at your old folder and copy over the database settings and the JWT key. The README explains each step.

Source on GitHub: https://github.com/junkerderprovinz/seafile
