4:"Mode";s:0:"";s:11:"Description";s:114:"Apprise URLs (Discord, Telegram, Gotify, ntfy, …). Unraid's own bell is used when /tmp/notifications is mounted.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log level";s:6:"Target";s:17:"TETHERD_LOG_LEVEL";s:7:"Default";s:4:"INFO";s:4:"Mode";s:0:"";s:11:"Description";s:30:"DEBUG, INFO, WARNING or ERROR.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"INFO";}}s:12:"TemplatePath";s:39:"/tmp/GitHub/AppFeed/tetherd/tetherd.xml";s:4:"Repo";s:23:"PhilBarker's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:575;s:9:"FirstSeen";i:1788305308;s:10:"LastUpdate";i:1789545653;s:14:"LastUpdateScan";i:1790969388;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:1003;s:11:"Displayable";b:1;s:6:"Author";s:12:"philbarker79";s:13:"DockerHubName";s:7:"tetherd";s:8:"RepoName";s:23:"PhilBarker's Repository";s:10:"SortAuthor";s:12:"philbarker79";s:8:"SortName";s:7:"tetherd";s:6:"random";i:1479356159;s:9:"Blacklist";b:0;s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/PhilBarkersRepository/philbarker79-tetherd-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1004;a:41:{s:4:"Name";s:22:"MMC-Media-Meta-Cleaner";s:10:"Repository";s:43:"galvatrondeva/mmc-media-meta-cleaner:latest";s:8:"Registry";s:62:"https://hub.docker.com/r/galvatrondeva/mmc-media-meta-cleaner/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:78:"https://raw.githubusercontent.com/Phive-5/mmc-media-meta-cleaner/main/icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:3000]";s:8:"Overview";s:1185:"MMC (Media Meta Cleaner) is a web application that removes embedded metadata from video files so media servers like Plex and Jellyfin rely solely on filenames. It scans directories for .mkv, .mp4, .avi, .mov, .wmv and .flv files, probes them for metadata tags (title, subtitle, tags, keywords, comment, description, synopsis), and lets you selectively strip those tags from any combination of files.

    It does NOT rename files, convert formats, or change encoding/quality.

    Features:
    - Modern web UI (React + Tailwind, dark/light themes, responsive)
    - Fast (In-Place) and Safe (Copy) processing modes
    - Post-processing verification - every file is re-probed and reported Verified Clean or FAILED
    - Real-time progress via WebSocket (scan %, batch %, per-file %)
    - Pause / Resume / Cancel
    - In-app log drawer with a final FAILED FILES summary
    - Mac turd handling - scan, log, or delete AppleDouble (._) files left behind by macOS, so Plex/Jellyfin don't get confused

    After installation, open the WebUI from the Unraid Docker page or at the address shown on the container page. Map your media directory to /media and the app data folder to /config.";s:7:"Support";s:56:"https://github.com/Phive-5/mmc-media-meta-cleaner/issues";s:7:"Project";s:49:"https://github.com/Phive-5/mmc-media-meta-cleaner";s:11:"TemplateURL";s:87:"https://raw.githubusercontent.com/Phive-5/mmc-media-meta-cleaner/main/templates/mmc.xml";s:6:"ReadMe";s:79:"https://raw.githubusercontent.com/Phive-5/mmc-media-meta-cleaner/main/README.md";s:16:"ExtraSearchTerms";s:82:"metadata cleaner tags strip plex jellyfin mkv mp4 video remux mac turd appledouble";s:6:"MinVer";s:4:"6.10";s:7:"License";s:3:"MIT";s:10:"Screenshot";a:2:{i:0;s:95:"https://raw.githubusercontent.com/Phive-5/mmc-media-meta-cleaner/main/screenshots/MMC-Snap1.png";i:1;s:95:"https://raw.githubusercontent.com/Phive-5/mmc-media-meta-cleaner/main/screenshots/MMC-Snap2.png";}s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"rw";s:11:"Description";s:22:"Media files to process";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"AppData";s:6:"Target";s:7:"/config";s:7:"Default";s:21:"/mnt/user/appdata/mmc";s:4:"Mode";s:2:"rw";s:11:"Description";s:49:"Application configuration storage (settings.json)";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Web Port";s:6:"Target";s:4:"3000";s:7:"Default";s:5:"14500";s:4:"Mode";s:3:"tcp";s:11:"Description";s:46:"Web UI (host port maps to container port 3000)";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:11:"Description";s:18:"Container timezone";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:37:"/tmp/GitHub/AppFeed/templates/mmc.xml";s:4:"Repo";s:26:"galvatrondeva's Repository";s:12:"CategoryList";a:1:{i:0;s:14:"MediaApp-Video";}s:9:"downloads";i:439;s:9:"FirstSeen";i:1786834286;s:10:"LastUpdate";i:1786948301;s:14:"LastUpdateScan";i:1792262791;s:8:"Category";s:14:"MediaApp:Video";s:2:"ID";i:1004;s:11:"Displayable";b:1;s:6:"Author";s:13:"galvatrondeva";s:13:"DockerHubName";s:22:"mmc-media-meta-cleaner";s:8:"RepoName";s:26:"galvatrondeva's Repository";s:10:"SortAuthor";s:13:"galvatrondeva";s:8:"SortName";s:22:"MMC Media Meta Cleaner";s:6:"random";i:755832939;s:9:"Blacklist";b:0;s:4:"Path";s:132:"/tmp/community.applications/tempFiles/templates-community-apps/galvatrondevasRepository/galvatrondeva-MMCMediaMetaCleaner-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1005;a:39:{s:4:"Name";s:9:"hindsight";s:10:"Repository";s:37:"ghcr.io/vectorize-io/hindsight:latest";s:8:"Registry";s:66:"https://github.com/vectorize-io/hindsight/pkgs/container/hindsight";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:77:"https://forums.unraid.net/topic/200491-support-hindsight-agent-memory-system/";s:7:"Project";s:41:"https://github.com/vectorize-io/hindsight";s:8:"Overview";s:1361:"Shared memory for AI agents through MCP and HTTP. Includes the API, web UI, and embedded PostgreSQL for a first deployment.

Before first start:
1. The container runs as user 1000 and cannot fix folder ownership itself. Before the first start, run this in the Unraid terminal: mkdir -p /mnt/user/appdata/hindsight && chown -R 1000:1000 /mnt/user/appdata/hindsight && chmod 700 /mnt/user/appdata/hindsight
   If you started the container first and the log says the database directory is not writable, stop the container, run the same command, and start it again.
2. Local Ollama is selected by default. Set Model endpoint to your Ollama address and Model name to a model you have pulled. To use a hosted API instead, change Model service and paste its key into Model provider key.
3. Set a strong Memory API key. Paste the SAME key into Web UI backend key. Set a separate Web UI login key.
4. Open the WebUI. Agents use http://YOUR_Unraid_IP:8888/mcp/YOUR_BANK/ with Authorization: Bearer YOUR_MEMORY_API_KEY. One bank per project.

No project folders or Docker socket mounts are needed. Keep ports on a trusted network. Shared API keys grant access across every bank, so bank names are not separate access controls.
Back up appdata while the container is stopped. For a long-lived shared service, use external PostgreSQL with pgvector as described in the guide.";s:5:"WebUI";s:24:"http://[IP]:[PORT:9999]/";s:11:"TemplateURL";s:95:"https://raw.githubusercontent.com/PikkonMG/unraid-docker-templates/main/templates/hindsight.xml";s:4:"Icon";s:99:"https://raw.githubusercontent.com/PikkonMG/unraid-docker-templates/main/templates/img/hindsight.png";s:6:"ReadMe";s:79:"https://github.com/PikkonMG/unraid-docker-templates/blob/main/docs/HINDSIGHT.md";s:11:"ExtraParams";s:31:"--shm-size=1g --stop-timeout=60";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:27:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Memory API / MCP port";s:6:"Target";s:4:"8888";s:7:"Default";s:4:"8888";s:4:"Mode";s:3:"tcp";s:11:"Description";s:68:"Host port for API and MCP. Use /mcp/PROJECT/ and the Memory API key.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8888";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:4:"9999";s:7:"Default";s:4:"9999";s:4:"Mode";s:3:"tcp";s:11:"Description";s:35:"Host port for the memory dashboard.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9999";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Memory data";s:6:"Target";s:20:"/home/hindsight/.pg0";s:7:"Default";s:27:"/mnt/user/appdata/hindsight";s:4:"Mode";s:2:"rw";s:11:"Description";s:128:"Embedded database. Prepare the host folder with owner 1000:1000 and mode 700 before starting. Do not map a code repository here.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/hindsight";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Model service";s:6:"Target";s:26:"HINDSIGHT_API_LLM_PROVIDER";s:7:"Default";s:6:"ollama";s:4:"Mode";s:0:"";s:11:"Description";s:180:"Local Ollama is selected. Keep ollama unless you choose another service in the guide. Hosted options include openai, anthropic, gemini, groq, ollama-cloud, openrouter and deepseek.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"ollama";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Model name";s:6:"Target";s:23:"HINDSIGHT_API_LLM_MODEL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:137:"Exact name of the model to use, for example one already pulled in Ollama. It must support tool calling and JSON output, or reflect fails.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Model endpoint";s:6:"Target";s:26:"HINDSIGHT_API_LLM_BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:135:"Needed for Ollama only. Use your Unraid IP, not localhost, for example http://YOUR_UNRAID_IP:11434/v1. Leave blank for hosted services.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Model provider key";s:6:"Target";s:25:"HINDSIGHT_API_LLM_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Leave blank for local Ollama. Enter the key for your hosted service. This is not the Memory API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Ollama context size";s:6:"Target";s:32:"HINDSIGHT_API_LLM_OLLAMA_NUM_CTX";s:7:"Default";s:5:"32768";s:4:"Mode";s:0:"";s:11:"Description";s:191:"Ollama only. Prompt window in tokens. Keep it above Reflect max context or long prompts get cut. Lower both together if the model does not fit in memory. Leave blank if you do not use Ollama.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"32768";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Parallel model calls";s:6:"Target";s:32:"HINDSIGHT_API_LLM_MAX_CONCURRENT";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:112:"Upstream recommends 1 for a local model. A single GPU serves one request at a time. Raise this for a hosted API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Background observations";s:6:"Target";s:33:"HINDSIGHT_API_ENABLE_OBSERVATIONS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:158:"Extra model calls after each save that build higher-level insights. Upstream recommends false for a local model because it is slow. Set true for a hosted API.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Reasoning effort";s:6:"Target";s:34:"HINDSIGHT_API_LLM_REASONING_EFFORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Leave blank unless your model thinks slowly. Values depend on the model, for example none, low or high. Blank sends nothing.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"Reflect reasoning effort";s:6:"Target";s:42:"HINDSIGHT_API_REFLECT_LLM_REASONING_EFFORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:163:"Reflect only. Leave blank unless needed. If Reasoning effort is none, set this to low, because some models skip tool calls with no thinking and reflect then fails.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Reflect time limit";s:6:"Target";s:34:"HINDSIGHT_API_REFLECT_WALL_TIMEOUT";s:7:"Default";s:4:"1200";s:4:"Mode";s:0:"";s:11:"Description";s:255:"Seconds a single reflect or knowledge page rebuild may run before it is abandoned. Upstream uses 300, which a local model often overruns and reports as a timed out reflect. Raise it on slow hardware, lower it on a fast hosted API. Do not leave this blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1200";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Reflect max context";s:6:"Target";s:40:"HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS";s:7:"Default";s:5:"24000";s:4:"Mode";s:0:"";s:11:"Description";s:289:"Most text, in tokens, a reflect may gather before it writes its answer. Keep it well below your model prompt window or the prompt gets cut and the answer suffers. Upstream uses 100000, which suits hosted models with large windows. Raise it to match a bigger model. Do not leave this blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"24000";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Model call timeout";s:6:"Target";s:25:"HINDSIGHT_API_LLM_TIMEOUT";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:94:"Seconds to wait for one model reply. Raise it for a slow local model. Do not leave this blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Database URL";s:6:"Target";s:26:"HINDSIGHT_API_DATABASE_URL";s:7:"Default";s:3:"pg0";s:4:"Mode";s:0:"";s:11:"Description";s:172:"Keep pg0 to use the embedded database in the Memory data folder. For an external PostgreSQL with pgvector, replace this with its connection string. Do not leave this blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"pg0";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Log level";s:6:"Target";s:23:"HINDSIGHT_API_LOG_LEVEL";s:7:"Default";s:4:"info";s:4:"Mode";s:0:"";s:11:"Description";s:92:"One of critical, error, warning, info or debug. Use debug when you need to report a problem.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"info";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Stateless MCP";s:6:"Target";s:27:"HINDSIGHT_API_MCP_STATELESS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:104:"Keep false for normal use. Set true when a reverse proxy or client cannot hold a streaming session open.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Memory API key";s:6:"Target";s:28:"HINDSIGHT_API_TENANT_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Required. Create a long random secret for agents. Paste the same value into Web UI backend key. No shared default is supplied.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Web UI backend key";s:6:"Target";s:30:"HINDSIGHT_CP_DATAPLANE_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:87:"Required. Must exactly match Memory API key so the dashboard can read and write memory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Web UI login key";s:6:"Target";s:23:"HINDSIGHT_CP_ACCESS_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:117:"Required. Use a separate long random secret to sign in to the dashboard. Leaving this blank disables dashboard login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"API authentication";s:6:"Target";s:30:"HINDSIGHT_API_TENANT_EXTENSION";s:7:"Default";s:61:"hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension";s:4:"Mode";s:0:"";s:11:"Description";s:57:"Keep enabled. Startup fails when Memory API key is empty.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:61:"hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Web UI backend URL";s:6:"Target";s:30:"HINDSIGHT_CP_DATAPLANE_API_URL";s:7:"Default";s:21:"http://127.0.0.1:8888";s:4:"Mode";s:0:"";s:11:"Description";s:97:"Internal API address for the bundled dashboard. Leave unchanged when changing host port mappings.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:21:"http://127.0.0.1:8888";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Worker identity";s:6:"Target";s:23:"HINDSIGHT_API_WORKER_ID";s:7:"Default";s:16:"hindsight-unraid";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Keep stable across restarts so interrupted work keeps the same owner. Use a unique value for each instance sharing a database.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"hindsight-unraid";}i:24;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"MCP enabled";s:6:"Target";s:25:"HINDSIGHT_API_MCP_ENABLED";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Enable memory tools for MCP clients.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:25;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Container home";s:6:"Target";s:4:"HOME";s:7:"Default";s:15:"/home/hindsight";s:4:"Mode";s:0:"";s:11:"Description";s:42:"Path inside the container. Keep unchanged.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/home/hindsight";}i:26;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Time zone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:47:"Container time zone. Change to your local zone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/hindsight.xml";s:4:"Repo";s:21:"PikkonMG's Repository";s:12:"CategoryList";a:3:{i:0;s:2:"AI";i:1;s:15:"Tools-Utilities";i:2;s:12:"Productivity";}s:9:"FirstSeen";i:1788670848;s:8:"Category";s:33:"AI: Tools:Utilities Productivity:";s:2:"ID";i:1005;s:11:"Displayable";b:1;s:6:"Author";s:12:"vectorize-io";s:13:"DockerHubName";s:9:"hindsight";s:8:"RepoName";s:21:"PikkonMG's Repository";s:10:"SortAuthor";s:12:"vectorize-io";s:8:"SortName";s:9:"hindsight";s:6:"random";i:2029531816;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/PikkonMGsRepository/vectorizeio-hindsight-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:38:"Templates are free, coffee is optional";s:10:"DonateLink";s:31:"https://paypal.me/HighlandJewls";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1006;a:43:{s:4:"Name";s:15:"laya-system-one";s:10:"Repository";s:28:"pikkonmg/laya-system-one:cpu";s:8:"Registry";s:50:"https://hub.docker.com/r/pikkonmg/laya-system-one/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:79:"https://forums.unraid.net/topic/200710-support-laya-system-one-decision-engine/";s:7:"Project";s:37:"https://github.com/NandhaKishorM/laya";s:8:"Overview";s:813:"Laya is a System One decision engine. A fast model that answers typed questions about text in one pass: pick a choice, give a score, or say yes, no or unsure, each with a calibrated probability. It serves the Jev-compatible /v1/systemone HTTP API for routing, triage, moderation and guardrails.

Before first start:
1. Pick cpu or nvidia when you install. The nvidia choice sets Extra Parameters to --runtime=nvidia for you and needs the Unraid NVIDIA Driver plugin.
2. Optional: set an API key. Clients then send Authorization: Bearer YOUR_API_KEY. Leave it blank for no key.
3. The first start downloads the model weights (a few GB) into the Model cache folder. The container shows healthy when the models are loaded.

