:8:"Category";s:24:"Tools:Utilities Plugins:";s:2:"ID";i:2016;s:11:"Displayable";b:1;s:13:"DockerHubName";s:28:"uptime kuma dashboard widget";s:8:"RepoName";s:20:"drohack's Repository";s:10:"SortAuthor";s:7:"drohack";s:8:"SortName";s:28:"Uptime Kuma Dashboard Widget";s:6:"random";i:132682830;s:9:"Blacklist";b:0;s:4:"Path";s:193:"/tmp/community.applications/tempFiles/templates-community-apps/drohacksRepository/drohack-UptimeKumaDashboardWidget-//raw.githubusercontent.com/drohack/UptimeKumaPlugin/main/uptime-kuma.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2017;a:43:{s:4:"Name";s:8:"Dropnook";s:10:"Repository";s:27:"ghcr.io/dropnook/dropnook:2";s:8:"Registry";s:64:"https://github.com/dropnook/dropnook.app/pkgs/container/dropnook";s:7:"Network";s:3:"br0";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/dropnook/dropnook.app/issues";s:7:"Project";s:30:"https://dropnook.dropnook.app/";s:6:"ReadMe";s:47:"https://github.com/dropnook/dropnook.app#readme";s:7:"License";s:13:"AGPL-3.0-only";s:8:"Overview";s:1090:"Instant sharing for your home network — like AirDrop, but for every device. Open one web page on your phone, laptop or PC, drop in text, files or a screenshot (Ctrl+V), and it is on every other device at once: no app, no login, no cloud. Text fields that survive lost connections, uploads of any size that resume, picture previews, 17 languages, five colour layouts in light and dark, an optional PIN, up to five users with an area of their own next to the shared one, and a live room: go live with video or voice, everyone with Drop open sees a tile and joins with one click — up to 10 people, straight from device to device.

Over HTTPS Drop can do more — the live room, copying pictures: give it a certificate from Cert Warden in the advanced settings, and it fetches and renews it by itself.

This is the LAN-only edition: a single container, reachable in your network only, without sharing to the internet. Sharing single files or texts through expiring links needs a second, locked-down container — for that, install Dropnook as a Compose stack instead (see the project page).";s:5:"WebUI";s:22:"http://[IP]:[PORT:80]/";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/dropnook/unraid-community-apps/main/templates/dropnook.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/dropnook/dropnook.app/main/.github/icons/drop.png";s:11:"ExtraParams";s:164:"--cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --cap-add NET_BIND_SERVICE --security-opt no-new-privileges:true --memory 2g --pids-limit 200";s:8:"Requires";s:241:"A share for Drop's files — create it first (Shares → Add Share, e.g. &quot;drop&quot;); otherwise Docker creates the folder as a share with default settings. And a free IP address in your network for Drop (Fixed IP address, network br0).";s:16:"ExtraSearchTerms";s:153:"dropnook drop airdrop share sharing clipboard screenshot files text lan localsend snapdrop pairdrop transfer video call live room group webrtc certwarden";s:6:"Config";a:20:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI port";s:6:"Target";s:2:"80";s:7:"Default";s:2:"80";s:4:"Mode";s:3:"tcp";s:11:"Description";s:611:"Port for Drop's page. Drop has an IP address of its own here (Network Type: Custom: br0 — put a free address of your network into Fixed IP address), so 80 fits: http://that address/. Works with ipvlan and macvlan alike (Settings → Docker); with macvlan the Unraid server itself cannot reach Drop unless Host access to custom networks is enabled — other devices can. Without a bridge on the server the network is called e.g. eth0 instead of br0. Switched to Bridge? Then port 80 is already taken by Unraid's own web interface and Drop will not start — change it, e.g. to 8088, and open http://Tower:8088.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"80";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"HTTPS port";s:6:"Target";s:3:"443";s:7:"Default";s:3:"443";s:4:"Mode";s:3:"tcp";s:11:"Description";s:185:"Only with a certificate (Cert Warden below): Drop's page over HTTPS, http:// then redirects here. Needed for the live room and copying pictures — browsers allow those over HTTPS only.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"443";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Files and texts";s:6:"Target";s:5:"/data";s:7:"Default";s:14:"/mnt/user/drop";s:4:"Mode";s:2:"rw";s:11:"Description";s:100:"Where Drop keeps its files and text fields — a share of its own. Create it before the first start.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"/mnt/user/drop";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"PIN";s:6:"Target";s:3:"PIN";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:198:"Optional. A PIN or password every new browser is asked for once (then signed in for 90 days). Empty: anyone in your network can open Drop. With users: the PIN of every user without one of their own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"More names";s:6:"Target";s:5:"HOSTS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:240:"Optional. Drop answers to IP addresses and local names (tower, tower.local, ….lan, ….fritz.box) by itself. If you open it under another name, put it here, e.g. drop.example.org — comma-separated, *.example.org for every name under it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"User (teal)";s:6:"Target";s:9:"USER_TEAL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:174:"Optional, up to five users, one per colour: name:PIN (e.g. Anna:2468), or the name alone. Each gets an area of their own next to the shared one, and the page in their colour.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"User (gold)";s:6:"Target";s:9:"USER_GOLD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Optional: name:PIN, or the name alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"User (blue)";s:6:"Target";s:9:"USER_BLUE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Optional: name:PIN, or the name alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"User (violet)";s:6:"Target";s:11:"USER_VIOLET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Optional: name:PIN, or the name alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"User (coral)";s:6:"Target";s:10:"USER_CORAL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Optional: name:PIN, or the name alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Cert Warden address";s:6:"Target";s:23:"CERTWARDEN_ENDPOINT_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:225:"Optional: fetch Drop's certificate from Cert Warden, e.g. https://certwarden.example.org — then Drop serves HTTPS. Open it by t