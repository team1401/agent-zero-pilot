ate";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:642;a:39:{s:4:"Name";s:9:"PassForge";s:10:"Repository";s:35:"ghcr.io/jpetovello/passforge:latest";s:8:"Registry";s:64:"https://github.com/JPetovello/PassForge/pkgs/container/passforge";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:86:"https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icons/passforge.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:5000]";s:8:"Overview";s:997:"PassForge is a privacy-focused password analysis and secure passphrase generation tool.

Evaluate password strength using zxcvbn and entropy analysis, check passwords against the Have I Been Pwned (HIBP) breach database using the k-Anonymity range API, and generate cryptographically secure passphrases from the official EFF large and short wordlists.

Password analysis, SHA-1 hashing, breach-result matching, and passphrase generation run locally in your browser. For breach checks, only the first 5 characters of the SHA-1 hash are sent to the PassForge backend, which retrieves the matching HIBP range. Your plaintext password and complete hash never leave your browser.

PassForge also provides configurable passphrase length, wordlists, separators, entropy targets, batch generation, dark mode, and Progressive Web App support.

No additional services are required. Redis is optional and can be used for shared rate-limit storage; by default, PassForge uses built-in in-memory rate limiting.";s:7:"Project";s:39:"https://github.com/JPetovello/PassForge";s:7:"Support";s:46:"https://github.com/JPetovello/PassForge/issues";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/JPetovello/unraid-templates/main/templates/passforge.xml";s:6:"ReadMe";s:69:"https://raw.githubusercontent.com/JPetovello/PassForge/main/README.md";s:11:"ExtraParams";s:119:"--read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777 --cap-drop=ALL --security-opt=no-new-privileges:true";s:16:"ExtraSearchTerms";s:120:"password passwords passphrase passphrases password strength entropy HIBP Have I Been Pwned security generator EFF zxcvbn";s:8:"Requires";s:198:"<br>No additional services are required. Internet access is required only for Have I Been Pwned breach checks. Password analysis and passphrase generation remain available independently of HIBP.<br>";s:4:"Date";s:10:"2026-09-14";s:7:"License";s:17:"AGPL-3.0-or-later";s:6:"Config";a:2:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"5000";s:7:"Default";s:4:"5150";s:4:"Mode";s:3:"tcp";s:11:"Description";s:53:"Host port used to access the PassForge web interface.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:9:"Redis URL";s:6:"Target";s:9:"REDIS_URL";s:7:"Default";s:9:"memory://";s:11:"Description";s:126:"Optional Redis connection URL for shared rate-limit storage. Leave as memory:// to use PassForge's built-in in-memory storage.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/templates/passforge.xml";s:4:"Repo";s:23:"JPetovello's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1789188852;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:642;s:11:"Displayable";b:1;s:6:"Author";s:10:"jpetovello";s:13:"DockerHubName";s:9:"passforge";s:8:"RepoName";s:23:"JPetovello's Repository";s:10:"SortAuthor";s:10:"jpetovello";s:8:"SortName";s:9:"PassForge";s:6:"random";i:1560573672;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/JPetovellosRepository/jpetovello-PassForge-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:643;a:38:{s:4:"Name";s:20:"X-ONU-SFPP-Dashboard";s:10:"Repository";s:46:"ghcr.io/jpetovello/x-onu-sfpp-dashboard:latest";s:8:"Registry";s:86:"https://github.com/JPetovello/x-onu-sfpp-dashboard/pkgs/container/x-onu-sfpp-dashboard";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:4:"Icon";s:97:"https://raw.githubusercontent.com/JPetovello/unraid-templates/main/icons/x-onu-sfpp-dashboard.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8080]";s:8:"Overview";s:1468:"A lightweight monitoring and alerting dashboard for EXEN X-ONU-SFPP and compatible ONTs running 8311 community firmware.

Core monitoring uses the 8311 JSON metrics endpoint to provide live and historical optical levels, temperatures, PLOAM state, connectivity, and profile-aware optical health without requiring SSH.

Optional SSH telemetry adds live XGS-PON traffic rates, byte counters, FEC/BIP/HEC/MIC statistics, active alarms, ONT system information, and optical module details.

On-demand Diagnostics provide standard status and counter views plus expert Datapath, PPv4, and burst-profile output over SSH. Diagnostics run only when explicitly requested and remain separate from normal background polling and alert processing.

Server-side alert monitoring provides configurable thresholds, severities, debounce behavior, counter-delta detection, and cooldowns. Alerts are stored in SQLite and continue to be evaluated even when the dashboard is not open.

Notifications are supported through Discord, ntfy, Gotify, Pushover, Generic Webhook, and Email (Gmail SMTP).

Telemetry and alert-history retention are configurable from the dashboard. Recent alerts are shown directly on the main dashboard, with a dedicated paginated Alert History view for retained events.

The dashboard also supports light, dark, and system themes.

The Unraid host must have network access to the ONT management IP. SSH access is optional and is required only for advanced telemetry.";s:7:"Project";s:50:"https://github.com/JPetovello/x-onu-sfpp-dashboard";s:7:"Support";s:68:"https://forums.unraid.net/topic/200639-support-x-onu-sfpp-dashboard/";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/JPetovello/unraid-templates/main/templates/x-onu-sfpp-dashboard.xml";s:6:"ReadMe";s:80:"https://raw.githubusercontent.com/JPetovello/x-onu-sfpp-dashboard/main/README.md";s:16:"ExtraSearchTerms";s:72:"XGS-PON XGSPON ONU ONT 8311 EXEN X-ONU-SFPP PON fiber optical monitoring";s:8:"Requires";s:627:"An EXEN X-ONU-SFPP or compatible ONT running 8311 community firmware with the JSON metrics endpoint enabled. The Unraid server must be able to reach the ONT management IP. SSH access to the ONT is optional and is required only for advanced telemetry.<br><br>Existing installations upgraded from older root-running versions may have root-owned application data. If the container cannot write to its existing database after upgrading, run this one-time command on the Unraid host if using the default appdata path:<br><br>chown -R 99:100 /mnt/user/appdata/x-onu-dashboard<br><br>Fresh installations require no permission changes.";s:4:"Date";s:10:"2026-09-21";s:7:"License";s:17:"AGPL-3.0-or-later";s:6:"Config";a:14:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8766";s:4:"Mode";s:3:"tcp";s:11:"Description";s:50:"Host port used to access the X-ONU-SFPP Dashboard.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:33:"/mnt/user/appdata/x-onu-dashboard";s:4:"Mode";s:2:"rw";s:11:"Description";s:51:"Persistent storage for the SQLite metrics database.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"tru