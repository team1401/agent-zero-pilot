The save game is chosen in the web UI by an admin: upload a .sav file, fetch it from a running dedicated server through its HTTPS API (game version 1.0 or newer, API token from server.GenerateAPIToken), or copy it over SSH. A "Refresh snapshot" button fetches the current state again. Visitors only see the map.

Reads saves from Update 5 up to 1.2.4. Works out of the box: the game's icons, names and in-game map (from Satisfactory 1.2.4) are included.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:11:"TemplateURL";s:106:"https://raw.githubusercontent.com/Tunefish92/unraid-templates/main/templates/satisfactory-map-renderer.xml";s:4:"Icon";s:110:"https://raw.githubusercontent.com/Tunefish92/SatisfactoryMapRenderer/main/unraid/satisfactory-map-renderer.png";s:7:"License";s:3:"MIT";s:10:"Screenshot";a:3:{i:0;s:103:"https://raw.githubusercontent.com/Tunefish92/SatisfactoryMapRenderer/main/docs/screenshots/overview.jpg";i:1;s:102:"https://raw.githubusercontent.com/Tunefish92/SatisfactoryMapRenderer/main/docs/screenshots/factory.jpg";i:2;s:110:"https://raw.githubusercontent.com/Tunefish92/SatisfactoryMapRenderer/main/docs/screenshots/statistics-dark.jpg";}s:16:"ExtraSearchTerms";s:67:"satisfactory map save savegame dedicated server factory interactive";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:26:"Port the map is served on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Data Path";s:6:"Target";s:5:"/data";s:7:"Default";s:43:"/mnt/user/appdata/satisfactory-map-renderer";s:4:"Mode";s:2:"rw";s:11:"Description";s:118:"The rendered map, exported game data, map images and the save game source settings (including the server's API token).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:43:"/mnt/user/appdata/satisfactory-map-renderer";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:18:"SMR_ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Required, at least 8 characters. Only admins who log in with it (Save game tab of the side panel) can choose or refresh the save game.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Game Folder";s:6:"Target";s:5:"/game";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:236:"Optional, normally not needed. A Satisfactory installation (the folder that contains FactoryGame and CommunityResources): if your game is newer than the game data in the image, the icons, names and in-game map are exported from it once.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Max Zoom";s:6:"Target";s:12:"SMR_MAX_ZOOM";s:7:"Default";s:1:"9";s:4:"Mode";s:0:"";s:11:"Description";s:142:"Highest rendered zoom level, 3 to 9. 9 is the sharpest; each level less renders about four times faster and needs a quarter of the disk space.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"9";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:88:"User ID that owns the data path; the app runs as this user. Unraid default: 99 (nobody).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:62:"Group ID that owns the data path. Unraid default: 100 (users).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:59:"/tmp/GitHub/AppFeed/templates/satisfactory-map-renderer.xml";s:4:"Repo";s:21:"Tunefish's Repository";s:12:"CategoryList";a:2:{i:0;s:11:"GameServe