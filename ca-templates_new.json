ision Model";s:6:"Target";s:19:"OLLAMA_VISION_MODEL";s:7:"Default";s:5:"llava";s:4:"Mode";s:0:"";s:11:"Description";s:61:"Vision-capable Ollama model used for auto-tagging thumbnails.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"llava";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Ollama Embed Model";s:6:"Target";s:18:"OLLAMA_EMBED_MODEL";s:7:"Default";s:16:"nomic-embed-text";s:4:"Mode";s:0:"";s:11:"Description";s:48:"Ollama embedding model used for semantic search.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"nomic-embed-text";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Username";s:6:"Target";s:13:"AUTH_USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:121:"Creates the admin login automatically on first start. Leave blank to set it up from the WebUI's first-run screen instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:13:"AUTH_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:172:"Paired with Admin Username above. Leave both blank to use the in-app setup screen instead (recommended -- avoids the password sitting in plain text in the container's env).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"Slicer CLI Path (advanced)";s:6:"Target";s:15:"SLICER_CLI_PATH";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:298:"Optional: absolute path *inside the container* to a headless slicer CLI binary (e.g. an extracted PrusaSlicer/OrcaSlicer AppImage) for exact print time/filament estimates instead of the built-in volumetric approximation. Bind-mount the binary in via 'Add another Path' first, then point this at it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/Model-Hub/model-hub.xml";s:4:"Repo";s:25:"allornothing's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:12:"Productivity";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:960;s:9:"FirstSeen";i:1788408392;s:10:"LastUpdate";i:1789335930;s:14:"LastUpdateScan";i:1791000596;s:8:"Category";s:29:"Tools:Utilities Productivity:";s:2:"ID";i:1510;s:11:"Displayable";b:1;s:6:"Author";s:12:"allornothing";s:13:"DockerHubName";s:8:"modelhub";s:8:"RepoName";s:25:"allornothing's Repository";s:10:"SortAuthor";s:12:"allornothing";s:8:"SortName";s:8:"ModelHub";s:6:"random";i:1048411277;s:9:"Blacklist";b:0;s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/allornothingsRepository/allornothing-ModelHub-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1511;a:42:{s:4:"Name";s:10:"repair-hub";s:10:"Repository";s:30:"allornothing/repair-hub:latest";s:8:"Registry";s:48:"https://hub.docker.com/r/allornothing/repair-hub";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:46:"https://github.com/aon082910/repair-hub/issues";s:7:"Project";s:39:"https://github.com/aon082910/repair-hub";s:11:"TemplateURL";s:90:"https://raw.githubusercontent.com/aon082910/AoN-Unraid-Apps/main/Repair-Hub/repair-hub.xml";s:6:"ReadMe";s:69:"https://raw.githubusercontent.com/aon082910/repair-hub/main/README.md";s:4:"Icon";s:84:"https://raw.githubusercontent.com/aon082910/AoN-Unraid-Apps/main/Repair-Hub/icon.png";s:5:"WebUI";s:24:"http://[IP]:[PORT:8000]/";s:7:"License";s:3:"MIT";s:8:"Overview";s:2047:"Self-hosted repair-reference and shop-management app. Vehicle records with VIN
decode, live NHTSA recalls/complaints and EPA fuel-economy specs, a DTC
(diagnostic trouble code) lookup preloaded with the ~140 generic SAE-standard
OBD-II codes, and free-text search against iFixit's guide library and
Wikimedia Commons for reference photos -- all backed by content you add
yourself (repair guides, wiring diagrams, photos).

Full shop management on top: customers, work orders, estimates with
no-login customer approval (signature capture included), appointment
scheduling with an .ics calendar feed, parts inventory, digital vehicle
inspections, sales tax, payment tracking, warranty tracking, a technician
time clock, email notifications, PDF invoices, and reports (revenue by
month, average repair time, top parts, outstanding balances). Three
account tiers share one login page -- staff (full access, with optional
2FA), technicians (repair reference plus only their assigned jobs), and
customers (their own vehicles and service history, via a login staff can
create for them).

Does not scrape, mirror, or resell ALLDATA or any other paid data provider --
if you already pay for ALLDATA, a vehicle's page lets you save a quick link
to the matching page in your own account, or attach a file you personally
exported. All other external lookups (NHTSA, EPA, iFixit, Wikimedia Commons)
are free, public APIs and degrade gracefully with no internet access.

SET DJANGO_SECRET_KEY before starting -- pick any long random string. Set
the superuser username and password too, or you'll have no way to log in
(create one later via `docker exec -it repair-hub python manage.py
createsuperuser` if you skip it here).

Everything lives under the single /config mount: the SQLite database and
all uploaded media (guide photos, wiring diagrams, ALLDATA attachments,
inspection photos). Back that one directory up and you've backed up the
whole app -- see the README for a scripted hot-backup that's safer than a
