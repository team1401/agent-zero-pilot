ription";s:176:"Optional in embedded mode: when left empty Alarm-HUB creates and persists a strong secret under /config. Set and keep a fixed value for external/managed deployments if desired.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Default Timezone";s:6:"Target";s:16:"DEFAULT_TIMEZONE";s:7:"Default";s:13:"Europe/Berlin";s:4:"Mode";s:0:"";s:11:"Description";s:31:"Default timezone for new users.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Berlin";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Secure Session Cookies";s:6:"Target";s:18:"SESSION_HTTPS_ONLY";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:122:"Default false for direct local HTTP access in Unraid. Set true when Alarm-HUB is published through an HTTPS reverse proxy.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"OpenRouteService API Key";s:6:"Target";s:24:"OPENROUTESERVICE_API_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:199:"Optional. Required for commute routing because Alarm-HUB uses OpenRouteService for address lookup and for Auto/Fahrrad routes. Bus/Bahn itself is routed through Transitous and needs no extra API key.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Admin E-Mails";s:6:"Target";s:12:"ADMIN_EMAILS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:176:"Optional. Comma-separated e-mail addresses of accounts that may open /admin (view, edit, lock and delete accounts, change the registration mode). Empty disables the admin page.";s:4:"Type";s:8:"Variable";s:7:"Displ