:0;d:1.054;i:1;d:1.268;i:2;d:2.225;i:3;d:1.981;i:4;d:0.666;i:5;d:2.66;i:6;d:2.564;}s:10:"trendsDate";a:7:{i:0;i:1774012291;i:1;i:1776611435;i:2;i:1779984444;i:3;i:1782746545;i:4;i:1785341103;i:5;i:1787933455;i:6;i:1790525754;}s:9:"FirstSeen";i:1781028981;s:10:"LastUpdate";i:1790095591;s:14:"LastUpdateScan";i:1790525754;s:11:"topTrending";d:1.51;s:13:"topPerforming";d:2.564;s:8:"Category";s:20:"Productivity: Cloud:";s:2:"ID";i:2792;s:11:"Displayable";b:1;s:6:"Author";s:13:"standardnotes";s:13:"DockerHubName";s:19:"standardnotes-webui";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:13:"standardnotes";s:8:"SortName";s:19:"StandardNotes WebUI";s:6:"random";i:353730;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:134:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/standardnotes-StandardNotesWebUI-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:1.51;s:12:"trendAverage";d:1.774;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2793;a:39:{s:4:"Name";s:10:"Stellarium";s:10:"Repository";s:34:"junkerderprovinz/stellarium:latest";s:8:"Registry";s:52:"https://hub.docker.com/r/junkerderprovinz/stellarium";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:6:"ReadMe";s:66:"https://github.com/junkerderprovinz/stellarium/blob/main/README.md";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:23:"https://stellarium.org/";s:8:"Overview";s:1759:"Stellarium, the free, open-source desktop planetarium, on a Selkies web desktop. Explore a photorealistic real-time sky in your browser: no VNC client, no local install. There is no maintained browser-desktop build of the actual Stellarium application ("Stellarium Web" is a separate, much lighter reimplementation), so this fills a genuine gap: a modern Selkies (WebRTC) build of the real thing for amd64 and arm64.

What you get:
• The full Stellarium desktop app, streamed as H.264 video (Selkies) so panning the sky, zooming into a nebula and scrubbing through time stay smooth, the continuously-rendered workload where the old noVNC containers feel laggy.
• Installed from Debian trixie's stellarium package, so it tracks Debian security updates.
• Software-GL (Mesa llvmpipe) fallback so the sky renders even without a GPU; a passed-through GPU is used when present.
• Your location, downloaded star catalogues, landscapes, plugins and screenshots persist under /config.

Notes:
• WebUI opens via HTTPS on port 3001 (self-signed cert, accept it once). The Selkies web client requires a secure connection, so open the WebUI directly ONLY over HTTPS (3001). Port 3000 (HTTP) is for a reverse proxy that terminates TLS in front of the container; opening it directly shows a "requires a secure connection (HTTPS)" error.
• PUID/PGID default to 99/100 (nobody/users on Unraid).
• Auth: leave "WebUI Username" and "Password" EMPTY to run without login. Set both to enable HTTP-basic auth on the WebUI. Recommended whenever the container is reachable beyond your LAN.
• GPU: a passed-through GPU is used when present; otherwise it falls back to software rendering.

Source on GitHub: https://github.com/junkerderprovinz/stellarium";s:5:"WebUI";s:25:"https://[IP]:[PORT:3001]/";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/stellarium/stellarium.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/stellarium/icon.png";s:11:"ExtraParams";s:39:"--restart=unless-stopped --shm-size=1gb";s:6:"Config";a:9:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"WebUI Port (HTTPS / Selkies)";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:179:"HTTPS port of the Selkies WebUI (self-signed cert). This is the default WebUI, and HTTPS is required for clipboard support in the browser. Accept the self-signed certificate once.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"WebUI Port (HTTP / Selkies)";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:311:"HTTP port of the Selkies WebUI. For a reverse proxy that terminates TLS in front of the container, NOT for direct browser access. The Selkies web client requires a secure context, so opening http://IP:3000 directly shows a 'requires a secure connection (HTTPS)' error. For direct access use the HTTPS port 3001.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"AppData (/config)";s:6:"Target";s:7:"/config";s:7:"Default";s:28:"/mnt/user/appdata/stellarium";s:4:"Mode";s:2:"rw";s:11:"Description";s:187:"Persistent Stellarium data: your chosen location, downloaded star catalogues and DSO textures, landscapes, enabled plugins, screenshots and preferences (stored under /config/.stellarium).";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/stellarium";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Username";s:6:"Target";s:11:"CUSTOM_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:173:"Optional. Username for HTTP-basic-auth on the WebUI. Leave EMPTY together with the password for no login. Set both fields to enable login (recommended outside trusted LANs).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Password";s:6:"Target";s:8:"PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:185:"Optional. Password for HTTP-basic-auth on the WebUI. Leave EMPTY together with the username for no login. STRONGLY recommended whenever the container is reachable from outside your LAN.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Timezone (TZ)";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/Vienna";s:4:"Mode";s:0:"";s:11:"Description";s:179:"Container timezone (affects log timestamps and file mtimes). Use this instead of a /etc/localtime bind-mount, because the LSIO base image manages /etc/localtime internally via TZ.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Vienna";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"User ID (PUID)";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:58:"User-ID Stellarium runs as. Default 99 (nobody on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Group ID (PGID)";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:40:"Group-ID. Default 100 (users on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:15:"000|022|002|077";s:4:"Mode";s:0:"";s:11:"Description";s:212:"Permission mask for newly created files. The default 000 lets every container user read and write them, which is what you want when other containers touch the same shares. Set 022 or 077 for stricter permissions.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/stellarium/stellarium.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:12:"Productivity";}s:9:"downloads";i:6997;s:9:"FirstSeen";i:1784678647;s:10:"LastUpdate";i:1789637684;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:29:"Tools:Utilities Productivity:";s:2:"ID";i:2793;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:10:"stellarium";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:10:"Stellarium";s:6:"random";i:2086130418;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:129:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-Stellarium-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2794;a:40:{s:4:"Name";s:10:"StrawDroid";s:10:"Repository";s:42:"ghcr.io/junkerderprovinz/strawdroid:latest";s:8:"Registry";s:72:"https://github.com/junkerderprovinz/strawdroid/pkgs/container/strawdroid";s:7:"Network";s:6:"br0.20";s:5:"MyMAC";s:0:"";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:75:"https://forums.unraid.net/topic/200577-support-junkerderprovinz-strawdroid/";s:7:"Project";s:46:"https://github.com/junkerderprovinz/strawdroid";s:6:"ReadMe";s:66:"https://github.com/junkerderprovinz/strawdroid/blob/main/README.md";s:8:"Overview";s:2752:"A straw droid is a practice dummy shaped like an Android phone: built like
    the real thing so somebody can strike at it without anybody getting hurt.
    This one runs the REAL Android emulator - the same AVD Android Studio
    starts - on a Selkies desktop, so an app under development can be
    installed, driven and broken without an APK ever touching a phone.
    
    NOT Android-in-a-container (ReDroid, Waydroid). Those run the Android
    userspace directly on the host kernel: no battery, no motion sensor, no
    power HAL. Doze therefore never fires, WorkManager runs more eagerly than it
    ever would on real hardware, and Android's limits on a dataSync
    foreground service never kick in. For an app whose job is syncing files in
    the background, a rig that is green because it never asks the question is
    worse than no rig at all.
    
    Android 16 (API 36), the NEWEST on purpose. It keeps the six-hour daily cap
    on dataSync foreground services that arrived in 14 AND the timeout that
    arrived in 15, so the newest level is the STRICTEST rather than a different
    one - and the Play Store wants a recent target level anyway. The google_apis
    image carries Play services and a real DocumentsUI, the SAF folder picker.
    
    Everything a phone has that the emulator can fake is switched on: a SIM
    that takes calls and SMS, a front and a back camera, every sensor the
    image offers (heart rate and wrist tilt among them), Bluetooth, and sound
    in the browser. Shizuku and PCAPdroid come installed for testing, and
    ROOT=true gives apps root. Android 14 is available as the latest-api34
    tag.
    
    Flutter apps need vm.overcommit_memory=1 on the host: without it the
    emulator crashes as soon as one draws. Add sysctl -w
    vm.overcommit_memory=1 to /boot/config/go to keep it after a reboot.
    
    Screen: Selkies over HTTPS on 3001. No login.
    
    Deploy from a development machine:
      adb connect container-ip:5555
    Android Studio then lists it as an ordinary device and deploys and debugs on
    it exactly like a phone on a cable.
    
    Force Doze, which is the point of using a real AVD:
      adb -s container-ip:5555 shell dumpsys deviceidle force-idle
    
    Needs /dev/kvm, passed in via Extra Parameters. Bottich is bare metal, so no
    nested virtualisation is involved. Without it the emulator will not start,
    and the container log says so in as many words.
    
    NOT set to restart on its own, on purpose. An emulator is a virtual machine
    and holds its memory whether anybody is testing or not - measured idle, with
    no app installed, about 6 GB. Start it when it is needed and stop it after.";s:5:"WebUI";s:25:"https://[IP]:[PORT:3001]/";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/strawdroid/strawdroid.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/strawdroid/icon.png";s:11:"ExtraParams";s:70:"--restart=no --device=/dev/kvm --shm-size=2gb --cpus="4" --memory="8g"";s:8:"Requires";s:69:"A CPU with hardware virtualisation, and /dev/kvm present on the host.";s:6:"Config";a:23:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"WebUI Port (HTTPS / Selkies)";s:6:"Target";s:4:"3001";s:7:"Default";s:4:"3001";s:4:"Mode";s:3:"tcp";s:11:"Description";s:169:"The desktop the emulator draws on, over WebRTC. Self-signed certificate - accept it once. HTTPS is the default because browsers only allow seamless clipboard over HTTPS.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3001";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"WebUI Port (HTTP / Selkies)";s:6:"Target";s:4:"3000";s:7:"Default";s:4:"3000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:55:"Optional fallback. The WebUI defaults to HTTPS on 3001.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3000";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"ADB Port";s:6:"Target";s:4:"5555";s:7:"Default";s:4:"5555";s:4:"Mode";s:3:"tcp";s:11:"Description";s:245:"Reached from a development machine with: adb connect container-ip:5555 . The emulator's own adb binds to loopback, so a forwarder inside the container hands this port to it; without that the port would appear open and never complete a handshake.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5555";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"AppData (/config)";s:6:"Target";s:7:"/config";s:7:"Default";s:28:"/mnt/user/appdata/strawdroid";s:4:"Mode";s:2:"rw";s:11:"Description";s:286:"The AVD itself, plus installed apps, granted permissions and anything a test wrote. The ONLY persistent mount by design. Without it every restart is a factory reset, which also throws away the folder permission an app was granted through the SAF picker - one of the things being tested.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:28:"/mnt/user/appdata/strawdroid";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:38:"Share for APKs and test files (/share)";s:6:"Target";s:6:"/share";s:7:"Default";s:18:"/mnt/user/download";s:4:"Mode";s:2:"ro";s:11:"Description";s:717:"Read-only. Drop an APK into this share from anywhere on the network and it appears ON THE DEVICE under Download/share, where the stock Files app and the SAF picker both find it - so it can be installed by tapping it on the phone, without a terminal. Mirrored rather than mounted, because an emulated phone is a virtual machine and a host directory is not reachable from inside it by any mount; the mirror compares sizes and timestamps and only sends what differs. From the container's terminal instead: sk list to see them, sk install name.apk to put one on the device, sk push file for test files. Read-only on purpose: this rig runs unfinished code, which has no business writing to a share full of everything else.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:18:"/mnt/user/download";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"Emulator rendering (EMULATOR_GPU)";s:6:"Target";s:12:"EMULATOR_GPU";s:7:"Default";s:4:"auto";s:4:"Mode";s:0:"";s:11:"Description";s:447:"How the emulator draws. auto uses a graphics card when one is passed in and the CPU otherwise, which works everywhere but is slow. Intel or AMD: add --device=/dev/dri to Extra Parameters. NVIDIA: add --runtime=nvidia to Extra Parameters and set NVIDIA_VISIBLE_DEVICES below; this needs the Nvidia Driver plugin. host forces the GPU, swiftshader_indirect forces the CPU. The READY block at the end of the log names the renderer Android ended up on.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"auto";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:35:"NVIDIA GPU (NVIDIA_VISIBLE_DEVICES)";s:6:"Target";s:22:"NVIDIA_VISIBLE_DEVICES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:153:"Only with an NVIDIA card and --runtime=nvidia in Extra Parameters: all, or the card's UUID from the Nvidia Driver plugin page. Empty leaves the card out.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:32:"Device profile (EMULATOR_DEVICE)";s:6:"Target";s:15:"EMULATOR_DEVICE";s:7:"Default";s:7:"pixel_6";s:4:"Mode";s:0:"";s:11:"Description";s:261:"Which device the emulator pretends to be. Decides screen size and density, which is what a layout is actually judged against. Read on FIRST boot only: the AVD is created once and then kept, so changing this later needs the AVD removed from /config/.android/avd.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"pixel_6";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"Emulated RAM in MB (EMULATOR_RAM)";s:6:"Target";s:12:"EMULATOR_RAM";s:7:"Default";s:4:"2048";s:4:"Mode";s:0:"";s:11:"Description";s:143:"Memory given to the emulated phone. Read on FIRST boot only, same as the device profile. Below about 1536 Android 14 boots badly or not at all.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2048";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:36:"Phone number (EMULATOR_PHONE_NUMBER)";s:6:"Target";s:21:"EMULATOR_PHONE_NUMBER";s:7:"Default";s:11:"12015550123";s:4:"Mode";s:0:"";s:11:"Description";s:304:"The SIM's number, digits only. The emulator's own default, 555-521-5554, is not a valid number to libphonenumber, so SMS apps that check numbers hide it. The default here is libphonenumber's US example number. Incoming SMS and calls come from the container's terminal: sk sms number text, sk call number.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"12015550123";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:34:"Back camera (EMULATOR_CAMERA_BACK)";s:6:"Target";s:20:"EMULATOR_CAMERA_BACK";s:7:"Default";s:7:"picture";s:4:"Mode";s:0:"";s:11:"Description";s:322:"picture shows a QR code that sk camera swaps for another code or a picture of your own, so scanning apps can be tested. emulated shows the emulator's moving test scene. none removes the camera, for testing how an app copes without one. imagefile:path and videofile:path show a picture or a video from inside the container.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"picture";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:36:"Front camera (EMULATOR_CAMERA_FRONT)";s:6:"Target";s:21:"EMULATOR_CAMERA_FRONT";s:7:"Default";s:8:"emulated";s:4:"Mode";s:0:"";s:11:"Description";s:32:"Same choices as the back camera.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"emulated";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Sound (EMULATOR_AUDIO)";s:6:"Target";s:14:"EMULATOR_AUDIO";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:122:"true sends the phone's sound to the browser tab, through the desktop's own audio. false starts the emulator without audio.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"Test tools (TEST_TOOLS)";s:6:"Target";s:10:"TEST_TOOLS";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:235:"true installs Shizuku and PCAPdroid once on each new device and starts the Shizuku server again after every boot, so apps that need it find it running. PCAPdroid shows which hosts an app talks to, without root. false leaves both alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Root for apps (ROOT)";s:6:"Target";s:4:"ROOT";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:254:"true gives apps root through su, for testing an app's root mode. The first start with it reboots the phone once to make the system partition writable. SELinux runs permissive then, unlike on most rooted phones, so leave it false unless a test needs root.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:46:"Extra emulator arguments (EMULATOR_EXTRA_ARGS)";s:6:"Target";s:19:"EMULATOR_EXTRA_ARGS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Passed to the emulator verbatim, for the occasional one-off (-writable-system, -dns-server, -netdelay). Empty is the ordinary case.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"AVD name (AVD_NAME)";s:6:"Target";s:8:"AVD_NAME";s:7:"Default";s:10:"strawdroid";s:4:"Mode";s:0:"";s:11:"Description";s:155:"The name of the virtual device inside /config. Changing it creates a SECOND device rather than renaming the first, which is a way to keep two side by side.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"strawdroid";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Username";s:6:"Target";s:11:"CUSTOM_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:88:"Optional. Leave EMPTY together with the password for no login. Set both to enable login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"WebUI Password";s:6:"Target";s:8:"PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:62:"Optional. Leave EMPTY together with the username for no login.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"Keyboard Layout (KEYBOARD_LAYOUT)";s:6:"Target";s:15:"KEYBOARD_LAYOUT";s:7:"Default";s:2:"us";s:4:"Mode";s:0:"";s:11:"Description";s:117:"X11 keyboard layout for the streamed desktop (us, de, ...). Typing into the emulator is half of what this rig is for.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"us";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Timezone (TZ)";s:6:"Target";s:2:"TZ";s:7:"Default";s:13:"Europe/Vienna";s:4:"Mode";s:0:"";s:11:"Description";s:107:"Container timezone. It reaches the emulated Android too, which matters for anything scheduled by the clock.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:13:"Europe/Vienna";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"User ID (PUID)";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:72:"User the desktop and the emulator run as. Default 99 (nobody on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Group ID (PGID)";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:37:"Group. Default 100 (users on Unraid).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:17:"TailscaleStateDir";s:0:"";s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/strawdroid/strawdroid.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:9:"CAComment";s:124:"This template is set up to use a custom network. You may have to adjust the network or IP address etc to match your system  ";s:9:"FirstSeen";i:1789615119;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:2794;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:10:"strawdroid";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:10:"StrawDroid";s:6:"random";i:1805422222;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:129:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-StrawDroid-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2795;a:38:{s:4:"Name";s:9:"TrickWork";s:10:"Repository";s:41:"ghcr.io/junkerderprovinz/trickwork:latest";s:8:"Registry";s:70:"https://github.com/junkerderprovinz/trickwork/pkgs/container/trickwork";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:7:"Support";s:52:"https://github.com/junkerderprovinz/trickwork/issues";s:7:"Project";s:45:"https://github.com/junkerderprovinz/trickwork";s:6:"ReadMe";s:65:"https://github.com/junkerderprovinz/trickwork/blob/main/README.md";s:8:"Overview";s:672:"TrickWork turns your images into proportional-font-aware ASCII art - a rebuild of the abandoned ASCII Gen 2, with a live interactive preview and TXT/XHTML/RTF/PNG export. Characters are picked by how much visual "ink" they actually cover at your chosen font, not just by brightness, so proportional (non-monospace) fonts render correctly instead of looking stretched or squashed. Nine of ASCII Gen 2's own original character ramps are built in, weighting mechanic included: repeat a character in the ramp and it claims proportionally more of the brightness range, exactly like the original. Fully stateless - no database, no accounts, nothing to configure beyond the port.";s:5:"WebUI";s:24:"http://[IP]:[PORT:3210]/";s:11:"TemplateURL";s:91:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/trickwork/trickwork.xml";s:4:"Icon";s:90:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/trickwork/icon.png?v=3";s:11:"ExtraParams";s:24:"--restart unless-stopped";s:6:"Config";a:2:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"3210";s:7:"Default";s:4:"3210";s:4:"Mode";s:3:"tcp";s:11:"Description";s:44:"Port the TrickWork web interface listens on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3210";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Port (PORT)";s:6:"Target";s:4:"PORT";s:7:"Default";s:4:"3210";s:4:"Mode";s:0:"";s:11:"Description";s:102:"Container-internal port the app listens on. Must match the WebUI Port above. Advanced - leave as 3210.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"3210";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/trickwork/trickwork.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:2:{i:0;s:15:"Tools-Utilities";i:1;s:15:"MediaApp-Photos";}s:9:"downloads";i:1950;s:9:"FirstSeen";i:1787112382;s:10:"LastUpdate";i:1788578051;s:14:"LastUpdateScan";i:1790001868;s:8:"Category";s:31:"Tools:Utilities MediaApp:Photos";s:2:"ID";i:2795;s:11:"Displayable";b:1;s:6:"Author";s:16:"junkerderprovinz";s:13:"DockerHubName";s:9:"trickwork";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:16:"junkerderprovinz";s:8:"SortName";s:9:"TrickWork";s:6:"random";i:252216111;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:128:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/junkerderprovinz-TrickWork-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2796;a:43:{s:4:"Name";s:9:"VersityGW";s:10:"Repository";s:24:"versity/versitygw:latest";s:8:"Registry";s:42:"https://hub.docker.com/r/versity/versitygw";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:76:"https://forums.unraid.net/topic/198811-support-junkerderprovinz-unraid-apps/";s:7:"Project";s:36:"https://github.com/versity/versitygw";s:6:"ReadMe";s:77:"https://github.com/junkerderprovinz/unraid-apps/blob/main/versitygw/README.md";s:8:"Overview";s:672:"Puts an S3 API in front of a folder you already have. Point it at a share and every file in it is an S3 object, readable over S3 and over SMB or NFS at the same time - no import, no second copy, no migration. Unlike an object store such as Garage or SeaweedFS, this one brings no storage of its own: your array stays the storage, and the bucket is a directory.Buckets are the top-level folders under the mapped path, objects are the files inside them. Ships an optional web interface for browsing and for managing accounts.Detailed README (setup, credentials, what works and what does not): https://github.com/junkerderprovinz/Unraid-apps/blob/main/versitygw/README.md";s:5:"WebUI";s:24:"http://[IP]:[PORT:7071]/";s:11:"TemplateURL";s:91:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/versitygw/versitygw.xml";s:4:"Icon";s:86:"https://raw.githubusercontent.com/junkerderprovinz/unraid-apps/main/versitygw/icon.png";s:8:"Requires";s:178:"Nothing beyond a folder to serve. Pick the access and secret key yourself before the first start - they are the root S3 credentials and the container will not start without them.";s:6:"Config";a:16:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"S3 API";s:6:"Target";s:4:"7070";s:7:"Default";s:4:"7070";s:4:"Mode";s:3:"tcp";s:11:"Description";s:81:"The S3 endpoint. Point your S3 client, backup tool or app at http://tower-ip:7070";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7070";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Web Interface";s:6:"Target";s:4:"7071";s:7:"Default";s:4:"7071";s:4:"Mode";s:3:"tcp";s:11:"Description";s:148:"Optional browser interface for buckets and accounts. Leave the variable 'Web Interface Address' empty to switch it off, then this port does nothing.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7071";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Admin API";s:6:"Target";s:4:"7080";s:7:"Default";s:4:"7080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:87:"Account administration endpoint. The web interface needs it; an S3-only setup does not.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7080";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:10:"/mnt/user/";s:4:"Mode";s:2:"rw";s:11:"Description";s:187:"The folder served as S3. Its top-level subfolders become buckets, the files inside them become objects. Map an existing share to expose what is already there, or a new one to start empty.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"/mnt/user/";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Accounts";s:6:"Target";s:7:"/config";s:7:"Default";s:27:"/mnt/user/appdata/versitygw";s:4:"Mode";s:2:"rw";s:11:"Description";s:123:"Where the built-in account store keeps its users. Without this, every account except the root user is gone after a restart.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/user/appdata/versitygw";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Backend";s:6:"Target";s:11:"VGW_BACKEND";s:7:"Default";s:5:"posix";s:4:"Mode";s:0:"";s:11:"Description";s:158:"Which storage the gateway puts S3 in front of. 'posix' is the one that means 'the folder above'. Leave it alone unless you know you want s3, azure or scoutfs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"posix";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Served Path";s:6:"Target";s:15:"VGW_BACKEND_ARG";s:7:"Default";s:5:"/data";s:4:"Mode";s:0:"";s:11:"Description";s:117:"The path inside the container that the posix backend serves. Must match the container side of the Data mapping above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"/data";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Root Access Key";s:6:"Target";s:15:"ROOT_ACCESS_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:86:"The root S3 access key, your choice. This is the user name half of the S3 credentials.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Root Secret Key";s:6:"Target";s:15:"ROOT_SECRET_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:113:"The root S3 secret key, your choice. Treat it as a password: anything holding it has full access to every bucket.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"S3 Address";s:6:"Target";s:8:"VGW_PORT";s:7:"Default";s:5:":7070";s:4:"Mode";s:0:"";s:11:"Description";s:100:"Listen address for the S3 API inside the container. Change only together with the S3 API port above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:":7070";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Web Interface Address";s:6:"Target";s:14:"VGW_WEBUI_PORT";s:7:"Default";s:5:":7071";s:4:"Mode";s:0:"";s:11:"Description";s:80:"Listen address for the web interface. Empty switches the interface off entirely.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:":7071";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Admin Address";s:6:"Target";s:14:"VGW_ADMIN_PORT";s:7:"Default";s:5:":7080";s:4:"Mode";s:0:"";s:11:"Description";s:103:"Listen address for the admin API. Empty switches it off; the web interface then cannot manage accounts.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:":7080";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"Plain HTTP For Web Interface";s:6:"Target";s:16:"VGW_WEBUI_NO_TLS";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:140:"Serve the web interface over plain HTTP. Right for a LAN without a certificate; set to false once you put a reverse proxy with TLS in front.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Account Store";s:6:"Target";s:11:"VGW_IAM_DIR";s:7:"Default";s:7:"/config";s:4:"Mode";s:0:"";s:11:"Description";s:96:"Directory for the built-in account store. Must match the container side of the Accounts mapping.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:7:"/config";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Region";s:6:"Target";s:10:"VGW_REGION";s:7:"Default";s:9:"us-east-1";s:4:"Mode";s:0:"";s:11:"Description";s:144:"The S3 region string the gateway answers with. Many clients insist on one; the value itself does not matter as long as client and gateway agree.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"us-east-1";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Health Path";s:6:"Target";s:10:"VGW_HEALTH";s:7:"Default";s:8:"/_health";s:4:"Mode";s:0:"";s:11:"Description";s:111:"A GET on this path answers without credentials, so a monitor or a reverse proxy can check the gateway is alive.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"/_health";}}s:12:"TemplatePath";s:43:"/tmp/GitHub/AppFeed/versitygw/versitygw.xml";s:4:"Repo";s:29:"junkerderprovinz's Repository";s:12:"CategoryList";a:4:{i:0;s:6:"Backup";i:1;s:5:"Cloud";i:2;s:13:"Network-Other";i:3;s:15:"Tools-Utilities";}s:5:"stars";i:1;s:9:"downloads";i:657712;s:13:"downloadtrend";a:2:{i:0;i:231890;i:1;i:657712;}s:6:"trends";a:1:{i:0;d:64.743;}s:10:"trendsDate";a:1:{i:0;i:1792262791;}s:9:"FirstSeen";i:1789615119;s:10:"LastUpdate";i:1788564247;s:14:"LastUpdateScan";i:1792262791;s:8:"Category";s:44:"Backup: Cloud: Network:Other Tools:Utilities";s:2:"ID";i:2796;s:11:"Displayable";b:1;s:6:"Author";s:7:"versity";s:13:"DockerHubName";s:9:"versitygw";s:8:"RepoName";s:29:"junkerderprovinz's Repository";s:10:"SortAuthor";s:7:"versity";s:8:"SortName";s:9:"VersityGW";s:6:"random";i:773475491;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:119:"/tmp/community.applications/tempFiles/templates-community-apps/junkerderprovinzsRepository/versity-VersityGW-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2797;a:36:{s:4:"Name";s:21:"Intel-IPEX-LLM-Ollama";s:10:"Repository";s:41:"ghcr.io/justjoseorg/ollama-intel-gpu:main";s:8:"Registry";s:44:"https://