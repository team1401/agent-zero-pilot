in (publish / delete / yank / mirror); leave it blank for a read-only public index. To proxy public PyPI on demand, set Proxy Upstream to https://pypi.org/simple/.Notes for Unraid: the container runs as the standard appdata user (99:100) so it can write to /data. The Data path IS your registry — back it up. Heads-up: pypiron is early (version 0.0.0 placeholder, beta) — run it where the blast radius is bounded.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8080]/";s:4:"Icon";s:88:"https://raw.githubusercontent.com/blackthorn-interstellar/pypiron-unraid/master/icon.png";s:11:"TemplateURL";s:101:"https://raw.githubusercontent.com/blackthorn-interstellar/pypiron-unraid/master/templates/pypiron.xml";s:6:"ReadMe";s:89:"https://raw.githubusercontent.com/blackthorn-interstellar/pypiron-unraid/master/README.md";s:11:"ExtraParams";s:13:"--user 99:100";s:16:"ExtraSearchTerms";s:105:"pypi python package index registry mirror proxy private devpi pypiserver bandersnatch proxpi uv pip twine";s:8:"Requires";s:98:"Outbound internet is only needed if you enable the proxy or sync. A pure private index needs none.";s:4:"Date";s:10:"2026-06-29";s:6:"MinVer";s:6:"6.12.0";s:7:"License";s:3:"MIT";s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:48:"HTTP port the index and web dashboard listen on.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:5:"/data";s:7:"Default";s:25:"/mnt/user/appdata/pypiron";s:4:"Mode";s:2:"rw";s:11:"Description";s:196:"The package storage tree — this IS your registry (private uploads + mirrored/proxied cache). Back it up. Upload/proxy spooling also lands here, so multi-GB wheels never spool into container RAM.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/pypiron";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:18:"PYPIRON_ADMIN_PASS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:175:"Set this to enable uploads + admin actions (publish / delete / yank / mirror). Leave blank for a read-only public index. Reads stay public unless you also set a Read Password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proxy Upstream";s:6:"Target";s:22:"PYPIRON_PROXY_UPSTREAM";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:161:"Turn on the on-demand pull-through proxy of a public index. Set to https://pypi.org/simple/ to lazily proxy and cache PyPI. Leave blank for a private-only index.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Admin User";s:6:"Target";s:18:"PYPIRON_ADMIN_USER";s:7:"Default";s:5:"admin";s:4:"Mode";s:0:"";s:11:"Description";s:34:"Username for the admin credential.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"admin";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Spool Dir";s:6:"Target";s:17:"PYPIRON_SPOOL_DIR";s:7:"Default";s:11:"/data/spool";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Where uploads/downloads spool to disk. Kept under /data (real disk) on purpose so large wheels never spool into container RAM.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:11:"/data/spool";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Read User";s:6:"Target";s:17:"PYPIRON_READ_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:122:"Set Read User + Read Password to make the whole index private (reads require auth). Leave both blank to keep reads public.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Read Password";s:6:"Target";s:17:"PYPIRON_READ_PASS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:49:"Password for the read credential (see Read User).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/pypiron.xml";s:4:"Repo";s:20:"pypiron's Repository";s:12:"CategoryList";a:2:{i:0;s:18:"Network-Management";i:1;s:15:"Tools-Utilities";}s:16:"ChangeLogPresent";s:1:"1";s:9:"FirstSeen";i:1783036023;s:8:"Category";s:34:"Network:Management Tools:Utilities";s:2:"ID";i:1658;s:11:"Displayable";b:1;s:6:"Author";s:23:"blackthorn-interstellar";s:13:"DockerHubName";s:7:"pypiron";s:8:"RepoName";s:20:"pypiron's Repository";s:10:"SortAuthor";s:23:"blackthorn-interstellar";s:8:"SortName";s:7:"pypiron";s:6:"random";i:1976872987;s:9:"Blacklist";b:0;s:4:"Path";s:123:"/tmp/community.applications/tempFiles/templates-community-apps/pypironsRepository/blackthorninterstellar-pypiron-latest.xml";s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1659;a:42:{s:4:"Name";s:21:"ARK-Survival-Ascended";s:10:"Repository";s:40:"ferment9348/ark-survival-ascended:latest";s:8:"Registry";s:59:"https://hub.docker.com/r/ferment9348/ark-survival-ascended/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/blckassassin/unraid-game-servers/issues";s:7:"Project";s:51:"https://github.com/blckassassin/unraid-game-servers";s:8:"Overview";s:821:"ARK: Survival Ascended dedicated server. Windows depot via SteamCMD, run under GE-Proton - both fetched on first start, so the image stays small.

Plan for the size: about 15GB installed, and 16GB RAM is a sensible floor for a vanilla map. Put the appdata on an SSD or cache pool - ARK is heavy on random I/O and spinning disks make startup and saves noticeably slower.

First boot downloads about 13GB and then builds a Proton prefix. Expect a long, quiet first startup; check the logs rather than assuming it hung.

A "config" shortcut at the top of the game files folder points at the config directory, so you can browse to it over SMB. Stop the container before editing - the server rewrites GameUserSettings.ini on shutdown.

Only 7777/udp needs forwarding. Forward RCON only if you administer from outside your LAN.";s:11:"TemplateURL";s:93:"https://raw.githubusercontent.com/blckassassin/ArkSA/main/templates/ark-survival-ascended.xml";s:4:"Icon";s:80:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/icon.png";s:6:"ReadMe";s:109:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/games/ark-survival-ascended/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:58:"ark survival ascended asa dedicated server steamcmd proton";s:11:"ExtraParams";s:56:"--restart=unless-stopped --ulimit nofile=1048576:1048576";s:8:"Requires";s:285:"About 15GB of disk for the game files, and 16GB RAM as a practical floor for a vanilla map - a stock TheIsland_WP server settles around 10GB. Put the appdata on a cache pool or SSD share rather than the array: ARK is heavy on random I/O, so spinning disks slow startup and world saves.";s:6:"Config";a:31:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Game Port";s:6:"Target";s:4:"7777";s:7:"Default";s:4:"7777";s:4:"Mode";s:3:"udp";s:11:"Description";s:755:"Game traffic. This is the one that has to be forwarded. To change it, set the Container Port, the Host Port and Server Port below all to the same number - Docker cannot tell the server what its host port is, so the three have to agree for the log to report the port players actually type. Peer Port below follows it too. Unraid greys out that Container Port box for every port a template supplied, so you cannot type your number into it. To move this port, Remove this entry and add your own Port entry with the Container Port and the Host Port both set to your number - a port entry you create yourself has no container port yet, and Unraid leaves those editable. A template update can restore this entry alongside yours; remove it again. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Port";s:6:"Target";s:9:"GAME_PORT";s:7:"Default";s:4:"7777";s:4:"Mode";s:0:"";s:11:"Description";s:301:"The port the server binds, passed as -port, and the number it prints in the log. Keep it equal to Game Port above, both the Container Port and the Host Port. If it differs from the Container Port nothing reaches the server; if it differs from the Host Port the log reports a number players cannot use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Peer Port";s:6:"Target";s:4:"7778";s:7:"Default";s:4:"7778";s:4:"Mode";s:3:"udp";s:11:"Description";s:276:"Game port + 1, derived by the engine - there is no variable for it. Not normally required, but cheap to forward if players report flaky connects. If you move Game Port, replace this entry the same way, with both sides set to your number + 1, or this mapping points at nothing.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7778";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Query Port";s:6:"Target";s:5:"27015";s:7:"Default";s:5:"27015";s:4:"Mode";s:3:"udp";s:11:"Description";s:110:"Legacy Steam query port. Vestigial in ASA - discovery runs through EOS. Left here for tooling that expects it.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27015";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"RCON Port";s:6:"Target";s:5:"27020";s:7:"Default";s:5:"27020";s:4:"Mode";s:3:"tcp";s:11:"Description";s:110:"Source RCON. Only forward at the router if you administer remotely, and never without a strong admin password.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27020";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Game Files";s:6:"Target";s:23:"/serverdata/serverfiles";s:7:"Default";s:40:"/mnt/cache/appdata/ark-survival-ascended";s:4:"Mode";s:2:"rw";s:11:"Description";s:167:"Where the server files, saves and configs live - about 15GB. Use a cache pool or SSD share: ARK is heavy on random I/O and spinning disks slow startup and world saves.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:40:"/mnt/cache/appdata/ark-survival-ascended";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SteamCMD";s:6:"Target";s:20:"/serverdata/steamcmd";s:7:"Default";s:27:"/mnt/cache/appdata/steamcmd";s:4:"Mode";s:2:"rw";s:11:"Description";s:82:"Shared SteamCMD install. Safe to point several game containers at the same folder.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:27:"/mnt/cache/appdata/steamcmd";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Name";s:6:"Target";s:11:"SERVER_NAME";s:7:"Default";s:10:"ASA Server";s:4:"Mode";s:0:"";s:11:"Description";s:49:"Session name shown in the Unofficial server list.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:10:"ASA Server";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"Map";s:6:"Target";s:3:"MAP";s:7:"Default";s:12:"TheIsland_WP";s:4:"Mode";s:0:"";s:11:"Description";s:193:"Note the _WP suffix - ASA maps are World Partition and the bare ASE name will not load. e.g. TheIsland_WP, ScorchedEarth_WP, TheCenter_WP, Aberration_WP, Extinction_WP, Ragnarok_WP, Astraeos_WP";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"TheIsland_WP";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Max Players";s:6:"Target";s:11:"MAX_PLAYERS";s:7:"Default";s:2:"20";s:4:"Mode";s:0:"";s:11:"Description";s:69:"Passed as -WinLiveMaxPlayers. The old ?MaxPlayers= is ignored by ASA.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"20";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Server Password";s:6:"Target";s:7:"SRV_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:46:"Join password. Leave blank for an open server.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:13:"SRV_ADMIN_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:111:"Admin password, and also the RCON password - ASA has no separate RCON credential. Change this from the default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:8:"changeme";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Mods";s:6:"Target";s:4:"MODS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:150:"Comma separated CurseForge project IDs, no spaces. ASA mods come from CurseForge, not the Steam Workshop. Load order follows the list, leftmost first.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Crossplay";s:6:"Target";s:9:"CROSSPLAY";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:150:"Set true to let Epic Games Store players join. Not on by default for self-hosted servers - this is the usual reason Epic players cannot find a server.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"BattlEye";s:6:"Target";s:8:"BATTLEYE";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:97:"BattlEye does not run cleanly under Proton, so this defaults to false (which passes -NoBattlEye).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Extra Game Parameters";s:6:"Target";s:17:"GAME_PARAMS_EXTRA";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:101:"Extra dash flags, space separated. e.g. -ForceAllowCaveFlyers -servergamelog -NoTransferFromFiltering";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Extra Query Parameters";s:6:"Target";s:18:"QUERY_PARAMS_EXTRA";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Extra ?key=value pairs for the map string, no leading ?. e.g. AllowCrateSpawnsOnTopOfStructures=true?PreventDownloadSurvivors=false";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Cluster ID";s:6:"Target";s:10:"CLUSTER_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:105:"Set the same value on every server in a cluster to enable transfers. Leave blank for a standalone server.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Cluster Directory";s:6:"Target";s:11:"CLUSTER_DIR";s:7:"Default";s:31:"/serverdata/serverfiles/cluster";s:4:"Mode";s:0:"";s:11:"Description";s:92:"Shared transfer folder. For a real cluster, map this to a path shared by all the containers.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:31:"/serverdata/serverfiles/cluster";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Validate Files";s:6:"Target";s:8:"VALIDATE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:97:"Set to true to have SteamCMD verify every file on start. Slow - turn it back off once it has run.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Debug Logging";s:6:"Target";s:5:"DEBUG";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:223:"Set true to capture verbose wine output and a Proton log in the logs folder under your game files. Use this when the server exits during startup without writing an engine log. Noisy and slower - turn it back off afterwards.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proton Version";s:6:"Target";s:14:"PROTON_VERSION";s:7:"Default";s:14:"GE-Proton10-34";s:4:"Mode";s:0:"";s:11:"Description";s:327:"Leave this alone unless you know why you are changing it. GE-Proton 11 hangs the ASA server before it writes any log at all - no crash, no error, it just never starts. Verified with this image: GE-Proton11-5 hangs, GE-Proton10-34 starts in under a minute on the same files. Setting 'latest' will currently get you GE-Proton 11.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"GE-Proton10-34";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Stop Timeout";s:6:"Target";s:12:"STOP_TIMEOUT";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Seconds to wait for a graceful save-and-exit before force killing. Also raise Unraid's own container stop timeout to match.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Username";s:6:"Target";s:8:"USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:54:"Leave blank. The ASA server app downloads anonymously.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:24;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Password";s:6:"Target";s:7:"PASSWRD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:54:"Leave blank. The ASA server app downloads anonymously.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:25;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"UID";s:6:"Target";s:3:"UID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:34:"User ID. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:26;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GID";s:6:"Target";s:3:"GID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Group ID. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:27;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Fix Share Permissions";s:6:"Target";s:9:"FIX_PERMS";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:225:"Keeps the Saved folder (configs and saves) readable and writable over SMB, so you can edit the ini files from a Windows PC. Runs on every start and again on shutdown. Set false only if you want to manage permissions yourself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:28;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Config UMASK";s:6:"Target";s:12:"CONFIG_UMASK";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:348:"umask applied to the Saved folder (configs and saves) when Fix Share Permissions is on. Leave blank to reuse the container UMASK, which is the usual choice. 000 = everyone can edit. 007 = owner and group only, which still works for Unraid SMB users since they belong to the users group. 022 = read-only for everyone but the owner. 077 = owner only.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:29;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Data Permissions";s:6:"Target";s:9:"DATA_PERM";s:7:"Default";s:3:"775";s:4:"Mode";s:0:"";s:11:"Description";s:159:"chmod applied to the top-level server files folder. 775 rather than 770 so an SMB client that is not the owner and not in the group can still traverse into it.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"775";}i:30;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:137:"umask for files the server creates. 000 means new files land as 666 and new directories as 777, which keeps them editable over the share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:55:"/tmp/GitHub/AppFeed/templates/ark-survival-ascended.xml";s:4:"Repo";s:21:"Blairwin's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"GameServers";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:1641;s:9:"FirstSeen";i:1787185369;s:10:"LastUpdate";i:1789742820;s:14:"LastUpdateScan";i:1792411842;s:8:"Category";s:12:"GameServers:";s:2:"ID";i:1659;s:11:"Displayable";b:1;s:6:"Author";s:11:"ferment9348";s:13:"DockerHubName";s:21:"ark-survival-ascended";s:8:"RepoName";s:21:"Blairwin's Repository";s:10:"SortAuthor";s:11:"ferment9348";s:8:"SortName";s:21:"ARK Survival Ascended";s:6:"random";i:1482765207;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:125:"/tmp/community.applications/tempFiles/templates-community-apps/BlairwinsRepository/ferment9348-ARKSurvivalAscended-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1660;a:42:{s:4:"Name";s:21:"RuneScape-Dragonwilds";s:10:"Repository";s:30:"ferment9348/dragonwilds:latest";s:8:"Registry";s:49:"https://hub.docker.com/r/ferment9348/dragonwilds/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/blckassassin/unraid-game-servers/issues";s:7:"Project";s:51:"https://github.com/blckassassin/unraid-game-servers";s:8:"Overview";s:682:"RuneScape: Dragonwilds dedicated server. Native Linux binary via SteamCMD - no Proton or wine. First boot downloads about 1.5GB and settles at about 5GB.

Owner ID is required - your in-game Player ID, from the bottom of the in-game Settings menu. Without it the server runs but turns away every player, so this container refuses to start and says so in the log.

The fields below are written into DedicatedServer.ini on every start, so changing one and restarting takes effect. Anything else in that file is left alone.

Stopping does not save. The server autosaves every 5 minutes, so a stop costs at most that. For a clean stop, have players quit out through the game menu first.";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/blckassassin/ArkSA/main/templates/dragonwilds.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/dragonwilds.png";s:6:"ReadMe";s:99:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/games/dragonwilds/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:53:"runescape dragonwilds jagex survival dedicated server";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:275:"About 5GB once installed, from a 1.5GB download, so allow 8GB of free space for saves and updates. Roughly 2GB of RAM plus 1GB per player, so 8GB for a full server - the cap is 6 players. The array is fine; a cache drive or SSD makes world loads and saves noticeably quicker.";s:6:"Config";a:19:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Game Port";s:6:"Target";s:4:"7777";s:7:"Default";s:4:"7777";s:4:"Mode";s:3:"udp";s:11:"Description";s:1068:"Game traffic, UDP, and the port to forward on your router. To move it you must set THREE things to the same number: this Host Port box, the Container Port behind the Edit button on this row, and Server Port below. That is not a Docker convention - this game advertises the port the server BINDS, so a port mapping cannot translate it. Publish 7780 against a server bound to 7777 and your world is listed, reports ready, heartbeats fine, logs no errors, and every player who clicks it is sent to 7777 instead. If something else on this box already listens on the number you pick, Docker refuses to start this container - pick another. Unraid greys out that Container Port box for every port a template supplied, so you cannot type your number into it. To move this port, Remove this entry and add your own Port entry with the Container Port and the Host Port both set to your number - a port entry you create yourself has no container port yet, and Unraid leaves those editable. A template update can restore this entry alongside yours; remove it again. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Port";s:6:"Target";s:9:"GAME_PORT";s:7:"Default";s:4:"7777";s:4:"Mode";s:0:"";s:11:"Description";s:290:"The port the server binds, and the port it advertises to other players - those are the same number and nothing can separate them. It must equal Game Port above, BOTH the Host Port and the Container Port. Under Network Type host there is no mapping and this is the only port number there is.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Beacon Port";s:6:"Target";s:4:"8888";s:7:"Default";s:4:"8888";s:4:"Mode";s:3:"udp";s:11:"Description";s:622:"The world settings beacon. The server binds this on top of the game port and the number is compiled into the game, so it cannot be moved - which also means only one of these containers per box can publish it. Whether clients actually need to reach it is UNTESTED; nothing has been reported broken without it. Publishing it costs nothing if 8888 is free. The server binds a third socket too, UDP 45453 for LAN discovery, which is deliberately not here: it is broadcast-based and Docker bridge networks do not carry the host LAN broadcasts it needs, so publishing it would promise something that cannot work. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8888";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Game Files";s:6:"Target";s:23:"/serverdata/serverfiles";s:7:"Default";s:29:"/mnt/user/appdata/dragonwilds";s:4:"Mode";s:2:"rw";s:11:"Description";s:203:"Where the server, saves and config live. About 5GB - see Requires below. Your worlds are under RSDragonwilds/Saved/SaveGames and your config is RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/mnt/user/appdata/dragonwilds";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SteamCMD";s:6:"Target";s:20:"/serverdata/steamcmd";s:7:"Default";s:26:"/mnt/user/appdata/steamcmd";s:4:"Mode";s:2:"rw";s:11:"Description";s:69:"SteamCMD itself. Small, and shareable with other SteamCMD containers.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/steamcmd";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Owner ID";s:6:"Target";s:8:"OWNER_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:314:"REQUIRED. Your in-game Player ID: open RuneScape: Dragonwilds, go to Settings, and it is at the bottom of that menu with a copy button next to it. The server will not serve anyone without this, and this container refuses to start without it rather than run something that looks healthy and turns every player away.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Name";s:6:"Target";s:11:"SERVER_NAME";s:7:"Default";s:18:"Dragonwilds Server";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Name shown in the server browser. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:18:"Dragonwilds Server";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"World Name";s:6:"Target";s:10:"WORLD_NAME";s:7:"Default";s:8:"Standard";s:4:"Mode";s:0:"";s:11:"Description";s:402:"Names the world the server creates on first boot, and the save file it uses - SaveGames/name.sav. This is most likely also the name players type to find you under Worlds then Public, and it is case-sensitive, so pick something you are happy telling people. Changing it after first boot starts a NEW world; the old one stays on disk and setting this name back returns to it. It does not rename anything.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:8:"Standard";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:13:"SRV_ADMIN_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:309:"Anyone who enters this in the game's Pause Menu, Settings, Server Management tab becomes an admin on this server. Leave it blank and the server generates a random one on first boot and prints it in the log - so setting one here is the easier path. Changing it revokes admin from everyone who used the old one.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"World Password";s:6:"Target";s:7:"SRV_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:113:"Join password. Leave blank for a server anyone can join. This supersedes any password stored in the world itself.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Extra Game Parameters";s:6:"Target";s:17:"GAME_PARAMS_EXTRA";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:346:"Appended to the launch line verbatim. Nothing routine needs this - every documented setting lives in DedicatedServer.ini, not on the command line. The one known use is attempting to raise the 6-player cap, which is not in that file: -ini:Game:[/Script/Engine.GameSession]:MaxPlayers=8 - though whether a value above 6 does anything is unverified.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Validate Files";s:6:"Target";s:8:"VALIDATE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:129:"Set to true to have SteamCMD verify every file on the next start. Slow on a 5GB install. Use it after a crash or a failed update.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Stop Timeout";s:6:"Target";s:12:"STOP_TIMEOUT";s:7:"Default";s:2:"30";s:4:"Mode";s:0:"";s:11:"Description";s:272:"Seconds to wait for the engine to shut down before force killing. This is not a save window - shutdown does not save, and the 5-minute autosave is what protects the world. Measured teardown is about 2 seconds. Also raise Unraid's own container stop timeout to at least 45.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"30";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Username";s:6:"Target";s:8:"USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:58:"Leave blank. The Dragonwilds server downloads anonymously.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Password";s:6:"Target";s:7:"PASSWRD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:12:"Leave blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"UID";s:6:"Target";s:3:"UID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:110:"User ID. 99 is the Unraid default. It must not be 0 - the server refuses to run as root and aborts on startup.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GID";s:6:"Target";s:3:"GID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Group ID. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Data Permissions";s:6:"Target";s:9:"DATA_PERM";s:7:"Default";s:3:"775";s:4:"Mode";s:0:"";s:11:"Description";s:48:"Mode applied to the top of the server directory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"775";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:75:"umask for files the server creates. 000 keeps them editable over the share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:45:"/tmp/GitHub/AppFeed/templates/dragonwilds.xml";s:4:"Repo";s:21:"Blairwin's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"GameServers";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:1291;s:9:"FirstSeen";i:1789615119;s:10:"LastUpdate";i:1789742855;s:14:"LastUpdateScan";i:1792262791;s:8:"Category";s:12:"GameServers:";s:2:"ID";i:1660;s:11:"Displayable";b:1;s:6:"Author";s:11:"ferment9348";s:13:"DockerHubName";s:21:"runescape-dragonwilds";s:8:"RepoName";s:21:"Blairwin's Repository";s:10:"SortAuthor";s:11:"ferment9348";s:8:"SortName";s:21:"RuneScape Dragonwilds";s:6:"random";i:593569663;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:126:"/tmp/community.applications/tempFiles/templates-community-apps/BlairwinsRepository/ferment9348-RuneScapeDragonwilds-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1661;a:42:{s:4:"Name";s:8:"Terraria";s:10:"Repository";s:27:"ferment9348/terraria:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/ferment9348/terraria/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/blckassassin/unraid-game-servers/issues";s:7:"Project";s:51:"https://github.com/blckassassin/unraid-game-servers";s:8:"Overview";s:750:"Terraria dedicated server.

Terraria ships a native Linux server, so the install is just a small download from terraria.org, checksummed before it is unpacked. First boot installs about 45MB and generates a world in seconds.

Settings are applied on every start, so changing Max Players or the password here and restarting takes effect. The exception is World Name: pointing it at a name that does not exist yet generates a new world rather than renaming the old one, and the container will list the worlds it found in the log.

Only 7777/tcp needs forwarding, and note that it is TCP rather than UDP.

The server saves its world when the container stops. Leave Unraid's stop timeout at the default; the shutdown is designed to finish well inside it.";s:11:"TemplateURL";s:80:"https://raw.githubusercontent.com/blckassassin/ArkSA/main/templates/terraria.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/terraria.png";s:6:"ReadMe";s:96:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/games/terraria/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:33:"terraria dedicated server sandbox";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:159:"About 100MB of disk and very little RAM - 1GB is comfortable for a small server. It is not I/O heavy, so the array is fine and no cache drive or SSD is needed.";s:6:"Config";a:19:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Game Port";s:6:"Target";s:4:"7777";s:7:"Default";s:4:"7777";s:4:"Mode";s:3:"tcp";s:11:"Description";s:723:"Game traffic. TCP, not UDP. This is the one to forward. To change it, set the Container Port, the Host Port and Server Port below all to the same number - Docker cannot tell the server what its host port is, so the three have to agree for the log to report the port players actually type. Unraid greys out that Container Port box for every port a template supplied, so you cannot type your number into it. To move this port, Remove this entry and add your own Port entry with the Container Port and the Host Port both set to your number - a port entry you create yourself has no container port yet, and Unraid leaves those editable. A template update can restore this entry alongside yours; remove it again. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Port";s:6:"Target";s:9:"GAME_PORT";s:7:"Default";s:4:"7777";s:4:"Mode";s:0:"";s:11:"Description";s:284:"The port the server binds, and the number it prints in the log. Keep it equal to Game Port above, both the Container Port and the Host Port. If it differs from the Container Port nothing reaches the server; if it differs from the Host Port the log reports a number players cannot use.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"7777";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Server Files";s:6:"Target";s:23:"/serverdata/serverfiles";s:7:"Default";s:26:"/mnt/user/appdata/terraria";s:4:"Mode";s:2:"rw";s:11:"Description";s:89:"Where the server, worlds and config live. About 100MB - the array is fine, no SSD needed.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/terraria";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"World Name";s:6:"Target";s:10:"WORLD_NAME";s:7:"Default";s:5:"World";s:4:"Mode";s:0:"";s:11:"Description";s:155:"Name of the world file. Changing this after first boot generates a NEW world - the old one stays on disk and the log lists it. It does not rename anything.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"World";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"World Size";s:6:"Target";s:10:"WORLD_SIZE";s:7:"Default";s:1:"2";s:4:"Mode";s:0:"";s:11:"Description";s:78:"1 = small, 2 = medium, 3 = large. Only used when the world is first generated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"2";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Difficulty";s:6:"Target";s:10:"DIFFICULTY";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:94:"0 = classic, 1 = expert, 2 = master, 3 = journey. Only used when the world is first generated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"World Seed";s:6:"Target";s:10:"WORLD_SEED";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:104:"Optional seed for world generation. Leave blank for random. Only used when the world is first generated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Max Players";s:6:"Target";s:11:"MAX_PLAYERS";s:7:"Default";s:1:"8";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Player slots. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"8";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Server Password";s:6:"Target";s:7:"SRV_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:72:"Join password. Leave blank for an open server. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"MOTD";s:6:"Target";s:4:"MOTD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:38:"Message shown to players as they join.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Secure Mode";s:6:"Target";s:6:"SECURE";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:132:"Terraria's built-in anti-cheat validation, rejecting actions a legitimate client could not have produced. 1 = on (default), 0 = off.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"UPnP";s:6:"Target";s:4:"UPNP";s:7:"Default";s:1:"0";s:4:"Mode";s:0:"";s:11:"Description";s:210:"Ask the router to auto-forward the game port via UPnP. Off by default - manual port forwarding (see Game Port above) is more reliable and works even when the router has UPnP disabled. 1 = on, 0 = off (default).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"0";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Verbose Log";s:6:"Target";s:11:"VERBOSE_LOG";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:227:"Prints every line Terraria emits verbatim, including per-0.1% worldgen and save progress - thousands of lines on first boot. Leave off unless you are diagnosing something; it cannot slow the server down, it just floods the log.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Terraria Version";s:6:"Target";s:16:"TERRARIA_VERSION";s:7:"Default";s:4:"1458";s:4:"Mode";s:0:"";s:11:"Description";s:173:"Server build to install, as it appears in terraria.org's download URL. If you change this you MUST change the checksum below to match, or the container will refuse to start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"1458";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Terraria Checksum";s:6:"Target";s:15:"TERRARIA_SHA256";s:7:"Default";s:64:"f513a4ac9789d34af766291ae217c9cd7d9472e13782a0e2b17512f70d7a8334";s:4:"Mode";s:0:"";s:11:"Description";s:93:"sha256 of the server zip. Verified before anything is unpacked. Must match the version above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:64:"f513a4ac9789d34af766291ae217c9cd7d9472e13782a0e2b17512f70d7a8334";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Stop Timeout";s:6:"Target";s:12:"STOP_TIMEOUT";s:7:"Default";s:1:"6";s:4:"Mode";s:0:"";s:11:"Description";s:324:"Seconds to wait for a save-and-exit before force killing. Kept low on purpose: this plus a bounded 3s wait for the log reader must stay under Docker's 10s default stop grace (6+3=9s, 1s to spare). Raise this and you must raise the container's own stop timeout to match, or Docker's outer kill fires before the save finishes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"6";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"UID";s:6:"Target";s:3:"UID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:34:"User ID. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GID";s:6:"Target";s:3:"GID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Group ID. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:75:"umask for files the server creates. 000 keeps them editable over the share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/terraria.xml";s:4:"Repo";s:21:"Blairwin's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"GameServers";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:548;s:9:"FirstSeen";i:1788533325;s:10:"LastUpdate";i:1789742883;s:14:"LastUpdateScan";i:1791198847;s:8:"Category";s:12:"GameServers:";s:2:"ID";i:1661;s:11:"Displayable";b:1;s:6:"Author";s:11:"ferment9348";s:13:"DockerHubName";s:8:"terraria";s:8:"RepoName";s:21:"Blairwin's Repository";s:10:"SortAuthor";s:11:"ferment9348";s:8:"SortName";s:8:"Terraria";s:6:"random";i:1609520724;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/BlairwinsRepository/ferment9348-Terraria-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1662;a:42:{s:4:"Name";s:8:"V-Rising";s:10:"Repository";s:27:"ferment9348/v-rising:latest";s:8:"Registry";s:46:"https://hub.docker.com/r/ferment9348/v-rising/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/blckassassin/unraid-game-servers/issues";s:7:"Project";s:51:"https://github.com/blckassassin/unraid-game-servers";s:8:"Overview";s:869:"V Rising dedicated server. Windows depot via SteamCMD, run under GE-Proton. First boot downloads about 2GB and then builds a Proton prefix, which can sit quiet for several minutes before anything appears in the log. That is normal.

The fields below are passed as launch options on every restart, so changing one and restarting takes effect. Your own edits to ServerHostSettings.json and ServerGameSettings.json are never overwritten - those are seeded once and then left alone.

Anything without a field is still reachable: the server reads its own VR_ environment variables, so a variable named VR_FPS set to 45 sets the server framerate. See https://github.com/StunlockStudios/vrising-dedicated-server-instructions for the full list.

The server saves when the container stops. Raise Unraid's container stop timeout to at least 75 seconds so the save is not cut off.";s:11:"TemplateURL";s:80:"https://raw.githubusercontent.com/blckassassin/ArkSA/main/templates/v-rising.xml";s:4:"Icon";s:84:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/v-rising.png";s:6:"ReadMe";s:96:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/games/v-rising/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:42:"v rising vampire survival dedicated server";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:295:"About 4GB once installed - 1.6GB of server files, 2.1GB for the GE-Proton build and its wine prefix - so allow 6GB of free space for saves and updates. It is not a light server, so give it several GB of RAM. The array is fine; a cache drive or SSD makes world loads and saves noticeably quicker.";s:6:"Config";a:31:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Game Port";s:6:"Target";s:5:"27015";s:7:"Default";s:5:"27015";s:4:"Mode";s:3:"udp";s:11:"Description";s:847:"Game traffic. UDP. This is the one to forward. To change it, set the Container Port, the Host Port and Server Port below all to the same number - Docker cannot tell the server what its host port is, so the three have to agree for the log to report the port players actually type. If something else on this box already listens on 27015, Docker refuses to start this container - change this port, or the other one. Unraid greys out that Container Port box for every port a template supplied, so you cannot type your number into it. To move this port, Remove this entry and add your own Port entry with the Container Port and the Host Port both set to your number - a port entry you create yourself has no container port yet, and Unraid leaves those editable. A template update can restore this entry alongside yours; remove it again. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27015";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Port";s:6:"Target";s:9:"GAME_PORT";s:7:"Default";s:5:"27015";s:4:"Mode";s:0:"";s:11:"Description";s:103:"The port the server binds. Keep it equal to Game Port above, both the Container Port and the Host Port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27015";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Query Port";s:6:"Target";s:5:"27016";s:7:"Default";s:5:"27016";s:4:"Mode";s:3:"udp";s:11:"Description";s:187:"Steam server list traffic. Forward this too, or the server runs fine and never appears in the browser. If you move it, replace this entry the same way as Game Port above - see the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27016";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Server Query Port";s:6:"Target";s:10:"QUERY_PORT";s:7:"Default";s:5:"27016";s:4:"Mode";s:0:"";s:11:"Description";s:110:"The query port the server binds. Keep it equal to Query Port above, both the Container Port and the Host Port.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"27016";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"RCON Port";s:6:"Target";s:5:"25575";s:7:"Default";s:5:"25575";s:4:"Mode";s:3:"tcp";s:11:"Description";s:146:"RCON. Only forward this if you administer the server from outside this box - anyone who reaches it and has the admin password controls the server.";s:4:"Type";s:4:"Port";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"25575";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Server RCON Port";s:6:"Target";s:9:"RCON_PORT";s:7:"Default";s:5:"25575";s:4:"Mode";s:0:"";s:11:"Description";s:65:"The RCON port the server binds. Keep it equal to RCON Port above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"25575";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Game Files";s:6:"Target";s:23:"/serverdata/serverfiles";s:7:"Default";s:26:"/mnt/user/appdata/v-rising";s:4:"Mode";s:2:"rw";s:11:"Description";s:75:"Where the server, saves and settings live. Several GB - see Requires below.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/v-rising";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SteamCMD";s:6:"Target";s:20:"/serverdata/steamcmd";s:7:"Default";s:26:"/mnt/user/appdata/steamcmd";s:4:"Mode";s:2:"rw";s:11:"Description";s:69:"SteamCMD itself. Small, and shareable with other SteamCMD containers.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/steamcmd";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Name";s:6:"Target";s:11:"SERVER_NAME";s:7:"Default";s:15:"V Rising Server";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Name shown in the server browser. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"V Rising Server";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Save Name";s:6:"Target";s:10:"WORLD_NAME";s:7:"Default";s:6:"world1";s:4:"Mode";s:0:"";s:11:"Description";s:212:"Name of the save directory. Changing this after first boot starts a NEW world - the old one stays on disk under save-data/Saves and can be switched back to by setting this name again. It does not rename anything.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:6:"world1";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Max Players";s:6:"Target";s:11:"MAX_PLAYERS";s:7:"Default";s:2:"40";s:4:"Mode";s:0:"";s:11:"Description";s:70:"Player slots. 128 is the documented maximum. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"40";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Server Password";s:6:"Target";s:7:"SRV_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:72:"Join password. Leave blank for an open server. Applied on every restart.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Admin Password";s:6:"Target";s:13:"SRV_ADMIN_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:190:"RCON password. Leaving this blank disables RCON entirely, which is the safe default - the server still saves and shuts down cleanly without it. Set it only if you want to run admin commands.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Server Description";s:6:"Target";s:11:"SERVER_DESC";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:84:"Shown in the server browser's details panel, and printed in chat as players connect.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Max Admins";s:6:"Target";s:10:"MAX_ADMINS";s:7:"Default";s:1:"4";s:4:"Mode";s:0:"";s:11:"Description";s:55:"Admins allowed to connect even when the server is full.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"4";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"Game Settings Preset";s:6:"Target";s:11:"GAME_PRESET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:156:"Load one of the presets shipped in VRisingServer_Data/StreamingAssets/GameSettingPresets, e.g. StandardPvP. Blank uses ServerGameSettings.json as it stands.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Difficulty Preset";s:6:"Target";s:17:"DIFFICULTY_PRESET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:88:"Difficulty_Easy, Difficulty_Normal or Difficulty_Brutal. Blank leaves the setting alone.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"List on Steam";s:6:"Target";s:13:"LIST_ON_STEAM";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:49:"Register on the Steam server list. true or false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"List on EOS";s:6:"Target";s:11:"LIST_ON_EOS";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:91:"Register on the EOS server list, which is where the client looks by default. true or false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Secure Mode";s:6:"Target";s:6:"SECURE";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:65:"VAC protection. VAC banned clients cannot connect. true or false.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Extra Game Parameters";s:6:"Target";s:17:"GAME_PARAMS_EXTRA";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:108:"Appended to the launch line verbatim. Most settings do not need this - see the Overview about VR_ variables.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Validate Files";s:6:"Target";s:8:"VALIDATE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:112:"Set to true to have SteamCMD verify every file on the next start. Slow. Use it after a crash or a failed update.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Debug Logging";s:6:"Target";s:5:"DEBUG";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:124:"Turns on Proton and wine logging. Noisy and slows startup - use it when the server exits without writing any log of its own.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Proton Version";s:6:"Target";s:14:"PROTON_VERSION";s:7:"Default";s:14:"GE-Proton10-34";s:4:"Mode";s:0:"";s:11:"Description";s:250:"GE-Proton build to run the server under. This image is tested against GE-Proton10-34. A build the game does not tolerate fails silently, before any log is written - if that happens, set this back and delete the proton folder so the prefix is rebuilt.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"GE-Proton10-34";}i:24;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Stop Timeout";s:6:"Target";s:12:"STOP_TIMEOUT";s:7:"Default";s:2:"60";s:4:"Mode";s:0:"";s:11:"Description";s:123:"Seconds to wait for a graceful save-and-exit before force killing. Also raise Unraid's own container stop timeout to match.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"60";}i:25;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Username";s:6:"Target";s:8:"USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:55:"Leave blank. The V Rising server downloads anonymously.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:26;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Password";s:6:"Target";s:7:"PASSWRD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:12:"Leave blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:27;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"UID";s:6:"Target";s:3:"UID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:34:"User ID. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:28;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GID";s:6:"Target";s:3:"GID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Group ID. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:29;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Data Permissions";s:6:"Target";s:9:"DATA_PERM";s:7:"Default";s:3:"775";s:4:"Mode";s:0:"";s:11:"Description";s:48:"Mode applied to the top of the server directory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"775";}i:30;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:75:"umask for files the server creates. 000 keeps them editable over the share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/v-rising.xml";s:4:"Repo";s:21:"Blairwin's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"GameServers";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:180;s:9:"FirstSeen";i:1788768632;s:10:"LastUpdate";i:1789742889;s:14:"LastUpdateScan";i:1791384879;s:8:"Category";s:12:"GameServers:";s:2:"ID";i:1662;s:11:"Displayable";b:1;s:6:"Author";s:11:"ferment9348";s:13:"DockerHubName";s:8:"v-rising";s:8:"RepoName";s:21:"Blairwin's Repository";s:10:"SortAuthor";s:11:"ferment9348";s:8:"SortName";s:8:"V Rising";s:6:"random";i:1326879335;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:113:"/tmp/community.applications/tempFiles/templates-community-apps/BlairwinsRepository/ferment9348-VRising-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1663;a:42:{s:4:"Name";s:7:"Valheim";s:10:"Repository";s:26:"ferment9348/valheim:latest";s:8:"Registry";s:45:"https://hub.docker.com/r/ferment9348/valheim/";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/blckassassin/unraid-game-servers/issues";s:7:"Project";s:51:"https://github.com/blckassassin/unraid-game-servers";s:8:"Overview";s:678:"Valheim dedicated server. Native Linux binary via SteamCMD - no Proton or wine. First boot downloads about 2GB and settles at about 2.1GB.

A password is required unless you set Public to 0. It must be at least 5 characters and it must not appear anywhere inside the server name.

There is no config file. Every setting here is passed to the server as a launch flag, so changing a field and restarting takes effect immediately, and nothing you edit by hand is ever overwritten.

Stopping saves the world, but only if the container is given time. Valheim saves on shutdown and has no other way to be told to save, so raise Unraid's container stop timeout to at least 150 seconds.";s:11:"TemplateURL";s:79:"https://raw.githubusercontent.com/blckassassin/ArkSA/main/templates/valheim.xml";s:4:"Icon";s:83:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/valheim.png";s:6:"ReadMe";s:95:"https://raw.githubusercontent.com/blckassassin/unraid-game-servers/main/games/valheim/README.md";s:7:"License";s:3:"MIT";s:16:"ExtraSearchTerms";s:50:"valheim iron gate viking survival dedicated server";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:362:"About 2.1GB once installed, from a 2GB download, so allow 5GB of free space for the world, backups and updates. Budget 3GB of RAM for an idle server and 6-8GB for a busy long-running world - this server's memory use grows over time, so a nightly restart is worth scheduling. The array is fine; a cache drive or SSD makes world loads and saves noticeably quicker.";s:6:"Config";a:27:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Game Port";s:6:"Target";s:4:"2456";s:7:"Default";s:4:"2456";s:4:"Mode";s:3:"udp";s:11:"Description";s:739:"Game traffic, UDP, and the port to forward on your router. To move it you must set THREE things to the same number: this Host Port box, the Container Port behind the Edit button on this row, and Server Port below. Unraid greys out that Container Port box for every port a template supplied, so you cannot type your number into it. To move this port, Remove this entry and add your own Port entry with the Container Port and the Host Port both set to your number - a port entry you create yourself has no container port yet, and Unraid leaves those editable. Then move the Query and Crossplay rows to your number plus 1 and plus 2 the same way. A template update can restore these entries alongside yours; remove them again. See the README.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2456";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Query Port";s:6:"Target";s:4:"2457";s:7:"Default";s:4:"2457";s:4:"Mode";s:3:"udp";s:11:"Description";s:280:"Steam's server query port, always Game Port plus 1. This is the port you type into Steam's View, Servers, Favourites, Add a server box - NOT the game port. Getting that wrong is the single most common reason people cannot find their own server. Forward it alongside the game port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2457";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Crossplay Port";s:6:"Target";s:4:"2458";s:7:"Default";s:4:"2458";s:4:"Mode";s:3:"udp";s:11:"Description";s:429:"Always Game Port plus 2. The comment block in the server's own start script tells you to forward 2456-2458, so this row exists to match that advice - but the server was never actually seen listening on it, with crossplay on or off, when the ports were read straight out of the running container. Publishing it costs nothing if 2458 is free. Remove the row if you would rather not publish a port nothing has been observed binding.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2458";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Port";s:6:"Target";s:9:"GAME_PORT";s:7:"Default";s:4:"2456";s:4:"Mode";s:0:"";s:11:"Description";s:279:"The port the server binds. It must equal Game Port above, BOTH the Host Port and the Container Port. The query and crossplay ports are derived from it by the game and cannot be set separately. Under Network Type host there is no mapping and this is the only port number there is.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"2456";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Game Files";s:6:"Target";s:23:"/serverdata/serverfiles";s:7:"Default";s:25:"/mnt/user/appdata/valheim";s:4:"Mode";s:2:"rw";s:11:"Description";s:220:"Where the server, worlds and permission lists live. About 2.1GB - see Requires below. Your worlds are under savedir/worlds_local, and adminlist.txt, bannedlist.txt and permittedlist.txt sit beside that folder in savedir.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:25:"/mnt/user/appdata/valheim";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"SteamCMD";s:6:"Target";s:20:"/serverdata/steamcmd";s:7:"Default";s:26:"/mnt/user/appdata/steamcmd";s:4:"Mode";s:2:"rw";s:11:"Description";s:69:"SteamCMD itself. Small, and shareable with other SteamCMD containers.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:26:"/mnt/user/appdata/steamcmd";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Server Name";s:6:"Target";s:11:"SERVER_NAME";s:7:"Default";s:14:"Valheim Server";s:4:"Mode";s:0:"";s:11:"Description";s:160:"Name shown in the server list. Applied on every restart. Note that the password below must not appear anywhere inside this name, or the server refuses to start.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"Valheim Server";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"World Name";s:6:"Target";s:10:"WORLD_NAME";s:7:"Default";s:9:"Dedicated";s:4:"Mode";s:0:"";s:11:"Description";s:245:"Names the world the server creates on first boot, and the save it uses - savedir/worlds_local/name. Changing it after first boot starts a NEW world; the old one stays on disk and setting this name back returns to it. It does not rename anything.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"Dedicated";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Server Password";s:6:"Target";s:7:"SRV_PWD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:412:"REQUIRED unless Public is 0. Three rules, all enforced by the server by refusing to start: at least 5 characters; it must not appear anywhere inside the Server Name above; and a server listed in the browser must have one. This container checks all three before launching and tells you which one failed. Leave blank only with Public set to 0, which gives an unlisted server anyone who can reach the port may join.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Public";s:6:"Target";s:6:"PUBLIC";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:160:"1 lists the server so players can find it by name; 0 hides it, and players join with the Join IP button instead. This is the only way to run without a password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"Crossplay";s:6:"Target";s:9:"CROSSPLAY";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:723:"Set to true to run on the crossplay (PlayFab) backend instead of Steam. Crossplay is what lets Xbox, PlayStation and Switch players join at all, and it removes the need to forward any port because traffic is relayed. The costs: your server disappears from the Steam server browser and appears in the in-game Community servers list instead, players join with a code rather than by address, and BepInEx mods are reported not to load. A crossplay server also stops listening on the game port entirely - only the query port stays bound - which is the flip side of not needing to forward anything. Iron Gate's own shipped start_server.sh now passes this flag by default, so this setting is worth revisiting rather than assuming.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"World Preset";s:6:"Target";s:6:"PRESET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:266:"World modifier preset, new in Valheim 1.0. One of: normal, casual, easy, hard, hardcore, immersive, hammer. Leave blank for a normal world. A preset resets every individual modifier it covers, and this container always applies it before the fields below so they win.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"World Modifiers";s:6:"Target";s:9:"MODIFIERS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:624:"Individual world modifiers as a comma separated list of name=value, for example: combat=hard,raids=none,portals=casual. Valid names and values - combat: veryeasy easy hard veryhard | deathpenalty: casual veryeasy easy hard hardcore | resources: muchless less more muchmore most | raids: none muchless less more muchmore | portals: casual hard veryhard. Each list leaves out its own normal setting on purpose: you name a modifier only to move it away from normal. A name or value that is not in these lists stops the container with a message, because the server would otherwise ignore it silently and hand you a normal world.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"World Toggles";s:6:"Target";s:7:"SETKEYS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:162:"World modifier switches, as a comma separated list. Any of: nobuildcost, playerevents, passivemobs, nomap. Leave blank for all off. For example nomap,passivemobs.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Save Interval";s:6:"Target";s:13:"SAVE_INTERVAL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:183:"Seconds between automatic world saves. Blank uses the game's default of 1800, which is 30 minutes. Lowering it costs a brief pause more often and loses less when something goes wrong.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Backups to Keep";s:6:"Target";s:12:"BACKUP_COUNT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:436:"How many of the server's own automatic backups to keep. Blank uses the game's default of 4, which the manual describes as one backup at the short interval and the rest at the long one - so by default one that is 2 hours old and three spaced 12 hours apart. These are the server's built-in backups and they live beside the world in savedir/worlds_local, so they are not protection against losing that disk - copy them elsewhere for that.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"First Backup Interval";s:6:"Target";s:12:"BACKUP_SHORT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:113:"Seconds before the first automatic backup after a start. Blank uses the game's default of 7200, which is 2 hours.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Later Backup Interval";s:6:"Target";s:11:"BACKUP_LONG";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:113:"Seconds between automatic backups after the first one. Blank uses the game's default of 43200, which is 12 hours.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Extra Game Parameters";s:6:"Target";s:17:"GAME_PARAMS_EXTRA";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:277:"Appended to the launch line verbatim. Nothing routine needs this, since every documented setting already has a field above. Uses: -instanceid something, if you run several servers on one public address, and -logFile /path if you want the server's log written to a file as well.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:19;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Validate Files";s:6:"Target";s:8:"VALIDATE";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:131:"Set to true to have SteamCMD verify every file on the next start. Slow on a 2.1GB install. Use it after a crash or a failed update.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:20;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Stop Timeout";s:6:"Target";s:12:"STOP_TIMEOUT";s:7:"Default";s:3:"120";s:4:"Mode";s:0:"";s:11:"Description";s:394:"Seconds to wait for the server to save and exit before force killing it. This IS a save window, unlike some servers: Valheim saves when it is told to stop and has no RCON, no console and no remote save command, so this is the only save there is. Also raise Unraid's own container stop timeout to at least 150, or Docker kills the server partway through the save regardless of what you put here.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"120";}i:21;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Username";s:6:"Target";s:8:"USERNAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:54:"Leave blank. The Valheim server downloads anonymously.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:22;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Steam Password";s:6:"Target";s:7:"PASSWRD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:12:"Leave blank.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:23;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"UID";s:6:"Target";s:3:"UID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:34:"User ID. 99 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:24;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:3:"GID";s:6:"Target";s:3:"GID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:36:"Group ID. 100 is the Unraid default.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:25;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"Data Permissions";s:6:"Target";s:9:"DATA_PERM";s:7:"Default";s:3:"775";s:4:"Mode";s:0:"";s:11:"Description";s:48:"Mode applied to the top of the server directory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"775";}i:26;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"000";s:4:"Mode";s:0:"";s:11:"Description";s:75:"umask for files the server creates. 000 keeps them editable over the share.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"000";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/valheim.xml";s:4:"Repo";s:21:"Blairwin's Repository";s:12:"CategoryList";a:1:{i:0;s:11:"GameServers";}s:16:"ChangeLogPresent";s:1:"1";s:9:"downloads";i:68;s:9:"FirstSeen";i:1790187710;s:10:"LastUpdate";i:1790093457;s:14:"LastUpdateScan";i:1790187285;s:8:"Catego