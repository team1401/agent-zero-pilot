e";s:0:"";s:11:"Description";s:101:"Emby username (optional). Determines which user owns managed playlists.  Leave blank to disable Emby.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"WATCHED_KEEP";s:6:"Target";s:12:"WATCHED_KEEP";s:7:"Default";s:1:"2";s:4:"Mode";s:0:"";s:11:"Description";s:120:"How many recently-watched episodes to leave in each playlist as a fall-asleep buffer. Older watched episodes are pruned.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"2";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"PRUNE_INTERVAL_MINUTES";s:6:"Target";s:22:"PRUNE_INTERVAL_MINUTES";s:7:"Default";s:2:"10";s:4:"Mode";s:0:"";s:11:"Description";s:66:"How often the background prune + auto-sync sweep runs, in minutes.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"10";}i:12;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"FRANCHISE_REFRESH_DAYS";s:6:"Target";s:22:"FRANCHISE_REFRESH_DAYS";s:7:"Default";s:1:"7";s:4:"Mode";s:0:"";s:11:"Description";s:98:"How often franchise definitions are refreshed from upstream sources, in days (default 7 = weekly).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"7";}i:13;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:9:"AUTO_SYNC";s:6:"Target";s:9:"AUTO_SYNC";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:195:"When true (default), the scheduler also splices newly-aired episodes and new seasons into managed playlists every PRUNE_INTERVAL_MINUTES. Set false to lock playlists until you edit them manually.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"true";}i:14;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"TV_LIBRARIES";s:6:"Target";s:12:"TV_LIBRARIES";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:145:"Comma-separated TV library names to source shows from (e.g. 'TV Shows,Dropout TV'). Leave blank for all TV libraries on every configured backend.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"FLASK_SECRET";s:6:"Target";s:12:"FLASK_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:86:"Optional. Random string for Flask session cookies. Generate with: openssl rand -hex 32";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:41:"/tmp/GitHub/AppFeed/templates/linearr.xml";s:4:"Repo";s:25:"gillberg1111's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"MediaApp-Other";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1779609787;s:8:"Category";s:30:"MediaApp:Other Tools:Utilities";s:2:"ID";i:2147;s:11:"Displayable";b:1;s:6:"Author";s:12:"gillberg1111";s:13:"DockerHubName";s:7:"linearr";s:8:"RepoName";s:25:"gillberg1111's Repository";s:10:"SortAuthor";s:12:"gillberg1111";s:8:"SortName";s:7:"linearr";s:6:"random";i:1411112053;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:118:"/tmp/community.applications/tempFiles/templates-community-apps/gillberg1111sRepository/gillberg1111-linearr-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:15:"Buy me a coffee";s:10:"DonateLink";s:37:"https://buymeacoffee.com/gillberg1111";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2148;a:37:{s:4:"Name";s:12:"MediaSpecter";s:10:"Repository";s:40:"ghcr.io/gillberg1111/mediaspecter:latest";s:8:"Registry";s:41:"https://ghcr.io/gillberg1111/mediaspecter";s:7:"Network";s:6:"bridge";s:10:"Privileged";s:5:"false";s:5:"WebUI";s:23:"http://[IP]:[PORT:5000]";s:8:"Overview";s:529:"Reclaim disk space by replacing watched movies and TV episodes with tiny, valid dummy video files — while keeping watch history, posters and metadata fully intact across Plex, Jellyfin and Emby. Archived posters get an "ARCHIVED - X GB SAVED" badge, archiving propagates across all your servers, and Radarr/Sonarr items are unmonitored to prevent re-downloads. IMPORTANT: map /data to the SAME path your Plex/Jellyfin/Emby (and *arr) containers use, with read/write access, so the file paths the servers report line up on disk.";s:7:"Project";s:44:"https://github.com/gillberg1111/mediaspecter";s:7:"Support";s:51:"https://github.com/gillberg1111/mediaspecter/issues";s:6:"ReadMe";s:74:"https://raw.githubusercontent.com/gillberg1111/mediaspecter/main/README.md";s:4:"Icon";s:92:"https://raw.githubusercontent.com/gillberg1111/mediaspecter/main/static/mediaspecter-512.png";s:11:"TemplateURL";s:86:"https://raw.githubusercontent.com/gillberg1111/linearr/main/templates/mediaspecter.xml";s:7:"License";s:3:"MIT";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"5000";s:7:"Default";s:4:"5000";s:4:"Mode";s:3:"tcp";s:11:"Description";s:40:"Port for the MediaSpecter web dashboard.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5000";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:30:"/mnt/user/appdata/mediaspecter";s:4:"Mode";s:2:"rw";s:11:"Description";s:135:"Stores config.yaml, the SQLite state DB, and poster backups. A default config is seeded on first run; finish setup in the Settings tab.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/mediaspecter";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"Media";s:6:"Target";s:5:"/data";s:7:"Default";s:14:"/mnt/user/data";s:4:"Mode";s:2:"rw";s:11:"Description";s:255:"Your media. MAP THIS TO THE SAME CONTAINER PA