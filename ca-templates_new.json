s:true --memory=512m";s:7:"Support";s:47:"https://github.com/SandObserver/Tellyard/issues";s:7:"Project";s:40:"https://github.com/SandObserver/Tellyard";s:6:"ReadMe";s:60:"https://github.com/SandObserver/Tellyard/blob/main/README.md";s:7:"License";s:58:"https://github.com/SandObserver/Tellyard/blob/main/LICENSE";s:8:"Overview";s:703:"A live TV tuner for Plex and Jellyfin that you'll forget is running.[br][br]Tellyard shows up in Plex and Jellyfin as a network tuner. You list your channels in one file. When someone tunes in, Tellyard finds the channel's live stream on YouTube, Twitch, a broadcaster's page or an HLS address and passes it on without re-encoding. When they stop watching, it stops. The guide merges XMLTV schedules with placeholder blocks, so it is never empty.[br][br]Tellyard ships no channels. It starts with an empty line-up: put your channels.toml in /mnt/user/appdata/tellyard/config and it is loaded within a minute. Then add the tuner in Plex at Unraid-IP:5004 and the guide at http://Unraid-IP:5004/guide.xml.";s:8:"Requires";s:105:"Plex or Jellyfin, and a channels.toml listing the live streams you may watch. Tellyard ships no channels.";s:11:"TemplateURL";s:83:"https://raw.githubusercontent.com/SandObserver/Tellyard/main/templates/tellyard.xml";s:4:"Icon";s:85:"https://raw.githubusercontent.com/SandObserver/Tellyard/main/site/public/icon-512.png";s:10:"Screenshot";s:81:"https://raw.githubusercontent.com/SandObserver/Tellyard/main/docs/social-card.png";s:16:"ExtraSearchTerms";s:67:"plex jellyfin live tv hdhomerun tuner iptv xmltv epg youtube twitch";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Tuner Port";s:6:"Target";s:4:"5004";s:7:"Default";s:4:"5004";s:4:"Mode";s:3:"tcp";s:11:"Description";s:75:"Port Plex and Jellyfin use for the tuner, the guide and the /healthz check.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5004";}i:1;a:2:{s:11:"@attributes";a:9:{s