m/vcolombo/docktail-unraid/main/icon.png";s:7:"License";s:6:"AGPLv3";s:11:"TemplateURL";s:84:"https://raw.githubusercontent.com/vcolombo/docktail-unraid/main/plugins/docktail.xml";s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/plugins/docktail.xml";s:4:"Repo";s:21:"vcolombo's Repository";s:10:"Repository";s:83:"https://raw.githubusercontent.com/vcolombo/docktail-unraid/main/plugin/docktail.plg";s:12:"CategoryList";a:2:{i:0;s:18:"Network-Management";i:1;s:7:"Plugins";}s:6:"Plugin";b:1;s:7:"Support";s:50:"https://github.com/vcolombo/docktail-unraid/issues";s:13:"pluginVersion";s:10:"2026.09.20";s:6:"MinVer";s:5:"7.0.0";s:6:"Author";s:8:"vcolombo";s:9:"downloads";i:36;s:9:"FirstSeen";i:1788819486;s:14:"LastUpdateScan";i:1792383193;s:11:"pluginStats";a:13:{i:10;i:10;i:11;i:0;i:12;i:0;s:2:"01";i:0;s:2:"02";i:0;s:2:"03";i:0;s:2:"04";i:0;s:2:"05";i:0;s:2:"06";i:0;s:2:"07";i:0;s:2:"08";i:0;s:2:"09";i:26;s:1:"T";i:36;}s:8:"Category";s:27:"Network:Management Plugins:";s:2:"ID";i:4864;s:11:"Displayable";b:1;s:13:"DockerHubName";s:8:"docktail";s:8:"RepoName";s:21:"vcolombo's Repository";s:10:"SortAuthor";s:8:"vcolombo";s:8:"SortName";s:8:"DockTail";s:6:"random";i:1587333473;s:9:"Blacklist";b:0;s:4:"Path";s:182:"/tmp/community.applications/tempFiles/templates-community-apps/vcolombosRepository/vcolombo-DockTail-//raw.githubusercontent.com/vcolombo/docktail-unraid/main/plugin/docktail.plg.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:4865;a:46:{s:4:"Name";s:6:"Vertex";s:10:"Repository";s:18:"lswl/vertex:stable";s:8:"Registry";s:36:"https://hub.docker.com/r/lswl/vertex";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:24:"https://wiki.vertex.icu/";s:7:"Project";s:36:"https://github.com/vertex-app/vertex";s:8:"Overview";s:795:"Vertex 是一款集 监控, 刷流, 站点, 搜索, 追剧 于一身的 PT 管理软件
主要有以下功能:
  监控 - 监控服务器以及下载器的各项指标信息
  刷流 - 提供 RSS - 删种 全自动化流程
  站点 - 站点管理, 数据增长记录, 数据可视化
  搜索 - 提供全站种子聚合搜索, 可直接推送至下载器
  追剧 - 提供全自动化追剧方案, 根据设定规则, 完成搜索种子, 下载种子, 根据 Plex 等媒体服务器的格式为种子文件软链接改名

请注意, 本工具专为 PT 用户打造, 无 PT 的用户也许用不上...
