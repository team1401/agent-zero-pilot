;s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:50:"https://github.com/asherflynt/media-curator/issues";s:7:"Project";s:43:"https://github.com/asherflynt/media-curator";s:8:"Overview";s:988:"media-curator audits your Radarr/Sonarr library for files whose size contradicts the quality they claim to be, and reclaims disk space by demoting over-quality files (e.g. 4K remuxes to 4K WEB-DL) using Radarr's native download-verify-replace path — it NEVER re-encodes. Free space is read from the filesystem (statvfs), not Radarr's per-share numbers, so it works correctly on Unraid/ZFS.

Configure Radarr and Sonarr in the WebUI (Connections) — no environment variables or config files needed. Set a free-space target and the loop holds it. Rule-based profile assignment (by genre, collection, or tag) keeps groups like kids movies on the right archive profile automatically. Protect anything with a blocklist and a keep-tag. Starts in dry-run.

IMPORTANT: mount your media share READ-ONLY at /media, pointed at the real dataset/share that holds your movies, so free space and orphan detection are accurate. media-curator never writes to it — Radarr performs the file operations.";s:5:"WebUI";s:24:"http://[IP]:[PORT:8420]/";s:11:"TemplateURL";s:81:"https://raw.githubusercontent.com/asherflynt/media-curator/main/media-curator.xml";s:4:"Icon";s:72:"https://raw.githubusercontent.com/asherflynt/media-curator/main/icon.png";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:4:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8420";s:7:"Default";s:4:"8420";s:4:"Mode";s:3:"tcp";s:11:"Description";s:19:"Web interface port.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8420";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Appdata (config + database)";s:6:"Target";s:5:"/data";s:7:"Default";s:31:"/mnt/user/appdata/media-curator";s:4:"Mode";s:2:"rw";s:11:"Description";s:77:"Where media-curator stores its SQLite database, settings, and action history.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:31:"/mnt/user/appdata/media-curator";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Media (read-only)";s:6:"Target";s:6:"/media";s:7:"Default";s:15:"/mnt/user/media";s:4:"Mode";s:2:"ro";s:11:"Description";s:266:"Your media share, mounted READ-ONLY. media-curator reads true free space (statvfs) and detects orphan folders here; it never writes. Point this at the real dataset/share that holds your movies (e.g. /mnt/cluster/Media on a ZFS pool) for accurate free-space readings.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:15:"/mnt/user/media";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:16:"America/New_York";s:4:"Mode";s:0:"";s:11:"Description";s:65:"Container timezone (affects scheduled run times shown in the UI).";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:16:"America/New_York";}}s:12:"TemplatePath";s:37:"/tmp/GitHub/AppFeed/media-curator.xml";s:4:"Repo";s:38:"gubernatorial-captive6678's Repository";s:12:"CategoryList";a:3:{i:0;s:14:"MediaApp-Video";i:1;s:15:"Tools-Utilities";i:2;s:11:"Downloaders";}s:9:"FirstSeen";i:1784563481;s:8:"Category";s:43:"MediaApp:Video Tools:Utilities Downloaders:";s:2:"ID";i:1517;s:11:"Displayable";b:1;s:6:"Author";s:10:"asherflynt";s:13:"DockerHubName";s:13:"media-curator";s:8:"RepoName";s:38:"gubernatorial-captive6678's Repository";s:10:"SortAuthor";s:10:"asherflynt";s:8:"SortName";s:13:"media curator";s:6:"random";i:1244647237;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:133:"/tmp/community.applications/tempFiles/templates-community-apps/gubernatorialcaptive6678sRepository/asherflynt-mediacurator-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1518;a:37:{s:4:"Name";s:15:"music-librarian";s:10:"Repository";s:41:"ghcr.io/asherflynt/music-librarian:latest";s:8:"Registry";s:42:"https://ghcr.io/asherflynt/music-librarian";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:74:"https://raw.githubusercontent.com/asherflynt/music-librarian/main/icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8730]";s:8:"Overview";s:1649:"Self-hosted, taste-driven, resumable FLAC-preferred auto-fill for a Navidrome + Soulbeet music library.

Music Librarian seeds from what your household actually plays — Navidrome and Plex/Plexamp play counts (Plex via Tautulli), plus YouTube Music Takeout history — expands that taste via Last.fm, and downloads through your existing Soulbeet API using a FLAC-preferred, high-quality-lossy fallback ladder. It keeps favorited artists' full discographies current via MusicBrainz (new releases arrive on their own) and can re-acquire lossy albums as FLAC on a schedule, verifying every staged FLAC before it replaces anything. All progress lives in SQLite, so a restart resumes exactly where it left off. Every knob is editable live in the web UI (no restart).

COMPANION APP: this is not a standalone downloader. It drives an existing Soulbeet instance and reads an existing Navidrome library — you need both already running. Tautulli (Plex plays) and a Last.fm API key are optional/required as noted below.

SECURITY: the web UI is LAN-only and unauthenticated by design (same posture as slskd/Soulbeet/Navidrome). It can change download targets and, with upgrades enabled, delete files — do NOT expose port 8730 through a reverse proxy or tunnel. POSTs are CSRF/Origin-guarded, but that is hardening, not auth.

FIRST RUN: /config starts empty and is auto-seeded with config.env, secrets.env, exclude.txt and favorites.txt. Edit /config/secrets.env with your LASTFM_API_KEY, SOULBEET_USER and SOULBEET_PASS (Navidrome/Soulbeet login). The container waits — it does not crash — until those are filled; no restart is needed once you save.";s:7:"Project";s:45:"https://github.com/asherflynt/music-librarian";s:7:"Support";s:52:"https://github.com/asherflynt/music-librarian/issues";s:11:"TemplateURL";s:95:"https://raw.githubusercontent.com/asherflynt/music-librarian/main/templates/music-librarian.xml";s:6:"ReadMe";s:75:"https://raw.githubusercontent.com/asherflynt/music-librarian/main/README.md";s:16:"ExtraSearchTerms";s:80:"navidrome soulbeet soulseek slskd flac lastfm musicbrainz tautulli plexamp music";s:8:"Requires";s:126:"A running Soulbeet instance and a Navidrome library. A free Last.fm API key. Optional: Tautulli for Plex/Plexamp play history.";s:4:"Date";s:10:"2026-07-25";s:6:"MinVer";s:4:"6.10";s:7:"License";s:3:"MIT";s:6:"Config";a:10:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8730";s:7:"Default";s:4:"8730";s:4:"Mode";s:3:"tcp";s:11:"Description";s:83:"Web UI / API port. LAN only — do not expose it through a reverse proxy or tunnel.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8730";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:33:"/mnt/user/appdata/music-librarian";s:4:"Mode";s:2:"rw";s:11:"Description";s:116:"Settings, secrets and Google Takeout drop-folder. Auto-seeded on first run; your edits are preserved across updates.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:33:"/mnt/user/appdata/music-librarian";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"State";s:6:"Target";s:5:"/data";s:7:"Default";s:39:"/mnt/user/appdata/music-librarian/state";s: