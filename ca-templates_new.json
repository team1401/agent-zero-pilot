"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:30:"/mnt/user/appdata/ha-dashboard";}}s:12:"TemplatePath";s:46:"/tmp/GitHub/AppFeed/templates/ha-dashboard.xml";s:4:"Repo";s:21:"Tjindarr's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:12:"Productivity";}s:9:"FirstSeen";i:1779739445;s:8:"Category";s:29:"HomeAutomation: Productivity:";s:2:"ID";i:1301;s:11:"Displayable";b:1;s:6:"Author";s:8:"tjindarr";s:13:"DockerHubName";s:12:"ha-dashboard";s:8:"RepoName";s:21:"Tjindarr's Repository";s:10:"SortAuthor";s:8:"tjindarr";s:8:"SortName";s:12:"HA Dashboard";s:6:"random";i:521569209;s:9:"Blacklist";b:0;s:4:"Path";s:114:"/tmp/community.applications/tempFiles/templates-community-apps/TjindarrsRepository/tjindarr-HADashboard-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1302;a:39:{s:4:"Name";s:9:"FireSight";s:10:"Repository";s:42:"ghcr.io/tjindarr/unifi-insights-hub:latest";s:8:"Registry";s:43:"https://ghcr.io/tjindarr/unifi-insights-hub";s:7:"Network";s:4:"host";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:4:"Icon";s:82:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/unraid/icon.png";s:5:"WebUI";s:23:"http://[IP]:[PORT:8095]";s:8:"Overview";s:1205:"FireSight is a self-hosted firewall log analyzer and syslog dashboard for UniFi routers (UDR / UDM / UXG / Cloud Gateway).

Acts as a syslog server on UDP/514, parses UniFi firewall, STA-tracker and internal events, enriches them with GeoIP and threat intelligence (AbuseIPDB + offline FireHOL/Spamhaus blocklists), and serves a fast dark NOC-style web UI with FTS5-backed search.

Single container — no separate database, no extra services. SQLite (WAL + FTS5) keeps searches snappy even on large log volumes.

Features:
  - Syslog UDP/514 listener with UniFi RFC3164 + CEF parser
  - Real-time firewall log viewer with pause/resume, country + ASN, threat level
  - Internal events viewer (Wi-Fi roam, auth, DHCP, admin actions) in plain English
  - Full-text search across raw syslog (SQLite FTS5)
  - Per-minute event charts driven by the global time range
  - Pie charts for actions, categories, and external IP threat level
  - Optional UniFi API polling (read-only) for client name resolution
  - Configurable retention by age + DB size cap, hourly VACUUM
  - First-login forced password change, session cookie auth
  - Local timezone support via the TZ env var (router timestamps lack a TZ field)";s:7:"Support";s:53:"https://github.com/Tjindarr/unifi-insights-hub/issues";s:7:"Project";s:46:"https://github.com/Tjindarr/unifi-insights-hub";s:11:"TemplateURL";s:97:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/unraid/templates/firesight.xml";s:6:"ReadMe";s:76:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/README.md";s:16:"ExtraSearchTerms";s:72:"unifi syslog firewall log analyzer udr udm ubiquiti security network noc";s:8:"Requires";s:161:"A UniFi router (UDR/UDM/UXG/Cloud Gateway) configured to send remote syslog to this container on UDP/514. Optional: a read-only UniFi local user for API polling.";s:4:"Date";s:10:"2026-06-28";s:6:"MinVer";s:4:"6.10";s:7:"License";s:3:"MIT";s:10:"Screenshot";a:6:{i:0;s:91:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/overview.png";i:1;s:91:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/firewall.png";i:2;s:91:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/internal.png";i:3;s:89:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/events.png";i:4;s:87:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/logs.png";i:5;s:86:"https://raw.githubusercontent.com/Tjindarr/unifi-insights-hub/main/screenshots/raw.png";}s:6:"Config";a:8:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"8095";s:7:"Default";s:4:"8095";s:4:"Mode";s:3:"tcp";s:11:"Description";s:91:"HTTP port for the FireSight web UI. Host networking is used so this also binds on the host.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8095";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Syslog UDP Port";s:6:"Target";s:3:"514";s:7:"Default";s:3:"514";s:4:"Mode";s:3:"udp";s:11:"Description";s:84:"UDP p