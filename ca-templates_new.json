al public HTTPS access only through Tailscale Funnel. After installation, retrieve the one-time pairing token from the container Console with: /opt/tautweekly/bin/run-as-user.sh /opt/tautweekly/bin/tautweekly-manager access-bootstrap --data-dir /data/manager. The pairing token is never written to logs. Unraid owns container lifecycle and stable image updates.";s:7:"Support";s:47:"https://github.com/sparkmoxie/TautWeekly/issues";s:7:"Project";s:40:"https://github.com/sparkmoxie/TautWeekly";s:11:"TemplateURL";s:85:"https://raw.githubusercontent.com/sparkmoxie/TautWeekly/main/templates/tautweekly.xml";s:6:"ReadMe";s:86:"https://raw.githubusercontent.com/sparkmoxie/TautWeekly/main/docs/nas-docker/README.md";s:16:"ExtraSearchTerms";s:46:"Tautulli Plex newsletter email activity digest";s:8:"Requires";s:251:"A reachable Tautulli server and an SMTP STARTTLS account. Optional public remote access also requires a separately created Tailscale account and explicit interactive sign-in; remote viewers need only an ordinary HTTPS browser and the Manager password.";s:4:"Date";s:10:"2026-09-01";s:6:"MinVer";s:6:"6.12.0";s:7:"License";s:3:"MIT";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:5:"/data";s:7:"Default";s:28:"/mnt/user/appdata/tautweekly";s:4:"Mode";s:2:"rw";s:11:"Description";s:147:"Private configuration, Manager credentials, state, backups, logs, assets, and generated previews. Preserve this path across updates and reinstalls.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"Tailscale state";s:6:"Target";s:29:"/var/lib/tautweekly-tailscale";s:7:"Default";s:38:"/mnt/user/appdata/tautweekly-tailscale";s:4:"Mode";s:2:"rw";s:11:"Description";s:158:"Root-only state for the optional official Tailscale userspace runtime. Keep separate from /data; never share, inspect, or back it up as ordinary Manager data.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:8:"Timezone";s:6:"Target";s:2:"TZ";s:7:"Default";s:7:"Etc/UTC";s:11:"Description";s:72:"IANA timezone used by the weekly scheduler, for example America/Phoenix.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:11:"Description";s:51:"Non-root Unraid user ID used for appdata ownership.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:11:"Description";s:52:"Non-root Unraid group ID used for appdata ownership.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:5:"UMASK";s:6:"Target";s:5:"UMASK";s:7:"Default";s:3:"077";s:11:"Description";s:60:"Restrictive file-creation mask for configuration and output.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:15:"Runtime profile";s:6:"Target";s:26:"TAUTWEEKLY_RUNTIME_PROFILE";s:7:"Default";s:6:"unraid";s:11:"Description";s:72:"Validated unified-image behavior profile. Keep unraid for this template.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:8:{s:4:"Name";s:21:"Public Funnel adapter";s:6:"Target";s:25:"TAUTWEEKLY_FUNNEL_ADAPTER";s:7:"Default";s:8:"disabled";s:11:"Description";s:197:"Set to enabled only to start the isolated official Tailscale userspace runtime. 