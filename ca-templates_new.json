s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:59:"Group id that owns the data folder. 100 is users on Unraid.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}}s:12:"TemplatePath";s:42:"/tmp/GitHub/AppFeed/templates/bawksync.xml";s:4:"Repo";s:17:"Judd's Repository";s:12:"CategoryList";a:2:{i:0;s:13:"Network-Other";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1790670039;s:8:"Category";s:29:"Network:Other Tools:Utilities";s:2:"ID";i:2754;s:11:"Displayable";b:1;s:6:"Author";s:10:"juddisjudd";s:13:"DockerHubName";s:8:"bawksync";s:8:"RepoName";s:17:"Judd's Repository";s:10:"SortAuthor";s:10:"juddisjudd";s:8:"SortName";s:8:"bawksync";s:6:"random";i:125150567;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:109:"/tmp/community.applications/tempFiles/templates-community-apps/JuddsRepository/juddisjudd-bawksync-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";s:19:"Support me on Ko-fi";s:10:"DonateLink";s:27:"https://ko-fi.com/ohitsjudd";s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2755;a:41:{s:4:"Name";s:10:"Crustation";s:10:"Repository";s:36:"ghcr.io/juddisjudd/crustation:latest";s:8:"Registry";s:66:"https://github.com/juddisjudd/crustation/pkgs/container/crustation";s:7:"Network";s:6:"bridge";s:5:"Shell";s:4:"bash";s:10:"Privileged";s:5:"false";s:7:"Support";s:47:"https://github.com/juddisjudd/crustation/issues";s:7:"Project";s:40:"https://github.com/juddisjudd/crustation";s:6:"ReadMe";s:47:"https://github.com/juddisjudd/crustation#readme";s:8:"Overview";s:1282:"A control panel for Minecraft, Rust, Enshrouded and RuneScape: Dragonwilds servers. One binary supervises the game servers and serves a web interface, so there is no Docker socket to expose and everything lives in the three folders you map below.

Create Vanilla, Paper, Purpur, Fabric, NeoForge and Bedrock servers, Rust through SteamCMD with Oxide or Carbon, and Enshrouded and Dragonwilds through SteamCMD too. Each server gets a live console, players, chat, files, schedules and settings. The roadmap is in the GitHub repository.

First sign-in: set the admin username and password below, or leave them empty and read the generated password from first-login.txt in the config folder.

Java 8, 11, 17, 21 and 25 are included, and each Minecraft server starts on the one its version asks for. The Steam games need an amd64 host. Enshrouded only ships for Windows, so the image runs it under Wine. Rust wants around 8 GB of memory per server, Enshrouded around 16 GB, and Dragonwilds 2 GB plus 1 GB a player. Forward the game ports your servers need; the defaults for Minecraft Java, Bedrock and one server of each Steam game are mapped below.

