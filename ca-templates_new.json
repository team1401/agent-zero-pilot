:"Default";s:5:"admin";s:4:"Mode";s:0:"";s:11:"Description";s:218:"Username for the initial admin account. Only used on first start. Can be safely deleted from the container afterwards — it is also the user that ADMIN_PASSWORD_RESET will reset if you ever forget your admin password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"admin";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"ADMIN_PASSWORD";s:6:"Target";s:14:"ADMIN_PASSWORD";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:293:"Password for the initial admin account. ONLY used on first start (when no users exist yet). After first start this variable is ignored and can — and should — be deleted from the container template for security. If you ever forget the admin password, use ADMIN_PASSWORD_RESET below instead.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:20:"ADMIN_PASSWORD_RESET";s:6:"Target";s:20:"ADMIN_PASSWORD_RESET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:335:"Emergency password reset for the user defined in ADMIN_USERNAME. Leave EMPTY in normal operation. Only set this if you have forgotten your admin password: enter a new password, restart the container, log in, then DELETE this variable. While set, the password is reset on every container start and all existing sessions are invalidated.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"ADDRESS_HEADER";s:6:"Target";s:14:"ADDRESS_HEADER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:234:"Only fill this in if Groly is running behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik) — set it to X-Forwarded-For. Leave empty if you access Groly directly. Setting this without a reverse proxy will cause login to fail.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"VAPID_PUBLIC_KEY";s:6:"Target";s:16:"VAPID_PUBLIC_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:202:"VAPID public key for push notifications (optional). Generate a key pair once with: node -e &quot;const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k,null,2))&quot;";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"VAPID_PRIVATE_KEY";s:6:"Target";s:17:"VAPID_PRIVATE_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:81:"VAPID private key for push notifications (optional). Must match VAPID_PUBLIC_KEY.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:23:"PUBLIC_VAPID_PUBLIC_KEY";s:6:"Target";s:23:"PUBLIC_VAPID_PUBLIC_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:76:"Must be the same value as VAPID_PUBLIC_KEY. Required for push notifications.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"VAPID_SUBJECT";s:6:"Target";s:13:"VAPID_SUBJECT";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:152:"A https:// URL or mailto: address for VAPID identification (e.g. https://your-domain.com). Required for push notifications. Must not be a .local domain.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"OFF_COUNTRY";s:6:"Target";s:11:"OFF_COUNTRY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";