    at that location called server.properties and your server will start.";s:5:"WebUI";s:30:"https://[IP]:[PORT:9443]/admin";s:11:"TemplateURL";s:80:"https://raw.githubusercontent.com/bluegizmo83/DockerXMLs/master/blynk-server.xml";s:4:"Icon";s:102:"https://lh3.googleusercontent.com/rTRWfl713otPTrmafsJ3OLb7I30XS1iBSZyP1WXYXKAlwkTMhihdMw_gDv5ogjEtQ1P6";s:10:"Networking";a:1:{s:4:"Mode";s:6:"bridge";}s:6:"Config";a:5:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Host Path 1";s:6:"Target";s:5:"/data";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:0:"";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:35:"/mnt/user/appdata/blynk-server/data";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Host Path 2";s:6:"Target";s:7:"/config";s:7:"Default";s:0:"";s:4:"Mode";s:2:"rw";s:11:"Description";s:0:"";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:37:"/mnt/user/appdata/blynk-server/config";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Host Port 1";s:6:"Target";s:4:"8080";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:0:"";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8080";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Host Port 2";s:6:"Target";s:4:"9443";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:0:"";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"9443";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Host Port 3";s:6:"Target";s:4:"8440";s:7:"Default";s:0:"";s:4:"Mode";s:3:"tcp";s:11:"Description";s:0:"";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8440";}}s:12:"TemplatePath";s:36:"/tmp/GitHub/AppFeed/blynk-server.xml";s:4:"Repo";s:24:"bluegizmo83's Repository";s:12:"CategoryList";a:2:{i:0;s:14:"HomeAutomation";i:1;s:15:"Tools-Utilities";}s:5:"stars";i:25;s:9:"downloads";i:1064392;s:13:"downloadtrend";a:7:{i:0;i:1055419;i:1;i:1056765;i:2;i:1059061;i:3;i:1059833;i:4;i:1061006;i:5;i:1062356;i:6;i:1064392;}s:8:"trending";d:0.191;s:6:"trends";a:7:{i:0;d:0.126;i:1;d:0.127;i:2;d:0.217;i:3;d:0.073;i:4;d:0.111;i:5;d:0.127;i:6;d:0.191;}s:10:"trendsDate";a:7:{i:0;i:1774012301;i:1;i:1776611444;i:2;i:1780681722;i:3;i:1783281837;i:4;i:1785926957;i:5;i:1788523586;i:6;i:1791198847;}s:9:"FirstSeen";i:1589018878;s:10:"LastUpdate";i:1567179096;s:14:"LastUpdateScan";i:1791198847;s:11:"topTrending";d:0.065;s:13:"topPerforming";d:0.191;s:8:"Category";s:31:"HomeAutomation: Tools:Utilities";s:2:"ID";i:1664;s:11:"Displayable";b:1;s:6:"Author";s:6:"mpherg";s:13:"DockerHubName";s:12:"blynk-server";s:8:"RepoName";s:24:"bluegizmo83's Repository";s:10:"SortAuthor";s:6:"mpherg";s:8:"SortName";s:12:"blynk server";s:6:"random";i:82608928;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:115:"/tmp/community.applications/tempFiles/templates-community-apps/bluegizmo83sRepository/mpherg-blynkserver-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:0.065;s:12:"trendAverage";d:0.1389;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1665;a:49:{s:4:"Name";s:9:"clamdscan";s:10:"Repository";s:29:"bmmbmm01/clamav-alpine:latest";s:8:"Registry";s:47:"https://hub.docker.com/r/bmmbmm01/clamav-alpine";s:7:"Network";s:6:"bridge";s:5:"MyMAC";s:0:"";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:78:"https://forums.unraid.net/topic/198948-support-bmartino1-ca-docker-repository/";s:7:"Project";s:42:"https://github.com/bmartino1/clamav-alpine";s:8:"Overview";s:533:"ClamAV - clamdscan is a one-shot filesystem malware scanner for Unraid using ClamAV and clamdscan.

When the container starts, it updates the ClamAV virus signatures, starts clamd, scans the configured folder or folders, writes persistent scan logs, and then exits when the scan is complete.

