;s:5:"false";}s:5:"value";s:0:"";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"LOCAL TIME";s:6:"Target";s:14:"/etc/localtime";s:7:"Default";s:0:"";s:4:"Mode";s:2:"ro";s:11:"Description";s:0:"";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:14:"/etc/localtime";}i:18;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"MYSQL_ROOT_USER";s:6:"Target";s:15:"MYSQL_ROOT_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:15:"MYSQL_ROOT_USER";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"root";}}s:12:"TemplatePath";s:51:"/tmp/GitHub/AppFeed/spaceinvaderone/shinobi_pro.xml";s:4:"Repo";s:28:"SpaceInvaderOne's Repository";s:12:"CategoryList";a:3:{i:0;s:14:"HomeAutomation";i:1;s:14:"MediaApp-Video";i:2;s:17:"MediaServer-Video";}s:5:"stars";i:5;s:9:"downloads";i:1098512;s:13:"downloadtrend";a:7:{i:0;i:1096757;i:1;i:1097011;i:2;i:1097162;i:3;i:1097332;i:4;i:1097835;i:5;i:1098165;i:6;i:1098512;}s:8:"trending";d:0.032;s:6:"trends";a:7:{i:0;d:0.02;i:1;d:0.023;i:2;d:0.014;i:3;d:0.015;i:4;d:0.046;i:5;d:0.03;i:6;d:0.032;}s:10:"trendsDate";a:7:{i:0;i:1775728985;i:1;i:1778325221;i:2;i:1780920207;i:3;i:1783512296;i:4;i:1786105684;i:5;i:1788711256;i:6;i:1791384879;}s:9:"FirstSeen";i:1575579943;s:10:"LastUpdate";i:1643818842;s:14:"LastUpdateScan";i:1791384879;s:11:"topTrending";d:0.012;s:13:"topPerforming";d:0.032;s:8:"Category";s:48:"HomeAutomation: MediaApp:Video MediaServer:Video";s:2:"ID";i:1219;s:11:"Displayable";b:1;s:6:"Author";s:15:"spaceinvaderone";s:13:"DockerHubName";s:10:"shinobipro";s:8:"RepoName";s:28:"SpaceInvaderOne's Repository";s:10:"SortAuthor";s:15:"spaceinvaderone";s:8:"SortName";s:10:"shinobipro";s:6:"random";i:1807230203;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:127:"/tmp/community.applications/tempFiles/templates-community-apps/SpaceInvaderOnesRepository/spaceinvaderone-shinobipro-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"trendDelta";d:0.012;s:12:"trendAverage";d:0.0257;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:1220;a:43:{s:4:"Name";s:25:"Transcoding-GPU-Benchmark";s:10:"Repository";s:48:"spaceinvaderone/transcoding-gpu-benchmark:latest";s:8:"Registry";s:66:"https://hub.docker.com/r/spaceinvaderone/transcoding-gpu-benchmark";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:67:"https://github.com/SpaceinvaderOne/transcoding-gpu-benchmark/issues";s:7:"Project";s:60:"https://github.com/SpaceinvaderOne/transcoding-gpu-benchmark";s:8:"Overview";s:1311:"Measures the maximum SUSTAINED number of simultaneous 4K HEVC -> 1080p H.264 (8 Mbit, strict >= 1.0x realtime) transcodes a GPU can do, shown live on a web scoreboard you can watch in a browser. Supports Intel (VAAPI), AMD (VAAPI), NVIDIA (NVENC/NVDEC) and CPU software transcoding - you pick which device to test from the web UI. GPU SETUP: INTEL and AMD work OUT OF THE BOX via the /dev/dri device below. FOR NVIDIA make ONE change - add  --runtime=nvidia  to Extra Parameters (the NVIDIA variables are already set; the NVIDIA driver plugin must be installed; on an NVIDIA-only host you can also remove the /dev/dri device). Everything else is identical for all vendors. It ramps the stream count one at a time and reports the highest count where EVERY stream still runs at or above real-time (same pinned test clips across vendors, so the numbers are comparable - and you can submit yours to the community leaderboard). Built on the Jellyfin image only to reuse the jellyfin-ffmpeg binary and its validated driver stack - the Jellyfin server itself is NOT run (the entrypoint is overridden). This is a run-and-watch benchmark, not an always-on service: pick a GPU, start it, watch the scoreboard reach the limit, then stop it. Nothing else should be using the GPU while it runs, or the result will be skewed.";s:5:"WebUI";s:23:"http://[IP]:[PORT:8088]";s:11:"TemplateURL";s:126:"https://raw.githubusercontent.com/SpaceinvaderOne/Docker-Templates-Unraid/master/spaceinvaderone/transcoding-gpu-benchmark.xml";s:4:"Icon";s:89:"https://raw.githubusercontent.com/SpaceinvaderOne/transcoding-gpu-benchmark/main/icon.png";s:11:"ExtraParams";s:17:"--cap-add PERFMON";s:8:"Requires";s:808:"A GPU with hardware transcoding. INTEL / AMD: works out of the box — just keep the /dev/dri device (VAAPI). NVIDIA: you MUST add  --runtime=nvidia  to Extra Parameters (it is NOT included by default; the NVIDIA driver plugin is required); the /dev/dri device can stay if you also have an Intel/AMD GPU, or be removed on NVIDIA-only hosts. --cap-add PERFMON (in Extra Parameters by default) lets intel_gpu_top read the Intel iGPU live telemetry (engine %, clock). OPTIONAL: add --pid=host to Extra Parameters to NAME which apps are using a GPU in the pre-test busy check (read-only host process visibility) - without it the check still warns when a GPU is busy, it just can't name the app. The RAM-speed readout (Intel iGPU) needs the read-only DMI mount below. The benchmark runs fine without these extras.";s:6:"Config";a:13:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:5:"WebUI";s:6:"Target";s:4:"8088";s:7:"Default";s:4:"8088";s:4:"Mode";s:3:"tcp";s:11:"Description";s:81:"Scoreboard web UI - open in a browser to pick a GPU and watch the benchmark live.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8088";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:24:"GPU device (Intel / AMD)";s:6:"Target";s:9:"/dev/dri/";s:7:"Default";s:9:"/dev/dri/";s:4:"Mode";s:0:"";s:11:"Description";s:239:"Intel/AMD GPU passthrough (VAAPI) - required to test an Intel or AMD GPU. Leave it for any host that has an Intel or AMD GPU. On an NVIDIA-only host with no /dev/dri you can remove this and instead add --runtime=nvidia to Extra Parameters.";s:4:"Type";s:6:"Device";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:9:"/dev/dri/";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"RAM disk (source clip)";s:6:"Target";s:8:"/ramdisk";s:7:"Default";s:19:"/tmp/transcode-test";s:4:"Mode";s:2:"rw";s:11:"Description";s:294:"MUST be a RAM-backed path. The benchmark hot-loads its source clip here at run start; keeping it in RAM ensures we measure the GPU, not disk I/O. /tmp is RAM-backed on Unraid - do NOT point this at an array or cache disk, or the stream count will be limited by storage speed instead of the GPU.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/tmp/transcode-test";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:26:"App data (clips + history)";s:6:"Target";s:7:"/config";s:7:"Default";s:43:"/mnt/user/appdata/transcoding-gpu-benchmark";s:4:"Mode";s:2:"rw";s:11:"Description";s:282:"Persistent app-data folder (standard Unraid appdata). REQUIRED for the one-time download of the pinned benchmark clips (kept here forever - container updates never re-download them), and stores your run history, CPU efficiency baseline and leaderboard identity. Safe to leave as-is.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:43:"/mnt/user/appdata/transcoding-gpu-benchmark";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:33:"Cache (unused, keeps Docker tidy)";s:6:"Target";s:6:"/cache";s:7:"Default";s:49:"/mnt/user/appdata/transcoding-gpu-benchmark/cache";s:4:"Mode";s:2:"rw";s:11:"Description";s:188:"The Jellyfin base image declares a /cache volume the benchmark never uses. Mapping it here stops Docker from creating a new anonymous volume on every container update. Safe to leave as-is.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:49:"/mnt/user/appdata/transcoding-gpu-benchmark/cache";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:28:"CPU power readout (optional)";s:6:"Target";s:9:"/powercap";s:7:"Default";s:29:"/sys/devices/virtual/powercap";s:4:"Mode";s:2:"ro";s:11:"Description";s:344:"Optional, read-only. Exposes the kernel's RAPL energy counters (the same source as the Unraid dashboard's CPU power) so CPU and iGPU tests can show real package watts - works on Intel AND modern AMD (Zen 2+) CPUs, no extra capabilities needed. Safe to leave as-is; remove it and CPU power falls back to intel_gpu_top (Intel GPU + PERFMON only).";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:29:"/sys/devices/virtual/powercap";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:40:"RAM speed readout (Intel iGPU, optional)";s:6:"Target";s:4:"/dmi";s:7:"Default";s:24:"/sys/firmware/dmi/tables";s:4:"Mode";s:2:"ro";s:11:"Description";s:229:"Optional, read-only. Lets the scoreboard show the system RAM type/speed for Intel iGPU runs (useful for explaining different results - e.g. XMP/EXPO off). Safe to leave as-is; remove it if you prefer not to expose the DMI tables.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:24:"/sys/firmware/dmi/tables";}i:7;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Unraid version (optional)";s:6:"Target";s:15:"/unraid-version";s:7:"Default";s:19:"/etc/unraid-version";s:4:"Mode";s:2:"ro";s:11:"Description";s:129:"Optional, read-only. Lets the result include your Unraid OS version (handy for the shared results database). Safe to leave as-is.";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:19:"/etc/unraid-version";}i:8;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:27:"Temperature unit (optional)";s:6:"Target";s:12:"/dynamix.cfg";s:7:"Default";s:40:"/boot/config/plugins/dynamix/dynamix.cfg";s:4:"Mode";s:2:"ro";s:11:"Description";s:268:"Optional, read-only. Lets the scoreboard show temperatures in Fahrenheit or Celsius to match your Unraid display setting (Settings - Display Settings). Safe to leave as-is; remove it and temperatures default to Celsius (you can still click the Temp readout to switch).";s:4:"Type";s:4:"Path";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:40:"/boot/config/plugins/dynamix/dynamix.cfg";}i:9;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"Your test clips folder";s:6:"Target";s:6:"/input";s:7:"Default";s:49:"/mnt/user/appdata/transcoding-gpu-benchmark/input";s:4:"Mode";s:2:"ro";s:11:"Description";s:486:"Read-only drop folder for benchmarking YOUR OWN videos: copy one or a few files in and they appear in the 'Or test your own file' picker (codec and resolution auto-detected). The benchmark samples 60 seconds from the MIDDLE of the chosen file (openings are easy-to-decode logos/credits) and loads it into RAM. You can point this at any folder - but NOT your whole media library (too many files and it refuses). Custom-file runs are local-only and never submitted to the shared database.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:49:"/mnt/user/appdata/transcoding-gpu-benchmark/input";}i:10;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"MAX_STREAMS";s:6:"Target";s:11:"MAX_STREAMS";s:7:"Default";s:3:"128";s:4:"Mode";s:0:"";s:11:"Description";s:126:"Safety cap on the ramp. Fast GPUs (e.g. high-end NVIDIA) can sustain many streams; raise only if a run ends with 'MAX >= 128'.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"128";}i:11;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:22:"NVIDIA_VISIBLE_DEVICES";s:6:"Target";s:22:"NVIDIA_VISIBLE_DEVICES";s:7:"Default";s:3:"all";s:4:"Mode";s:0:"";s:11:"Description";s:154:"NVIDIA only. Which NVIDIA GPUs the container can see. 'all' exposes every NVIDIA GPU. Requires --runtime=nvidia in Extra Parameters. Ignored by Intel/AMD.";