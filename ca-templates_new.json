"tcp";s:11:"Description";s:119:"Host port mapped to the container's internal port 8080. Default is 8007 to avoid conflicts with common Unraid services.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"8007";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"Data";s:6:"Target";s:33:"/var/lib/taskchampion-sync-server";s:7:"Default";s:42:"/mnt/user/appdata/taskchampion-sync-server";s:4:"Mode";s:2:"rw";s:11:"Description";s:48:"Persistent storage for the SQLite task database.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:42:"/mnt/user/appdata/taskchampion-sync-server";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:139:"UID the server process runs as. Defaults to Unraid's nobody user (99). Change to match your user ID on other systems (run `id` to find it).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:141:"GID the server process runs as. Defaults to Unraid's users group (100). Change to match your group ID on other systems (run `id` to find it).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:12:"Client ID(s)";s:6:"Target";s:9:"CLIENT_ID";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:206:"Required. UUID(s) allowed to sync. Comma-separated for multiple devices (e.g. uuid1,uuid2). Generate a UUID with `uuidgen` on Linux/Mac or use an online generator. The container will not start without this.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"No Create Clients";s:6:"Target";s:17:"NO_CREATE_CLIENTS";s:7:"Default";s:5:"false";s:4:"Mode";s:0:"";s:11:"Description";s:202:"Set to true to prevent new clients from registering after initial setup. Only useful after all your devices have synced at least once — enabling this before first sync will block even allowed clients.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"false";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:14:"Listen Address";s:6:"Target";s:6:"LISTEN";s:7:"Default";s:12:"0.0.0.0:8080";s:4:"Mode";s:0:"";s:11:"Description";s:120:"Address and port the server binds to inside the container. Only change this if you also adjust the container port above.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:12:"0.0.0.0:8080";}}s:12:"TemplatePath";s:48:"/tmp/GitHub/AppFeed/taskchampion-sync-server.xml";s:4:"Repo";s:34:"UnraidUser-3609265787's Repository";s:12:"CategoryList";a:2:{i:0;s:12:"Productivity";i:1;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1778890064;s:8:"Category";s:29:"Productivity: Tools:Utilities";s:2:"ID";i:2119;s:11:"Displayable";b:1;s:6:"Author";s:8:"furan917";s:13:"DockerHubName";s:24:"taskchampion-sync-server";s:8:"RepoName";s:34:"UnraidUser-3609265787's Repository";s:10:"SortAuthor";s:8:"furan917";s:8:"SortName";s:24:"taskchampion sync server";s:6:"random";i:1923487353;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:137:"/tmp/community.applications/tempFiles/templates-community-apps/UnraidUser3609265787sRepository/furan917-taskchampionsyncserver-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:2120;a:36:{s:4:"Name";s:22:"taskwarrior-web-portal";s:10:"Repository";s:53:"ghcr.io/furan917/taskwarrior-web-portal-docker:latest";s:8:"Registry";s:102:"https://github.com/furan917/taskwarrior-web-portal-docker/pkgs/container/taskwarrior-web-portal-docker";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:70:"https://forums.unraid.net/topic/XXXXXX-support-taskwarrior-web-portal/";s:7:"Project";s:50:"https://github.com/furan917/taskwarrior-web-portal";s:8:"Overview";s:778:"A web UI for Taskwarrior 3.x, packaged for Unraid. Browse, create, edit, and complete tasks from your browser without touching the CLI. Task data lives on your Unraid share and is never sent anywhere unless you opt in to sync. Optionally pairs with the taskchampion-sync-server Community App to sync tasks across multiple devices — all encryption happens client-side, the sync server never sees plaintext. Runs fully local with no sync server if preferred.

WARNING: This app has no built-in authentication. It is designed for trusted LAN access only. If you intend to expose it outside your local network, place it behind a reverse proxy with authentication — for example Nginx Proxy Manager with HTTP Basic Auth, or a Cloudflare Tunnel with Authelia or Authentik in front.";s:5:"WebUI";s:24:"http://[IP]:[PORT:5050]/";s:11:"TemplateURL";s:104:"https://raw.githubusercontent.com/furan917/taskwarrior-web-portal-docker/main/taskwarrior-web-portal.xml";s:4:"Icon";s:47:"https://avatars.githubusercontent.com/u/7008500";s:11:"ExtraParams";s:24:"--restart=unless-stopped";s:8:"Requires";s:765:"Taskwarrior 3.x is bundled in the image — nothing to install separately. On first start the container generates a unique client UUID. You can find it in the container log (Unraid Docker tab > Log icon) or on the web portal's config page (cog icon, top right). If you are syncing across multiple devices, all devices must use the same UUID — set the Sync Client ID field to match your existing device's UUID so they share the same task database on the server. To add UDA definitions, context definitions, journal settings, or any other Taskwarrior settings, edit /config/taskrc — add your settings below the end marker line. The container-managed block at the top of that file is regenerated on each start, but your settings below the marker are never touched.";s:6:"Config";a:11:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"WebUI Port";s:6:"Target";s:4:"5050";s:7:"Default";s:4:"5050";s:4:"Mode";s:3:"tcp";s:11:"Description";s:108:"Host port for the web UI. The default is 5050; change it here if that port is already in use on your server.";s:4:"Type";s:4:"Port";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:4:"5050";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:6:"Config";s:6:"Target";s:7:"/config";s:7:"Default";s:40:"/mnt/user/appdata/taskwarrior-web-portal";s:4:"Mode";s:2:"rw";s:11:"Description";s:120:"Persistent storage for your task data, client UUID, and config. Back this path up — it is the only copy of your tasks.";s:4:"Type";s:4:"Path";s:7:"Display";s:6:"always";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:40:"/mnt/user/appdata/taskwarrior-web-portal";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PUID";s:6:"Target";s:4:"PUID";s:7:"Default";s:2:"99";s:4:"Mode";s:0:"";s:11:"Description";s:175:"User ID the process runs as. Defaults to Unraid's nobody user (99). Set to your own UID (run `id -u` in the Unraid terminal) if you want task files owned by your user account.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:2:"99";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:4:"PGID";s:6:"Target";s:4:"PGID";s:7:"Default";s:3:"100";s:4:"Mode";s:0:"";s:11:"Description";s:69:"Group ID the process runs as. Defaults to Unraid's users group (100).";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:3:"100";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"Disable Host Check";s:6:"Target";s:22:"TWP_DISABLE_HOST_CHECK";s:7:"Default";s:1:"1";s:4:"Mode";s:0:"";s:11:"Description";s:204:"Set to 1 to disable the host/origin allowlist check. Recommended for Docker deployments where the external hostname or port is not known. Set to 0 and use Allowed Hosts below if you want stricter control.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:1:"1";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:13:"Allowed Hosts";s:6:"Target";s:17:"TWP_ALLOWED_HOSTS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:134:"Only used when Disable Host Check is 0. Your Unraid server's LAN IP address, e.g. 192.168.1.10. Separate multiple entries with commas.";s:4:"Type";s:8:"Variable";s:7:"Display";s:6:"always";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s