ePath";s:47:"/tmp/GitHub/AppFeed/templates/gods-eye-view.xml";s:4:"Repo";s:21:"Lindworm's Repository";s:12:"CategoryList";a:1:{i:0;s:15:"Tools-Utilities";}s:9:"FirstSeen";i:1791389636;s:8:"Category";s:15:"Tools:Utilities";s:2:"ID";i:889;s:11:"Displayable";b:1;s:6:"Author";s:10:"mircoblitz";s:13:"DockerHubName";s:13:"gods-eye-view";s:8:"RepoName";s:21:"Lindworm's Repository";s:10:"SortAuthor";s:10:"mircoblitz";s:8:"SortName";s:13:"Gods Eye View";s:6:"random";i:500410280;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:116:"/tmp/community.applications/tempFiles/templates-community-apps/LindwormsRepository/mircoblitz-GodsEyeView-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:890;a:43:{s:4:"Name";s:6:"NocoDB";s:10:"Repository";s:20:"nocodb/nocodb:latest";s:8:"Registry";s:38:"https://hub.docker.com/r/nocodb/nocodb";s:7:"Network";s:6:"bridge";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:58:"https://github.com/MircoBlitz/unraid-community-apps/issues";s:7:"Project";s:32:"https://github.com/nocodb/nocodb";s:8:"Overview";s:449:"NocoDB is a self-hosted database application with a spreadsheet-style interface, forms, views, and APIs. This template uses the official NocoDB image. It works with SQLite by default. PostgreSQL is recommended for ongoing use; provide its database and user separately. Persistent appdata is required with either database. See the installation and database guide at https://github.com/MircoBlitz/Unraid-community-apps/blob/main/docs/nocodb/README.md.";s:5:"WebUI";s:33:"http://[IP]:[PORT:8080]/dashboard";s:11:"TemplateURL";s:92:"https://raw.githubusercontent.com/MircoBlitz/unraid-community-apps/main/templates/nocodb.xml";s:4:"Icon";s:87:"https://raw.githubusercontent.com/nocodb/nocodb/develop/packages/nc-gui/public/icon.png";s:11:"ExtraParams";s:24:"--init --stop-timeout=30";s:8:"Requires";s:476:"Set a long random Authentication Secret before the first start and keep it unchanged. Leave Database Connection empty to use SQLite. For PostgreSQL, first create a dedicated database and user on a separately managed PostgreSQL server. Keep the web port on a trusted LAN or VPN; create the administrator account before exposing it through an HTTPS reverse proxy. Back up appdata and the database before updating. Changing the database connection does not migrate existing data.";s:6:"Config";a:7:{i:0;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:7:"Appdata";s:6:"Target";s:13:"/usr/app/data";s:7:"Default";s:24:"/mnt/user/appdata/nocodb";s:4:"Mode";s:2:"rw";s:11:"Description";s:130:"Persistent SQLite database, local attachments, and application files. Required with SQLite and PostgreSQL. Back up this directory.";s:4:"Type";s:4:"Path";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:1;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"Web UI Port";s:6:"Target";s:4:"8080";s:7:"Default";s:4:"8080";s:4:"Mode";s:3:"tcp";s:11:"Description";s:101:"NocoDB web interface and API. Restrict access to a trusted LAN or VPN, or use an HTTPS reverse proxy.";s:4:"Type";s:4:"Port";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:2;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:21:"Authentication Secret";s:6:"Target";s:18:"NC_AUTH_JWT_SECRET";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:193:"Required long random secret used to sign authentication tokens. Generate it with a password manager before first start, store it securely, and keep the same value across updates and recreation.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:4:"true";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:3;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"Database Connection";s:6:"Target";s:5:"NC_DB";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:279:"Leave empty for SQLite. PostgreSQL is recommended for ongoing use and must be supplied separately. Format: pg://HOST:5432?u=USER&amp;p=PASSWORD&amp;d=DATABASE. URL-encode special characters in connection values. Use a dedicated database and user. This value contains credentials.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:4;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:10:"Public URL";s:6:"Target";s:13:"NC_PUBLIC_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:143:"Optional externally reachable URL when using an HTTPS reverse proxy, for example https://nocodb.example.com. Leave empty for direct LAN access.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:5;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:25:"Connection Encryption Key";s:6:"Target";s:25:"NC_CONNECTION_ENCRYPT_KEY";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:283:"Optional stable encryption key for credentials of external data sources. Without it, upstream stores those credentials in plaintext in the database. Set it before configuring external sources. Later changes require the upstream secret-management CLI; do not simply replace the value.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:6;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:17:"Disable Telemetry";s:6:"Target";s:15:"NC_DISABLE_TELE";s:7:"Default";s:4:"true";s:4:"Mode";s:0:"";s:11:"Description";s:53:"Set true to disable anonymous NocoDB usage telemetry.";s:4:"Type";s:8:"Variable";s:7:"Display";s:13:"advanced-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}}s:12:"TemplatePath";s:40:"/tmp/GitHub/AppFeed/templates/nocodb.xml";s:4:"Repo";s:21:"Lindworm's Repository";s:12:"CategoryList";a:1:{i:0;s:12:"Productivity";}s:8:"Official";b:1;s:5:"stars";i:97;s:9:"downloads";i:22695355;s:9:"FirstSeen";i:1792354556;s:10:"LastUpdate";i:1790692715;s:14:"LastUpdateScan";i:1792354556;s:8:"Category";s:13:"Productivity:";s:2:"ID";i:890;s:11:"Displayable";b:1;s:6:"Author";s:6:"nocodb";s:13:"DockerHubName";s:6:"nocodb";s:8:"RepoName";s:21:"Lindworm's Repository";s:10:"SortAuthor";s:6:"nocodb";s:8:"SortName";s:6:"NocoDB";s:6:"random";i:1360350506;s:9:"Blacklist";b:0;s:6:"MinVer";s:3:"6.0";s:4:"Path";s:107:"/tmp/community.applications/tempFiles/templates-community-apps/LindwormsRepository/nocodb-NocoDB-latest.xml";s:4:"Date";N;s:11:"BrandNewApp";b:1;s:10:"Deprecated";b:0;s:10:"DonateText";N;s:10:"DonateLink";N;s:10:"Compatible";b:1;s:16:"ModeratorComment";N;}i:891;a:40:{s:4:"Name";s:9:"tor-relay";s:10:"Repository";s:34:"mitchellthompkins/tor-relay:latest";s:8:"Registry";s:76:"https://hub.docker.com/repository/docker/mitchellthompkins/tor-relay/general";s:7:"Network";s:3:"br0";s:5:"Shell";s:2:"sh";s:10:"Privileged";s:5:"false";s:7:"Support";s:74:"https://forums.unraid.net/topic/193216-support-mitchellthompkinstor-relay/";s:7:"Project";s:58:"https://github.com/MitchellThompkins/tor-relay/tree/master";s:8:"Overview";s:1379:"This allows a tor to act as a relay on your Unraid system. It does NOT allow it to act as an exit node. It automatically enables account bandwidth tracking to prevent from using too much network bandwidth.

These are the container variables which can be modified:

IPV4_ONLY
OR_PORT
DIR_PORT
RELAY_BANDWIDTH_RATE
RELAY_BANDWIDTH_BURST
ACCOUNTING_MAX
ACCOUNTING_START
NICKNAME
CONTACT_INFO
ENABLE_METRICS
METRICS_PORT
METRICS_PORT_POLICY

A few defaults are pre-set, otherwise they are set by the container itself. Metrics are disabled unless ENABLE_METRICS is set to 1.

Two manual steps are required, in addition to one highly recommended configuration:

1. (Step1) Users must create a data/ folder somewhere on their Unraid system, by default it is expected that this is at /mnt/user/appdata/tor-relay/data/
2. (Step2) The root user must change the folder permissions to that of the unprivileged tor user. This is required for tor container to create a .tor folder to track bandwidth stats between reboots.
3. (Configuration) Assign this container a static ip on the network, and forward the ports for OR_PORT and DIR_PORT to that static ip.

These two manual steps from above are:

