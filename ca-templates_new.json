like to remove orphaned files from your root_dir directory that are not referenced by any torrents. It will scan your root_dir directory and compare it with what is in qBittorrent. Any data not referenced in qBittorrent will be moved into /data/torrents/orphaned_data folder for you to review/delete.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"False";}i:15;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:19:"QBT_TAG_NOHARDLINKS";s:6:"Target";s:19:"QBT_TAG_NOHARDLINKS";s:7:"Default";s:10:"False|True";s:4:"Mode";s:0:"";s:11:"Description";s:442:"Use this to tag any torrents that do not have any hard links associated with any of the files. This is useful for those that use Sonarr/Radarr that hard links your media files with the torrents for seeding. When files get upgraded they no longer become linked with your media therefore will be tagged with a new tag noHL. You can then safely delete/remove these torrents to free up any extra space that is not being used by your media folder.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"False";}i:16;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:16:"QBT_SKIP_CLEANUP";s:6:"Target";s:16:"QBT_SKIP_CLEANUP";s:7:"Default";s:10:"False|True";s:4:"Mode";s:0:"";s:11:"Description";s:60:"Use this to skip cleaning up Recycle Bin/Orphaned directory.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"False";}i:17;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:11:"QBT_DRY_RUN";s:6:"Target";s:11:"QBT_DRY_RUN";s:7:"Default";s:10:"True|False";s:4:"Mode";s:0:"";s:11:"Description";s:102:"If you would like to see what is gonna happen but not actually move/delete or tag/categorize anything.";s:4:"Type";s:8:"Variable";s:7:"Display";s:11:"always-hide";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:5:"False";}i:18;a: