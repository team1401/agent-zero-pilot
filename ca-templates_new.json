e";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:68;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_SMTP_USER";s:6:"Target";s:15:"EMAIL_SMTP_USER";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Optional. SMTP authentication username.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:69;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_SMTP_PASS";s:6:"Target";s:15:"EMAIL_SMTP_PASS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:39:"Optional. SMTP authentication password.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:4:"true";}s:5:"value";s:0:"";}i:70;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:18:"EMAIL_FROM_ADDRESS";s:6:"Target";s:18:"EMAIL_FROM_ADDRESS";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:74:"Optional. Sender email address for outgoing mail, e.g. yuvomi@example.com.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:71;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:15:"EMAIL_FROM_NAME";s:6:"Target";s:15:"EMAIL_FROM_NAME";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:177:"Optional. Sender display name for outgoing mail. Leave empty to set it under Settings, Household, Email (the server then uses Yuvomi); any value here locks that field in the UI.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";s:8:"Required";s:5:"false";s:4:"Mask";s:5:"false";}s:5:"value";s:0:"";}i:72;a:2:{s:11:"@attributes";a:9:{s:4:"Name";s:8:"BASE_URL";s:6:"Target";s:8:"BASE_URL";s:7:"Default";s:0:"";s:4:"Mode";s:0:"";s:11:"Description";s:224:"Optional but required for password-reset emails to be sent. Absolute origin used to build reset links, e.g. https://yuvomi.example.com. The request Host header is never trusted as a fallback, to prevent reset-link poisoning.";s:4:"Type";s:8:"Variable";s:7:"Display";s:8:"advanced";